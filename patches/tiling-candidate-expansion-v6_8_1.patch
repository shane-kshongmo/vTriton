index 000000000..5a4e8b732
--- /dev/null
+++ b/third_party/ascend/experiments/candidate_value_eval/validate_native_v68_pair.py
@@ -0,0 +1,353 @@
+#!/usr/bin/env python3
+"""V6.8 robust post-selection validation with long-window Event + MSProf parser V2."""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+import os
+import shutil
+import statistics
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CAL = HERE.parent / "vtriton_new_ops_calibration"
+for p in (HERE, CAL):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+
+def read(p: Path):
+    return json.loads(p.read_text(encoding="utf-8"))
+
+
+def write(p: Path, x):
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(json.dumps(x, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
+
+
+def _event_batch_ms(di, fn, launches: int) -> float:
+    start = di.Event(enable_timing=True)
+    end = di.Event(enable_timing=True)
+    start.record()
+    for _ in range(max(1, launches)):
+        fn()
+    end.record()
+    di.synchronize()
+    return float(start.elapsed_time(end))
+
+
+def calibrate_common_batch(di, fns: dict[str, object], *, target_window_ms: float,
+                           probe_launches: int, max_launches: int) -> dict:
+    estimates = {}
+    for name, fn in fns.items():
+        # Three probes make the batch decision less sensitive to one tiny-event sample.
+        vals = []
+        for _ in range(3):
+            vals.append(_event_batch_ms(di, fn, probe_launches) / max(1, probe_launches))
+        estimates[name] = statistics.median(vals)
+    fastest = max(1e-6, min(estimates.values()))
+    batch = int(math.ceil(max(1.0, target_window_ms) / fastest))
+    batch = min(max(1, batch), max(1, int(max_launches)))
+    return {
+        "probe_launches": probe_launches,
+        "single_launch_estimate_ms": estimates,
+        "target_window_ms": target_window_ms,
+        "chosen_common_launches_per_sample": batch,
+        "max_launches_per_sample": max_launches,
+    }
+
+
+def bench_samples(di, fn, *, warmup_batches: int, repeats: int, launches_per_sample: int):
+    batch = max(1, int(launches_per_sample))
+    for _ in range(max(1, int(warmup_batches))):
+        for _ in range(batch):
+            fn()
+    di.synchronize()
+    device_vals = []
+    window_vals = []
+    host_vals = []
+    for _ in range(max(1, int(repeats))):
+        start_event = di.Event(enable_timing=True)
+        end_event = di.Event(enable_timing=True)
+        host0 = time.perf_counter()
+        start_event.record()
+        for _ in range(batch):
+            fn()
+        end_event.record()
+        di.synchronize()
+        window_ms = float(start_event.elapsed_time(end_event))
+        device_vals.append(window_ms / batch)
+        window_vals.append(window_ms)
+        host_vals.append((time.perf_counter() - host0) * 1000.0 / batch)
+    return {
+        "device_event_per_launch_samples_ms": device_vals,
+        "device_event_window_samples_ms": window_vals,
+        "host_wall_per_launch_samples_ms": host_vals,
+        "device_event_median_ms": statistics.median(device_vals),
+        "device_event_mean_ms": statistics.fmean(device_vals),
+        "device_event_window_median_ms": statistics.median(window_vals),
+        "host_wall_median_ms": statistics.median(host_vals),
+        "launches_per_sample": batch,
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo", type=Path, required=True)
+    ap.add_argument("--result-root", type=Path, required=True)
+    ap.add_argument("--operator", choices=("flash_attention_npu_v8", "chunk_o"), required=True)
+    ap.add_argument("--case-index", type=int, required=True)
+    ap.add_argument("--output", type=Path, required=True)
+    ap.add_argument("--cache-dir", type=Path, required=True)
+    ap.add_argument("--rounds", type=int, default=5)
+    ap.add_argument("--warmup-batches", type=int, default=3)
+    ap.add_argument("--repeats", type=int, default=7)
+    ap.add_argument("--target-event-window-ms", type=float, default=50.0)
+    ap.add_argument("--probe-launches", type=int, default=32)
+    ap.add_argument("--max-launches-per-sample", type=int, default=8192)
+    ap.add_argument("--run-msprof", action="store_true")
+    ap.add_argument("--msprof-warmup", type=int, default=10)
+    ap.add_argument("--msprof-iterations", type=int, default=60)
+    ap.add_argument("--suspicious-gap-pct-points", type=float, default=5.0)
+    a = ap.parse_args()
+
+    root = a.result_root.resolve()
+    off = read(root / "official" / a.operator / f"case_{a.case_index}" / "result.json")
+    ours = read(root / "ours_v68" / a.operator / f"case_{a.case_index}" / "result.json")
+    cfgs = {"official": dict(off["winner"]["config"]), "ours_v68": dict(ours["winner"]["config"])}
+
+    shutil.rmtree(a.cache_dir, ignore_errors=True)
+    a.cache_dir.mkdir(parents=True, exist_ok=True)
+    os.environ["TRITON_CACHE_DIR"] = str(a.cache_dir.resolve())
+    os.environ["TRITON_DUMP_DIR"] = str((a.cache_dir / "triton_dump").resolve())
+
+    import torch
+    import torch_npu  # noqa: F401
+    import triton
+    from cases import get_cases
+    from operator_adapters import load_module, prepare, reference, launch
+    from msprof_parser_v55 import parse_msprof_csv
+
+    di = triton.runtime.driver.active.get_device_interface()
+    case = dict(get_cases(a.operator)[a.case_index])
+    module, source = load_module(a.repo.resolve(), a.operator)
+
+    # Each winner gets an independent tensor/output state.  Earlier versions used a
+    # shared output buffer for Official and Ours, which can hide sequence/state
+    # dependence and makes a failing second winner hard to diagnose.  Inputs are
+    # deterministic because the adapter seeds prepare() identically.
+    tensors_by = {}
+    refs = {}
+    fns = {}
+    tol = 4e-2 if case["dtype"] == "bfloat16" else 2e-2
+
+    def _check(name: str, out):
+        finite = bool(torch.isfinite(out).all().item())
+        ok = finite and bool(torch.allclose(out, refs[name], atol=tol, rtol=tol, equal_nan=False))
+        diff = (out.float() - refs[name].float()).abs()
+        max_abs = float(diff.max().item()) if finite else float("inf")
+        return {
+            "allclose": ok,
+            "finite": finite,
+            "max_abs_error": max_abs,
+            "nan_count": int(torch.isnan(out).sum().item()),
+            "inf_count": int(torch.isinf(out).sum().item()),
+            "atol": tol, "rtol": tol,
+        }
+
+    correctness = {}
+    for name, cfg in cfgs.items():
+        tensors = prepare(a.operator, case, cfg, "npu")
+        ref = reference(a.operator, case, tensors)
+        di.synchronize()
+        out = launch(a.operator, module, case, cfg, tensors)
+        di.synchronize()
+        tensors_by[name] = tensors
+        refs[name] = ref
+        correctness[name] = _check(name, out)
+        fns[name] = lambda c=cfg, t=tensors: launch(a.operator, module, case, c, t)
+
+    if not all(x["allclose"] for x in correctness.values()):
+        failure = {
+            "schema_version": "candidate_value_v6_8_post_validation_failure_v1",
+            "operator": a.operator,
+            "case_index": a.case_index,
+            "case": case,
+            "configs": cfgs,
+            "correctness": correctness,
+            "stage": "initial_independent_winner_replay",
+        }
+        write(a.output, failure)
+        raise RuntimeError(f"post-validation correctness failed: {correctness}")
+
+    calibration = calibrate_common_batch(
+        di, fns,
+        target_window_ms=a.target_event_window_ms,
+        probe_launches=max(1, a.probe_launches),
+        max_launches=max(1, a.max_launches_per_sample),
+    )
+    batch = int(calibration["chosen_common_launches_per_sample"])
+
+    calibration_correctness = {}
+    for name in cfgs:
+        calibration_correctness[name] = _check(name, tensors_by[name]["o"])
+    if not all(x["allclose"] for x in calibration_correctness.values()):
+        failure = {
+            "schema_version": "candidate_value_v6_8_post_validation_failure_v1",
+            "operator": a.operator,
+            "case_index": a.case_index,
+            "case": case,
+            "configs": cfgs,
+            "correctness": correctness,
+            "calibration_correctness": calibration_correctness,
+            "calibration": calibration,
+            "stage": "after_batch_calibration",
+        }
+        write(a.output, failure)
+        raise RuntimeError(f"winner became incorrect during batch calibration: {calibration_correctness}")
+
+    rounds = []
+    device_by = {k: [] for k in cfgs}
+    host_by = {k: [] for k in cfgs}
+    window_by = {k: [] for k in cfgs}
+    for r in range(max(1, a.rounds)):
+        order = ["official", "ours_v68"] if r % 2 == 0 else ["ours_v68", "official"]
+        rr = {"round": r, "order": order, "results": {}}
+        for name in order:
+            rec = bench_samples(
+                di, fns[name],
+                warmup_batches=a.warmup_batches,
+                repeats=a.repeats,
+                launches_per_sample=batch,
+            )
+            stability = _check(name, tensors_by[name]["o"])
+            rec["post_batch_correctness"] = stability
+            if not stability["allclose"]:
+                failure = {
+                    "schema_version": "candidate_value_v6_8_post_validation_failure_v1",
+                    "operator": a.operator,
+                    "case_index": a.case_index,
+                    "case": case,
+                    "configs": cfgs,
+                    "correctness": correctness,
+                    "calibration_correctness": calibration_correctness,
+                    "round": r,
+                    "method": name,
+                    "batch_result": rec,
+                    "stage": "after_timed_batch",
+                }
+                write(a.output, failure)
+                raise RuntimeError(f"winner became incorrect after timed batch: {name}: {stability}")
+            rr["results"][name] = rec
+            device_by[name].append(float(rec["device_event_median_ms"]))
+            host_by[name].append(float(rec["host_wall_median_ms"]))
+            window_by[name].append(float(rec["device_event_window_median_ms"]))
+        rounds.append(rr)
+
+    device_med = {k: statistics.median(v) for k, v in device_by.items()}
+    host_med = {k: statistics.median(v) for k, v in host_by.items()}
+    window_med = {k: statistics.median(v) for k, v in window_by.items()}
+    gain = (device_med["official"] - device_med["ours_v68"]) / device_med["official"] * 100.0
+    host_gain = (host_med["official"] - host_med["ours_v68"]) / host_med["official"] * 100.0
+
+    result = {
+        "schema_version": "candidate_value_v6_8_post_validation_v1",
+        "operator": a.operator,
+        "case_index": a.case_index,
+        "case": case,
+        "source": str(source),
+        "configs": cfgs,
+        "calibration": calibration,
+        "rounds": rounds,
+        "device_event_round_medians_ms": device_by,
+        "device_event_window_round_medians_ms": window_by,
+        "host_wall_round_medians_ms": host_by,
+        "device_event_median_of_round_medians_ms": device_med,
+        "device_event_window_median_of_round_medians_ms": window_med,
+        "host_wall_median_of_round_medians_ms": host_med,
+        "gain_pct": gain,
+        "host_wall_gain_pct": host_gain,
+        "primary_metric": "long_window_device_event_median_of_round_medians_ms",
+        "correctness": correctness,
+        "calibration_correctness": calibration_correctness,
+        "contract": {
+            "independent_tensor_state_per_winner": True,
+            "correctness_rechecked_after_calibration_and_each_timed_batch": True,
+            "alternating_order": True,
+            "common_batch_for_both_winners": True,
+            "adaptive_long_event_window": True,
+            "target_event_window_ms": a.target_event_window_ms,
+            "device_event_primary": True,
+            "host_wall_secondary": True,
+            "winner_selection_independent": True,
+            "post_validation_not_in_autotune_overhead": True,
+        },
+    }
+
+    if a.run_msprof:
+        import fresh_end_to_end_value_eval as helper
+        env = os.environ.copy(); ms = {}
+        for name, src in (("official", off), ("ours_v68", ours)):
+            ms[name] = helper.profile_winner(
+                a.repo.resolve(), CAL / "worker.py", a.operator, a.case_index, src["winner"],
+                a.output.parent / f"msprof_{name}", env, a.msprof_warmup, a.msprof_iterations,
+            )
+            ms[name]["sample_stats_v2"] = parse_msprof_csv(
+                Path(ms[name]["source_csv"]) if ms[name].get("source_csv") else Path("/nonexistent"),
+                str(ms[name].get("kernel_token") or ""),
+                expected_iterations=a.msprof_iterations,
+                scalar_fallback_us=ms[name].get("kernel_duration_us"),
+            )
+        result["msprof"] = ms
+        ou = (ms["official"].get("sample_stats_v2") or {}).get("duration_us")
+        nu = (ms["ours_v68"].get("sample_stats_v2") or {}).get("duration_us")
+        result["msprof_gain_pct"] = (float(ou) - float(nu)) / float(ou) * 100.0 if ou and nu else None
+        mg = result["msprof_gain_pct"]
+        evidence_ok = all(bool((ms[name].get("sample_stats_v2") or {}).get("evidence_sufficient")) for name in ms)
+        event_us = {k: float(v) * 1000.0 for k, v in device_med.items()}
+        ms_us = {
+            "official": float(ou) if ou is not None else None,
+            "ours_v68": float(nu) if nu is not None else None,
+        }
+        launch_overhead_proxy = {
+            k: (event_us[k] - ms_us[k]) if ms_us[k] is not None else None
+            for k in event_us
+        }
+        result["launch_overhead_proxy_us"] = launch_overhead_proxy
+        result["timing_consistency"] = {
+            "event_vs_msprof_sign_match": None if mg is None else ((gain >= 0) == (mg >= 0)),
+            "event_vs_msprof_abs_gap_pct_points": None if mg is None else abs(gain - mg),
+            "msprof_evidence_sufficient": evidence_ok,
+            "msprof_parser_modes": {k: (ms[k].get("sample_stats_v2") or {}).get("mode") for k in ms},
+            "suspicious_gap_threshold_pct_points": a.suspicious_gap_pct_points,
+            "suspicious": None if mg is None else (
+                ((gain >= 0) != (mg >= 0))
+                or abs(gain - mg) > a.suspicious_gap_pct_points
+                or not evidence_ok
+            ),
+            "interpretation": (
+                "event measures steady-state launch-to-completion device interval; "
+                "MSProf measures profiler-reported target-kernel duration; their gap may include fixed launch/dispatch effects"
+            ),
+        }
+
+    write(a.output, result)
+    print(json.dumps({
+        "operator": a.operator,
+        "case": a.case_index,
+        "long_window_launches": batch,
+        "event_window_ms": window_med,
+        "post_event_gain_pct": gain,
+        "post_host_gain_pct": host_gain,
+        "msprof_gain_pct": result.get("msprof_gain_pct"),
+        "timing_suspicious": (result.get("timing_consistency") or {}).get("suspicious"),
+    }, ensure_ascii=False))
+    print("OUTPUT=", a.output)
+
+
+if __name__ == "__main__":
+    main()
