+#!/usr/bin/env python3
+"""Post-hoc ranking/search diagnostics for Candidate Value V6.8.
+
+Hardware outcomes are read only after the V6.8 search has finished. Nothing in
+this file can influence source-prior ranking or online acquisition.
+"""
+from __future__ import annotations
+import argparse, json
+from pathlib import Path
+
+
+def load(p): return json.loads(Path(p).read_text(encoding="utf-8"))
+def write(p,x):
+    p=Path(p); p.parent.mkdir(parents=True,exist_ok=True)
+    p.write_text(json.dumps(x,indent=2,ensure_ascii=False,default=str),encoding="utf-8")
+def sig(cfg): return tuple(sorted((str(k),v) for k,v in dict(cfg).items()))
+
+
+def measured_latency(rec):
+    for key in ("controller_normalized_observation_ms", "unified_native_timing_ms", "batch_native_timing_ms"):
+        v=rec.get(key)
+        if v is not None:
+            try: return float(v)
+            except Exception: pass
+    race=rec.get("pair_race") or {}
+    v=(race.get("median_ms") or {}).get("candidate")
+    try: return None if v is None else float(v)
+    except Exception: return None
+
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument("--root",type=Path,required=True); ap.add_argument("--operator",required=True); ap.add_argument("--case-index",type=int,required=True); ap.add_argument("--output",type=Path,required=True); a=ap.parse_args()
+    op=a.operator; idx=a.case_index
+    o=load(a.root/"official"/op/f"case_{idx}"/"result.json")
+    w=load(a.root/"ours_v68"/op/f"case_{idx}"/"result.json")
+    ranked=load(a.root/"ours_v68"/op/f"case_{idx}"/"precompile_ranked_pool.json").get("ranked",[])
+    plan=load(a.root/"ours_v68"/op/f"case_{idx}"/"selection_plan.json")
+    pp=a.root/"post_validation"/op/f"case_{idx}.json"; post=load(pp) if pp.is_file() else None
+
+    rank_by={sig(r["config"]):r.get("source_prior_rank") for r in ranked}
+    prop_by={sig(r["config"]):r for r in plan.get("proposal_queue",[])}
+    search=[r for r in list(w.get("search_records") or []) if r.get("config")]
+    search_by={sig(r["config"]):r for r in search}
+    osig=sig(o["winner"]["config"]); wsig=sig(w["winner"]["config"])
+
+    measured=[r for r in search if measured_latency(r) is not None and bool((r.get("correctness") or {}).get("allclose"))]
+    measured_sorted=sorted(measured,key=lambda r:(measured_latency(r), int(r.get("evaluation_index") or 10**9)))
+    best_novel=measured_sorted[0] if measured_sorted else None
+    winner_search=search_by.get(wsig)
+    result={
+      "schema_version":"candidate_value_v6_8_ranking_diagnostic_v1",
+      "operator":op,"case_index":idx,
+      "official_winner":o["winner"],"v68_winner":w["winner"],
+      "official_winner_source_prior_rank":rank_by.get(osig),
+      "v68_winner_source_prior_rank":rank_by.get(wsig),
+      "v68_winner_is_novel":str(w["winner"].get("origin_stage","B0"))!="B0",
+      "v68_winner_proposal_rank":(prop_by.get(wsig) or {}).get("proposal_rank"),
+      "v68_winner_proposal_role":(prop_by.get(wsig) or {}).get("proposal_role"),
+      "v68_winner_evaluation_index":None if winner_search is None else winner_search.get("evaluation_index"),
+      "v68_winner_batch_index":None if winner_search is None else winner_search.get("batch_index"),
+      "v68_winner_controller_estimate_before_measurement":None if winner_search is None else winner_search.get("controller_estimate_before_measurement"),
+      "safe_declared_domain_size":int(w.get("official_count",0))+int(w.get("safe_novel_count",0)),
+      "hardware_evaluated_count":int(w.get("official_count",0))+int(w.get("novel_correctness_valid_count",0)),
+      "near_optimal_status":w.get("near_optimal_status"),
+      "best_measured_novel":None if best_novel is None else {
+          "config":best_novel["config"],
+          "evaluation_index":best_novel.get("evaluation_index"),
+          "batch_index":best_novel.get("batch_index"),
+          "source_prior_rank":best_novel.get("source_prior_rank"),
+          "proposal_rank":best_novel.get("proposal_rank"),
