+from pathlib import Path
+import sys, types
+ROOT=Path(__file__).resolve().parents[3]
+RUNTIME=ROOT/"third_party/ascend/backend/runtime"
+if "backend" not in sys.modules:
+    b=types.ModuleType("backend"); b.__path__=[str(RUNTIME.parent)]; sys.modules["backend"]=b
+if "backend.runtime" not in sys.modules:
+    r=types.ModuleType("backend.runtime"); r.__path__=[str(RUNTIME)]; sys.modules["backend.runtime"]=r
+from backend.runtime.search_space_v6 import infer_search_space
+from backend.runtime.precompile_selection_v6 import build_v6_proposal_queue, progressive_stage_decision
+
+def row(cfg,score,rank,stage="S1"):
+    return {"config":cfg,"source_prior_rank":rank,"origin_stage":stage,"precompile_source_prefilter":{"consensus_rank_score":score,"rank_view_disagreement":0.1,"task_count":64,"total_inner_iterations":128}}
+
+def test_generic_one_axis_queue_and_exploration():
+    b0=[{"BLOCK_SIZE":128},{"BLOCK_SIZE":256}]
+    rows=[row(b0[0],.4,3,"B0"),row(b0[1],.3,2,"B0"),row({"BLOCK_SIZE":64},.1,1,"S1"),row({"BLOCK_SIZE":512},.8,4,"S2")]
+    sp=infer_search_space(b0,[r["config"] for r in rows],parameter_domains={"BLOCK_SIZE":[64,128,256,512]},tunable_parameters=["BLOCK_SIZE"])
+    p=build_v6_proposal_queue(rows,official_configs=b0,search_space=sp,proposal_queue_limit=4)
+    assert p["operator_name_used_by_search_policy"] is False
+    assert p["candidate_performance_labels_used"] is False
+    assert p["proposal_queue"]
+    assert set(x["proposal_role"] for x in p["proposal_queue"]).issubset({"exploit","explore"})
+
+def test_generic_gemm_queue_no_operator_dispatch():
+    b0=[{"BM":64,"BN":64,"BK":32},{"BM":128,"BN":64,"BK":32}]
+    rows=[row(b0[0],.5,3,"B0"),row(b0[1],.4,2,"B0"),row({"BM":64,"BN":128,"BK":32},.1,1,"S1")]
+    sp=infer_search_space(b0,[r["config"] for r in rows],parameter_domains={"BM":[64,128],"BN":[64,128],"BK":[32]},tunable_parameters=["BM","BN","BK"])
+    p=build_v6_proposal_queue(rows,official_configs=b0,search_space=sp)
+    assert p["proposal_queue"][0]["config"]["BN"]==128
+
+def test_progressive_model_only_stage_stop_disabled_for_near_optimality():
+    d=progressive_stage_decision(stage_name="B2_plus_s2")
+    assert d["stop"] is False
+    assert "near_optimal" in d["reason"]
+
+def test_launch_meta_is_coordinate_not_fake_tile_volume():
+    from backend.runtime.search_space_v6 import infer_search_space
+    from backend.runtime.generic_source_rank_v6 import rank_rows_generic
+
+    dom={"BLOCK_M":[64],"AICORE_NUM":[20],"num_warps":[4,8],"num_stages":[2,3]}
+    cfgs=[
+        {"BLOCK_M":64,"AICORE_NUM":20,"num_warps":4,"num_stages":2},
+        {"BLOCK_M":64,"AICORE_NUM":20,"num_warps":8,"num_stages":3},
+    ]
+    spec=infer_search_space(cfgs,cfgs,parameter_domains=dom,tunable_parameters=list(dom))
+    rows=[{"config":c,"origin_stage":"T"} for c in cfgs]
+    ranked,_=rank_rows_generic(rows,search_space=spec,all_args={"M":1024},options={"num_cores":20,"operator_family":"generic"})
+    recs=[r["precompile_source_prefilter"] for r in ranked]
+    assert {r["num_warps"] for r in recs}=={4.0,8.0}
+    assert {r["num_stages"] for r in recs}=={2.0,3.0}
+    # There is no universal monotone prior saying more warps/stages enlarge a tile.
+    assert len({r["tile_volume"] for r in recs})==1
