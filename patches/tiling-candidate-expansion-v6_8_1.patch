+"""Auditable hardware pruning for Ascend autotuning.
+
+Safe mode removes only explicit kernel/parameter legality violations.  The
+analytical capacity estimate is intentionally optional (``aggressive_capacity``)
+because an upper-bound estimate exceeding a capacity is not proof that the
+compiler's actual live allocation exceeds it.
+"""
+from __future__ import annotations
+from typing import Any, Dict, Mapping, Sequence, Tuple
+
+from .cv_autotune.hardware_consts import get_default_hardware_constraints
+
+
+def _ival(cfg, *names, default=1):
+    for name in names:
+        value = cfg.kwargs.get(name)
+        if isinstance(value, int):
+            return value
+    return default
+
+
+def check_hardware_constraints(cfg, all_args: Mapping[str, Any], dtype_bytes: int = 2,
+                               options: Mapping[str, Any] | None = None) -> Tuple[bool, str, Dict[str, int]]:
+    opts = dict(options or {})
+    hw = get_default_hardware_constraints()
+    bm = _ival(cfg, "BLOCK_M", "BLOCK_SIZE_M", "BM")
+    bn = _ival(cfg, "BLOCK_N", "BLOCK_SIZE_N", "BN")
+    bk = _ival(cfg, "BLOCK_K", "BLOCK_SIZE_K", "BK", default=int(all_args.get("HEAD_DIM", 1) or 1))
+    n_ctx = all_args.get("N_CTX")
+    head_dim = all_args.get("HEAD_DIM")
+
+    if min(bm, bn, bk) <= 0:
+        return False, "non_positive_tile", {}
+
+    # Tail tiles are legal for masked kernels. Enable divisibility only when the
+    # concrete kernel contract explicitly requires it.
+    if opts.get("require_n_ctx_divisible", False) and isinstance(n_ctx, int) and (n_ctx % bm or n_ctx % bn):
+        return False, "tile_does_not_divide_N_CTX", {}
+    if opts.get("require_head_dim_divisible", False) and isinstance(head_dim, int) and head_dim % bk:
+        return False, "BLOCK_K_does_not_divide_HEAD_DIM", {}
+    if opts.get("block_m_ge_block_n", False) and bm < bn:
+        return False, "kernel_constraint_BLOCK_M_lt_BLOCK_N", {}
+
+    # The concrete FA kernel uses NUM_BLOCKS_M = N_CTX // BLOCK_M and
+    # unmasked full-width K/V block loads. Therefore both tiling axes must
+    # divide N_CTX unless an explicitly different masked-tail kernel is used.
+    if opts.get("fa_requires_full_tiles", False) and isinstance(n_ctx, int):
+        if n_ctx % bm:
+            return False, "fa_kernel_BLOCK_M_must_divide_N_CTX", {}
+        if n_ctx % bn:
+            return False, "fa_kernel_BLOCK_N_must_divide_N_CTX", {}
+
+    # HEAD_DIM >= 256 follows the external-accumulator path and slices every
+    # BLOCK_M tile into four BLOCK_M//4 pieces. BM < 4 or BM % 4 != 0 is not
+    # a legal kernel shape for that path.
+    if opts.get("fa_head_dim_256_quarter_slices", False) and isinstance(head_dim, int) and head_dim >= 256:
+        if bm < 4 or bm % 4:
+            return False, "fa_kernel_HEAD_DIM256_requires_BLOCK_M_multiple_of_4", {}
+
+    allowed_small = {int(v) for v in opts.get("allowed_small_block_m", (1, 2, 4, 8))}
+    bm_multiple = max(1, int(opts.get("large_block_m_multiple_of", opts.get("block_m_multiple_of", 1))))
+    if bm not in allowed_small and bm % bm_multiple:
+        return False, f"kernel_constraint_BLOCK_M_not_multiple_of_{bm_multiple}", {}
+
+    stages = max(1, int(getattr(cfg, "num_stages", 1) or 1))
+    l0a = bm * bk * dtype_bytes * min(stages, 2)
+    l0b = bn * bk * dtype_bytes * min(stages, 2)
+    l0c = bm * bn * 4
+    l1 = (bm * bk + bn * bk) * dtype_bytes * min(stages, 2)
+    ub = ((bm * bk) + 2 * (bn * bk) + 2 * (bm * bn)) * dtype_bytes + 8 * bm
+    usage = {"l0a_bytes": l0a, "l0b_bytes": l0b, "l0c_bytes": l0c, "l1_bytes": l1, "ub_bytes": ub}
+
+    if opts.get("aggressive_capacity", False):
+        limits = {"l0a_bytes": hw.l0a_size, "l0b_bytes": hw.l0b_size, "l0c_bytes": hw.l0c_size,
+                  "l1_bytes": hw.max_l1_size, "ub_bytes": hw.ub_size}
+        for key, value in usage.items():
+            if value > limits[key]:
+                return False, f"analytical_{key}_exceeds_{limits[key]}", usage
+    return True, "kept_safe", usage
+
+
+def hard_prune_configs(configs: Sequence, all_args: Mapping[str, Any], dtype_bytes: int = 2,
+                       options: Mapping[str, Any] | None = None):
+    kept, records = [], {}
+    for cfg in configs:
+        valid, reason, usage = check_hardware_constraints(cfg, all_args, dtype_bytes, options)
+        records[cfg] = {"kept": valid, "reason": reason, **usage}
+        if valid:
+            kept.append(cfg)
+    return kept, records
