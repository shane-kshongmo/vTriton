+
+def _auxiliary_outputs_finite(operator: str, state: Mapping[str, Any], torch) -> bool:
+    """Require auxiliary kernel outputs to remain finite as part of stability eligibility.
+
+    FlashAttention writes an auxiliary LSE-like ``l`` buffer in addition to the
+    returned ``o`` tensor.  V6.8 only checked ``o``.  The 2026-08-18 910B3 run
+    exposed an Official B0 config that could intermittently leave NaN in ``l``
+    and later produce non-finite ``o`` on a clean replay.  Treat auxiliary
+    non-finiteness as a correctness failure even when the primary output happens
+    to pass on a particular launch.
+    """
+    if operator == "flash_attention_npu_v8" and "l" in state:
+        return bool(torch.isfinite(state["l"]).all().item())
+    return True
+
+
+def _stable_compile_validate_one(*, operator, case, module, tensors, ref, torch, cfg, replays: int = 3):
+    """Require consecutive clean replays before a candidate is correctness-eligible.
+
+    The compile cache is reused after the first launch, so extra clean replays are
+    cheap compared with candidate JIT.  A single failure is enough to quarantine
+    the candidate for the current run.
+    """
+    attempts = []
+    total_wall = 0.0
+    last = None
+    n = max(1, int(replays))
+    for i in range(n):
+        rec = _compile_validate_one(
+            operator=operator, case=case, module=module, tensors=tensors,
+            ref=ref, torch=torch, cfg=cfg,
+        )
+        total_wall += float(rec.get("compile_first_launch_wall_s", 0.0) or 0.0)
+        aux_finite = _auxiliary_outputs_finite(operator, rec.get("state") or {}, torch)
+        corr = dict(rec.get("correctness") or {})
+        primary_ok = bool(corr.get("allclose")) and bool(corr.get("finite", True))
+        ok = primary_ok and aux_finite
+        corr["auxiliary_finite"] = aux_finite
+        corr["stability_attempt_pass"] = ok
+        attempt = {
+            "attempt": i + 1,
+            "correctness": corr,
+            "error": rec.get("error"),
+        }
+        attempts.append(attempt)
+        last = rec
+        if not ok:
+            break
+    passed = len(attempts) == n and all(bool(a["correctness"].get("stability_attempt_pass")) for a in attempts)
+    last = dict(last or {"config": dict(cfg), "state": dict(tensors), "error": None})
+    last["compile_first_launch_wall_s"] = total_wall
+    last["correctness"] = {
+        "finite": passed,
+        "allclose": passed,
+        "auxiliary_finite": passed,
+        "stability_replays_required": n,
+        "stability_replays_completed": len(attempts),
+        "stability_pass": passed,
+        "attempts": attempts,
+    }
+    if not passed and not last.get("error"):
+        last["error"] = "stability_replay_failed"
+    return last
+
+
+def _native_tune_stable(*, operator, case, module, tensors, ref, torch,
+                        selected_cfgs, candidate_value_batch_mode: bool = False,
+                        stability_replays: int = 3, capture_compiled_ir: bool = False):
+    """Run native autotune, then filter timing eligibility by repeated clean replay.
+
+    Native timing is still the performance source.  Replays only decide whether a
+    timed candidate is correctness-stable enough to participate in winner/search
+    selection; they do not introduce a new latency ranking signal.
+    """
+    raw = _native_tune(
+        operator=operator, case=case, module=module, tensors=tensors,
+        ref=ref, torch=torch, selected_cfgs=[dict(c) for c in selected_cfgs],
+        candidate_value_batch_mode=candidate_value_batch_mode,
+        capture_compiled_ir=capture_compiled_ir,
+    )
+    native = dict(raw.get("native") or {})
+    final_timings = list(native.get("final_timings") or [])
+    timing_by_sig = {}
+    for r in final_timings:
+        cfg = dict(r.get("config") or {})
+        try:
+            timing_by_sig[_cfg_sig(cfg)] = float(r.get("median_ms"))
+        except Exception:
+            pass
+    ordered = sorted(
+        [dict(c) for c in selected_cfgs if _cfg_sig(c) in timing_by_sig],
+        key=lambda c: (timing_by_sig[_cfg_sig(c)], _cfg_sig(c)),
+    )
+    stable_sigs = set()
+    stability_records = []
+    validation_wall = 0.0
+    for cfg in ordered:
+        t0 = time.perf_counter()
+        chk = _stable_compile_validate_one(
+            operator=operator, case=case, module=module, tensors=tensors,
+            ref=ref, torch=torch, cfg=cfg, replays=stability_replays,
+        )
+        validation_wall += time.perf_counter() - t0
+        ok = bool((chk.get("correctness") or {}).get("stability_pass"))
+        sig = _cfg_sig(cfg)
+        stability_records.append({
+            "config": dict(cfg), "config_signature": sig,
+            "median_ms": timing_by_sig.get(sig), "stable": ok,
+            "correctness": chk.get("correctness"), "error": chk.get("error"),
+        })
+        if ok:
+            stable_sigs.add(sig)
+    if not stable_sigs:
+        raise RuntimeError(f"native autotune produced no repeated-replay-stable candidate: {stability_records}")
+
+    # Keep all raw timing records for diagnostics, but expose only stable timings
+    # to subsequent V6.8 search logic.
+    native["final_timings_unfiltered"] = final_timings
+    native["final_timings"] = [
+        r for r in final_timings
+        if _cfg_sig(dict(r.get("config") or {})) in stable_sigs
+    ]
+    native["stability_guard_enabled"] = True
+    native["stability_replays_required"] = max(1, int(stability_replays))
+    native["stability_validation_wall_s"] = validation_wall
+    native["stability_records"] = stability_records
+    raw["native"] = native
+
+    stable_ordered = [c for c in ordered if _cfg_sig(c) in stable_sigs]
+    winner_cfg = stable_ordered[0]
+    raw["winner"] = {
+        "config": dict(winner_cfg),
+        "config_signature": _cfg_sig(winner_cfg),
+        "benchmark_latency_ms": timing_by_sig[_cfg_sig(winner_cfg)],
+    }
+    raw["correctness"] = {
+        "allclose": True, "finite": True, "stability_pass": True,
+        "stability_replays_required": max(1, int(stability_replays)),
+    }
+    native["native_autotune_plus_winner_validation_wall_s"] = (
+        float(native.get("native_autotune_plus_winner_validation_wall_s", 0.0) or 0.0)
+        + validation_wall
+    )
+    return raw
+
+def _opportunity(row: Mapping[str, Any]) -> float:
+    return max(0.0, float(((row.get("v6_relative") or {}).get("opportunity_score", 0.0)) or 0.0))
+
+
+def _confidence(row: Mapping[str, Any]) -> float:
+    return min(1.0, max(0.0, float(((row.get("v6_relative") or {}).get("multiview_confidence", 0.0)) or 0.0)))
+
+
+def _bootstrap_evidence(records: Sequence[Mapping[str, Any]], *, incumbent_ms: float) -> dict[str, float]:
+    """Summarize *current-run* bootstrap hardware evidence without label leakage.
+
+    V6.5 showed that optimistic residual estimates alone could make almost every
+    frontier look valuable enough to rescue.  V6.8 therefore calibrates later
+    continuation value by what the already-paid unified bootstrap actually saw.
+    This is online acquisition feedback only; it never re-enters Source ranking.
+    """
+    inc = max(1e-12, float(incumbent_ms))
+    gains: list[float] = []
+    for rec in records:
+        if not bool((rec.get("correctness") or {}).get("allclose")):
+            continue
+        obs = rec.get("controller_normalized_observation_ms")
+        if obs is None:
+            continue
+        try:
+            gain = (inc - float(obs)) / inc * 100.0
+        except Exception:
+            continue
+        gains.append(float(gain))
+    if not gains:
+        return {
+            "valid_count": 0,
+            "best_native_gain_pct": 0.0,
+            "median_native_gain_pct": 0.0,
+            "positive_fraction": 0.0,
+            "evidence_factor": 0.20,
+        }
+    best = max(gains)
+    median = statistics.median(gains)
+    positive_fraction = sum(g > 0.0 for g in gains) / len(gains)
+    # Conservative shrinkage: no bootstrap signal leaves only 20% of raw VPC;
+    # broad/strong positive evidence can restore the full residual estimate.
+    factor = 0.20 + 0.35 * positive_fraction + 0.45 * min(1.0, max(0.0, best) / 1.0)
+    return {
+        "valid_count": len(gains),
+        "best_native_gain_pct": float(best),
+        "median_native_gain_pct": float(median),
+        "positive_fraction": float(positive_fraction),
+        "evidence_factor": float(min(1.0, max(0.20, factor))),
+    }
+
+
+def _continuation_value_metrics(
+    row: Mapping[str, Any],
+    *,
+    controller,
+    incumbent_ms: float,
+    expected_candidate_cost_s: float,
+    bootstrap_evidence: Mapping[str, Any] | None = None,
+) -> dict[str, float]:
+    """Hardware-calibrated current-run value estimate for another JIT.
+
+    The raw prediction still comes only from the current-run residual model plus
+    label-free Source prior.  V6.8 additionally shrinks that prediction using
+    the unified-bootstrap observations already measured in this same run.  This
+    addresses V6.5's false-high VPC/rescue behavior without using historical
+    latency, MSProf, winner labels, or offline performance data.
+    """
+    estimate = dict(controller.estimate(row))
+    inc = max(1e-12, float(incumbent_ms))
+    predicted = max(1e-12, float(estimate.get("predicted_ms", inc)))
+    optimistic = max(1e-12, float(estimate.get("optimistic_ms", predicted)))
+    expected_gain = max(0.0, (inc - predicted) / inc * 100.0)
+    optimistic_gain = max(0.0, (inc - optimistic) / inc * 100.0)
+    confidence = _confidence(row)
+    opportunity = _opportunity(row)
+    raw_potential_gain = 0.65 * expected_gain + 0.35 * optimistic_gain
+    ev = dict(bootstrap_evidence or {})
+    evidence_factor = min(1.0, max(0.20, float(ev.get("evidence_factor", 0.20) or 0.20)))
+    calibrated_potential_gain = raw_potential_gain * evidence_factor
+    confidence_factor = 0.50 + 0.50 * confidence
+    cost = max(1e-6, float(expected_candidate_cost_s))
+    value_per_cost = calibrated_potential_gain * confidence_factor / cost
+    return {
+        "predicted_ms": predicted,
+        "optimistic_ms": optimistic,
+        "sigma_log": float(estimate.get("sigma_log", 0.0) or 0.0),
+        "nearest_distance": float(estimate.get("nearest_distance", 0.0) or 0.0),
+        "expected_gain_pct": expected_gain,
+        "optimistic_gain_pct": optimistic_gain,
+        "raw_potential_gain_pct": raw_potential_gain,
+        "potential_gain_pct": calibrated_potential_gain,
+        "source_opportunity": opportunity,
+        "source_confidence": confidence,
+        "bootstrap_evidence_factor": evidence_factor,
+        "bootstrap_best_native_gain_pct": float(ev.get("best_native_gain_pct", 0.0) or 0.0),
+        "bootstrap_positive_fraction": float(ev.get("positive_fraction", 0.0) or 0.0),
+        "expected_candidate_cost_s": cost,
+        "value_per_cost_pct_per_s": value_per_cost,
+    }
+
+def _continuation_value_gate(
+    metrics: Mapping[str, Any],
+    *,
+    rescue_mode: bool,
+    min_value_per_cost_pct_per_s: float,
+    min_expected_gain_pct: float,
+    min_optimistic_gain_pct: float,
+    min_bootstrap_evidence: float,
+    rescue_min_value_per_cost_pct_per_s: float,
+    rescue_min_optimistic_gain_pct: float,
+    rescue_min_confidence: float,
+    rescue_min_bootstrap_evidence: float,
+    rescue_min_bootstrap_native_gain_pct: float,
+) -> tuple[bool, str]:
+    """Gate continuation by performance value, cost, and paid bootstrap evidence."""
+    vpc = float(metrics.get("value_per_cost_pct_per_s", 0.0) or 0.0)
+    exp_gain = float(metrics.get("expected_gain_pct", 0.0) or 0.0)
+    opt_gain = float(metrics.get("optimistic_gain_pct", 0.0) or 0.0)
+    conf = float(metrics.get("source_confidence", 0.0) or 0.0)
+    ev = float(metrics.get("bootstrap_evidence_factor", 0.20) or 0.20)
+    best_boot = float(metrics.get("bootstrap_best_native_gain_pct", 0.0) or 0.0)
+    if rescue_mode:
+        ok = (
+            vpc >= float(rescue_min_value_per_cost_pct_per_s)
+            and opt_gain >= float(rescue_min_optimistic_gain_pct)
+            and conf >= float(rescue_min_confidence)
+            and ev >= float(rescue_min_bootstrap_evidence)
+            and best_boot >= float(rescue_min_bootstrap_native_gain_pct)
+        )
+        return ok, ("hardware_supported_high_value_rescue" if ok else "rescue_hardware_value_evidence_too_low")
+    upside = exp_gain >= float(min_expected_gain_pct) or opt_gain >= float(min_optimistic_gain_pct)
+    ok = upside and vpc >= float(min_value_per_cost_pct_per_s) and ev >= float(min_bootstrap_evidence)
+    return ok, ("hardware_calibrated_value_candidate" if ok else "hardware_calibrated_value_per_cost_too_low")
+
+def _read_official_reference(path: Path | None) -> dict[str, Any] | None:
+    if path is None or not Path(path).is_file():
+        return None
+    try:
+        j = json.loads(Path(path).read_text(encoding="utf-8"))
+        wall = float((j.get("timing") or {}).get("autotune_core_wall_s"))
+        native = dict(j.get("baseline_native_autotuner") or {})
+        meta = dict(native.get("native") or {})
+        official_count = max(1, int(j.get("official_count", 1) or 1))
+        phase = float(meta.get("compile_time_s", 0.0) or 0.0) + float(meta.get("measure_time_s", 0.0) or 0.0)
+        per_candidate = max(1e-3, phase / official_count, wall / official_count)
+        return {
+            "path": str(Path(path).resolve()),
+            "autotune_core_wall_s": wall,
+            "per_candidate_cost_seed_s": per_candidate,
+            "official_count": official_count,
+        }
+    except Exception:
+        return None
+
+
+def _bootstrap_budget_count(
+    *,
+    available: int,
+    max_count: int,
+    min_count: int,
+    official_reference: Mapping[str, Any] | None,
+    max_relative_overhead_pct: float,
+    marginal_cost_discount: float,
+    safety_factor: float,
+) -> tuple[int, dict[str, Any]]:
+    """Choose bootstrap size without allowing cost control to erase search.
+
+    The minimum bootstrap entitlement is intentional: V6.3 could reduce short
+    kernels to novel=0, which protects wall time but abandons the optimization
+    objective.  V6.8 retains at least min_count release-SAFE probes while using
+    the Official reference only as a *cost* estimate, never as ranking data.
+    """
+    available = max(0, int(available))
+    cap = min(available, max(0, int(max_count)))
+    floor_n = min(cap, max(0, int(min_count)))
+    if cap <= 0:
+        return 0, {"reason": "no_release_safe_candidate", "affordable": 0, "floor": 0}
+    if official_reference is None or max_relative_overhead_pct <= 0:
+        return max(floor_n, cap), {
+            "reason": "no_official_cost_reference_use_bootstrap_cap",
+            "affordable": cap,
+            "floor": floor_n,
+        }
+    wall = float(official_reference["autotune_core_wall_s"])
+    per = float(official_reference["per_candidate_cost_seed_s"])
+    soft_extra = wall * float(max_relative_overhead_pct) / 100.0
+    marginal = per * max(0.05, float(marginal_cost_discount)) * max(1.0, float(safety_factor))
+    affordable = int(math.floor(soft_extra / max(marginal, 1e-6) + 1e-12))
+    chosen = min(cap, max(floor_n, affordable))
+    return chosen, {
+        "reason": "official_cost_reference_with_search_entitlement",
+        "soft_extra_budget_s": soft_extra,
+        "estimated_unified_marginal_candidate_s": marginal,
+        "affordable": affordable,
+        "floor": floor_n,
+        "cap": cap,
+    }
+
+
+def _select_bootstrap_rows(
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    search_space,
+    count: int,
+    min_distance: float,
+) -> list[dict[str, Any]]:
+    """Value-first, diversity-aware bootstrap selection.
+
+    Proposal/source ordering remains label-free.  The first point maximizes the
+    existing V6 opportunity/confidence prior; later points prefer structural
+    diversity so a small unified compile buys information from more than one
+    local basin.  The distance rule is a preference, never a domain prune.
+    """
+    from backend.runtime.search_space_v6 import structural_distance
+
+    pool = [dict(r) for r in rows]
+    if not pool or count <= 0:
+        return []
+    pool.sort(key=lambda r: (
+        -_opportunity(r),
+        -_confidence(r),
+        int(r.get("proposal_rank", 10**9)),
+        int(r.get("source_prior_rank", 10**9)),
+        _cfg_sig(r["config"]),
+    ))
+    selected: list[dict[str, Any]] = []
+    while pool and len(selected) < int(count):
+        if not selected:
+            pick = pool.pop(0)
+        else:
+            diverse = [
+                r for r in pool
+                if min(structural_distance(search_space, r["config"], s["config"]) for s in selected)
+                >= max(0.0, float(min_distance))
+            ]
+            candidates = diverse or pool
+            pick = min(candidates, key=lambda r: (
+                -_opportunity(r),
+                -_confidence(r),
+                int(r.get("proposal_rank", 10**9)),
+                _cfg_sig(r["config"]),
+            ))
+            pool.remove(pick)
+        selected.append(pick)
+    return selected
+
+
+def _best_cfg_from_timing_map(cfgs: Sequence[Mapping[str, Any]], timing_map: Mapping[tuple, float]):
+    valid = [(float(timing_map[_cfg_sig(c)]), dict(c)) for c in cfgs if _cfg_sig(c) in timing_map]
+    if not valid:
+        return None, None
+    valid.sort(key=lambda x: (x[0], _cfg_sig(x[1])))
+    return valid[0][1], valid[0][0]
+
+
+def _current_core_wall(*, official_generation_wall, expansion_wall, static_wall, rank_wall, registry_wall,
+                       unified_native_wall, b0_seed_wall, bootstrap_validation_wall,
+                       continuation_native_wall, continuation_validation_wall, pair_race_wall, replay_wall=0.0):
+    return float(
+        official_generation_wall + expansion_wall + static_wall + rank_wall + registry_wall
+        + unified_native_wall + b0_seed_wall + bootstrap_validation_wall
+        + continuation_native_wall + continuation_validation_wall + pair_race_wall + replay_wall
+    )
+
