@@ -0,0 +1,1682 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Low-cost model instantiated from a real TTIR KernelTemplate.
+
+The structural template is extracted once per IR family by
+``ttir_kernel_template.KernelTemplateCache``.  Operator semantic adapters then
+instantiate grid/loop/work/buffer quantities for thousands of tiling Configs.
+A legacy metadata-only fallback is available only when explicitly enabled.
+"""
+from __future__ import annotations
+
+import math
+from collections import OrderedDict
+from dataclasses import asdict, dataclass, replace
+from threading import RLock
+from typing import Any, Dict, Iterable, List, Mapping, Sequence, Tuple
+
+from .ttir_kernel_template import KernelTemplate, structural_family_key
+from .universal_ttir_cost import extract_universal_features, universal_roofline_score
+from .universal_memory_model import analyze_memory_pattern
+from .ttir_calibration import calibrate_latency
+from .ttir_dag_model import build_ttir_dag
+from .pipeline_cost_model import estimate_pipeline_time
+from .a5_hardware_model import resolve_num_cores, resolve_ub_capacity, resolved_hardware_options
+from .model_context import config_signature
+from .light_ttir_vectorized import universal_batch as _vector_universal_batch, specialized_batch as _vector_specialized_batch, fuse_batch as _vector_fuse_batch
+
+
+@dataclass(frozen=True, slots=True)
+class LightTTIRReport:
+    score: float
+    grid_time: float
+    cube_time: float
+    vector_time: float
+    mte_time: float
+    loop_overhead: float
+    handoff_overhead: float
+    tail_penalty: float
+    imbalance_penalty: float
+    capacity_risk: float
+    active_program_ratio: float
+    load_imbalance: float
+    max_tiles_per_program: int
+    loop_count: int
+    memory_redundancy: float
+    ub_peak_bytes: float
+    ub_utilization: float
+    ub_headroom_bytes: float
+    tail_waste: float
+    bottleneck: str
+    confidence: float
+    structural_signature: Tuple[int, ...]
+    level1_region: Tuple[int, ...]
+    template_family: Tuple[Any, ...] = ()
+    template_sha256: str = ""
+    template_extractor: str = "legacy_metadata"
+    template_confidence: float = 0.0
+    template_unknown_ops: Tuple[str, ...] = ()
+    base_score: float = 0.0
+    specialized_score: float = 0.0
+    residual_score: float = 0.0
+    residual_weight: float = 0.0
+    score_mode: str = "legacy"
+    motif: str = ""
+    base_bottleneck: str = ""
+    fused_bottleneck: str = ""
+    selection_region: Tuple[int, ...] = ()
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+
+
+# Static TTIR analysis cache. Parsing/DAG/pointer analysis is performed once
+# per canonical template and reused for all tiling configs (P4 hot-path rule).
+_STATIC_ANALYSIS_CACHE: "OrderedDict[Any, Tuple[Any, Any, Any]]" = OrderedDict()
+_STATIC_ANALYSIS_CACHE_LOCK = RLock()
+_STATIC_ANALYSIS_CACHE_MAX = 128
+
+def _static_analysis(template: KernelTemplate, options: Mapping[str, Any]):
+    template_key = getattr(template, "ttir_sha256", "") or repr(getattr(template, "family_key", ()))
+    ub_capacity = resolve_ub_capacity(options)
+    key = (
+        template_key,
+        max(1, int(options.get("dtype_bytes", 2))),
+        ub_capacity,
+    )
+    with _STATIC_ANALYSIS_CACHE_LOCK:
+        cached = _STATIC_ANALYSIS_CACHE.get(key)
+        if cached is not None:
+            _STATIC_ANALYSIS_CACHE.move_to_end(key)
+            return cached
+    dag = build_ttir_dag(template)
+    memory = analyze_memory_pattern(template)
+    features = extract_universal_features(
+        template,
+        dtype_bytes=max(1, int(options.get("dtype_bytes", 2))),
+        ub_capacity=ub_capacity,
+    )
+    value = (dag, memory, features)
+    with _STATIC_ANALYSIS_CACHE_LOCK:
+        # Another thread may have populated the same key while analysis ran.
+        existing = _STATIC_ANALYSIS_CACHE.get(key)
+        if existing is not None:
+            _STATIC_ANALYSIS_CACHE.move_to_end(key)
+            return existing
+        _STATIC_ANALYSIS_CACHE[key] = value
+        max_entries = max(1, int(options.get("light_static_cache_max_entries", _STATIC_ANALYSIS_CACHE_MAX)))
+        while len(_STATIC_ANALYSIS_CACHE) > max_entries:
+            _STATIC_ANALYSIS_CACHE.popitem(last=False)
+    return value
+
+def clear_light_ttir_analysis_cache() -> None:
+    with _STATIC_ANALYSIS_CACHE_LOCK:
+        _STATIC_ANALYSIS_CACHE.clear()
+
+def light_ttir_analysis_cache_size() -> int:
+    with _STATIC_ANALYSIS_CACHE_LOCK:
+        return len(_STATIC_ANALYSIS_CACHE)
+
+@dataclass(frozen=True, slots=True)
+class LightTTIRBatchScores:
+    """Numeric-only Light TTIR result used before survivor materialization."""
+    score: Any
+    estimated_time: Any
+    ub_utilization: Any
+    load_imbalance: Any
+    tail_waste: Any
+    confidence: Any
+    bottleneck_id: Any
+    region_id: Any
+    structural_signature: Any
+    level1_region: Any
+
+
+
+
+@dataclass(frozen=True, slots=True)
+class LightTTIRS1Selection:
+    """Universal-only S1 result reusable by the S2 residual stage."""
+    indices: Tuple[int, ...]
+    universal: LightTTIRBatchScores
+    universal_details: Mapping[str, Any]
+    target_fraction: float
+    policy: str
+
+
+@dataclass(frozen=True, slots=True)
+class LightTTIRPreselection:
+    """Result of the homogeneous S1/S2 low-cost preselection pipeline."""
+    s1_indices: Tuple[int, ...]
+    selected_indices: Tuple[int, ...]
+    universal: LightTTIRBatchScores
+    hybrid_scores: Any
+    s1_target_fraction: float
+    s2_target_fraction: float
+    hybrid_evaluated: int
+    policy: str
+
+
+def generic_region(report: LightTTIRReport):
+    """Generic execution-state region for B2 coverage."""
+    return (
+        int(_bucket(report.active_program_ratio, (0.25,0.5,0.75,1.0))),
+        int(_bucket(report.cube_time, (1,10,100))),
+        int(_bucket(report.mte_time, (1,10,100))),
+        int(_bucket(report.loop_count, (1,4,8,16))),
+        int(_bucket(report.ub_utilization, (0.25,0.5,0.75,1.0))),
+        int(_bucket(report.tail_waste, (0.05,0.15,0.3))),
+    )
+
+
+def _cfg_int(cfg, *names: str, default: int = 1) -> int:
+    kwargs = getattr(cfg, "kwargs", {})
+    for name in names:
+        value = kwargs.get(name)
+        if isinstance(value, int) and value > 0:
+            return value
+    return max(1, int(default))
+
+
+def _bucket(value: float, cuts) -> int:
+    for idx, cut in enumerate(cuts):
+        if value < cut:
+            return idx
+    return len(tuple(cuts))
+
+
+def _fa_report(cfg, all_args: Mapping[str, Any], options: Mapping[str, Any], template: KernelTemplate | None) -> LightTTIRReport:
+    bm = _cfg_int(cfg, "BLOCK_M", "BM")
+    bn = _cfg_int(cfg, "BLOCK_N", "BN")
+    hd = max(1, int(all_args.get("HEAD_DIM", all_args.get("QK_DIM", 64))))
+    nq = max(1, int(all_args.get("MAX_Q_LEN", all_args.get("NQ", all_args.get("N_CTX", all_args.get("N", 1))))))
+    nk = max(1, int(all_args.get("MAX_K_LEN", all_args.get("NK", all_args.get("N_CTX", nq)))))
+    z = max(1, int(all_args.get("Z", all_args.get("BATCH", 1))))
+    h = max(1, int(all_args.get("H", all_args.get("HEADS", 1))))
+    causal = bool(all_args.get("CAUSAL", all_args.get("causal", False)))
+    cores = _effective_cores_for_config(cfg, options)
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+
+    if template is not None:
+        if not template.has_load or not template.has_store:
+            raise ValueError("TTIR template does not contain the required load/store structure")
+        # Flash Attention is expected to use dot/cube work.  Keep an explicit
+        # override for vector-only debugging kernels rather than silently
+        # assigning cube work to TTIR that has no dot operation.
+        if not template.has_dot and not bool(options.get("light_allow_no_dot_fa", False)):
+            raise ValueError("Flash-Attention TTIR template contains no tt.dot")
+
+    q_tiles = math.ceil(nq / bm) * z * h
+    active_programs = min(q_tiles, cores)
+    active_ratio = active_programs / cores
+    max_tiles_per_program = max(1, math.ceil(q_tiles / cores))
+    assigned_slots = max(1, math.ceil(q_tiles / cores) * cores)
+    load_imbalance = max(0.0, (assigned_slots - q_tiles) / assigned_slots)
+
+    full_loops = math.ceil(nk / bn)
+    if causal:
+        # Approximate the busiest query tile; kernel time is controlled by the
+        # heaviest persistent program, not the average query tile.
+        loop_count = full_loops
+        useful_pairs = nq * (nk + 1) / 2 if nq == nk else nq * nk * 0.5
+    else:
+        loop_count = full_loops
+        useful_pairs = nq * nk
+
+    issued_pairs = math.ceil(nq / bm) * bm * math.ceil(nk / bn) * bn
+    tail_waste = max(0.0, 1.0 - useful_pairs / max(1.0, issued_pairs))
+    memory_redundancy = issued_pairs / max(1.0, useful_pairs)
+
+    # Work on the busiest program.  Calibration values are relative and only
+    # used for ranking; they are not claimed as measured latency.
+    iterations = loop_count * max_tiles_per_program
+    # Explicit FlashAttention phases: QK, online softmax, PV.  Keeping these
+    # separate lets BLOCK_N, num_stages, causal masking and phase handoffs
+    # affect the residual without changing the universal base scale.
+    qk_ops = 2.0 * bm * bn * hd * iterations
+    pv_ops = 2.0 * bm * bn * hd * iterations
+    exp_ops = bm * bn * iterations
+    reduce_ops = 2.0 * bm * bn * iterations
+    mask_ops = (bm * bn * iterations) if causal else 0.0
+    elementwise_ops = 4.0 * bm * bn * iterations
+
+    cube_rate = max(1.0, float(options.get("light_cube_ops_per_us", 3.2e8)))
+    exp_rate = max(1.0, float(options.get("light_vector_exp_ops_per_us", 1.2e7)))
+    reduce_rate = max(1.0, float(options.get("light_vector_reduce_ops_per_us", 2.0e7)))
+    elem_rate = max(1.0, float(options.get("light_vector_elementwise_ops_per_us", 8.0e7)))
+    mask_rate = max(1.0, float(options.get("light_vector_mask_ops_per_us", 6.0e7)))
+    mte_bw = max(1.0, float(options.get("light_mte_bytes_per_us", 2.0e5)))
+
+    warps = max(1, int(getattr(cfg, "num_warps", 4)))
+    stages = max(1, int(getattr(cfg, "num_stages", 1)))
+    # Alignment/parallel efficiency is deliberately bounded: it is a residual
+    # correction, not an uncalibrated replacement for the hardware model.
+    tile_alignment = min(1.0, bm / 64.0) * min(1.0, bn / 64.0)
+    warp_eff = min(1.12, 0.88 + 0.06 * min(warps, 4))
+    cube_eff = max(0.60, min(1.12, 0.78 + 0.22 * tile_alignment)) * warp_eff
+    qk_time = qk_ops / (cube_rate * cube_eff)
+    pv_time = pv_ops / (cube_rate * cube_eff)
+    softmax_time = (
+        exp_ops / exp_rate
+        + reduce_ops / reduce_rate
+        + elementwise_ops / elem_rate
+        + mask_ops / mask_rate
+    )
+    cube_time = qk_time + pv_time
+    vector_time = softmax_time
+
+    q_load = dtype_bytes * bm * hd * max_tiles_per_program
+    kv_load = dtype_bytes * iterations * (2 * bn * hd)
+    out_store = dtype_bytes * bm * hd * max_tiles_per_program
+    issued_bytes = q_load + kv_load + out_store
+    raw_mte_time = issued_bytes / mte_bw
+    stage_overlap = min(0.48, 0.16 * max(0, stages - 1))
+    stage_pressure = 1.0 + max(0, stages - 3) * 0.08
+    mte_time = raw_mte_time * stage_pressure
+
+    # QK -> Vector -> PV is serial, while MTE can overlap with compute.
+    compute_serial = qk_time + softmax_time + pv_time
+    overlap_credit = stage_overlap * min(raw_mte_time, qk_time + pv_time)
+    phased_pipeline_time = max(compute_serial, raw_mte_time) - overlap_credit
+
+    loop_overhead = iterations * float(options.get("light_loop_cost_us", 0.008))
+    phase_switches = 3.0  # QK->softmax, softmax->PV, PV->next tile/store
+    handoff_overhead = iterations * phase_switches * float(options.get("light_handoff_cost_us", 0.004))
+
+    # Phase-based UB peak approximation: QK, softmax and PV phases.
+    q_bytes = bm * hd * dtype_bytes
+    kv_bytes = 2 * bn * hd * dtype_bytes
+    score_bytes = bm * bn * 4
+    row_state_bytes = bm * 8
+    out_acc_bytes = bm * hd * 4
+    prefetch_bytes = float(options.get("light_prefetch_factor", 0.0)) * kv_bytes
+    workspace_bytes = max(0, int(getattr(cfg, "num_stages", 1)) - 1) * score_bytes
+    ub_qk = q_bytes + kv_bytes + score_bytes + row_state_bytes + prefetch_bytes
+    ub_softmax = score_bytes * 2 + row_state_bytes + out_acc_bytes
+    ub_pv = q_bytes + kv_bytes + score_bytes + out_acc_bytes + workspace_bytes
+    ub_peak = float(max(ub_qk, ub_softmax, ub_pv))
+    ub_capacity = float(resolve_ub_capacity(options))
+    ub_utilization = ub_peak / ub_capacity
+    ub_headroom = ub_capacity - ub_peak
+
+    # Component work above already includes ``max_tiles_per_program`` through
+    # ``iterations``; multiplying again would square persistent-program work.
+    grid_time = max(phased_pipeline_time, mte_time)
+    tail_penalty = tail_waste * float(options.get("light_tail_penalty_us", 0.5))
+    imbalance_penalty = load_imbalance * float(options.get("light_imbalance_penalty_us", 0.5))
+    # Soft risk only; hard capacity pruning remains the responsibility of
+    # compiler/formal allocation reports.
+    capacity_risk = float(options.get("light_capacity_risk_weight", 2.0)) * max(0.0, ub_utilization - 0.85) ** 2
+    score = grid_time + loop_overhead + handoff_overhead + tail_penalty + imbalance_penalty + capacity_risk
+
+    component = {"cube": cube_time, "vector": vector_time, "mte": mte_time}
+    bottleneck = max(component, key=component.get)
+    if active_ratio < float(options.get("light_under_parallel_threshold", 0.75)):
+        bottleneck = "grid"
+    elif ub_utilization >= float(options.get("light_near_capacity_threshold", 0.85)):
+        bottleneck = "buffer"
+
+    confidence = template.confidence if template is not None else 0.45
+    if ub_utilization >= 0.85:
+        confidence -= 0.10
+    if bool(options.get("light_template_out_of_domain", False)):
+        confidence -= 0.35
+    if bool(options.get("light_unknown_opcode", False)):
+        confidence -= 0.25
+    confidence = min(1.0, max(0.05, confidence))
+
+    grid_state = 0 if active_ratio < 0.75 else (2 if load_imbalance > 0.10 else 1)
+    loop_state = _bucket(loop_count, (2, 5, 9, 17))
+    bottleneck_id = {"grid": 0, "cube": 1, "vector": 2, "mte": 3, "buffer": 4}[bottleneck]
+    pressure_state = _bucket(ub_utilization, (0.65, 0.85, 1.0))
+    tail_state = _bucket(tail_waste, (0.10, 0.30))
+    structural_signature = (grid_state, loop_state, bottleneck_id, pressure_state, tail_state)
+    level1_region = (grid_state, loop_state, bottleneck_id)
+
+    return LightTTIRReport(
+        score=score, grid_time=grid_time, cube_time=cube_time, vector_time=vector_time,
+        mte_time=mte_time, loop_overhead=loop_overhead, handoff_overhead=handoff_overhead,
+        tail_penalty=tail_penalty, imbalance_penalty=imbalance_penalty, capacity_risk=capacity_risk,
+        active_program_ratio=active_ratio, load_imbalance=load_imbalance,
+        max_tiles_per_program=max_tiles_per_program, loop_count=loop_count,
+        memory_redundancy=memory_redundancy, ub_peak_bytes=ub_peak,
+        ub_utilization=ub_utilization, ub_headroom_bytes=ub_headroom,
+        tail_waste=tail_waste, bottleneck=bottleneck, confidence=confidence,
+        structural_signature=structural_signature, level1_region=level1_region,
+        template_family=template.family_key if template is not None else (),
+        template_sha256=template.ttir_sha256 if template is not None else "",
+        template_extractor=template.extractor if template is not None else "legacy_metadata",
+        template_confidence=template.confidence if template is not None else 0.0,
+        template_unknown_ops=template.unknown_tt_ops if template is not None else (),
+    )
+
+
+def _hw_rates(options: Mapping[str, Any]) -> Dict[str, float]:
+    """Hardware calibration rates shared across family adapters."""
+    return {
+        "cube_rate": max(1.0, float(options.get("light_cube_ops_per_us", 3.2e8))),
+        "exp_rate": max(1.0, float(options.get("light_vector_exp_ops_per_us", 1.2e7))),
+        "reduce_rate": max(1.0, float(options.get("light_vector_reduce_ops_per_us", 2.0e7))),
+        "elem_rate": max(1.0, float(options.get("light_vector_elementwise_ops_per_us", 8.0e7))),
+        "mask_rate": max(1.0, float(options.get("light_vector_mask_ops_per_us", 6.0e7))),
+        "mte_bw": max(1.0, float(options.get("light_mte_bytes_per_us", 2.0e5))),
+    }
+
+
+def _effective_cores_for_config(cfg, options: Mapping[str, Any]) -> int:
+    """Resolve per-config active AI-core count, capped by the hardware profile."""
+    physical = max(1, int(options.get("num_cores", 20)))
+    parameter = str(options.get("light_effective_core_parameter", "AICORE_NUM"))
+    kwargs = getattr(cfg, "kwargs", {}) or {}
+    requested = kwargs.get(parameter, physical)
+    if not isinstance(requested, int) or requested <= 0:
+        requested = physical
+    return max(1, min(physical, int(requested)))
+
+
+def _grid_state_and_imbalance(programs: int, cores: int) -> Tuple[float, float, int]:
+    """Return (active_ratio, load_imbalance, max_tiles_per_program)."""
+    active = min(programs, cores)
+    ratio = active / cores
+    mtp = max(1, math.ceil(programs / cores))
+    assigned = max(1, mtp * cores)
+    imb = max(0.0, (assigned - programs) / assigned)
+    return ratio, imb, mtp
+
+
+def _bottleneck_and_confidence(cube_time: float, vector_time: float, mte_time: float,
+                                active_ratio: float, ub_util: float,
+                                options: Mapping[str, Any], template: KernelTemplate | None,
+                                extra_penalty: float = 0.0) -> Tuple[str, float]:
+    component = {"cube": cube_time, "vector": vector_time, "mte": mte_time}
+    bottleneck = max(component, key=component.get)
+    if active_ratio < float(options.get("light_under_parallel_threshold", 0.75)):
+        bottleneck = "grid"
+    elif ub_util >= float(options.get("light_near_capacity_threshold", 0.85)):
+        bottleneck = "buffer"
+    confidence = template.confidence if template is not None else 0.45
+    if ub_util >= 0.85:
+        confidence -= 0.10
+    if bool(options.get("light_template_out_of_domain", False)):
+        confidence -= 0.35
+    if bool(options.get("light_unknown_opcode", False)):
+        confidence -= 0.25
+    confidence = min(1.0, max(0.05, confidence))
+    return bottleneck, confidence
+
+
+def _structural_sig(active_ratio: float, load_imbalance: float, loop_count: int,
+                    ub_util: float, tail_waste: float, bottleneck: str) -> Tuple[Tuple[int, ...], Tuple[int, ...]]:
+    grid_state = 0 if active_ratio < 0.75 else (2 if load_imbalance > 0.10 else 1)
+    loop_state = _bucket(loop_count, (2, 5, 9, 17))
+    bottleneck_id = {"grid": 0, "cube": 1, "vector": 2, "mte": 3, "buffer": 4}[bottleneck]
+    pressure_state = _bucket(ub_util, (0.65, 0.85, 1.0))
+    tail_state = _bucket(tail_waste, (0.10, 0.30))
+    return (grid_state, loop_state, bottleneck_id, pressure_state, tail_state), (grid_state, loop_state, bottleneck_id)
+
+
+_MXFP_BLOCK_SIZE = 32  # OCP MX standard: one scale per 32 elements
+_MXFP_PROFILE = {
+    # quant_dtype: (element_bits, scale_bytes_per_block)
+    "mxfp4": (4, 1),   # E2M1 packed 2-per-byte; E8M0 scale = 1 byte per 32 elems
+    "mxfp8": (8, 1),   # E4M3/E5M2; E8M0 scale = 1 byte per 32 elems
+}
+
+
+def _gemm_report(cfg, all_args, options, template):
+    """Light TTIR adapter for GEMM/MatMul/Linear (cube-dominant, no softmax).
+
+    Supports quantized variants MXFP4/MXFP8 via ``options['quant_dtype']``.
+    Quantization adds: (1) sub-byte packing reducing MTE bytes, (2) per-block
+    scale tensor traffic, (3) dequant vector work before Cube, (4) scale
+    buffer UB occupancy.
+    """
+    bm = _cfg_int(cfg, "BLOCK_M", "BLOCK_SIZE_M", "BM")
+    bn = _cfg_int(cfg, "BLOCK_N", "BLOCK_SIZE_N", "BN")
+    bk = _cfg_int(cfg, "BLOCK_K", "BLOCK_SIZE_K", "BK")
+    m = max(1, int(all_args.get("M", 1)))
+    n = max(1, int(all_args.get("N", 1)))
+    k = max(1, int(all_args.get("K", 1)))
+    cores = _effective_cores_for_config(cfg, options)
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+
+    quant_dtype = str(options.get("quant_dtype", "")).lower()
+    quant_profile = _MXFP_PROFILE.get(quant_dtype) if quant_dtype else None
+    if quant_profile is not None:
+        elem_bits, scale_bytes_per_block = quant_profile
+        elem_bytes_packed = max(1, elem_bits // 8)  # 4-bit -> 0.5 byte; use ceil at aggregate level
+        a_bytes_per_elem = elem_bytes_packed if elem_bits >= 8 else 0  # 4-bit handled fractionally below
+        b_bytes_per_elem = elem_bytes_packed if elem_bits >= 8 else 0
+    else:
+        a_bytes_per_elem = dtype_bytes
+        b_bytes_per_elem = dtype_bytes
+        scale_bytes_per_block = 0
+
+    if template is not None and not template.has_dot:
+        raise ValueError("GEMM TTIR template contains no tt.dot")
+
+    programs = math.ceil(m / bm) * math.ceil(n / bn)
+    active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+    loop_count = math.ceil(k / bk)
+    iterations = loop_count * mtp
+
+    # Work: 2*bm*bn*bk FMA per iteration
+    cube_ops = 2.0 * bm * bn * bk * iterations
+    r = _hw_rates(options)
+    cube_time = cube_ops / r["cube_rate"]
+
+    # Vector work: quantized kernels require dequant before Cube (per-tile).
+    # Cost ~ bm*bk + bn*bk elementwise ops per iteration (cast + scale mul).
+    if quant_profile is not None:
+        dequant_ops = (bm * bk + bn * bk) * iterations
+        vector_time_total = dequant_ops / r["elem_rate"]
+    else:
+        vector_time_total = 0.0  # GEMM is cube-dominant, vector ~0
+
+    # Memory: A tile + B tile per iteration, C tile once.
+    # For sub-byte (4-bit) packing, bytes = elems * bits / 8 (fractional, exact at tile level
+    # because bk is a multiple of _MXFP_BLOCK_SIZE=32 in well-formed MXFP kernels).
+    if quant_profile is not None and elem_bits < 8:
+        a_tile_bytes = bm * bk * elem_bits / 8
+        b_tile_bytes = bn * bk * elem_bits / 8
+    else:
+        a_tile_bytes = bm * bk * a_bytes_per_elem
+        b_tile_bytes = bn * bk * b_bytes_per_elem
+    c_tile_bytes = bm * bn * 4  # accumulator/output FP32
+
+    # Scale tensor: one scale per _MXFP_BLOCK_SIZE elements, for A and B tiles per iteration.
+    scale_blocks_a = math.ceil(bm * bk / _MXFP_BLOCK_SIZE)
+    scale_blocks_b = math.ceil(bn * bk / _MXFP_BLOCK_SIZE)
+    scale_bytes_iter = (scale_blocks_a + scale_blocks_b) * scale_bytes_per_block
+
+    issued_bytes = iterations * (a_tile_bytes + b_tile_bytes) + c_tile_bytes + iterations * scale_bytes_iter
+    mte_time = issued_bytes / r["mte_bw"]
+
+    # UB: A + B + accumulator + scale buffers (double-buffered)
+    ub_peak = float(a_tile_bytes + b_tile_bytes + c_tile_bytes
+                    + scale_bytes_iter  # resident scale buffers
+                    + c_tile_bytes)  # workspace for dequant staging
+    ub_capacity = float(resolve_ub_capacity(options))
+    ub_util = ub_peak / ub_capacity
+
+    # Tail & redundancy
+    issued = math.ceil(m / bm) * bm * math.ceil(n / bn) * bn
+    useful = m * n
+    tail_waste = max(0.0, 1.0 - useful / max(1.0, issued))
+    memory_redundancy = issued / max(1.0, useful)
+
+    grid_time = max(cube_time, vector_time_total, mte_time)
+    loop_overhead = iterations * float(options.get("light_loop_cost_us", 0.008))
+    handoff_overhead = iterations * 2.0 * float(options.get("light_handoff_cost_us", 0.004))
+    tail_penalty = tail_waste * float(options.get("light_tail_penalty_us", 0.5))
+    imbalance_penalty = load_imbalance * float(options.get("light_imbalance_penalty_us", 0.5))
+    capacity_risk = float(options.get("light_capacity_risk_weight", 2.0)) * max(0.0, ub_util - 0.85) ** 2
+    score = grid_time + loop_overhead + handoff_overhead + tail_penalty + imbalance_penalty + capacity_risk
+
+    bottleneck, confidence = _bottleneck_and_confidence(
+        cube_time, vector_time_total, mte_time, active_ratio, ub_util, options, template)
+    sig, region = _structural_sig(active_ratio, load_imbalance, loop_count, ub_util, tail_waste, bottleneck)
+
+    return LightTTIRReport(
+        score=score, grid_time=grid_time, cube_time=cube_time, vector_time=vector_time_total,
+        mte_time=mte_time, loop_overhead=loop_overhead, handoff_overhead=handoff_overhead,
+        tail_penalty=tail_penalty, imbalance_penalty=imbalance_penalty, capacity_risk=capacity_risk,
+        active_program_ratio=active_ratio, load_imbalance=load_imbalance,
+        max_tiles_per_program=mtp, loop_count=loop_count,
+        memory_redundancy=memory_redundancy, ub_peak_bytes=ub_peak,
+        ub_utilization=ub_util, ub_headroom_bytes=max(0.0, ub_capacity - ub_peak),
+        tail_waste=tail_waste, bottleneck=bottleneck, confidence=confidence,
+        structural_signature=sig, level1_region=region,
+        template_family=template.family_key if template is not None else (),
+        template_sha256=template.ttir_sha256 if template is not None else "",
+        template_extractor=template.extractor if template is not None else "gemm",
+        template_confidence=template.confidence if template is not None else 0.0,
+        template_unknown_ops=template.unknown_tt_ops if template is not None else (),
+    )
+
+
+def _reduction_report(cfg, all_args, options, template, family):
+    """Light TTIR adapter for Softmax/LayerNorm/RMSNorm (vector reduction)."""
+    xblock = _cfg_int(cfg, "XBLOCK", "XBLOCK_SIZE", "BLOCK_M", default=1)
+    rblock = _cfg_int(cfg, "RBLOCK_SIZE", "BLOCK_SIZE", "BLOCK_N", default=64)
+    rows = max(1, int(all_args.get("M", all_args.get("n_rows", 1))))
+    cols = max(1, int(all_args.get("N", all_args.get("n_cols", 1))))
+    cores = _effective_cores_for_config(cfg, options)
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+
+    if template is not None and template.has_dot:
+        raise ValueError("Reduction-family TTIR template unexpectedly contains tt.dot")
+
+    programs = math.ceil(rows / xblock)
+    active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+    loop_count = math.ceil(cols / rblock)
+    iterations = loop_count * mtp
+
+    # Work: reduction passes (2 for softmax, 3 for layernorm/rmsnorm)
+    passes = 3 if family in {"layer_norm", "rmsnorm", "vector_multi_reduction"} else 2
+    reduce_ops = passes * rows * cols
+    elementwise_ops = (3 if passes == 3 else 2) * rows * cols
+    r = _hw_rates(options)
+    vector_time = reduce_ops / r["reduce_rate"] + elementwise_ops / r["elem_rate"]
+    cube_time = 0.0
+
+    # Memory: load input + store output (reduction in-place)
+    issued_bytes = dtype_bytes * (rows * cols * 2)
+    mte_time = issued_bytes / r["mte_bw"]
+
+    # UB: xblock * rblock * passes buffers
+    ub_peak = float(xblock * rblock * dtype_bytes * passes)
+    ub_capacity = float(resolve_ub_capacity(options))
+    ub_util = ub_peak / ub_capacity
+
+    padded_cols = math.ceil(cols / rblock) * rblock
+    tail_waste = max(0.0, 1.0 - cols / max(1.0, padded_cols))
+    memory_redundancy = padded_cols / max(1.0, cols)
+
+    grid_time = max(cube_time, vector_time, mte_time)
+    loop_overhead = iterations * float(options.get("light_loop_cost_us", 0.008))
+    handoff_overhead = iterations * 2.0 * float(options.get("light_handoff_cost_us", 0.004))
+    tail_penalty = tail_waste * float(options.get("light_tail_penalty_us", 0.5))
+    imbalance_penalty = load_imbalance * float(options.get("light_imbalance_penalty_us", 0.5))
+    capacity_risk = float(options.get("light_capacity_risk_weight", 2.0)) * max(0.0, ub_util - 0.75) ** 2
+    score = grid_time + loop_overhead + handoff_overhead + tail_penalty + imbalance_penalty + capacity_risk
+
+    bottleneck, confidence = _bottleneck_and_confidence(
+        cube_time, vector_time, mte_time, active_ratio, ub_util, options, template)
+    sig, region = _structural_sig(active_ratio, load_imbalance, loop_count, ub_util, tail_waste, bottleneck)
+
+    return LightTTIRReport(
+        score=score, grid_time=grid_time, cube_time=cube_time, vector_time=vector_time,
+        mte_time=mte_time, loop_overhead=loop_overhead, handoff_overhead=handoff_overhead,
+        tail_penalty=tail_penalty, imbalance_penalty=imbalance_penalty, capacity_risk=capacity_risk,
+        active_program_ratio=active_ratio, load_imbalance=load_imbalance,
+        max_tiles_per_program=mtp, loop_count=loop_count,
+        memory_redundancy=memory_redundancy, ub_peak_bytes=ub_peak,
+        ub_utilization=ub_util, ub_headroom_bytes=max(0.0, ub_capacity - ub_peak),
+        tail_waste=tail_waste, bottleneck=bottleneck, confidence=confidence,
+        structural_signature=sig, level1_region=region,
+        template_family=template.family_key if template is not None else (),
+        template_sha256=template.ttir_sha256 if template is not None else "",
+        template_extractor=template.extractor if template is not None else "reduction",
+        template_confidence=template.confidence if template is not None else 0.0,
+        template_unknown_ops=template.unknown_tt_ops if template is not None else (),
+    )
+
