+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Generic online controller for V6 near-optimal candidate search.
+
+This module is deliberately hardware-API agnostic.  It receives a source-only
+prior queue plus *current autotune run* measurements and decides which safe,
+unmeasured candidate to evaluate next.
+
+Using measurements already queried by the current search is not offline data
+leakage; it is sequential black-box optimization.  The controller never claims
+an epsilon certificate unless the caller supplies an admissible lower bound.
+Without such a bound, the reported gap is explicitly empirical.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+import statistics
+from typing import Any, Mapping, Sequence
+
+from .search_space_v6 import SearchSpaceSpec, config_signature, record_features, structural_coordinates
+
+
+def _median(xs, default=0.0):
+    vals = [float(x) for x in xs if math.isfinite(float(x))]
+    return statistics.median(vals) if vals else float(default)
+
+
+def _mad(xs, center=None, default=0.0):
+    vals = [float(x) for x in xs if math.isfinite(float(x))]
+    if not vals:
+        return float(default)
+    c = _median(vals) if center is None else float(center)
+    return _median([abs(x - c) for x in vals], default=default)
+
+
+def _euclidean(a: Sequence[float], b: Sequence[float]) -> float:
+    if not a or not b:
+        return 0.0
+    n = min(len(a), len(b))
+    return math.sqrt(sum((float(a[i]) - float(b[i])) ** 2 for i in range(n)) / n)
+
+
+def finalize_declared_domain_status(
+    status: Mapping[str, Any],
+    *,
+    complete_declared_domain: bool,
+    full_pool_count: int,
+    official_count: int,
+    static_rejected_count: int,
+    statically_legal_novel_count: int,
+    safety: Mapping[str, Any] | None,
+    safe_novel_evaluated_count: int,
+) -> dict[str, Any]:
+    """Lift SAFE-subset controller status to the full declared-domain semantics.
+
+    Final V6 built the controller from B0 + release-SAFE novel only.  With zero
+    SAFE coverage, that tiny controller had no remaining rows and therefore
+    incorrectly reported exact_domain_exhausted/cert_gap=0 even though hundreds
+    of UNKNOWN candidates had never been evaluated.  V6.1 makes those unresolved
+    safety states explicit and blocks exact/certified claims.
+    """
+    out = dict(status or {})
+    counts = dict((safety or {}).get("counts") or {})
+    safe = int(counts.get("safe", 0) or 0)
+    unsafe = int(counts.get("unsafe", 0) or 0)
+    unknown = int(counts.get("unknown", 0) or 0)
+    foreign = int(counts.get("foreign_campaign", 0) or 0)
+    unresolved_safety = unknown + foreign
+    safe_subset_cov = out.get("coverage_ratio")
+
+    # Static-rejected and registry-UNSAFE candidates are resolved infeasible for
+    # this production search. SAFE candidates only become performance-resolved
+    # after hardware evaluation. UNKNOWN/foreign certificates remain unresolved.
+    performance_resolved = (
+        int(official_count)
+        + int(static_rejected_count)
+        + unsafe
+        + min(int(safe_novel_evaluated_count), safe)
+    )
+    full_cov = min(1.0, max(0.0, performance_resolved / max(1, int(full_pool_count))))
+    safe_cov = safe / max(1, int(statically_legal_novel_count))
+
+    out.update({
+        "declared_domain_candidate_count": int(full_pool_count),
+        "official_b0_count": int(official_count),
+        "static_rejected_novel_count": int(static_rejected_count),
+        "statically_legal_novel_count": int(statically_legal_novel_count),
+        "release_safe_novel_count": safe,
+        "release_unsafe_novel_count": unsafe,
+        "release_unknown_novel_count": unknown,
+        "release_foreign_campaign_novel_count": foreign,
+        "release_unresolved_safety_novel_count": unresolved_safety,
+        "release_safe_novel_coverage_ratio": safe_cov,
+        "safe_subset_search_coverage_ratio": safe_subset_cov,
+        "declared_domain_performance_resolution_coverage_ratio": full_cov,
+        "declared_domain_complete": bool(complete_declared_domain),
+    })
+
+    # Preserve the controller's empirical estimate as a SAFE-subset diagnostic,
+    # but do not present it as a gap for the full domain when safety is unresolved.
+    safe_subset_emp = out.get("empirical_epsilon_gap_pct")
+    out["safe_subset_empirical_epsilon_gap_pct"] = safe_subset_emp
+
+    if unresolved_safety > 0:
+        out["exact_best_in_declared_safe_domain"] = False
+        out["exact_best_in_declared_domain"] = False
+        out["certified_epsilon_gap_pct"] = None
+        out["empirical_epsilon_gap_pct"] = None
+        out["optimality_certificate_blocked_by_unresolved_safety"] = True
+        reason = str(out.get("reason", ""))
+        if safe == 0:
+            out["reason"] = "blocked_by_release_safety_coverage"
+            out["stop"] = True
+        elif reason in {"exact_domain_exhausted", "domain_exhausted_with_unresolved_runtime_rejections"}:
+            out["reason"] = "release_safe_frontier_exhausted_with_unresolved_safety"
+            out["stop"] = True
+        return out
+
+    if not complete_declared_domain:
+        out["exact_best_in_declared_safe_domain"] = False
+        out["exact_best_in_declared_domain"] = False
+        out["certified_epsilon_gap_pct"] = None
+        if str(out.get("reason", "")) == "exact_domain_exhausted":
+            out["reason"] = "materialized_frontier_exhausted_but_declared_domain_incomplete"
+        out["optimality_certificate_blocked_by_incomplete_domain"] = True
+        return out
+
+    exact_subset = bool(out.get("exact_best_in_declared_safe_domain", False))
+    out["exact_best_in_declared_domain"] = bool(exact_subset and full_cov >= 1.0 - 1e-12)
+    if not out["exact_best_in_declared_domain"] and exact_subset:
+        # This should only happen if bookkeeping indicates a missing SAFE eval.
+        out["exact_best_in_declared_safe_domain"] = False
+        out["certified_epsilon_gap_pct"] = None
+    return out
+
+
+@dataclass
+class Observation:
+    config: dict[str, Any]
+    latency_ms: float
+    origin: str
+    eligible_incumbent: bool = True
+
+
+class NearOptimalController:
+    """Best-first optimistic search with online local residual correction."""
+
+    def __init__(
+        self,
+        *,
+        search_space: SearchSpaceSpec,
+        candidate_rows: Sequence[Mapping[str, Any]],
+        epsilon_pct: float = 1.0,
+        exploration_every: int = 4,
+        uncertainty_beta: float = 1.5,
+        min_empirical_coverage: float = 0.50,
+        min_empirical_observations: int = 6,
+        admissible_lower_bounds_ms: Mapping[tuple, float] | None = None,
+    ):
+        self.spec = search_space
+        self.rows = {config_signature(r["config"]): dict(r) for r in candidate_rows}
+        self.epsilon_pct = max(0.0, float(epsilon_pct))
+        self.exploration_every = max(0, int(exploration_every))
+        self.uncertainty_beta = max(0.0, float(uncertainty_beta))
+        self.min_empirical_coverage = min(1.0, max(0.0, float(min_empirical_coverage)))
+        self.min_empirical_observations = max(1, int(min_empirical_observations))
+        self.admissible_bounds = dict(admissible_lower_bounds_ms or {})
+        self.observations: dict[tuple, Observation] = {}
+        self.rejections: dict[tuple, dict[str, Any]] = {}
+        self.pending: set[tuple] = set()
+        self.pick_count = 0
+        # Search-time feature/prior caching matters once generic handwritten
+        # domains grow into hundreds or thousands of configs.  These are all
+        # source-only immutable descriptors, so compute them exactly once.
+        self._feature_cache = {sig: record_features(self.spec, row) for sig, row in self.rows.items()}
+        self._coord_cache = {sig: structural_coordinates(self.spec, row["config"]) for sig, row in self.rows.items()}
+        self._prior_cache = {sig: self._prior_scalar_uncached(row) for sig, row in self.rows.items()}
+        self._observation_version = 0
+        self._estimate_cache_version = -1
+        self._batch_estimate_cache: dict[tuple, dict[str, float]] = {}
+
+    def observe(self, cfg: Mapping[str, Any], latency_ms: float, *, origin: str, eligible_incumbent: bool = True) -> None:
+        sig = config_signature(cfg)
+        self.rejections.pop(sig, None)
+        self.pending.discard(sig)
+        self.observations[sig] = Observation(
+            dict(cfg), float(latency_ms), str(origin), bool(eligible_incumbent)
+        )
+        self._observation_version += 1
+        self._batch_estimate_cache.clear()
+
+    def reject(self, cfg: Mapping[str, Any], *, reason: str, resolved_infeasible: bool = False) -> None:
+        """Remove a failed candidate from future acquisition.
+
+        A release-certified candidate that unexpectedly fails in the current
+        runtime is *unresolved*, so it blocks an exact/certified optimum claim.
+        A dedicated exhaustive lab may mark a deterministic compile/correctness
+        failure as resolved infeasible and still certify the best feasible point.
+        """
+        sig = config_signature(cfg)
+        if sig in self.observations:
+            return
+        self.pending.discard(sig)
+        self.rejections[sig] = {
+            "reason": str(reason),
+            "resolved_infeasible": bool(resolved_infeasible),
+        }
+        self._observation_version += 1
+        self._batch_estimate_cache.clear()
+
+    def _prior_scalar_uncached(self, row: Mapping[str, Any]) -> float:
+        rec = dict(row.get("precompile_source_prefilter") or {})
+        # Prefer physical/source proxy when available.  Consensus rank remains a
+        # weak monotone fallback and is shifted away from zero for log fitting.
+        for key in ("score_us_proxy", "generic_work_proxy"):
+            try:
+                value = float(rec.get(key))
+                if math.isfinite(value) and value > 0:
+                    return value
+            except Exception:
+                pass
+        return 1.0 + float(rec.get("consensus_rank_score", row.get("source_prior_rank", 1)) or 1)
+
+    def _prior_scalar(self, row: Mapping[str, Any]) -> float:
+        sig = config_signature(row["config"])
+        return float(self._prior_cache.get(sig, self._prior_scalar_uncached(row)))
+
+    @staticmethod
+    def _coord_distance(a: Sequence[float], b: Sequence[float]) -> float:
+        if not a:
+            return 0.0
+        return math.sqrt(sum((float(x) - float(y)) ** 2 for x, y in zip(a, b)) / len(a))
+
+    def _global_calibration(self) -> tuple[float, float, float]:
+        pairs = []
+        for sig, obs in self.observations.items():
+            row = self.rows.get(sig)
+            if row is None or obs.latency_ms <= 0:
+                continue
+            p = self._prior_scalar(row)
+            if p > 0:
+                pairs.append((math.log(p), math.log(obs.latency_ms)))
+        if not pairs:
+            return 0.0, 0.0, 0.50
+        if len(pairs) == 1:
+            x, y = pairs[0]
+            return y - x, 1.0, 0.35
+        xs = [x for x, _ in pairs]; ys = [y for _, y in pairs]
+        xm, ym = statistics.fmean(xs), statistics.fmean(ys)
+        den = sum((x - xm) ** 2 for x in xs)
+        beta = 1.0 if den <= 1e-12 else sum((x - xm) * (y - ym) for x, y in pairs) / den
+        beta = min(2.0, max(0.0, beta))
+        alpha = ym - beta * xm
+        residuals = [y - (alpha + beta * x) for x, y in pairs]
+        sigma = max(0.05, 1.4826 * _mad(residuals, default=0.10))
+        return alpha, beta, sigma
+
+    def _rebuild_batch_estimates(self) -> None:
+        """Estimate every unmeasured config once per observation state.
+
+        V6 may expose 10^3--10^4 legal configs while evaluating only a small
+        hardware budget.  The prototype recomputed the global calibration and
+        local residual neighborhood once *per candidate*, producing seconds of
+        avoidable Python overhead.  Final V6 batches this acquisition model:
+        one global fit plus one vectorized candidate x observation distance
+        calculation whenever a new hardware observation arrives.
+        """
+        if self._estimate_cache_version == self._observation_version:
+            return
+        remaining = [(sig, row) for sig, row in self.rows.items() if sig not in self.observations and sig not in self.rejections]
+        cache: dict[tuple, dict[str, float]] = {}
+        if not remaining:
+            self._batch_estimate_cache = cache
+            self._estimate_cache_version = self._observation_version
+            return
+
+        alpha, beta, global_sigma = self._global_calibration()
+        obs_items = [(sig, obs) for sig, obs in self.observations.items() if sig in self.rows]
+
+        # Vectorized fast path. NumPy is already a normal dependency of the
+        # experiment stack; the pure-Python fallback below preserves portability.
+        try:
+            import numpy as np
+            rem_sigs = [sig for sig, _ in remaining]
+            pri = np.asarray([max(1e-12, self._prior_scalar(self.rows[sig])) for sig in rem_sigs], dtype=np.float64)
+            base = alpha + beta * np.log(pri)
+            disagreement = np.asarray([
+                float((self.rows[sig].get("precompile_source_prefilter") or {}).get("rank_view_disagreement", 0.0) or 0.0)
+                for sig in rem_sigs
+            ], dtype=np.float64)
+
+            if obs_items:
+                X = np.asarray([self._feature_cache[sig] for sig in rem_sigs], dtype=np.float64)
+                O = np.asarray([self._feature_cache[sig] for sig, _ in obs_items], dtype=np.float64)
+                # N x M, where M is the small number of hardware evaluations.
+                dist = np.sqrt(np.mean((X[:, None, :] - O[None, :, :]) ** 2, axis=2)) if X.shape[1] else np.zeros((len(rem_sigs), len(obs_items)))
+                nearest = np.min(dist, axis=1)
+                obs_prior = np.asarray([max(1e-12, self._prior_scalar(self.rows[sig])) for sig, _ in obs_items], dtype=np.float64)
+                obs_latency = np.asarray([max(1e-12, obs.latency_ms) for _, obs in obs_items], dtype=np.float64)
+                residual = np.log(obs_latency) - (alpha + beta * np.log(obs_prior))
+                k = min(5, len(obs_items))
+                if k == len(obs_items):
+                    idx = np.argsort(dist, axis=1, kind="stable")[:, :k]
+                else:
+                    idx = np.argpartition(dist, k - 1, axis=1)[:, :k]
+                local_res = residual[idx]
+                correction = np.median(local_res, axis=1)
+                local_mad = 1.4826 * np.median(np.abs(local_res - correction[:, None]), axis=1)
+            else:
+                nearest = np.ones(len(rem_sigs), dtype=np.float64)
+                correction = np.zeros(len(rem_sigs), dtype=np.float64)
+                local_mad = np.full(len(rem_sigs), global_sigma, dtype=np.float64)
+
+            sigma = np.maximum.reduce([
+                np.full(len(rem_sigs), 0.03, dtype=np.float64),
+                local_mad,
+                global_sigma * (0.5 + nearest),
+                disagreement * 0.5,
+            ])
+            pred = np.exp(base + correction)
+            optimistic = pred * np.exp(-self.uncertainty_beta * sigma)
+            for i, sig in enumerate(rem_sigs):
+                cache[sig] = {
+                    "predicted_ms": float(pred[i]),
+                    "sigma_log": float(sigma[i]),
+                    "optimistic_ms": float(optimistic[i]),
+                    "nearest_distance": float(nearest[i]),
+                }
+        except Exception:
+            # Portable fallback: still fit the global model once per observation
+            # state instead of once per candidate.
+            residual_info = []
+            for osig, obs in obs_items:
+                op = max(1e-12, self._prior_scalar(self.rows[osig]))
+                ores = math.log(max(1e-12, obs.latency_ms)) - (alpha + beta * math.log(op))
+                residual_info.append((osig, ores))
+            for sig, row in remaining:
+                base_log = alpha + beta * math.log(max(1e-12, self._prior_scalar(row)))
+                residual_neighbors = []
+                nearest = 1.0
+                target_feat = self._feature_cache[sig]
+                for osig, ores in residual_info:
+                    dist = _euclidean(target_feat, self._feature_cache[osig])
+                    nearest = min(nearest, dist)
+                    residual_neighbors.append((dist, ores))
+                residual_neighbors.sort(key=lambda x: x[0])
+                local = residual_neighbors[: min(5, len(residual_neighbors))]
+                correction = _median([r for _, r in local], default=0.0)
+                local_mad = 1.4826 * _mad([r for _, r in local], default=global_sigma) if local else global_sigma
+                disagreement = float((row.get("precompile_source_prefilter") or {}).get("rank_view_disagreement", 0.0) or 0.0)
+                sigma = max(0.03, local_mad, global_sigma * (0.5 + nearest), disagreement * 0.5)
+                pred = math.exp(base_log + correction)
+                cache[sig] = {
+                    "predicted_ms": pred,
+                    "sigma_log": sigma,
+                    "optimistic_ms": pred * math.exp(-self.uncertainty_beta * sigma),
+                    "nearest_distance": nearest,
+                }
+
+        self._batch_estimate_cache = cache
+        self._estimate_cache_version = self._observation_version
+
+    def estimate(self, row: Mapping[str, Any]) -> dict[str, float]:
+        cfg = dict(row["config"]); sig = config_signature(cfg)
+        if sig in self.observations:
+            v = self.observations[sig].latency_ms
+            return {"predicted_ms": v, "sigma_log": 0.0, "optimistic_ms": v, "nearest_distance": 0.0}
+        self._rebuild_batch_estimates()
+        return dict(self._batch_estimate_cache[sig])
+
+    def _unmeasured_rows(self) -> list[dict[str, Any]]:
+        return [
+            r for sig, r in self.rows.items()
+            if sig not in self.observations and sig not in self.rejections and sig not in self.pending
+        ]
+
+    def mark_pending(self, cfg: Mapping[str, Any]) -> None:
+        sig = config_signature(cfg)
+        if sig in self.rows and sig not in self.observations and sig not in self.rejections:
+            self.pending.add(sig)
+
+    def release_pending(self, cfg: Mapping[str, Any]) -> None:
+        self.pending.discard(config_signature(cfg))
+
+    def next_batch(self, batch_size: int, *, min_batch_distance: float = 0.0) -> list[dict[str, Any]]:
+        """Select a small adaptive batch without duplicate/redundant candidates.
+
+        V6.3 keeps the first pick identical to best-first acquisition, then tries
+        to keep later in-batch picks structurally separated from already pending
+        members.  This improves information gained per parallel compile batch and
+        avoids spending a tight production budget on near-duplicate configs.  If
+        no candidate satisfies the requested distance, the best remaining point
+        is still selected; this is a diversity preference, never a domain prune.
+        """
+        out: list[dict[str, Any]] = []
+        min_dist = max(0.0, float(min_batch_distance))
+        for _ in range(max(0, int(batch_size))):
+            if not out or min_dist <= 0.0:
+                row = self.next_candidate()
+            else:
+                remaining = self._unmeasured_rows()
+                if not remaining:
+                    row = None
+                else:
+                    self._rebuild_batch_estimates()
+                    chosen_sigs = [config_signature(r["config"]) for r in out]
+                    diverse = []
+                    for cand in remaining:
+                        sig = config_signature(cand["config"])
+                        d = min(
+                            _euclidean(self._coord_cache[sig], self._coord_cache[other])
+                            for other in chosen_sigs
+                        )
+                        if d >= min_dist:
+                            diverse.append(cand)
+                    pool = diverse or remaining
+                    row = min(
+                        pool,
+                        key=lambda cand: (
+                            self._batch_estimate_cache[config_signature(cand["config"])]["optimistic_ms"],
+                            int(cand.get("proposal_rank", 10**9)),
+                            int(cand.get("source_prior_rank", cand.get("raw_deca_rank", 10**9))),
+                            config_signature(cand["config"]),
+                        ),
+                    )
+                    self.pick_count += 1
+            if row is None:
+                break
+            self.mark_pending(row["config"])
+            out.append(row)
+        return out
+
+    def next_candidate(self) -> dict[str, Any] | None:
+        remaining = self._unmeasured_rows()
+        if not remaining:
+            return None
+        self.pick_count += 1
+
+        # Periodic exploration protects against a miscalibrated prior.  The
+        # batched estimator already computes distance to observed configurations
+        # in the generic feature space, so reuse it rather than re-running an
+        # O(N x observations) Python structural-distance loop.
+        self._rebuild_batch_estimates()
+        if self.exploration_every and self.pick_count % self.exploration_every == 0 and self.observations:
+            return min(
+                remaining,
+                key=lambda row: (
+                    -self._batch_estimate_cache[config_signature(row["config"])]["nearest_distance"],
+                    self._batch_estimate_cache[config_signature(row["config"])]["optimistic_ms"],
+                    config_signature(row["config"]),
+                ),
+            )
+
+        return min(
+            remaining,
+            key=lambda row: (
+                self._batch_estimate_cache[config_signature(row["config"])]["optimistic_ms"],
+                int(row.get("proposal_rank", 10**9)),
+                int(row.get("source_prior_rank", row.get("raw_deca_rank", 10**9))),
+                config_signature(row["config"]),
+            ),
+        )
+
+    def incumbent(self) -> Observation | None:
+        if not self.observations:
+            return None
+        eligible = [o for o in self.observations.values() if o.eligible_incumbent]
+        pool = eligible or list(self.observations.values())
+        return min(pool, key=lambda o: (o.latency_ms, config_signature(o.config)))
+
+    def status(self) -> dict[str, Any]:
+        remaining = self._unmeasured_rows()
+        incumbent = self.incumbent()
+        resolved_count = len(self.observations) + len(self.rejections)
+        coverage = resolved_count / max(1, len(self.rows))
+        unresolved_rejections = [
+            {"config_signature": sig, **rec}
+            for sig, rec in self.rejections.items()
+            if not bool(rec.get("resolved_infeasible"))
+        ]
+        if self.pending:
+            return {
+                "stop": False,
+                "reason": "batch_in_flight",
+                "coverage_ratio": coverage,
+                "pending_candidate_count": len(self.pending),
+                "certified_epsilon_gap_pct": None,
+                "empirical_epsilon_gap_pct": None,
+            }
+        if incumbent is None:
+            return {
+                "stop": False,
+                "reason": "no_measurements",
+                "coverage_ratio": coverage,
+                "certified_epsilon_gap_pct": None,
+                "empirical_epsilon_gap_pct": None,
+            }
+
+        if not remaining:
+            if unresolved_rejections:
+                return {
+                    "stop": True,
+                    "reason": "domain_exhausted_with_unresolved_runtime_rejections",
+                    "coverage_ratio": 1.0,
+                    "exact_best_in_declared_safe_domain": False,
+                    "certified_epsilon_gap_pct": None,
+                    "empirical_epsilon_gap_pct": 0.0,
+                    "rejected_candidate_count": len(self.rejections),
+                    "unresolved_rejection_count": len(unresolved_rejections),
+                    "unresolved_rejections_block_certificate": True,
+                }
+            return {
+                "stop": True,
+                "reason": "exact_domain_exhausted",
+                "coverage_ratio": 1.0,
+                "exact_best_in_declared_safe_domain": True,
+                "certified_epsilon_gap_pct": 0.0,
+                "empirical_epsilon_gap_pct": 0.0,
+                "rejected_infeasible_count": len(self.rejections),
+            }
+
+        optimistic = [(self.estimate(r)["optimistic_ms"], r) for r in remaining]
+        min_emp = min(x for x, _ in optimistic)
+        empirical_gap = max(0.0, (incumbent.latency_ms / max(min_emp, 1e-12) - 1.0) * 100.0)
+
+        certified_gap = None
+        if (not unresolved_rejections) and self.admissible_bounds and all(config_signature(r["config"]) in self.admissible_bounds for r in remaining):
+            lb = min(float(self.admissible_bounds[config_signature(r["config"])]) for r in remaining)
+            certified_gap = max(0.0, (incumbent.latency_ms / max(lb, 1e-12) - 1.0) * 100.0)
+            if certified_gap <= self.epsilon_pct:
+                return {
+                    "stop": True,
+                    "reason": "certified_epsilon_optimal",
+                    "coverage_ratio": coverage,
+                    "exact_best_in_declared_safe_domain": False,
+                    "certified_epsilon_gap_pct": certified_gap,
+                    "empirical_epsilon_gap_pct": empirical_gap,
+                }
+
+        enough = len(self.observations) >= self.min_empirical_observations and coverage >= self.min_empirical_coverage
+        if enough and empirical_gap <= self.epsilon_pct:
+            return {
+                "stop": True,
+                "reason": "empirical_epsilon_frontier_converged",
+                "coverage_ratio": coverage,
+                "exact_best_in_declared_safe_domain": False,
+                "certified_epsilon_gap_pct": certified_gap,
+                "empirical_epsilon_gap_pct": empirical_gap,
+                "empirical_gap_is_not_a_mathematical_certificate": True,
+            }
+
+        return {
+            "stop": False,
+            "reason": "continue_best_first_search",
+            "coverage_ratio": coverage,
+            "exact_best_in_declared_safe_domain": False,
+            "certified_epsilon_gap_pct": certified_gap,
+            "empirical_epsilon_gap_pct": empirical_gap,
+            "empirical_gap_is_not_a_mathematical_certificate": True,
+            "rejected_candidate_count": len(self.rejections),
+            "unresolved_rejection_count": len(unresolved_rejections),
+        }
