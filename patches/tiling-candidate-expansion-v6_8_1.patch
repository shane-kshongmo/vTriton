@@ -0,0 +1,35 @@
+"""Universal TTIR memory model with pointer-pattern analysis."""
+from dataclasses import dataclass
+from .ttir_pointer_analysis import analyze_pointer_access
+
+@dataclass(frozen=True)
+class MemoryAccessReport:
+    coalescing_score: float
+    random_access_penalty: float
+    reuse_factor: float
+    bandwidth_scale: float
+    pointer_confidence: float = 0.0
+
+
+def analyze_memory_pattern(template):
+    ops = dict(getattr(template, "operation_counts", {}) or {})
+    unknown = len(getattr(template, "unknown_tt_ops", ()) or ())
+    loads = sum(v for k,v in ops.items() if "load" in k)
+    stores = sum(v for k,v in ops.items() if "store" in k)
+    total = max(1, loads + stores)
+
+    indirect = sum(v for k,v in ops.items() if any(x in k.lower() for x in ["gather", "scatter", "index"]))
+
+    ptr = analyze_pointer_access(template)
+    random_penalty = min(0.9, 0.5 * indirect / total + 0.5 * ptr.indirect_access_ratio + 0.03 * unknown)
+    coalescing = max(0.05, ptr.contiguous_score * (1.0 - random_penalty))
+    reuse = ptr.reuse_hint + min(4.0, getattr(template, "persistent_loop_count", 0) * 0.25)
+    bandwidth_scale = max(0.05, coalescing * reuse * ptr.stride_score)
+
+    return MemoryAccessReport(
+        coalescing,
+        random_penalty,
+        reuse,
+        bandwidth_scale,
+        ptr.confidence
+    )
