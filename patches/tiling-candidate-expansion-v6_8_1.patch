index 000000000..6c874e3ef
--- /dev/null
+++ b/third_party/ascend/backend/runtime/ttir_pointer_analysis.py
@@ -0,0 +1,75 @@
+"""TTIR pointer/access-pattern analysis from textual MLIR.
+
+The fallback recognises block-pointer shapes/strides/order, masked accesses,
+addptr chains, gather/scatter operations and affine multiplication.  It returns
+an explicit confidence score so synthetic templates are not treated as real
+pointer analysis.
+"""
+from dataclasses import dataclass
+import re
+
+
+@dataclass(frozen=True)
+class PointerAccessReport:
+    contiguous_score: float
+    stride_score: float
+    indirect_access_ratio: float
+    reuse_hint: float
+    confidence: float = 0.0
+    masked_access_ratio: float = 0.0
+
+
+def _numeric_list(text: str, name: str):
+    match = re.search(rf"{name}\s*=\s*\[([^\]]*)\]", text)
+    if not match:
+        return []
+    values = []
+    for token in match.group(1).split(','):
+        token = token.strip()
+        if re.fullmatch(r"-?[0-9]+", token):
+            values.append(int(token))
+    return values
+
+
+def analyze_pointer_access(template):
+    raw = getattr(template, "ttir_text", "") or ""
+    text = raw if isinstance(raw, str) else "\n".join(raw)
+    counts = dict(getattr(template, "operation_counts", {}) or {})
+    loads = sum(v for k, v in counts.items() if "load" in k) or len(re.findall(r"tt\.load", text))
+    stores = sum(v for k, v in counts.items() if "store" in k) or len(re.findall(r"tt\.store", text))
+    total = max(1, loads + stores)
+    if not text.strip():
+        # Synthetic/count-only template: deliberately low confidence.
+        return PointerAccessReport(0.65, 0.65, 0.15, 1.0, 0.10, 0.0)
+
+    lower = text.lower()
+    gather = len(re.findall(r"\b(?:gather|scatter)\b", lower))
+    addptr = len(re.findall(r"tt\.addptr", lower))
+    dynamic_index = len(re.findall(r"(?:arith\.muli|arith\.index_cast|%idx|%index|\boffset\b)", lower))
+    masks = len(re.findall(r"tt\.(?:load|store)[^\n]*(?:mask|boundary_check)", lower))
+    broadcasts = len(re.findall(r"(?:tt\.|tensor\.)?(?:broadcast|expand_dims|splat)", lower))
+    ptrs = re.findall(r"tt\.make_tensor_ptr[^\n]*", text)
+
+    contiguous_hints = 0
+    strided_hints = 0
+    for ptr in ptrs:
+        strides = _numeric_list(ptr, "strides")
+        order = _numeric_list(ptr, "order")
+        if strides and 1 in map(abs, strides):
+            contiguous_hints += 1
+        if strides and any(abs(v) > 1 for v in strides):
+            strided_hints += 1
+        if order:
+            contiguous_hints += 1
+
+    indirect = gather * 2 + dynamic_index + max(0, addptr - contiguous_hints)
+    indirect_ratio = min(1.0, indirect / max(1.0, total * 2.0))
+    masked_ratio = min(1.0, masks / total)
+    contiguous = 0.55 + 0.10 * contiguous_hints - 0.45 * indirect_ratio - 0.10 * masked_ratio
+    contiguous = min(1.0, max(0.05, contiguous))
+    stride_score = 0.65 + 0.08 * contiguous_hints - 0.07 * strided_hints - 0.15 * indirect_ratio
+    stride_score = min(1.0, max(0.10, stride_score))
+    reuse = 1.0 + min(4.0, 0.35 * broadcasts + 0.20 * len(ptrs))
+    evidence = min(1.0, (len(ptrs) + loads + stores + masks) / 8.0)
+    confidence = min(0.95, 0.35 + 0.60 * evidence)
+    return PointerAccessReport(contiguous, stride_score, indirect_ratio, reuse, confidence, masked_ratio)
diff --git a/third_party/ascend/backend/runtime/universal_memory_model.py b/third_party/ascend/backend/runtime/universal_memory_model.py
