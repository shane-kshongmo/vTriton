+from pathlib import Path
+import sys, types
+ROOT=Path(__file__).resolve().parents[3]
+RUNTIME=ROOT/"third_party/ascend/backend/runtime"
+if "backend" not in sys.modules:
+    b=types.ModuleType("backend"); b.__path__=[str(RUNTIME.parent)]; sys.modules["backend"]=b
+if "backend.runtime" not in sys.modules:
+    r=types.ModuleType("backend.runtime"); r.__path__=[str(RUNTIME)]; sys.modules["backend.runtime"]=r
+from backend.runtime.search_space_v6 import infer_search_space, config_signature
+from backend.runtime.near_optimal_search_v6 import NearOptimalController
+
+def rows():
+    return [
+      {"config":{"X":1},"source_prior_rank":1,"precompile_source_prefilter":{"generic_work_proxy":1.0,"consensus_rank_score":0.0}},
+      {"config":{"X":2},"source_prior_rank":2,"precompile_source_prefilter":{"generic_work_proxy":2.0,"consensus_rank_score":.3}},
+      {"config":{"X":4},"source_prior_rank":3,"precompile_source_prefilter":{"generic_work_proxy":4.0,"consensus_rank_score":.6}},
+    ]
+
+def controller(bounds=None):
+    rs=rows(); sp=infer_search_space([{"X":1}],[r["config"] for r in rs],parameter_domains={"X":[1,2,4]},tunable_parameters=["X"])
+    return NearOptimalController(search_space=sp,candidate_rows=rs,epsilon_pct=1.0,min_empirical_coverage=.1,min_empirical_observations=1,admissible_lower_bounds_ms=bounds)
+
+def test_exact_domain_exhaustion_is_true_certificate():
+    c=controller()
+    for r,v in zip(rows(),[3.0,2.0,1.0]): c.observe(r["config"],v,origin="test")
+    s=c.status(); assert s["reason"]=="exact_domain_exhausted"; assert s["certified_epsilon_gap_pct"]==0.0; assert s["exact_best_in_declared_safe_domain"] is True
+
+def test_empirical_gap_is_not_certified():
+    c=controller(); c.observe({"X":1},1.0,origin="test"); s=c.status()
+    assert s["certified_epsilon_gap_pct"] is None
+    assert s.get("empirical_gap_is_not_a_mathematical_certificate") is True
+
+def test_admissible_bound_can_certify():
+    rs=rows(); sp=infer_search_space([{"X":1}],[r["config"] for r in rs],parameter_domains={"X":[1,2,4]},tunable_parameters=["X"])
+    b={config_signature({"X":2}):.995,config_signature({"X":4}):.995}
+    c=NearOptimalController(search_space=sp,candidate_rows=rs,epsilon_pct=1.0,admissible_lower_bounds_ms=b,min_empirical_observations=99)
+    c.observe({"X":1},1.0,origin="test"); s=c.status(); assert s["reason"]=="certified_epsilon_optimal"; assert s["certified_epsilon_gap_pct"]<=1.0
+
+def test_online_observation_changes_search_state_without_mutating_prior():
+    c=controller(); first=c.next_candidate(); assert first is not None
+    c.observe(first["config"],10.0,origin="current_run")
+    second=c.next_candidate(); assert second is not None and second["config"]!=first["config"]
+
+def test_rejected_candidate_is_not_repeated_and_unresolved_blocks_exact_certificate():
+    c=controller()
+    c.observe({"X":1},3.0,origin="test")
+    c.reject({"X":2},reason="runtime_failure",resolved_infeasible=False)
+    nxt=c.next_candidate()
+    assert nxt is not None and nxt["config"]=={"X":4}
+    c.observe({"X":4},1.0,origin="test")
+    s=c.status()
+    assert s["reason"]=="domain_exhausted_with_unresolved_runtime_rejections"
+    assert s["exact_best_in_declared_safe_domain"] is False
+    assert s["certified_epsilon_gap_pct"] is None
+
+
+def test_resolved_infeasible_rejection_allows_exact_feasible_domain_exhaustion():
+    c=controller()
+    c.observe({"X":1},3.0,origin="test")
+    c.reject({"X":2},reason="deterministic_illegal",resolved_infeasible=True)
+    c.observe({"X":4},1.0,origin="test")
+    s=c.status()
+    assert s["reason"]=="exact_domain_exhausted"
+    assert s["exact_best_in_declared_safe_domain"] is True
+    assert s["rejected_infeasible_count"]==1
+
+
+def test_unresolved_safety_blocks_false_exact_domain_claim():
+    from backend.runtime.near_optimal_search_v6 import finalize_declared_domain_status
+    st = finalize_declared_domain_status(
+        {
+            "stop": True,
+            "reason": "exact_domain_exhausted",
+            "coverage_ratio": 1.0,
+            "exact_best_in_declared_safe_domain": True,
+            "certified_epsilon_gap_pct": 0.0,
+            "empirical_epsilon_gap_pct": 0.0,
+        },
+        complete_declared_domain=True,
+        full_pool_count=100,
+        official_count=4,
+        static_rejected_count=10,
+        statically_legal_novel_count=86,
+        safety={"counts": {"safe": 0, "unsafe": 0, "unknown": 86, "foreign_campaign": 0}},
+        safe_novel_evaluated_count=0,
+    )
+    assert st["reason"] == "blocked_by_release_safety_coverage"
+    assert st["exact_best_in_declared_domain"] is False
+    assert st["exact_best_in_declared_safe_domain"] is False
+    assert st["certified_epsilon_gap_pct"] is None
+    assert st["empirical_epsilon_gap_pct"] is None
+    assert st["declared_domain_performance_resolution_coverage_ratio"] < 1.0
+
+
+def test_exact_declared_domain_requires_no_unknown_and_full_resolution():
+    from backend.runtime.near_optimal_search_v6 import finalize_declared_domain_status
+    st = finalize_declared_domain_status(
+        {
+            "stop": True,
+            "reason": "exact_domain_exhausted",
+            "coverage_ratio": 1.0,
+            "exact_best_in_declared_safe_domain": True,
+            "certified_epsilon_gap_pct": 0.0,
+            "empirical_epsilon_gap_pct": 0.0,
+        },
+        complete_declared_domain=True,
+        full_pool_count=10,
+        official_count=2,
+        static_rejected_count=2,
+        statically_legal_novel_count=6,
+        safety={"counts": {"safe": 4, "unsafe": 2, "unknown": 0, "foreign_campaign": 0}},
+        safe_novel_evaluated_count=4,
+    )
+    assert st["exact_best_in_declared_domain"] is True
+    assert st["certified_epsilon_gap_pct"] == 0.0
+    assert st["declared_domain_performance_resolution_coverage_ratio"] == 1.0
+
+
+def test_v62_batch_pending_prevents_duplicate_acquisition_and_resolves_cleanly():
+    c=controller()
+    batch=c.next_batch(2)
+    assert len(batch)==2
+    assert len({config_signature(r['config']) for r in batch})==2
+    assert c.status()['reason']=='batch_in_flight'
+    assert c.next_candidate() is not None
+    for i,r in enumerate(batch):
+        c.observe(r['config'], 2.0+i, origin='batch', eligible_incumbent=(i==0))
+    assert not c.pending
+    nxt=c.next_candidate()
+    assert nxt is not None
+    assert config_signature(nxt['config']) not in {config_signature(r['config']) for r in batch}
+
+
+def test_v62_nonaccepted_batch_observation_cannot_replace_incumbent():
+    c=controller()
+    c.observe({'X':1}, 2.0, origin='b0', eligible_incumbent=True)
+    c.observe({'X':2}, 1.0, origin='batch_native', eligible_incumbent=False)
+    assert c.incumbent().config == {'X':1}
+    c.observe({'X':2}, 0.9, origin='batch_accepted', eligible_incumbent=True)
+    assert c.incumbent().config == {'X':2}
