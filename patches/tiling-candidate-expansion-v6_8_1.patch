+def _light_mode_options(opts: Mapping[str, Any], score_mode: str) -> Dict[str, Any]:
+    """Create a score-mode view while sharing per-expansion scratch caches."""
+    local = dict(opts)
+    local["light_score_mode"] = score_mode
+    for name in (
+        "_runtime_model_stats", "_candidate_light_score_cache",
+        "_candidate_model_report_cache",
+    ):
+        if name in opts:
+            local[name] = opts[name]
+    return local
+
+
+def _report_cache(opts: Mapping[str, Any]) -> Dict[Any, Any]:
+    if isinstance(opts, dict):
+        return opts.setdefault("_candidate_model_report_cache", {})
+    return {}
+
+
+def _light_report(
+    cfg: Config,
+    all_args: Mapping[str, Any],
+    opts: Mapping[str, Any],
+    *,
+    score_mode: str | None = None,
+) -> LightTTIRReport | None:
+    if not bool(opts.get("enable_light_ttir", True)):
+        return None
+    model_opts = _light_mode_options(opts, score_mode) if score_mode else opts
+    cache = _report_cache(model_opts)
+    key = ("light", _model_context_key(all_args, model_opts, "candidate_light_report"), _sig(cfg))
+    if key in cache:
+        return cache[key]
+    stats = _runtime_model_stats(model_opts)
+    if stats:
+        stats["light_attempted"] += 1
+    try:
+        report = evaluate_light_ttir(cfg, all_args, model_opts)
+        if stats:
+            stats["light_succeeded"] += 1
+        cache[key] = report
+        return report
+    except Exception as exc:
+        _record_model_failure(model_opts, "light", exc)
+        if str(model_opts.get("light_failure_policy", "raise")) == "raise":
+            raise
+        if stats:
+            stats["fallback_used"] += 1
+        return None
+
+
+def _light_guided_spaces(cfg: Config, spaces: Mapping[str, Sequence[int]], all_args: Mapping[str, Any], opts: Mapping[str, Any]):
+    """Return S1 candidate domains biased by Light TTIR execution state."""
+    if not bool(opts.get("enable_light_guided_expansion", True)):
+        return spaces
+    # S1 generation is guided only by the common Universal coordinate.
+    # Operator residuals are reserved for the S2 survivor refinement stage.
+    report = _light_report(cfg, all_args, opts, score_mode="universal")
+    guidance = expansion_guidance(report)
+    guided = {}
+    for name, values in spaces.items():
+        current = cfg.kwargs.get(name)
+        direction = guidance.get("axis", {}).get(name)
+        if isinstance(current, int):
+            preferred = filter_values(values, current, direction)
+            guided[name] = preferred if preferred else list(values)
+        else:
+            guided[name] = list(values)
+    return guided
+
+
+def _formal_report(cfg: Config, all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> Mapping[str, Any] | None:
+    cache = _report_cache(opts)
+    key = ("formal", _model_context_key(all_args, opts, "candidate_formal_report"), _sig(cfg))
+    if key in cache:
+        return cache[key]
+    formal = opts.get("formal_cost_model") or opts.get("cost_model")
+    if not callable(formal):
+        return None
+    stats = _runtime_model_stats(opts)
+    if stats:
+        stats["formal_attempted"] += 1
+    try:
+        value = formal(cfg=cfg, all_args=all_args, options=opts)
+        if not isinstance(value, Mapping):
+            value = {"score": float(value)}
+        if stats:
+            stats["formal_succeeded"] += 1
+        cache[key] = value
+        return value
+    except Exception as exc:
+        _record_model_failure(opts, "formal", exc)
+        if str(opts.get("formal_failure_policy", "raise")) == "raise":
+            raise
+        if stats:
+            stats["fallback_used"] += 1
+        return None
+
+
+def _score(cfg: Config, all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> float:
+    stage = str(opts.get("_model_stage", "light"))
+    if stage == "formal":
+        value = _formal_report(cfg, all_args, opts)
+        if value is not None:
+            return float(value.get("score", value.get("formal_time_us", value.get("latency", float("inf")))))
+        if not bool(opts.get("allow_analytic_formal_fallback", True)):
+            raise RuntimeError("S3 requires formal_cost_model; analytic fallback is disabled")
+    else:
+        cached_numeric = _light_score_cache(opts).get(_light_numeric_cache_key(cfg, all_args, opts))
+        if cached_numeric is not None:
+            return float(cached_numeric[0])
+        light_external = opts.get("light_ttir_model")
+        if callable(light_external):
+            value = light_external(cfg=cfg, all_args=all_args, options=opts)
+            if isinstance(value, Mapping):
+                value = value.get("score")
+            return float(value)
+        report = _light_report(cfg, all_args, opts)
+        if report is not None:
+            return float(report.score)
+        if not bool(opts.get("allow_legacy_light_proxy", False)):
+            raise RuntimeError("S1/S2 require a real Light TTIR template provider")
+    return analytic_cost_model(cfg, all_args, opts).score
+
+
+def _diverse_seed_subset(configs: Sequence[Config], names: Sequence[str], limit: int) -> List[Config]:
+    """Deterministic farthest-point subset for bounded expansion seed cost."""
+    items = sorted(_dedupe(configs), key=_sig)
+    if limit <= 0 or len(items) <= limit:
+        return items
+    selected = [items[0]]
+    remaining = items[1:]
+    while remaining and len(selected) < limit:
+        chosen = max(remaining, key=lambda c: (min(_distance(c, s, names) for s in selected), _sig(c)))
+        remaining.remove(chosen)
+        selected.append(chosen)
+    return selected
+
+
+def _distance(a: Config, b: Config, names: Sequence[str]) -> float:
+    d = 0.0
+    for name in names:
+        x, y = a.kwargs.get(name), b.kwargs.get(name)
+        if isinstance(x, int) and isinstance(y, int) and x > 0 and y > 0:
+            d += abs(math.log2(x / y))
+    return d
+
+
+def _diverse_top_k(configs: Sequence[Config], scores: Mapping[Config, float], names: Sequence[str], k: int,
+                   diversity_weight: float) -> List[Config]:
+    if k <= 0 or len(configs) <= k:
+        return sorted(configs, key=lambda c: scores[c])
+    ranked = sorted(configs, key=lambda c: scores[c])
+    selected = [ranked.pop(0)]
+    min_score = min(scores.values())
+    score_span = max(scores.values()) - min_score or 1.0
+    while ranked and len(selected) < k:
+        def key(c):
+            normalized_cost = (scores[c] - min_score) / score_span
+            diversity = min(_distance(c, s, names) for s in selected)
+            return normalized_cost - diversity_weight * diversity
+        chosen = min(ranked, key=key)
+        ranked.remove(chosen)
+        selected.append(chosen)
+    return selected
+
+
+def _objectives(cfg: Config, all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> Tuple[float, ...]:
+    """Pareto objectives from the active model report."""
+    if str(opts.get("_model_stage", "light")) == "formal":
+        formal = _formal_report(cfg, all_args, opts)
+        if formal is not None:
+            return (
+                float(formal.get("score", formal.get("formal_time_us", float("inf")))),
+                float(formal.get("serial_time", formal.get("t_serial_irreducible_us", 0.0)) or 0.0),
+                float(formal.get("ub_utilization", formal.get("capacity_utilization", 0.0)) or 0.0),
+                float(formal.get("load_imbalance", 0.0) or 0.0),
+            )
+        if not bool(opts.get("allow_analytic_formal_fallback", True)):
+            raise RuntimeError("Formal Pareto objectives require a formal report")
+    cached_numeric = _light_score_cache(opts).get(_light_numeric_cache_key(cfg, all_args, opts))
+    if cached_numeric is not None:
+        return tuple(float(x) for x in cached_numeric[:4])
+    report = _light_report(cfg, all_args, opts)
+    if report is not None:
+        return (float(report.score), report.ub_utilization,
+                report.load_imbalance, report.tail_waste)
+    breakdown = analytic_cost_model(cfg, all_args, opts)
+    metrics = _resource_metrics(cfg, all_args, opts)
+    return (_score(cfg, all_args, opts), breakdown.ub_pressure,
+            breakdown.core_imbalance, metrics["tail_waste"])
+
+
+def _pareto_top_k(configs: Sequence[Config], all_args: Mapping[str, Any], opts: Mapping[str, Any],
+                  names: Sequence[str], k: int) -> List[Config]:
+    """NSGA-II-style non-dominated fronts with diversity tie breaking."""
+    if k <= 0 or len(configs) <= k:
+        return sorted(configs, key=lambda c: _score(c, all_args, opts))
+    stage = str(opts.get("_model_stage", "light"))
+    if stage != "formal" and bool(opts.get("enable_light_ttir", True)):
+        # Unified production preselection: the same TTIR-aware score contract
+        # is used by compact batch arrays and survivor reports.
+        _prime_light_score_cache(configs, all_args, opts)
+    prefilter = int(opts.get("pareto_prefilter_n", max(512, 4 * k)))
+    working = list(configs)
+    if len(working) > prefilter:
+        ranked = sorted(working, key=lambda c: _score(c, all_args, opts))
+        working = ranked[:prefilter]
+        # Preserve the best candidate from each compact execution region.
+        if stage != "formal":
+            numeric_cache = _light_score_cache(opts)
+            region_best = {}
+            for c in configs:
+                item = numeric_cache.get(_light_numeric_cache_key(c, all_args, opts))
+                if item is None:
+                    continue
+                region = item[4]
+                prev = region_best.get(region)
+                if prev is None or item[0] < numeric_cache[_light_numeric_cache_key(prev, all_args, opts)][0]:
+                    region_best[region] = c
+            keep_sigs = {_sig(c) for c in working}
+            for c in region_best.values():
+                if _sig(c) not in keep_sigs:
+                    working.append(c); keep_sigs.add(_sig(c))
+    objs = {c: _objectives(c, all_args, opts) for c in working}
+    remaining = list(working)
+    selected: List[Config] = []
+    while remaining and len(selected) < k:
+        front = []
+        for c in remaining:
+            dominated = any(all(a <= b for a, b in zip(objs[d], objs[c])) and
+                            any(a < b for a, b in zip(objs[d], objs[c]))
+                            for d in remaining if d is not c)
+            if not dominated:
+                front.append(c)
+        if len(selected) + len(front) <= k:
+            selected.extend(sorted(front, key=lambda c: objs[c][0]))
+        else:
+            scores = {c: objs[c][0] for c in front}
+            selected.extend(_diverse_top_k(front, scores, names, k - len(selected),
+                                           float(opts.get("diversity_weight", 0.08))))
+        fset = set(front)
+        remaining = [c for c in remaining if c not in fset]
+    return selected
+
+
+def _select(configs: Sequence[Config], scores: Mapping[Config, float], names: Sequence[str], k: int,
+            all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> List[Config]:
+    mode = str(opts.get("selection_mode", "pareto")).lower()
+    if mode == "pareto":
+        return _pareto_top_k(configs, all_args, opts, names, k)
+    if mode == "random":
+        # Advance the deterministic random stream across repeated selection calls
+        # instead of restarting from the same seed every generation.
+        counter = int(opts.get("_random_select_counter", 0))
+        if isinstance(opts, dict):
+            opts["_random_select_counter"] = counter + 1
+        rng = random.Random(int(opts.get("random_seed", 20260710)) + counter)
+        items = list(configs); rng.shuffle(items)
+        return items[:k]
+    return _diverse_top_k(configs, scores, names, k, float(opts.get("diversity_weight", 0.08)))
+
+
+
+def _ta_domain_values(options: Mapping[str, Any], name: str) -> List[int]:
+    """Return the explicitly configured legal values for one strict domain."""
+    domains = options.get("parameter_domains", {}) or {}
+    raw = domains.get(name)
+    if raw is None:
+        raw = domains.get(name.upper())
+    if raw is None:
+        return []
+    return sorted({int(value) for value in raw if isinstance(value, int) and int(value) > 0})
+
+
+def _ta_project_strict_domains_final(configs: Sequence[Config],
+                                     options: Mapping[str, Any]) -> List[Config]:
+    """Project strict discrete parameters back to their declared domains.
+
+    Generic mutation families may otherwise create intermediate values such as
+    5 or 10 for a hardware-core domain declared as {1,2,4,8,12,16,20}.  The
+    final projection is deliberately applied at every cumulative-stage exit so
+    no out-of-domain value can leak into benchmarking or a built wheel.
+    """
+    strict = {str(name) for name in options.get("strict_parameter_domains", ())}
+    if not strict:
+        return _dedupe(configs)
+    projected: List[Config] = []
+    for cfg in configs:
+        kwargs = dict(cfg.kwargs)
+        changed = False
+        for name in strict:
+            domain = _ta_domain_values(options, name)
+            value = kwargs.get(name)
+            if not domain or not isinstance(value, int) or value in domain:
+                continue
+            kwargs[name] = min(domain, key=lambda candidate: (abs(candidate - value), candidate))
+            changed = True
+        projected.append(_clone(cfg, kwargs) if changed else cfg)
+    return _dedupe(projected)
+
+
+def _ta_balance_parameter_domains_final(configs: Sequence[Config],
+                                         options: Mapping[str, Any]) -> List[Config]:
+    """Cartesian-expand cumulative pools over selected discrete parameters.
+
+    This mode is intended for offline fairness studies.  Each unique base
+    tiling receives exactly the same legal AICORE_NUM values, preventing a
+    misleading comparison where one core count is benchmarked on many more
+    BM/BN combinations than another.
+    """
+    names = [str(name) for name in options.get("balanced_parameter_domains", ())]
+    names = [name for name in names if _ta_domain_values(options, name)]
+    if not names:
+        return _ta_project_strict_domains_final(configs, options)
+
+    bases: Dict[Tuple, Config] = {}
+    for cfg in _ta_project_strict_domains_final(configs, options):
+        base_kwargs = {key: value for key, value in cfg.kwargs.items() if key not in names}
+        key = (tuple(sorted(base_kwargs.items())), cfg.num_warps, cfg.num_stages,
+               cfg.num_ctas, cfg.maxnreg)
+        bases.setdefault(key, _clone(cfg, base_kwargs))
+
+    balanced: List[Config] = []
+    domains = [_ta_domain_values(options, name) for name in names]
+    for base in bases.values():
+        for values in itertools.product(*domains):
+            kwargs = dict(base.kwargs)
+            kwargs.update(dict(zip(names, values)))
+            balanced.append(_clone(base, kwargs))
+    return _dedupe(balanced)
+
+
+def _ta_inject_tunable_defaults(configs: Sequence[Config], all_args: Mapping[str, Any],
+                                options: Mapping[str, Any]) -> List[Config]:
+    """Materialize tunable parameters absent from official Config kwargs."""
+    requested = options.get("tunable_parameter") or options.get("tunable_parameters") or ()
+    defaults = dict(options.get("parameter_defaults", {}) or {})
+    out: List[Config] = []
+    for cfg in configs:
+        kwargs = dict(cfg.kwargs)
+        for name in requested:
+            name = str(name)
+            if name in kwargs:
+                continue
+            value = defaults.get(name, all_args.get(name))
+            if isinstance(value, int) and value > 0:
+                kwargs[name] = value
+        out.append(_clone(cfg, kwargs))
+    return _dedupe(out)
+
+def expand_official_configs(official: Sequence[Config], all_args: Mapping[str, Any],
+                            options: Mapping[str, Any] | None = None):
+    """Build cumulative candidate pools only up to ``max_stage``.
+
+    This stage gate is intentionally inside candidate generation.  A B0/B1/B2
+    experiment therefore cannot accidentally pay for later-stage generation,
+    which is essential for valid end-to-end autotune and break-even metrics.
+
+    ``generation_only=True`` is the accuracy-audit mode: S1/S2/S3 preserve
+    structural expansion semantics but never read Light TTIR, Full-vTriton, or
+    analytical ranking scores.  The final pool can then be evaluated by an
+    independent Full-vTriton-vs-hardware experiment without selection bias.
+    """
+    opts = dict(options or {})
+    # Isolate runtime mutable state from any caller-supplied dict.  A shallow
+    # copy above keeps caller-owned keys, but setdefault elsewhere would otherwise
+    # reuse mutable sub-dicts if the caller passes the same options dict twice.
+    # Force-reset the internal scratch keys so each expansion call is independent.
+    opts["_runtime_model_stats"] = {
+        "light_attempted": 0, "light_succeeded": 0, "light_failed": 0,
+        "formal_attempted": 0, "formal_succeeded": 0, "formal_failed": 0,
+        "fallback_used": 0, "failure_reasons": {},
+    }
+    opts["_candidate_light_score_cache"] = {}
+    opts["_candidate_model_report_cache"] = {}
+    stage_order = ("B0_official", "B1_plus_s1", "B2_plus_s2", "B3_plus_s3")
+    max_stage = str(opts.get("max_stage", "B3_plus_s3"))
+    if max_stage not in stage_order:
+        raise ValueError(f"Unknown max_stage={max_stage!r}; expected one of {stage_order}")
+    target_idx = stage_order.index(max_stage)
+
+    s1_limit = int(opts.get("s1_max_new", 48))
+    s2_limit = int(opts.get("s2_max_new", 64))
+    s3_limit = int(opts.get("s3_max_new", 64))
+    retain_all_generated = bool(opts.get("retain_all_generated", False))
+    generation_only = bool(opts.get("generation_only", False))
+    parent_k = int(opts.get("evolution_parent_k", 8))
+    population_k = int(opts.get("evolution_population", max(32, parent_k * 2)))
+    generations = int(opts.get("evolution_generations", 2))
+    mutation_per_parent = int(opts.get("mutation_per_parent", 8))
+    seed = int(opts.get("random_seed", 20260710))
+    rng = random.Random(seed)
+    opts["_random_select_counter"] = 0
+    timings: Dict[str, float] = {}
+
+    t0 = time.perf_counter()
+    # B0 remains the untouched official TileGenerator output. Search-only
+    # normalization is kept in a separate seed pool.
+    b0 = _dedupe(copy.deepcopy(list(official)))
+    search_seed = _ta_inject_tunable_defaults(b0, all_args, opts)
+    search_seed = _ta_project_strict_domains_final(search_seed, opts)
+    requested_tunable = opts.get("tunable_parameter") or opts.get("tunable_parameters")
+    requested = {str(x) for x in requested_tunable} if requested_tunable else None
+    tunable = sorted({k for cfg in search_seed for k, v in cfg.kwargs.items()
+                      if isinstance(v, int) and (requested is None or k in requested)})
+    spaces = {name: _legal_values(name, search_seed, all_args, opts) for name in tunable}
+    spaces = {name: vals for name, vals in spaces.items() if len(vals) > 1}
+    search_seed_full_count = len(search_seed)
+    seed_limit = max(1, int(opts.get("expansion_seed_limit", 128)))
+    search_seed = _diverse_seed_subset(search_seed, list(spaces), seed_limit)
+    timings["official_capture_s"] = time.perf_counter() - t0
+
+    stages: Dict[str, List[Config]] = {"B0_official": b0}
+    stats: Dict[str, Any] = {
+        "requested_max_stage": max_stage,
+        "generated_through_stage": "B0_official",
+        "official": len(b0), "expansion_seed_full": search_seed_full_count,
+        "expansion_seed_used": len(search_seed), "expansion_seed_limit": seed_limit,
+        "s1_generated": 0, "s1_new": 0,
+        "s2_generated": 0, "s2_new": 0, "s3_generated": 0, "s3_new": 0,
+        "b1": None, "b2": None, "b3": None,
+        "s3_no_op": None, "tunable_parameters": list(spaces),
+        "selection_mode": ("model_free_generation" if generation_only else str(opts.get("selection_mode", "pareto"))),
+        "retain_all_generated": retain_all_generated,
+        "generation_only": generation_only,
+        "parameter_domains": spaces,
+        "evolution": {"generations": generations, "parent_k": parent_k,
+                      "population": population_k, "generation_stats": [],
+                      "patience": int(opts.get("evolution_patience", 1)),
+                      "min_generations": int(opts.get("evolution_min_generations", 2)),
+                      "min_new_children": int(opts.get("evolution_min_new_children", 4)),
+                      "min_relative_improvement": float(opts.get("evolution_min_relative_improvement", 0.005)),
+                      "cost_model": None},
+        "modeling": {"light_ttir_enabled": (False if generation_only else bool(opts.get("enable_light_ttir", True))),
+                     "light_operator_family": str(opts.get("operator_family", "generic")),
+                     "formal_model_configured": callable(opts.get("formal_cost_model") or opts.get("cost_model")),
+                     "capacity_policy": ("model_free_generation_no_model_prune" if generation_only
+                                         else "light_soft_risk_formal_hard_prune"),
+                     "light_guided_expansion": (False if generation_only else bool(opts.get("enable_light_guided_expansion", True))),
+                     "generation_only_no_model_scoring": generation_only},
+        "predicted_costs": {"s1": {}, "s2": {}, "s3": {}, "all": {}},
+        "timings_s": timings,
+    }
+
+    def finalize(final_pool: Sequence[Config]) -> Tuple[Dict[str, List[Config]], Dict[str, Any]]:
+        stats["covered_values"] = {
+            name: sorted({c.kwargs.get(name) for c in final_pool if isinstance(c.kwargs.get(name), int)})
+            for name in spaces
+        }
+        if target_idx > 0 and not generation_only:
+            stats["predicted_costs"]["all"] = {
+                str(_sig(c)): float(_score(c, all_args, opts)) for c in final_pool
+            }
+        stats["executed_stage_names"] = list(stages)
+        stats["model_runtime"] = dict(opts.get("_runtime_model_stats", {}))
+        provider = opts.get("light_ttir_template_provider")
+        if provider is not None:
+            stats["kernel_template_cache_size"] = getattr(provider, "cache_size", None)
+            stats["kernel_template_failures"] = dict(getattr(provider, "failures", {}))
+        formal = opts.get("formal_cost_model") or opts.get("cost_model")
+        if formal is not None:
+            stats["formal_model_failures"] = dict(getattr(formal, "failures", {}))
+        return stages, stats
+
+    if target_idx == 0:
+        return finalize(b0)
+
+    opts["_model_stage"] = "generation" if generation_only else "light"
+    t0 = time.perf_counter()
+    # S1: auditable local/multiscale families. Index offsets are local in the
+    # ordered legal domain; multiplicative and numeric steps are separate.
+    local_offsets = tuple(int(v) for v in opts.get("s1_local_offsets", (-1, 1)))
+    pair_offsets = tuple(int(v) for v in opts.get("s1_pair_offsets", (-1, 1)))
+    scale_factors = tuple(float(v) for v in opts.get("s1_scale_factors", (0.5, 0.75, 1.25, 1.5, 2.0)))
+    numeric_steps = tuple(int(v) for v in opts.get("s1_numeric_steps", (8, 16, 32)))
+    small_bm_budget = max(0, int(opts.get("s1_small_bm_budget", 8)))
+    per_seed_budget = max(4, int(opts.get("s1_generation_per_seed", 48)))
+    guided_fraction = min(1.0, max(0.0, float(opts.get("s1_guided_fraction", 0.60))))
+    symmetric_fraction = min(1.0 - guided_fraction, max(0.0, float(opts.get("s1_symmetric_fraction", 0.30))))
+    s1_candidates: List[Config] = []
+    for cfg in search_seed:
+        if generation_only:
+            # Accuracy-audit mode: S1 is pure structural generation.  No Light
+            # TTIR or formal score is allowed to influence which configs enter
+            # the evaluation pool.  The existing per-seed budget remains as a
+            # deterministic engineering bound, not a model-driven prune.
+            symmetric = _dedupe(
+                _mutate_one(cfg, spaces, local_offsets, scale_factors, numeric_steps)
+                + _pairwise_local(cfg, spaces, pair_offsets)
+            )
+            s1_candidates.extend(sorted(symmetric, key=_sig)[:per_seed_budget])
+            continue
+        guided_spaces = _light_guided_spaces(cfg, spaces, all_args, opts)
+        guided = _dedupe(
+            _mutate_one(cfg, guided_spaces, local_offsets, scale_factors, numeric_steps)
+            + _pairwise_local(cfg, guided_spaces, pair_offsets)
+        )
+        symmetric = _dedupe(
+            _mutate_one(cfg, spaces, local_offsets, scale_factors, numeric_steps)
+            + _pairwise_local(cfg, spaces, pair_offsets)
+        )
+        guided_budget = max(1, int(round(per_seed_budget * guided_fraction)))
+        symmetric_budget = max(1, int(round(per_seed_budget * symmetric_fraction)))
+        guided = sorted(guided, key=_sig)[:guided_budget]
+        guided_sigs = {_sig(c) for c in guided}
+        symmetric = [c for c in sorted(symmetric, key=_sig) if _sig(c) not in guided_sigs][:symmetric_budget]
+        s1_candidates.extend(guided)
+        s1_candidates.extend(symmetric)
+    s1_candidates.extend(_structural_anchors(search_seed, spaces, small_bm_budget, opts))
+    s1_all = _novel(search_seed, s1_candidates, all_args)
+
+    # Mainline S1 uses Light TTIR preselection. Accuracy-audit generation-only
+    # mode deliberately bypasses all model scoring and retains the generated
+    # structural pool after legality/deduplication.
+    if generation_only:
+        s1_preselection = None
+        s1_scores = {}
+        s1_new = list(s1_all)
+    else:
+        s1_opts = _light_mode_options(opts, "universal")
+        s1_opts["light_s1_max_candidates"] = s1_limit
+        s1_preselection = evaluate_light_ttir_s1(s1_all, all_args, s1_opts)
+        s1_scores = {
+            cfg: float(s1_preselection.universal.score[i])
+            for i, cfg in enumerate(s1_all)
+        }
+        s1_new = list(s1_all) if retain_all_generated else [
+            s1_all[i] for i in s1_preselection.indices
+        ]
+    b1 = _dedupe(b0 + _ta_project_strict_domains_final(search_seed + s1_new, opts))
+    b1 = _ta_balance_parameter_domains_final(b1, opts)
+    stages["B1_plus_s1"] = b1
+    timings["s1_generation_s"] = time.perf_counter() - t0
+    stats.update({"s1_generated": len(s1_all), "s1_new": len(s1_new), "b1": len(b1),
+                  "generated_through_stage": "B1_plus_s1",
+                  "s1_strategy": {"type": "structured_multiscale_local",
+                                  "domain_index_offsets": list(local_offsets),
+                                  "scale_factors": list(scale_factors),
+                                  "numeric_steps": list(numeric_steps),
+                                  "pairwise_offsets": list(pair_offsets),
+                                  "small_block_m_anchors": [1, 2, 4, 8],
+                                  "small_block_m_budget": small_bm_budget,
+                                  "generation_per_seed": per_seed_budget,
+                                  "guided_fraction": guided_fraction,
+                                  "symmetric_fraction": symmetric_fraction,
+                                  "anchor_scope": "per_structural_family",
+                                  "preselection": ("disabled_generation_only" if generation_only
+                                                   else "universal_full_pool")}})
+    if generation_only:
+        stats["light_ttir_preselection_s1"] = {
+            "policy": "disabled_generation_only", "evaluated": 0,
+            "selected": len(s1_new), "residual_evaluated": 0,
+        }
+        stats["light_ttir_reports_s1"] = {}
+    else:
+        stats["light_ttir_preselection_s1"] = {
+            "policy": ("retain_all_generated" if retain_all_generated else s1_preselection.policy),
+            "target_fraction": float(s1_preselection.target_fraction),
+            "evaluated": len(s1_all),
+            "selected": len(s1_new),
+            "residual_evaluated": 0,
+        }
+        stats["predicted_costs"]["s1"] = {str(_sig(c)): float(s1_scores[c]) for c in s1_new}
+        stats["light_ttir_reports_s1"] = {}
+        for c in s1_new:
+            report = _light_report(c, all_args, opts, score_mode="universal")
+            stats["light_ttir_reports_s1"][str(_sig(c))] = report.to_dict() if report else None
+    if target_idx == 1:
+        return finalize(b1)
+
+    t0 = time.perf_counter()
+    # S2: build a bounded resource-coverage reservoir, then use the same staged
+    # Light TTIR contract as the standalone API: Universal on the whole S2
+    # cohort, residual only on its S1 survivors, and final selection from that
+    # survivor subset.  Universal arrays are reused inside evaluate_light_ttir_s2.
+    s2_candidates, resource_stats = _resource_aware_candidates(b1, spaces, all_args, opts)
+    s2_all = _novel(b1, s2_candidates, all_args)
+    if generation_only:
+        s2_opts = {}
+        s2_s1 = None
+        s2_preselection = None
+        s2_new = list(s2_all)
+        s2_scores = {}
+    else:
+        s2_opts = _light_mode_options(opts, "auto")
+        s2_opts["light_s2_max_candidates"] = s2_limit
+        s2_s1 = evaluate_light_ttir_s1(s2_all, all_args, s2_opts)
+        if retain_all_generated:
+            # Retain-all is an explicit ablation.  Evaluate the full Hybrid pool
+            # once, but do not also run the subset residual path.
+            s2_preselection = None
+            s2_new = list(s2_all)
+            hybrid_numeric = evaluate_light_ttir_scores_batch(
+                s2_all, all_args, _light_mode_options(opts, "hybrid")
+            )
+            s2_scores = {cfg: float(hybrid_numeric.score[i]) for i, cfg in enumerate(s2_all)}
+        else:
+            s2_preselection = evaluate_light_ttir_s2(s2_all, all_args, s2_s1, s2_opts)
+            s2_new = [s2_all[i] for i in s2_preselection.selected_indices]
+            s2_scores = {}
+            for i, cfg in enumerate(s2_all):
+                hybrid = float(s2_preselection.hybrid_scores[i])
+                s2_scores[cfg] = (hybrid if math.isfinite(hybrid)
+                                  else float(s2_preselection.universal.score[i]))
+    b2 = _ta_project_strict_domains_final(b1 + s2_new, opts)
+    b2 = _ta_balance_parameter_domains_final(b2, opts)
+    stages["B2_plus_s2"] = b2
+    timings["s2_generation_s"] = time.perf_counter() - t0
+    stats.update({"s2_generated": len(s2_all), "s2_new": len(s2_new), "b2": len(b2),
+                  "generated_through_stage": "B2_plus_s2",
+                  "s2_strategy": ("resource_coverage_then_deterministic_diversity" if generation_only
+                                  else "resource_coverage_then_s1_universal_s2_residual"),
+                  "s2_resource_coverage": resource_stats})
+    if generation_only:
+        stats["light_ttir_preselection_s2"] = {
+            "policy": "disabled_generation_only", "universal_evaluated": 0,
+            "s1_survivors": 0, "residual_evaluated": 0, "selected": len(s2_new),
+        }
+        stats["light_ttir_reports_s2"] = {}
+    else:
+        stats["light_ttir_preselection_s2"] = {
+            "policy": ("retain_all_generated" if retain_all_generated else s2_preselection.policy),
+            "s1_target_fraction": float(s2_s1.target_fraction),
+            "s2_target_fraction": (1.0 if retain_all_generated else float(s2_preselection.s2_target_fraction)),
+            "universal_evaluated": len(s2_all),
+            "s1_survivors": len(s2_s1.indices),
+            "residual_evaluated": (len(s2_all) if retain_all_generated
+                                   else int(s2_preselection.hybrid_evaluated)),
+            "selected": len(s2_new),
+        }
+        stats["predicted_costs"]["s2"] = {str(_sig(c)): float(s2_scores[c]) for c in s2_new}
+        stats["light_ttir_reports_s2"] = {}
+        for c in s2_new:
+            report = _light_report(c, all_args, opts, score_mode="hybrid")
+            stats["light_ttir_reports_s2"][str(_sig(c))] = report.to_dict() if report else None
+    if target_idx == 2:
+        return finalize(b2)
+
+    if generation_only:
+        # S3 accuracy-audit mode keeps the structural intent (single-axis,
+        # multi-axis, crossover, factorial interactions) but performs no
+        # Light-TTIR/formal scoring. This avoids circularly selecting the pool
+        # with the same model that will later be evaluated against hardware.
+        t0 = time.perf_counter()
+        population = _diverse_seed_subset(b2, list(spaces), max(1, population_k))
+        factorial_reserved = _novel(b2, _model_free_factorial_candidates(b2, spaces, opts), all_args)
+        factorial_quota = max(0, int(opts.get("s3_factorial_reserve", min(32, s3_limit))))
+        factorial_reserved = factorial_reserved[:factorial_quota]
+        generated_s3: List[Config] = list(factorial_reserved)
+        generation_stats = []
+        for generation in range(max(0, generations)):
+            parents = _diverse_seed_subset(population, list(spaces), max(1, parent_k))
+            children: List[Config] = []
+            multi_axis_per_parent = max(0, int(opts.get("s3_multi_axis_per_parent", max(2, mutation_per_parent // 2))))
+            for parent in parents:
+                children.extend(_model_free_single_axis_mutations(parent, spaces, mutation_per_parent))
+                children.extend(_model_free_multi_axis_mutations(parent, spaces, opts, multi_axis_per_parent))
+            children.extend(_cross(parents, list(spaces), max_pairs=max(1, parent_k * 2), rng=rng,
+                                   min_distance=float(opts.get("min_crossover_distance", 1.0))))
+            children = _novel(b2 + generated_s3, children, all_args)
+            generated_s3.extend(children)
+            population = _diverse_seed_subset(_dedupe(population + children), list(spaces), max(1, population_k))
+            generation_stats.append({
+                "generation": generation + 1, "parents": len(parents),
+                "children": len(children), "survivors": len(population),
+                "best_predicted_cost": None, "relative_improvement": None,
+            })
+            if not children:
+                generation_stats[-1]["early_stop"] = True
+                break
+        s3_all = _novel(b2, generated_s3, all_args)
+        s3_new = _diverse_seed_subset(s3_all, list(spaces), min(s3_limit, len(s3_all))) if s3_limit > 0 else list(s3_all)
+        b3 = _ta_project_strict_domains_final(b2 + s3_new, opts)
+        b3 = _ta_balance_parameter_domains_final(b3, opts)
+        stages["B3_plus_s3"] = b3
+        timings["s3_evolution_s"] = time.perf_counter() - t0
+        stats.update({
+            "s3_generated": len(s3_all), "s3_new": len(s3_new), "b3": len(b3),
+            "s3_no_op": len(s3_new) == 0, "generated_through_stage": "B3_plus_s3",
+            "s3_strategy": "model_free_single_multi_axis_crossover_factorial_generation",
+            "s3_factorial_generated": len(factorial_reserved),
+            "s3_factorial_reserved": len(factorial_reserved),
+        })
+        stats["evolution"]["cost_model"] = "none_generation_only"
+        stats["evolution"]["generation_stats"] = generation_stats
+        return finalize(b3)
+
+    # S3 is a higher-order search stage, not intrinsically a formal-model
+    # stage.  Keep the historical formal behavior as the default, while
+    # allowing the same production Light TTIR model used by S1/S2 to guide
+    # mutation, crossover and survivor selection.  This is useful for the
+    # independent-oracle experiment where search must not read formal scores.
+    s3_score_model = str(opts.get("s3_score_model", "formal")).strip().lower()
+    if s3_score_model not in {"formal", "light"}:
+        raise ValueError(
+            f"Unknown s3_score_model={s3_score_model!r}; expected 'formal' or 'light'"
+        )
+    opts["_model_stage"] = s3_score_model
+    if s3_score_model == "light":
+        opts["light_score_mode"] = str(opts.get("s3_light_score_mode", "hybrid"))
+        stats["evolution"]["cost_model"] = "light_ttir"
+    elif callable(opts.get("formal_cost_model") or opts.get("cost_model")):
+        stats["evolution"]["cost_model"] = "online_or_external_formal"
+    elif bool(opts.get("allow_analytic_formal_fallback", True)):
+        stats["evolution"]["cost_model"] = "legacy_analytic_fallback"
+    else:
+        stats["evolution"]["cost_model"] = "formal_model_required"
+    t0 = time.perf_counter()
+    population_scores = {c: _score(c, all_args, opts) for c in b2}
+    population = _select(b2, population_scores, list(spaces), population_k, all_args, opts)
+    factorial_reserved = _novel(
+        b2, _marginal_factorial_candidates(b2, spaces, population_scores, opts), all_args
+    )
+    factorial_quota = max(0, int(opts.get("s3_factorial_reserve", min(32, s3_limit))))
+    factorial_reserved = factorial_reserved[:factorial_quota]
+    generated_s3: List[Config] = list(factorial_reserved)
+    generation_stats = []
+    patience = max(0, int(opts.get("evolution_patience", 1)))
+    min_generations = max(0, int(opts.get("evolution_min_generations", 2)))
+    min_new_children = max(0, int(opts.get("evolution_min_new_children", 4)))
+    min_relative_improvement = max(0.0, float(opts.get("evolution_min_relative_improvement", 0.005)))
+    stale_generations = 0
+    previous_best = min(population_scores.values()) if population_scores else math.inf
+    for generation in range(max(0, generations)):
+        scores = {c: _score(c, all_args, opts) for c in population}
+        parents = _select(population, scores, list(spaces), max(1, parent_k), all_args, opts)
+        children: List[Config] = []
+        multi_axis_per_parent = max(0, int(opts.get("s3_multi_axis_per_parent", max(2, mutation_per_parent // 2))))
+        for parent in parents:
+            children.extend(_cost_guided_mutations(parent, spaces, all_args, opts, mutation_per_parent))
+            children.extend(_direct_multi_axis_mutations(
+                parent, spaces, all_args, opts, multi_axis_per_parent
+            ))
+        children.extend(_cross(parents, list(spaces), max_pairs=max(1, parent_k * 2), rng=rng,
+                               min_distance=float(opts.get("min_crossover_distance", 1.0))))
+        children = _novel(b2 + generated_s3, children, all_args)
+        generated_s3.extend(children)
+        union = _dedupe(population + children)
+        union_scores = {c: _score(c, all_args, opts) for c in union}
+        population = _select(union, union_scores, list(spaces), population_k, all_args, opts)
+        best_cost = min(union_scores.values()) if union_scores else math.inf
+        relative_improvement = ((previous_best - best_cost) / max(abs(previous_best), 1e-12)
+                                if math.isfinite(previous_best) else math.inf)
+        converged = len(children) < min_new_children or relative_improvement < min_relative_improvement
+        stale_generations = stale_generations + 1 if converged else 0
+        generation_stats.append({
+            "generation": generation + 1, "parents": len(parents),
+            "children": len(children), "survivors": len(population),
+            "best_predicted_cost": best_cost if math.isfinite(best_cost) else None,
+            "relative_improvement": relative_improvement if math.isfinite(relative_improvement) else None,
+            "stale_generations": stale_generations,
+        })
+        previous_best = min(previous_best, best_cost)
+        if patience > 0 and generation + 1 >= min_generations and stale_generations >= patience:
+            generation_stats[-1]["early_stop"] = True
+            break
+    s3_all = _novel(b2, generated_s3, all_args)
+    s3_scores = {c: _score(c, all_args, opts) for c in s3_all}
+    if retain_all_generated:
+        s3_new = list(s3_all)
+    else:
+        reserved = [cfg for cfg in factorial_reserved if cfg in s3_scores]
+        reserve_sigs = {_sig(cfg) for cfg in reserved}
+        residual = [cfg for cfg in s3_all if _sig(cfg) not in reserve_sigs]
+        selected = _select(
+            residual, s3_scores, list(spaces), max(0, s3_limit - len(reserved)), all_args, opts
+        )
+        s3_new = _dedupe(reserved + selected)[:s3_limit]
+    b3 = _ta_project_strict_domains_final(b2 + s3_new, opts)
+    b3 = _ta_balance_parameter_domains_final(b3, opts)
+    stages["B3_plus_s3"] = b3
+    timings["s3_evolution_s"] = time.perf_counter() - t0
+    stats.update({"s3_generated": len(s3_all), "s3_new": len(s3_new), "b3": len(b3),
+                  "s3_no_op": len(s3_new) == 0, "generated_through_stage": "B3_plus_s3",
+                  "s3_strategy": "pareto_evolution_with_single_multi_axis_and_marginal_factorial_mutation",
+                  "s3_factorial_generated": len(factorial_reserved),
+                  "s3_factorial_reserved": len([c for c in s3_new if _sig(c) in {_sig(x) for x in factorial_reserved}])})
+    stats["evolution"]["generation_stats"] = generation_stats
+    stats["predicted_costs"]["s3"] = {str(_sig(c)): float(s3_scores[c]) for c in s3_new}
+    return finalize(b3)
