+from native_autotune_v65 import _bootstrap_budget_count, _select_bootstrap_rows, _continuation_value_metrics, _continuation_value_gate
+from backend.runtime.search_space_v6 import infer_search_space
+
+
+def test_v65_search_entitlement_prevents_safe_frontier_from_becoming_novel_zero():
+    ref={'autotune_core_wall_s':4.6,'per_candidate_cost_seed_s':2.0,'official_count':4}
+    n,meta=_bootstrap_budget_count(available=3,max_count=2,min_count=1,official_reference=ref,
+        max_relative_overhead_pct=30.0,marginal_cost_discount=1.0,safety_factor=1.15)
+    assert meta['affordable'] == 0
+    assert n == 1
+
+
+def test_v65_budget_can_use_two_unified_bootstrap_candidates_when_affordable():
+    ref={'autotune_core_wall_s':14.0,'per_candidate_cost_seed_s':1.4,'official_count':9}
+    n,meta=_bootstrap_budget_count(available=9,max_count=2,min_count=1,official_reference=ref,
+        max_relative_overhead_pct=30.0,marginal_cost_discount=0.65,safety_factor=1.15)
+    assert meta['affordable'] >= 2
+    assert n == 2
+
+
+def test_v65_bootstrap_value_first_then_structural_diversity():
+    rows=[
+      {'config':{'X':0},'proposal_rank':1,'source_prior_rank':1,'v6_relative':{'opportunity_score':0.9,'multiview_confidence':0.9}},
+      {'config':{'X':1},'proposal_rank':2,'source_prior_rank':2,'v6_relative':{'opportunity_score':0.8,'multiview_confidence':0.9}},
+      {'config':{'X':10},'proposal_rank':3,'source_prior_rank':3,'v6_relative':{'opportunity_score':0.7,'multiview_confidence':0.8}},
+    ]
+    sp=infer_search_space([{'X':0}],[r['config'] for r in rows],parameter_domains={'X':[0,1,10]},tunable_parameters=['X'])
+    selected=_select_bootstrap_rows(rows,search_space=sp,count=2,min_distance=0.6)
+    assert selected[0]['config']=={'X':0}
+    assert selected[1]['config']=={'X':10}
+
+
+def test_v65_bootstrap_distance_is_preference_not_prune():
+    rows=[
+      {'config':{'X':0},'proposal_rank':1,'source_prior_rank':1,'v6_relative':{'opportunity_score':0.9,'multiview_confidence':0.9}},
+      {'config':{'X':1},'proposal_rank':2,'source_prior_rank':2,'v6_relative':{'opportunity_score':0.8,'multiview_confidence':0.8}},
+    ]
+    sp=infer_search_space([{'X':0}],[r['config'] for r in rows],parameter_domains={'X':[0,1]},tunable_parameters=['X'])
+    selected=_select_bootstrap_rows(rows,search_space=sp,count=2,min_distance=2.0)
+    assert len(selected)==2
+
+
+class _FakeController:
+    def __init__(self, predicted_ms, optimistic_ms, sigma_log=0.2):
+        self._e={'predicted_ms':predicted_ms,'optimistic_ms':optimistic_ms,'sigma_log':sigma_log,'nearest_distance':0.3}
+    def estimate(self, row):
+        return dict(self._e)
+
+
+def test_v65_value_per_cost_uses_current_run_prediction_and_compile_cost():
+    row={'config':{'X':1},'v6_relative':{'opportunity_score':0.8,'multiview_confidence':0.8}}
+    m=_continuation_value_metrics(row,controller=_FakeController(0.95,0.90),incumbent_ms=1.0,expected_candidate_cost_s=2.0)
