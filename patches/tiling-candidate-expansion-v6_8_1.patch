+"""NumPy hot path for Light TTIR.
+
+The module computes numeric fields first and never allocates per-candidate
+reports.  ``light_ttir_model`` materializes reports from these arrays only when
+diagnostics are requested.  This keeps score-only S1/S2 selection cheap while
+preserving one mathematical source of truth.
+"""
+from __future__ import annotations
+
+from typing import Any, Mapping, Sequence
+import math
+
+import numpy as np
+
+
+def _cfg_array(configs: Sequence[Any], names: Sequence[str], default: int) -> np.ndarray:
+    out = np.empty(len(configs), dtype=np.int64)
+    for i, cfg in enumerate(configs):
+        kwargs = getattr(cfg, "kwargs", {}) or {}
+        value = default
+        for name in names:
+            candidate = kwargs.get(name)
+            if isinstance(candidate, int) and candidate > 0:
+                value = candidate
+                break
+        out[i] = max(1, int(value))
+    return out
+
+
+def _attr_array(configs: Sequence[Any], name: str, default: int) -> np.ndarray:
+    return np.fromiter(
+        (max(1, int(getattr(cfg, name, default) or default)) for cfg in configs),
+        dtype=np.int64, count=len(configs),
+    )
+
+
+def _ceil_div(a: int | np.ndarray, b: np.ndarray) -> np.ndarray:
+    return (a + b - 1) // b
+
+
+def _arg_int(args: Mapping[str, Any], names: Sequence[str], default: int = 1) -> int:
+    for name in names:
+        value = args.get(name)
+        if isinstance(value, int) and value > 0:
+            return int(value)
+    return max(1, int(default))
+
+
+def _bucket_array(values: np.ndarray, cuts: Sequence[float]) -> np.ndarray:
+    return np.searchsorted(np.asarray(cuts, dtype=np.float64), values, side="right").astype(np.int16)
+
+
+def _effective_cores(configs: Sequence[Any], options: Mapping[str, Any]) -> np.ndarray:
+    """Return per-config active AI-core counts, capped by physical hardware.
+
+    Kernels such as flash_attention_dev expose ``AICORE_NUM`` as a
+    ``tl.constexpr`` and launch ``grid=(AICORE_NUM,)``.  Treating every config
+    as if it used all physical cores makes core-count search a no-op and gives
+    incorrect wave/imbalance features.  Missing metadata conservatively falls
+    back to the detected/profile physical core count.
+    """
+    physical = max(1, int(options.get("num_cores", 20)))
+    parameter = str(options.get("light_effective_core_parameter", "AICORE_NUM"))
+    requested = _cfg_array(configs, (parameter,), physical)
+    return np.clip(requested, 1, physical).astype(np.int64, copy=False)
+
+
+def _grid(programs: np.ndarray, cores: int | np.ndarray):
+    programs = np.maximum(1, programs.astype(np.int64, copy=False))
+    core_array = np.asarray(cores, dtype=np.int64)
+    if core_array.ndim == 0:
+        core_array = np.full_like(programs, max(1, int(core_array)))
+    else:
+        core_array = np.maximum(1, np.broadcast_to(core_array, programs.shape))
+    active = np.minimum(programs, core_array)
+    ratio = active.astype(np.float64) / core_array.astype(np.float64)
+    mtp = _ceil_div(programs, core_array)
+    assigned = np.maximum(1, mtp * core_array)
+    imbalance = np.maximum(0.0, (assigned - programs) / assigned)
+    return ratio, imbalance, mtp
+
+
+def _metadata(template: Any, n: int) -> dict[str, Any]:
+    return {
+        "template_family": getattr(template, "family_key", ()),
+        "template_sha256": str(getattr(template, "ttir_sha256", "")),
+        "template_extractor": str(getattr(template, "extractor", "generic")),
+        "template_confidence": float(getattr(template, "confidence", 0.0)),
+        "template_unknown_ops": tuple(getattr(template, "unknown_tt_ops", ()) or ()),
+        "n": n,
+    }
+
+
+def _base_result(n: int) -> dict[str, Any]:
+    z = np.zeros(n, dtype=np.float64)
+    return {
+        "score": z.copy(), "grid_time": z.copy(), "cube_time": z.copy(),
+        "vector_time": z.copy(), "mte_time": z.copy(), "loop_overhead": z.copy(),
+        "handoff_overhead": z.copy(), "tail_penalty": z.copy(),
+        "imbalance_penalty": z.copy(), "capacity_risk": z.copy(),
+        "active_program_ratio": z.copy(), "load_imbalance": z.copy(),
+        "max_tiles_per_program": np.ones(n, dtype=np.int64),
+        "loop_count": np.ones(n, dtype=np.int64), "memory_redundancy": np.ones(n),
+        "ub_peak_bytes": z.copy(), "ub_utilization": z.copy(),
+        "ub_headroom_bytes": z.copy(), "tail_waste": z.copy(),
+        "bottleneck_id": np.zeros(n, dtype=np.int16),
+        "base_bottleneck_id": np.zeros(n, dtype=np.int16),
+        "fused_bottleneck_id": np.zeros(n, dtype=np.int16), "confidence": z.copy(),
+        "structural_signature": np.zeros((n, 5), dtype=np.int16),
+        "level1_region": np.zeros((n, 3), dtype=np.int16),
+        "base_score": z.copy(), "specialized_score": z.copy(),
+        "residual_score": z.copy(), "residual_weight": z.copy(),
+    }
+
+
+def _finalize(result: dict[str, Any], options: Mapping[str, Any], template: Any,
+              *, confidence_cap: float | None = None) -> dict[str, Any]:
+    n = len(result["score"])
+    threshold_parallel = float(options.get("light_under_parallel_threshold", 0.75))
+    threshold_buffer = float(options.get("light_near_capacity_threshold", 0.85))
+    comp = np.stack([result["cube_time"], result["vector_time"], result["mte_time"]], axis=1)
+    # IDs: grid=0, cube=1, vector=2, mte=3, buffer=4.
+    bottleneck = np.argmax(comp, axis=1).astype(np.int16) + 1
+    bottleneck = np.where(result["active_program_ratio"] < threshold_parallel, 0, bottleneck)
+    bottleneck = np.where(result["ub_utilization"] >= threshold_buffer, 4, bottleneck).astype(np.int16)
+    result["bottleneck_id"] = bottleneck
+    result["base_bottleneck_id"] = bottleneck.copy()
+    result["fused_bottleneck_id"] = bottleneck.copy()
+
+    conf = np.full(n, float(getattr(template, "confidence", 0.45)), dtype=np.float64)
+    conf -= np.where(result["ub_utilization"] >= 0.85, 0.10, 0.0)
+    if bool(options.get("light_template_out_of_domain", False)):
+        conf -= 0.35
+    if bool(options.get("light_unknown_opcode", False)):
+        conf -= 0.25
+    if confidence_cap is not None:
+        conf = np.minimum(conf, confidence_cap)
+    # Provisional hardware profiles are intentionally less trusted.  A measured
+    # calibration file may provide a monotone piecewise mapping from raw model
+    # confidence to observed Top-K retention reliability.
+    if str(options.get("_light_calibration_version", "")).startswith("provisional"):
+        conf = np.minimum(conf, float(options.get("light_provisional_confidence_cap", 0.70)))
+    reliability = options.get("light_confidence_reliability_map", ())
+    if reliability:
+        pairs = sorted((float(x), float(y)) for x, y in reliability)
+        xp = np.asarray([x for x, _ in pairs], dtype=np.float64)
+        fp = np.asarray([y for _, y in pairs], dtype=np.float64)
+        conf = np.interp(conf, xp, fp, left=fp[0], right=fp[-1])
+    result["confidence"] = np.clip(conf, 0.05, 1.0)
+
+    grid_state = np.where(result["active_program_ratio"] < 0.75, 0,
+                          np.where(result["load_imbalance"] > 0.10, 2, 1)).astype(np.int16)
+    loop_state = _bucket_array(result["loop_count"].astype(np.float64), (2, 5, 9, 17))
+    pressure = _bucket_array(result["ub_utilization"], (0.65, 0.85, 1.0))
+    tail = _bucket_array(result["tail_waste"], (0.10, 0.30))
+    result["structural_signature"] = np.stack(
+        [grid_state, loop_state, bottleneck, pressure, tail], axis=1).astype(np.int16)
+    result["level1_region"] = np.stack([grid_state, loop_state, bottleneck], axis=1).astype(np.int16)
+    result.update(_metadata(template, n))
+    return result
+
+
+def _rates(options: Mapping[str, Any]) -> dict[str, float]:
+    return {
+        "cube": max(1.0, float(options.get("light_cube_ops_per_us", 3.2e8))),
+        "elem": max(1.0, float(options.get("light_vector_elementwise_ops_per_us", 8.0e7))),
+        "exp": max(1.0, float(options.get("light_vector_exp_ops_per_us", 1.2e7))),
+        "reduce": max(1.0, float(options.get("light_vector_reduce_ops_per_us", 2.0e7))),
+        "mask": max(1.0, float(options.get("light_vector_mask_ops_per_us", 6.0e7))),
+        "mte": max(1.0, float(options.get("light_mte_bytes_per_us", 2.0e5))),
+    }
+
+
+def universal_batch(configs: Sequence[Any], all_args: Mapping[str, Any], options: Mapping[str, Any],
+                    template: Any, static_analysis: tuple[Any, Any, Any]) -> dict[str, Any]:
+    n = len(configs)
+    r = _base_result(n)
+    dag, memory, features = static_analysis
+    rates = _rates(options)
+    cores = _effective_cores(configs, options)
+    dtype = max(1, int(options.get("dtype_bytes", 2)))
+    ub_capacity = float(options.get("ub_capacity_bytes", 256 * 1024))
+    counts = dict(getattr(template, "operation_counts", {}) or {})
+    lowered = {str(k).lower(): int(v) for k, v in counts.items()}
+    dot = sum(v for k, v in lowered.items() if "dot" in k or "mma" in k)
+    reduce = sum(v for k, v in lowered.items() if "reduce" in k)
+    exp = sum(v for k, v in lowered.items() if "exp" in k)
+    atomic = sum(v for k, v in lowered.items() if "atomic" in k)
+    vector = sum(v for k, v in lowered.items() if k.startswith(("arith.", "math.")) or any(t in k for t in ("exp", "reduce", "add", "mul", "div", "sub", "where", "extern_elementwise")))
+    loads = sum(v for k, v in lowered.items() if "load" in k)
+    stores = sum(v for k, v in lowered.items() if "store" in k)
+    attention = dot >= 2 and (reduce > 0 or exp > 0)
+    dot_motif = dot > 0 and not attention
+    reduce_motif = reduce > 0 and dot == 0
+    bandwidth_scale = max(0.05, float(getattr(memory, "bandwidth_scale", 1.0)))
+    # The static pointer analysis is a confidence signal for attainable MTE
+    # bandwidth, not a licence to remove traffic.  For regular attention
+    # pointers the embedded vTriton calibration corresponds to roughly 42% of
+    # the sustained GM/L1 bandwidth; irregular kernels retain the conservative
+    # raw scale from the memory analyzer.
+    pointer_confidence = max(0.0, min(1.0, float(getattr(memory, "pointer_confidence", 0.0))))
+    effective_bw = rates["mte"] * bandwidth_scale
+
+    if attention:
+        bm = _cfg_array(configs, ("BLOCK_M", "BM"), 32)
+        bn = _cfg_array(configs, ("BLOCK_N", "BN"), 32)
+        nq = _arg_int(all_args, ("MAX_Q_LEN", "NQ", "N_CTX", "N"), 1)
+        nk = _arg_int(all_args, ("MAX_K_LEN", "NK", "N_CTX"), nq)
+        hd = _arg_int(all_args, ("HEAD_DIM", "QK_DIM"), 64)
+        z = _arg_int(all_args, ("Z", "BATCH"), 1)
+        heads = _arg_int(all_args, ("H", "HEADS"), 1)
+        causal = bool(all_args.get("CAUSAL", all_args.get("causal", False)))
+        programs = _ceil_div(nq, bm) * z * heads
+        loops = _ceil_div(nk, bn)
+        active, imbalance, mtp = _grid(programs, cores)
+        iters = loops * mtp
+        area = bm * bn
+        cube = max(1, dot) * 2.0 * area * hd * iters / rates["cube"]
+        universal_vector_rate = max(1.0, float(options.get("light_universal_vector_ops_per_us", rates["elem"])))
+        vector_factor = max(1, vector + atomic)
+        if causal:
+            vector_factor = max(vector_factor, int(options.get("light_fa_causal_vector_factor", 7)))
+        else:
+            vector_factor = max(1, min(vector_factor, int(options.get("light_fa_noncausal_vector_factor", 6))))
+        vec = vector_factor * area * iters / universal_vector_rate
+        q_bytes = bm * hd * dtype
+        kv_bytes = 2.0 * bn * hd * dtype
+        out_bytes = bm * hd * 4.0
+        per_program_bytes = q_bytes * mtp + kv_bytes * iters + out_bytes * mtp
+        # Account for inter-program L2/cache reuse without assuming perfect
+        # reuse.  The confidence-gated credit removes the previous systematic
+        # bias toward the largest BLOCK_M while retaining a conservative share
+        # of K/V reload traffic.
+        # Do not assume cross-program K/V cache reuse in the conservative
+        # universal bound.  Such reuse is device/cache-state dependent and was
+        # the main cause of underestimating small BLOCK_M traffic.  A calibrated
+        # environment may opt in with a bounded credit.
+        reuse_credit = max(0.0, min(0.50, float(options.get("light_fa_kv_reuse_credit", 0.0))))
+        reuse_credit *= pointer_confidence
+        attention_bw_scale = max(
+            bandwidth_scale,
+            min(1.0, bandwidth_scale + pointer_confidence * float(
+                options.get("light_fa_pointer_bandwidth_credit", 0.17)
+            )),
+        )
+        attention_effective_bw = rates["mte"] * attention_bw_scale
+        ideal_kv = (2.0 * nk * hd * dtype) * np.maximum(1.0, mtp / np.maximum(1.0, programs / cores))
+        kv_actual = kv_bytes * iters
+        issued = q_bytes * mtp + out_bytes * mtp + (1.0 - reuse_credit) * kv_actual + reuse_credit * ideal_kv
+        mte = issued / attention_effective_bw
+        useful_pairs = nq * nk * (0.5 if causal else 1.0)
+        issued_pairs = _ceil_div(nq, bm) * bm * _ceil_div(nk, bn) * bn
+        tail = np.maximum(0.0, 1.0 - useful_pairs / np.maximum(1.0, issued_pairs))
+        redundancy = issued_pairs / max(1.0, useful_pairs)
+        score_bytes = area * 4.0
+        row_state = bm * 8.0
+        ub_peak = np.maximum.reduce([
+            q_bytes + kv_bytes + score_bytes + row_state,
+            2.0 * score_bytes + row_state + out_bytes,
+            q_bytes + kv_bytes + score_bytes + out_bytes,
+        ])
+    elif dot_motif:
+        bm = _cfg_array(configs, ("BLOCK_M", "BM"), 64)
+        bn = _cfg_array(configs, ("BLOCK_N", "BN"), 64)
+        bk = _cfg_array(configs, ("BLOCK_K", "BK"), 32)
+        M = _arg_int(all_args, ("M",), 1); N = _arg_int(all_args, ("N",), 1); K = _arg_int(all_args, ("K",), 1)
+        programs = _ceil_div(M, bm) * _ceil_div(N, bn)
+        loops = _ceil_div(K, bk)
+        active, imbalance, mtp = _grid(programs, cores); iters = loops * mtp
+        cube = max(1, dot) * 2.0 * bm * bn * bk * iters / rates["cube"]
+        vec = max(0, vector) * bm * bn * mtp / rates["elem"]
+        load_iter = (bm * bk + bn * bk) * dtype * max(1.0, loads / 2.0)
+        store_tile = bm * bn * 4.0 * max(1, stores)
+        issued = load_iter * iters + store_tile * mtp
+        mte = issued / effective_bw
+        issued_all = _ceil_div(M, bm) * bm * _ceil_div(N, bn) * bn * _ceil_div(K, bk) * bk
+        useful = M * N * K
+        tail = np.maximum(0.0, 1.0 - useful / np.maximum(1.0, issued_all))
+        redundancy = issued_all / max(1.0, useful)
+        stages = _attr_array(configs, "num_stages", 1)
+        ub_peak = (bm * bk + bn * bk) * dtype * stages + bm * bn * 4.0
+    elif reduce_motif:
+        xb = _cfg_array(configs, ("XBLOCK", "BLOCK_M", "BLOCK_SIZE"), 1)
+        rb = _cfg_array(configs, ("RBLOCK_SIZE", "BLOCK_N", "BLOCK_R"), 128)
+        rows = _arg_int(all_args, ("M", "ROWS"), 1); cols = _arg_int(all_args, ("N", "COLS", "HIDDEN_SIZE"), 1)
+        programs = _ceil_div(rows, xb); loops = _ceil_div(cols, rb)
+        active, imbalance, mtp = _grid(programs, cores); iters = loops * mtp
+        elems = xb * rb
+        cube = np.zeros(n)
+        vec = max(1, reduce) * elems * iters / rates["reduce"] + max(1, vector - reduce) * elems * iters / rates["elem"]
+        issued = (max(1, loads) + max(1, stores)) * elems * dtype * iters
+        mte = issued / effective_bw
+        issued_all = _ceil_div(rows, xb) * xb * _ceil_div(cols, rb) * rb
+        useful = rows * cols
+        tail = np.maximum(0.0, 1.0 - useful / np.maximum(1.0, issued_all))
+        redundancy = issued_all / max(1.0, useful)
+        ub_peak = elems * dtype * (2.0 + min(2.0, reduce))
+    else:
+        block = _cfg_array(configs, ("BLOCK_SIZE", "XBLOCK", "BLOCK_M", "BLOCK_N"), 256)
+        numel = _arg_int(all_args, ("numel", "n_elements"), 0)
+        if numel <= 0:
+            numel = _arg_int(all_args, ("M",), 1) * _arg_int(all_args, ("N",), 1)
+        programs = _ceil_div(numel, block)
+        loops = np.full(n, max(1, int(getattr(template, "persistent_loop_count", 0) or 1)), dtype=np.int64)
+        active, imbalance, mtp = _grid(programs, cores); iters = loops * mtp
+        elems = block * iters
+        cube = np.zeros(n)
+        vec = max(1, vector + atomic) * elems / rates["elem"]
+        issued = (max(1, loads) + max(1, stores)) * elems * dtype
+        mte = issued / effective_bw
+        issued_all = programs * block
+        tail = np.maximum(0.0, 1.0 - numel / np.maximum(1.0, issued_all))
+        redundancy = issued_all / max(1.0, numel)
+        ub_peak = block * dtype * max(2.0, loads + stores)
+
+    # Structural roofline floor is scalar and amortized over the whole group.
+    arithmetic = float(getattr(features, "arithmetic_ops", 0.0))
+    memory_bytes = float(getattr(features, "memory_bytes", 0.0))
+    vec_ops = float(getattr(features, "vector_ops", 0.0) + getattr(features, "reduce_ops", 0.0))
+    floor = max(arithmetic / rates["cube"], memory_bytes / effective_bw, vec_ops * 256.0 / rates["elem"])
+    vec = np.maximum(vec, floor * 0.10); mte = np.maximum(mte, floor * 0.20)
+    ub_peak = np.minimum(ub_peak.astype(np.float64), ub_capacity * 1.5)
+    ub_util = ub_peak / ub_capacity
+    grid_time = np.maximum.reduce([cube, vec, mte])
+    loop_cost = float(options.get("light_loop_cost_us", 0.008))
+    handoff_cost = float(options.get("light_handoff_cost_us", 0.004))
+    # Attention loop/handoff bookkeeping is mostly overlapped in a staged
+    # persistent kernel.  Apply a bounded overlap factor rather than charging
+    # every conceptual iteration serially.
+    if attention:
+        overlap = float(options.get("light_fa_control_overlap", 1.0))
+        control_scale = max(0.0, 1.0 - overlap)
+    else:
+        control_scale = 1.0
+    loop_over = loops * mtp * loop_cost * control_scale
+    phase_count = max(1.0, float(getattr(dag, "phase_count", 1)))
+    handoff = loops * mtp * phase_count * handoff_cost * control_scale
+    tail_pen = tail * float(options.get("light_tail_penalty_us", 0.5))
+    imb_pen = imbalance * float(options.get("light_imbalance_penalty_us", 0.5))
+    cap = float(options.get("light_capacity_risk_weight", 2.0)) * np.maximum(0.0, ub_util - 0.85) ** 2
+    dependency_multiplier = np.ones(n, dtype=np.int64) if attention else np.maximum(1, loops)
+    dependency = (float(options.get("light_dag_dependency_us", 0.001))
+                  * (float(getattr(dag, "critical_path", 1)) + 0.15 * float(getattr(dag, "dependency_edges", 0)))
+                  * dependency_multiplier / max(1.0, float(getattr(dag, "parallelism", 1.0))))
+    # The K/V tile loop is a pipelined steady-state loop.  Its iteration count
+    # changes with BLOCK_N but should not be charged as a serial DAG depth;
+    # only the number of waves assigned to a physical core remains exposed.
+    pipeline = np.maximum(mte, np.maximum(cube, vec)) + dependency
+    score = pipeline + loop_over + handoff + tail_pen + imb_pen + cap
+
+    r.update({
+        "score": score, "grid_time": grid_time, "cube_time": cube, "vector_time": vec,
+        "mte_time": mte, "loop_overhead": loop_over, "handoff_overhead": handoff,
+        "tail_penalty": tail_pen, "imbalance_penalty": imb_pen, "capacity_risk": cap,
+        "active_program_ratio": active, "load_imbalance": imbalance,
+        "max_tiles_per_program": mtp.astype(np.int64), "loop_count": loops.astype(np.int64),
+        "memory_redundancy": redundancy.astype(np.float64), "ub_peak_bytes": ub_peak,
+        "ub_utilization": ub_util, "ub_headroom_bytes": np.maximum(0.0, ub_capacity - ub_peak),
+        "tail_waste": tail,
+    })
+    _finalize(r, options, template)
+    conf = np.full(n, 0.35 + (0.08 if (attention or dot_motif or reduce_motif) else 0.0), dtype=float)
+    if float(getattr(dag, "parallelism", 1.0)) > 1.5: conf += 0.04
+    conf -= min(0.15, 0.03 * len(tuple(getattr(template, "unknown_tt_ops", ()) or ())))
+    if bool(options.get("light_template_out_of_domain", False)):
+        conf -= 0.15
+    if bool(options.get("light_unknown_opcode", False)):
+        conf -= 0.10
+    r["confidence"] = np.clip(conf, 0.05, 0.55)
+    return r
+
+
+def specialized_batch(family: str, configs: Sequence[Any], all_args: Mapping[str, Any],
+                      options: Mapping[str, Any], template: Any) -> dict[str, Any] | None:
+    fam = family
+    n = len(configs); r = _base_result(n); rates = _rates(options)
+    cores = _effective_cores(configs, options); dtype = max(1, int(options.get("dtype_bytes", 2)))
+    ub_capacity = float(options.get("ub_capacity_bytes", 256 * 1024))
+    loop_cost = float(options.get("light_loop_cost_us", 0.008)); handoff_cost = float(options.get("light_handoff_cost_us", 0.004))
+    tail_weight = float(options.get("light_tail_penalty_us", 0.5)); imb_weight = float(options.get("light_imbalance_penalty_us", 0.5)); cap_weight = float(options.get("light_capacity_risk_weight", 2.0))
+
+    if fam == "flash_attention":
+        bm = _cfg_array(configs, ("BLOCK_M", "BM"), 1); bn = _cfg_array(configs, ("BLOCK_N", "BN"), 1)
+        hd = _arg_int(all_args, ("HEAD_DIM", "QK_DIM"), 64); nq = _arg_int(all_args, ("MAX_Q_LEN", "NQ", "N_CTX", "N"), 1); nk = _arg_int(all_args, ("MAX_K_LEN", "NK", "N_CTX"), nq)
+        z = _arg_int(all_args, ("Z", "BATCH"), 1); heads = _arg_int(all_args, ("H", "HEADS"), 1); causal = bool(all_args.get("CAUSAL", all_args.get("causal", False)))
+        programs = _ceil_div(nq, bm) * z * heads; loops = _ceil_div(nk, bn); active, imbalance, mtp = _grid(programs, cores); iters = loops * mtp
+        area = bm * bn; warps = _attr_array(configs, "num_warps", 4); stages = _attr_array(configs, "num_stages", 1)
+        alignment = np.minimum(1.0, bm / 64.0) * np.minimum(1.0, bn / 64.0)
