index 000000000..2adf94a48
--- /dev/null
+++ b/third_party/ascend/backend/runtime/deca_execution_core.py
@@ -0,0 +1,142 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Shared arithmetic execution core for DECA online/offline frontends.
+
+This module is deliberately compiler-free and hardware-label-free.  It owns the
+parts of DECA that are true source/runtime semantics rather than IR extraction:
+logical task construction, dynamic inner-loop multiplicity, persistent
+round-robin task ownership and generic per-core aggregation.
+
+Two frontends consume this core:
+  * online source frontend (precompile_source_prefilter.py): Shape + Config only;
+  * offline Full-vTriton frontend (perfbound/workload/whitebox_schedule.py): the
+    same task/core semantics plus TTIR/HIVM/DES-derived component work.
+
+Keeping these primitives shared prevents the deployable model from drifting
+away from the audited DECA semantics while keeping the online path free of
+TTIR/HIVM/DES materialization.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Sequence
+
+
+@dataclass(frozen=True)
+class LogicalTask:
+    """One logical work unit executed by a persistent program."""
+
+    task_id: int
+    inner_iterations: int
+    group_id: int = 0
+    tile_id: int = 0
+
+
+def build_logical_tasks(
+    operator: str,
+    case: Mapping[str, Any],
+    cfg: Mapping[str, Any],
+) -> list[LogicalTask]:
+    """Build exact source-level logical-task and loop multiplicities.
+
+    No latency constants, benchmark labels, MSProf data, TTIR, HIVM or DES are
+    read here.  These formulas are the audited source semantics used by DECA.
+    """
+    if operator == "flash_attention_npu_v8":
+        bm = max(1, int(cfg["BLOCK_M"]))
+        bn = max(1, int(cfg["BLOCK_N"]))
+        q_len = max(0, int(case["q_len"]))
+        k_len = max(0, int(case["k_len"]))
+        groups = max(1, int(case["batch"])) * max(1, int(case["q_heads"]))
+        q_tiles = math.ceil(q_len / bm) if q_len else 0
+        causal = bool(case.get("causal", False))
+        out: list[LogicalTask] = []
+        tid = 0
+        for group in range(groups):
+            for q_tile in range(q_tiles):
+                q_start = q_tile * bm
+                if causal:
+                    # Exact source semantics:
+                    #   begin = start_m * BLOCK_M
+                    #   for start_n in range(begin, k_len, BLOCK_N)
+                    remaining_k = max(0, k_len - q_start)
+                    inner = math.ceil(remaining_k / bn) if remaining_k > 0 else 0
+                else:
+                    inner = math.ceil(k_len / bn) if k_len > 0 else 0
+                out.append(LogicalTask(
+                    task_id=tid,
+                    inner_iterations=inner,
+                    group_id=group,
+                    tile_id=q_tile,
+                ))
+                tid += 1
+        return out
+
+    if operator == "chunk_o":
+        bk = max(1, int(cfg["BK"]))
+        bv = max(1, int(cfg["BV"]))
+        bt = max(1, int(case["BT"]))
+        batch = max(1, int(case["batch"]))
+        hv = max(1, int(case["HV"]))
+        t = max(0, int(case["T"]))
+        k = max(0, int(case["K"]))
+        v = max(0, int(case["V"]))
+        total_chunks = batch * (math.ceil(t / bt) if t else 0)
+        v_tiles = math.ceil(v / bv) if v else 0
+        inner = math.ceil(k / bk) if k else 0
+        n_tasks = total_chunks * hv * v_tiles
+        return [
+            LogicalTask(task_id=i, inner_iterations=inner, group_id=0, tile_id=i)
+            for i in range(n_tasks)
+        ]
+
+    raise KeyError(f"unsupported DECA workload adapter: {operator}")
+
+
+def assign_tasks_round_robin(
+    tasks: Iterable[LogicalTask],
+    launch_programs: int,
+) -> list[list[LogicalTask]]:
+    """Apply audited persistent ownership ``task_id % launch_programs``."""
+    launch = max(1, int(launch_programs))
+    assigned: list[list[LogicalTask]] = [[] for _ in range(launch)]
+    for task in tasks:
+        assigned[task.task_id % launch].append(task)
+    return assigned
+
+
+def aggregate_scalar_costs_round_robin(
+    costs: Sequence[float],
+    launch_programs: int,
+) -> tuple[float, float, list[float]]:
+    """Aggregate one scalar task cost per logical task onto persistent cores.
+
+    Returns ``(max_load, imbalance, per_core_loads)`` where imbalance is
+    ``max/mean - 1``.  The online source frontend uses this with analytical
+    component bottleneck costs; offline DECA uses the same ownership semantics
+    with IR-derived component work.
+    """
+    launch = max(1, int(launch_programs))
+    loads = [0.0] * launch
+    for task_id, cost in enumerate(costs):
+        loads[task_id % launch] += float(cost)
+    max_load = max(loads, default=0.0)
+    mean = sum(loads) / len(loads) if loads else 0.0
+    imbalance = max_load / mean - 1.0 if mean > 0.0 else 0.0
+    return float(max_load), float(max(0.0, imbalance)), loads
+
+
+def assignment_summary(tasks: Sequence[LogicalTask], launch_programs: int) -> dict[str, Any]:
+    assigned = assign_tasks_round_robin(tasks, launch_programs)
+    task_counts = [len(x) for x in assigned]
+    inner_counts = [sum(t.inner_iterations for t in x) for x in assigned]
+    return {
+        "task_count": len(tasks),
+        "launch_programs": max(1, int(launch_programs)),
+        "active_programs": sum(v > 0 for v in task_counts),
+        "total_inner_iterations": sum(t.inner_iterations for t in tasks),
+        "per_program_task_counts": task_counts,
+        "per_program_inner_iterations": inner_counts,
+        "max_tasks_per_program": max(task_counts, default=0),
+        "max_inner_iterations_per_program": max(inner_counts, default=0),
+    }
