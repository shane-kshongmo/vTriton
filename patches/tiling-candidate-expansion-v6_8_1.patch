@@ -0,0 +1,115 @@
+from pathlib import Path
+import json
+import sys
+import types
+
+ROOT = Path(__file__).resolve().parents[3]
+RUNTIME = ROOT / "third_party/ascend/backend/runtime"
+if "backend" not in sys.modules:
+    b = types.ModuleType("backend"); b.__path__ = [str(RUNTIME.parent)]; sys.modules["backend"] = b
+if "backend.runtime" not in sys.modules:
+    r = types.ModuleType("backend.runtime"); r.__path__ = [str(RUNTIME)]; sys.modules["backend.runtime"] = r
+
+from backend.runtime.safety_registry import (
+    SCHEMA_VERSION,
+    SafetyRegistry,
+    certificate_key,
+    certificate_payload,
+)
+
+
+def _identity():
+    return {
+        "schema": SCHEMA_VERSION,
+        "operator": "op",
+        "source_sha256": "src",
+        "safety_worker_sha256": "worker",
+        "runtime": {"runtime": "same"},
+    }
+
+
+def test_v53_default_launch_meta_key_is_backward_compatible(tmp_path):
+    current = certificate_payload(
+        repo=tmp_path,
+        operator="op",
+        case={"M": 128},
+        cfg={"BLOCK": 64},
+        identity=_identity(),
+        num_warps=4,
+        num_stages=3,
+        num_ctas=1,
+        maxnreg=None,
+    )
+    legacy = dict(current)
+    legacy.pop("num_ctas")
+    legacy.pop("maxnreg")
+    path = tmp_path / "registry.json"
+    path.write_text(json.dumps({
+        "schema_version": SCHEMA_VERSION,
+        "entries": {
+            certificate_key(legacy): {
+                "status": "SAFE",
+                "payload": legacy,
+                "evidence": {"campaign_id": "campaign"},
+            }
+        },
+    }))
+    reg = SafetyRegistry(path)
+    rec, mode = reg.lookup_compatible(current)
+    assert rec is not None
+    assert rec["status"] == "SAFE"
+    assert mode == "legacy_v53_equivalent_default_launch_meta"
+
+
+def test_nondefault_launch_meta_never_borrows_v53_certificate(tmp_path):
+    default = certificate_payload(
+        repo=tmp_path,
+        operator="op",
+        case={"M": 128},
+        cfg={"BLOCK": 64},
+        identity=_identity(),
+        num_warps=4,
+        num_stages=3,
+        num_ctas=1,
+        maxnreg=None,
+    )
+    legacy = dict(default); legacy.pop("num_ctas"); legacy.pop("maxnreg")
+    path = tmp_path / "registry.json"
+    path.write_text(json.dumps({
+        "schema_version": SCHEMA_VERSION,
+        "entries": {certificate_key(legacy): {"status":"SAFE","payload":legacy,"evidence":{"campaign_id":"campaign"}}},
+    }))
+    reg = SafetyRegistry(path)
+    for overrides in (
+        {"num_warps": 8},
+        {"num_stages": 2},
+        {"num_ctas": 2},
+        {"maxnreg": 128},
+    ):
+        payload = dict(default); payload.update(overrides)
+        rec, mode = reg.lookup_compatible(payload)
+        assert rec is None
+        assert mode is None
+
+
+def test_current_v61_key_wins_before_legacy(tmp_path):
+    current = certificate_payload(
+        repo=tmp_path,
+        operator="op",
+        case={"M": 128},
+        cfg={"BLOCK": 64},
+        identity=_identity(),
+    )
+    legacy = dict(current); legacy.pop("num_ctas"); legacy.pop("maxnreg")
+    path = tmp_path / "registry.json"
+    path.write_text(json.dumps({
+        "schema_version": SCHEMA_VERSION,
+        "entries": {
+            certificate_key(legacy): {"status":"UNSAFE","payload":legacy,"evidence":{"campaign_id":"campaign"}},
+            certificate_key(current): {"status":"SAFE","payload":current,"evidence":{"campaign_id":"campaign"}},
+        },
+    }))
+    reg = SafetyRegistry(path)
+    rec, mode = reg.lookup_compatible(current)
+    assert rec["status"] == "SAFE"
+    assert mode == "current_v61_key"
