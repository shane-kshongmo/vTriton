+from pathlib import Path
+import sys
+ROOT=Path(__file__).resolve().parents[3]
+EVAL=ROOT/'third_party/ascend/experiments/candidate_value_eval'
+if str(EVAL) not in sys.path: sys.path.insert(0,str(EVAL))
+from certify_v65_frontier import select_v65_certification_frontier
+
+
+def _row(i,opp,conf,dis,dist,direction):
+    return {'config':{'X':i},'_proposal_rank':i,'origin_stage':'S1',
+      'v6_relative':{'opportunity_score':opp,'multiview_confidence':conf,'primary_anchor_distance':dist,'direction_signature':[direction]},
+      'precompile_source_prefilter':{'rank_view_disagreement':dis}}
+
+
+def test_v65_certification_frontier_mixes_value_uncertainty_and_direction_diversity():
+    rows=[
+      _row(1,.9,.9,.1,.1,1), _row(2,.8,.8,.2,.2,1),
+      _row(3,.2,.5,.9,.3,2), _row(4,.1,.4,.8,.9,3),
+      _row(5,.3,.6,.4,1.2,4), _row(6,.25,.5,.5,1.0,5),
+    ]
+    s=select_v65_certification_frontier(rows,max_select=4,exploit_fraction=.5,uncertainty_fraction=.25)
+    assert len(s)==4
+    roles=[x['_certification_role'] for x in s]
+    assert roles.count('value')==2
+    assert 'uncertainty' in roles
+    assert any(r in {'direction_diverse','fill'} for r in roles)
+    assert s[0]['config']=={'X':1}
