+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Persistent execution-safety certificates for V5.3.
+
+The registry is deliberately *not* a performance database.  Entries contain
+only SAFE/UNSAFE execution evidence and a versioned identity payload.  No
+candidate latency, rank, winner flag, DECA score, or MSProf duration is stored.
+
+V5.3 also strengthens certificate invalidation: the payload fingerprints the
+operator source, the safety worker, relevant package versions and runtime roots
+so stale certificates are not silently reused after compiler/runtime changes.
+"""
+from __future__ import annotations
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import time
+from pathlib import Path
+from typing import Any, Mapping
+
+SCHEMA_VERSION = "candidate_safety_registry_v53_v1"
+
+
+def _canonical(obj: Any) -> str:
+    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, default=str)
+
+
+def sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as fh:
+        for block in iter(lambda: fh.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def _pkg_version(*names: str) -> str:
+    for name in names:
+        try:
+            return importlib.metadata.version(name)
+        except importlib.metadata.PackageNotFoundError:
+            continue
+        except Exception:
+            continue
+    return "unknown"
+
+
+def operator_source(repo: Path, operator: str) -> Path:
+    path = repo / "third_party/ascend/experiments/operators" / f"{operator}.py"
+    if not path.is_file():
+        raise FileNotFoundError(path)
+    return path
+
+
+def safety_worker_source(repo: Path) -> Path:
+    path = repo / "third_party/ascend/experiments/candidate_value_eval/candidate_safety_smoke.py"
+    if not path.is_file():
+        raise FileNotFoundError(path)
+    return path
+
+
+def runtime_identity() -> dict[str, str]:
+    return {
+        "triton_package_version": _pkg_version("triton"),
+        "torch_package_version": _pkg_version("torch"),
+        "torch_npu_package_version": _pkg_version("torch-npu", "torch_npu"),
+        "triton_runtime_root": str(Path(os.environ.get("TRITON_RUNTIME_ROOT", "unknown")).expanduser()),
+        "triton_py_site": str(Path(os.environ.get("VTRITON_PY_SITE", "unknown")).expanduser()),
+        "triton_ascend_arch": os.environ.get("TRITON_ASCEND_ARCH", "unknown"),
+        "cann_root": str(Path(os.environ.get("CANN_ROOT", "/usr/local/Ascend/cann-9.0.0")).expanduser()),
+    }
+
+
+def certificate_identity(
+    *, repo: Path, operator: str, source_path: Path | None = None,
+    safety_worker_path: Path | None = None,
+) -> dict[str, Any]:
+    """Build the invariant part of a certificate payload once.
+
+    Final V6 scanned O(10^3) candidates and re-hashed the same operator/worker
+    files plus package/runtime identity once per candidate.  V6.1 hoists those
+    invariants out of the loop so registry lookup remains millisecond-scale.
+    """
+    repo = repo.resolve()
+    src = Path(source_path).resolve() if source_path is not None else operator_source(repo, operator)
+    worker = Path(safety_worker_path).resolve() if safety_worker_path is not None else safety_worker_source(repo)
+    return {
+        "schema": SCHEMA_VERSION,
+        "operator": str(operator),
+        "source_sha256": sha256_file(src),
+        "safety_worker_sha256": sha256_file(worker),
+        "runtime": runtime_identity(),
+    }
+
+
+def _legacy_v53_payload_from_current(payload: Mapping[str, Any]) -> dict[str, Any] | None:
+    """Return the exact V5.3 key shape when launch metadata is equivalent.
+
+    V5.3 certificates encoded num_warps=4 and num_stages=3 but did not yet
+    serialize num_ctas/maxnreg.  Final V6 added the latter fields without
+    changing the registry schema, unintentionally making every V5.3 key
+    unreachable.  Compatibility is safe *only* for the historical defaults.
+    """
+    p = dict(payload)
+    try:
+        if int(p.get("num_warps", 4)) != 4 or int(p.get("num_stages", 3)) != 3:
+            return None
+        if int(p.get("num_ctas", 1)) != 1:
+            return None
+    except Exception:
+        return None
+    if p.get("maxnreg") is not None:
+        return None
+    p.pop("num_ctas", None)
+    p.pop("maxnreg", None)
+    return p
+
+
+def certificate_payload(
+    *, repo: Path, operator: str, case: Mapping[str, Any], cfg: Mapping[str, Any],
+    source_path: Path | None = None, safety_worker_path: Path | None = None,
+    num_warps: int = 4, num_stages: int = 3, num_ctas: int = 1, maxnreg: int | None = None,
+    identity: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Build an exact execution-safety key.
+
+    ``source_path`` makes the registry usable by every handwritten repository
+    kernel, not only the two candidate-value calibration operators.  Existing
+    callers remain byte-for-byte compatible because the old default resolver is
+    preserved.
+    """
+    ident = dict(identity or certificate_identity(
+        repo=repo, operator=operator, source_path=source_path, safety_worker_path=safety_worker_path,
+    ))
+    return {
+        **ident,
+        # Exact-case reuse is deliberately conservative.  Safety evidence is
+        # never silently transferred to a different shape/dtype/causal mode.
+        "case": dict(case),
+        "config": dict(cfg),
+        "num_warps": int(num_warps),
+        "num_stages": int(num_stages),
+        "num_ctas": int(num_ctas),
+        "maxnreg": None if maxnreg is None else int(maxnreg),
+    }
+
+
+def certificate_key(payload: Mapping[str, Any]) -> str:
+    return hashlib.sha256(_canonical(dict(payload)).encode("utf-8")).hexdigest()
+
+
+class SafetyRegistry:
+    def __init__(self, path: Path):
+        self.path = path.resolve()
+        self.data = self._load()
+
+    def _load(self) -> dict[str, Any]:
+        if not self.path.is_file():
+            return {"schema_version": SCHEMA_VERSION, "entries": {}}
+        try:
+            data = json.loads(self.path.read_text(encoding="utf-8"))
+        except Exception as exc:
+            raise RuntimeError(f"invalid safety registry {self.path}: {exc}") from exc
+        if data.get("schema_version") != SCHEMA_VERSION:
+            raise RuntimeError(
+                f"unsupported safety registry schema {data.get('schema_version')!r}; expected {SCHEMA_VERSION}"
+            )
+        data.setdefault("entries", {})
+        return data
+
+    def lookup(self, payload: Mapping[str, Any]) -> dict[str, Any] | None:
+        return (self.data.get("entries") or {}).get(certificate_key(payload))
+
+    def lookup_compatible(self, payload: Mapping[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
+        """Lookup current key first, then the strictly-equivalent V5.3 key.
+
+        The fallback never transfers safety across case/source/runtime or across
+        non-default launch metadata.  It only repairs the V6 serialization
+        regression where num_ctas=1/maxnreg=None were newly appended.
+        """
+        entries = self.data.get("entries") or {}
+        current = entries.get(certificate_key(payload))
+        if current is not None:
+            return current, "current_v61_key"
+        legacy = _legacy_v53_payload_from_current(payload)
+        if legacy is not None:
+            rec = entries.get(certificate_key(legacy))
+            if rec is not None:
+                return rec, "legacy_v53_equivalent_default_launch_meta"
+        return None, None
+
+    def record(self, payload: Mapping[str, Any], *, status: str, evidence: Mapping[str, Any]) -> dict[str, Any]:
+        status = str(status).upper()
+        if status not in {"SAFE", "UNSAFE"}:
+            raise ValueError(f"invalid certificate status {status!r}")
+        # Reject accidental performance fields at the registry boundary.
+        forbidden = ("latency", "benchmark", "msprof", "winner", "rank", "score")
+        for key in evidence:
+            low = str(key).lower()
+            if any(tok in low for tok in forbidden):
+                raise ValueError(f"performance-like evidence field forbidden in SafetyRegistry: {key}")
+        key = certificate_key(payload)
+        rec = {
+            "key": key,
+            "status": status,
+            "payload": dict(payload),
+            "evidence": dict(evidence),
+            "updated_unix_s": time.time(),
+            "candidate_performance_label_used": False,
+            "candidate_msprof_label_used": False,
+        }
+        self.data.setdefault("entries", {})[key] = rec
+        self._flush()
+        return rec
+
+    def _flush(self) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = self.path.with_suffix(self.path.suffix + f".tmp.{os.getpid()}")
+        tmp.write_text(json.dumps(self.data, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
+        os.replace(tmp, self.path)
+
+    def stats(self) -> dict[str, int]:
+        vals = list((self.data.get("entries") or {}).values())
+        return {
+            "entries": len(vals),
+            "safe": sum(str(v.get("status")) == "SAFE" for v in vals),
+            "unsafe": sum(str(v.get("status")) == "UNSAFE" for v in vals),
+        }
