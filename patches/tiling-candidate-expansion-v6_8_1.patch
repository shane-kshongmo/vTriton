+from __future__ import annotations
+
+from pathlib import Path
+import sys, types
+ROOT=Path(__file__).resolve().parents[3]
+RUNTIME=ROOT/'third_party/ascend/backend/runtime'
+if 'backend' not in sys.modules:
+    b=types.ModuleType('backend'); b.__path__=[str(RUNTIME.parent)]; sys.modules['backend']=b
+if 'backend.runtime' not in sys.modules:
+    r=types.ModuleType('backend.runtime'); r.__path__=[str(RUNTIME)]; sys.modules['backend.runtime']=r
+
+from backend.runtime.search_space_v6 import infer_search_space
+from backend.runtime.source_motif_deca import (
+    analyze_source_signature,
+    infer_source_motif,
+    score_motif_deca,
+)
+from backend.runtime.generic_source_rank_v6 import rank_rows_generic
+
+
+def _spec(domains, split=None, tiling=None, reduction=None):
+    cfg = {k: vals[0] for k, vals in domains.items()}
+    return infer_search_space(
+        [cfg], [cfg], parameter_domains=domains,
+        tunable_parameters=list(domains), split_params=split,
+        tiling_params=tiling, reduction_axes=reduction,
+    )
+
+
+def test_source_ast_motif_detection_is_operator_name_free():
+    gemm_src = '''
+def kernel(a, b, c, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr):
+    x = tl.load(a)
+    y = tl.load(b)
+    z = tl.dot(x, y)
+    tl.store(c, z)
+'''
+    sig = analyze_source_signature({'source_text': gemm_src})
+    assert sig['available'] is True
+    assert sig['tl_dot_count'] == 1
+    spec = _spec(
+        {'BLOCK_M':[32,64], 'BLOCK_N':[32,64], 'BLOCK_K':[32,64]},
+        split={'m':'BLOCK_M','n':'BLOCK_N'}, tiling={'k':'BLOCK_K'}, reduction=['k'],
+    )
+    meta = infer_source_motif(spec, options={
+        'source_text': gemm_src,
+        'split_params': {'m':'BLOCK_M','n':'BLOCK_N'},
+        'tiling_params': {'k':'BLOCK_K'},
+        'reduction_axes': ['k'],
+    }, source_signature=sig)
+    assert meta['motif'] == 'gemm_like'
+    assert meta['confidence'] > 0.8
+    assert meta['operator_name_used'] is False
+
+
+def test_reduction_scan_elementwise_and_atomic_motifs():
+    cases = [
+        ('reduction_like', 'x=tl.load(a); y=tl.sum(x); tl.store(o,y)'),
+        ('scan_recurrent', 'x=tl.load(a); y=tl.cumsum(x, axis=0); tl.store(o,y)'),
+        ('irregular_atomic', 'x=tl.load(a); tl.atomic_add(o, x)'),
+        ('elementwise_memory', 'x=tl.load(a); tl.store(o, x + 1)'),
+    ]
+    spec = _spec({'BLOCK_SIZE':[64,128]}, split={'x':'BLOCK_SIZE'})
+    for expected, body in cases:
+        src = f'def kernel(a,o,BLOCK_SIZE: tl.constexpr):\n    {body}\n'
+        meta = infer_source_motif(
+            spec,
+            options={'source_text':src, 'split_params':{'x':'BLOCK_SIZE'}},
+        )
+        assert meta['motif'] == expected
+        assert meta['supported_by_motif_deca'] is True
+
+
+def test_metadata_only_fallback_still_builds_motif():
+    spec = _spec(
+        {'BLOCK_M':[32,64], 'BLOCK_N':[32,64], 'BLOCK_K':[32,64]},
+        split={'m':'BLOCK_M','n':'BLOCK_N'}, tiling={'k':'BLOCK_K'}, reduction=['k'],
+    )
+    meta = infer_source_motif(spec, options={
+        'split_params':{'m':'BLOCK_M','n':'BLOCK_N'},
+        'tiling_params':{'k':'BLOCK_K'},
+        'reduction_axes':['k'],
+    })
+    assert meta['motif'] == 'gemm_like'
+    assert meta['origin'] == 'autotiling_metadata'
+    assert 0 < meta['confidence'] < 0.8
+
+
+def test_motif_score_is_compile_free_and_candidate_sensitive():
+    domains = {'BLOCK_M':[32,64], 'BLOCK_N':[32,64], 'BLOCK_K':[32,64]}
+    spec = _spec(
+        domains, split={'m':'BLOCK_M','n':'BLOCK_N'}, tiling={'k':'BLOCK_K'}, reduction=['k'],
+    )
+    opts = {
+        'source_text':'def kernel(a,b,c,BLOCK_M: tl.constexpr,BLOCK_N: tl.constexpr,BLOCK_K: tl.constexpr):\n    tl.store(c, tl.dot(tl.load(a),tl.load(b)))\n',
+        'split_params':{'m':'BLOCK_M','n':'BLOCK_N'},
+        'tiling_params':{'k':'BLOCK_K'},
+        'reduction_axes':['k'],
+        'parameter_to_axis':{'BLOCK_M':'m','BLOCK_N':'n','BLOCK_K':'k'},
+        'axis_sizes':{'m':512,'n':512,'k':512},
+        'num_cores':20,
+        'light_detect_hardware':False,
+    }
+    meta = infer_source_motif(spec, options=opts)
+    a = score_motif_deca({'BLOCK_M':32,'BLOCK_N':32,'BLOCK_K':32}, search_space=spec, all_args={}, options=opts, motif_meta=meta)
+    b = score_motif_deca({'BLOCK_M':64,'BLOCK_N':64,'BLOCK_K':64}, search_space=spec, all_args={}, options=opts, motif_meta=meta)
+    assert a is not None and b is not None
+    assert a['model_kind'] == 'source_motif_deca_v66'
+    assert a['uses_ttir'] is False and a['uses_hivm'] is False and a['uses_des'] is False
+    assert a['uses_candidate_latency_labels'] is False
+    assert a['motif_score_proxy'] != b['motif_score_proxy']
+
+
+def test_generic_ranker_adds_motif_deca_for_non_fa_non_chunk_family():
+    domains = {'BLOCK_M':[32,64], 'BLOCK_N':[32,64], 'BLOCK_K':[32,64]}
+    spec = _spec(domains, split={'m':'BLOCK_M','n':'BLOCK_N'}, tiling={'k':'BLOCK_K'}, reduction=['k'])
+    rows = [
+        {'config': {'BLOCK_M':m,'BLOCK_N':n,'BLOCK_K':k}, 'origin_stage':'X'}
+        for m in domains['BLOCK_M'] for n in domains['BLOCK_N'] for k in domains['BLOCK_K']
+    ]
+    opts = {
+        'operator_family':'completely_new_family',
+        'source_text':'def kernel(a,b,c,BLOCK_M: tl.constexpr,BLOCK_N: tl.constexpr,BLOCK_K: tl.constexpr):\n    tl.store(c, tl.dot(tl.load(a),tl.load(b)))\n',
+        'split_params':{'m':'BLOCK_M','n':'BLOCK_N'},
+        'tiling_params':{'k':'BLOCK_K'},
+        'reduction_axes':['k'],
+        'parameter_to_axis':{'BLOCK_M':'m','BLOCK_N':'n','BLOCK_K':'k'},
+        'axis_sizes':{'m':512,'n':512,'k':512},
+        'num_cores':20,
+        'light_detect_hardware':False,
+    }
+    ranked, prov = rank_rows_generic(rows, search_space=spec, all_args={}, options=opts)
+    assert len(ranked) == 8
+    assert prov['motif_deca_view_used'] is True
+    assert prov['motif_deca_capability']['motif'] == 'gemm_like'
+    assert prov['specialized_deca_view_used'] is False
+    assert 'motif_deca' in prov['views']
+    rec = ranked[0]['precompile_source_prefilter']
+    assert rec['motif_deca_view_used'] is True
+    assert rec['source_motif'] == 'gemm_like'
