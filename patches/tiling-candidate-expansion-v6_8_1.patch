new file mode 100644
index 000000000..c5de1a8a7
--- /dev/null
+++ b/third_party/ascend/backend/runtime/precompile_safety.py
@@ -0,0 +1,146 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Compile-free hard-safety gate for expanded Ascend autotune candidates.
+
+This is *not* a performance heuristic.  It removes only configurations that
+violate audited source/backend geometry or conservative local-memory capacity
+bounds before any NPU launch.  Hardware execution safety is still verified for
+novel Top-K candidates in an isolated subprocess by the V5.1 experiment path,
+because an AICore 507015 fault can poison the calling process context.
+"""
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+
+# Ascend 910B3 v4 memory-space capacities. These are architectural capacity
+# constants, not performance labels. Source of truth:
+# vtriton_vendor/source/configs/ascend_910b3_v4.json.
+AICORE_MAX = 20
+L0A_BYTES = 64 * 1024
+L0B_BYTES = 64 * 1024
+L0C_BYTES = 256 * 1024
+L1_BYTES = 1024 * 1024
+UB_BYTES = 256 * 1024
+
+
+def _positive_int(cfg: Mapping[str, Any], name: str) -> int:
+    value = int(cfg.get(name, 0) or 0)
+    if value <= 0:
+        raise ValueError(f"{name} must be > 0")
+    return value
+
+
+def _capacity_usage_fa(*, bm: int, bn: int, d: int, elem: int, stages: int = 3) -> dict[str, int]:
+    pipe = min(max(1, int(stages)), 2)
+    return {
+        "l0a_bytes": bm * d * elem * pipe,
+        "l0b_bytes": bn * d * elem * pipe,
+        "l0c_bytes": bm * bn * 4,
+        "l1_bytes": (bm * d + bn * d) * elem * pipe,
+        # Conservative source-level live-set proxy.  This is used only as a
+        # hard safety bound, never as a performance score.
+        "ub_bytes": ((bm * d) + 2 * (bn * d) + 2 * (bm * bn)) * elem + 8 * bm,
+    }
+
+
+def _capacity_usage_chunk(*, bt: int, bk: int, bv: int, elem: int, stages: int = 3) -> dict[str, int]:
+    pipe = min(max(1, int(stages)), 2)
+    # q/k/h dot tiles plus fp32 accumulators A[BT,BT] and O[BT,BV].
+    return {
+        "l0a_bytes": max(bt * bk, bt * bt) * elem * pipe,
+        "l0b_bytes": max(bk * bv, bk * bt, bt * bv) * elem * pipe,
+        "l0c_bytes": max(bt * bv, bt * bt) * 4,
+        "l1_bytes": (bt * bk + bk * bt + bk * bv + bt * bv) * elem * pipe,
+        "ub_bytes": (
+            (bt * bk + bk * bt + bk * bv + bt * bv) * elem
+            + (bt * bt + bt * bv) * 4
+        ),
+    }
+
+
+def _capacity_ok(usage: Mapping[str, int]) -> tuple[bool, str]:
+    limits = {
+        "l0a_bytes": L0A_BYTES,
+        "l0b_bytes": L0B_BYTES,
+        "l0c_bytes": L0C_BYTES,
+        "l1_bytes": L1_BYTES,
+        "ub_bytes": UB_BYTES,
+    }
+    for key, limit in limits.items():
+        if int(usage.get(key, 0)) > limit:
+            return False, f"{key}_exceeds_{limit}"
+    return True, "capacity_safe"
+
+
+
+# V5.3 leakage-clean contract:
+# historical hardware-valid geometry is deliberately NOT encoded in source.
+# Source safety below contains only auditable shape/config/backend constraints.
+# Runtime safety evidence belongs in the versioned SafetyRegistry and is looked
+# up only after the DECA source ranking has been frozen.
+
+def is_certified_geometry(operator: str, cfg: Mapping[str, Any]) -> bool:
+    """Deprecated compatibility shim.
+
+    V5.3 intentionally returns False for every candidate so historical
+    regression-campaign geometry cannot silently influence selection.
+    Callers must use ``check_source_safety`` plus ``SafetyRegistry``.
+    """
+    del operator, cfg
+    return False
+
+
+def check_source_safety(
+    operator: str,
+    case: Mapping[str, Any],
+    cfg: Mapping[str, Any],
+    *,
+    dtype_bytes: int = 2,
+    num_stages: int = 3,
+) -> dict[str, Any]:
+    """Return an auditable compile-free safety decision for one Config."""
+    elem = max(1, int(dtype_bytes))
+    try:
+        cores = _positive_int(cfg, "AICORE_NUM")
+    except Exception as exc:
+        return {"safe": False, "reason": f"invalid_core:{exc}", "usage": {}}
+    if cores > AICORE_MAX:
+        return {"safe": False, "reason": f"AICORE_NUM_exceeds_{AICORE_MAX}", "usage": {}}
+
+    try:
+        if operator == "flash_attention_npu_v8":
+            bm = _positive_int(cfg, "BLOCK_M")
+            bn = _positive_int(cfg, "BLOCK_N")
+            d = max(1, int(case["head_dim"]))
+            # Source/backend contract: this kernel family is admitted only on
+            # 8-element tile granularity.  No historical runtime-safe geometry
+            # set is consulted here.
+            if bm % 8 or bn % 8:
+                return {"safe": False, "reason": "fa_tile_not_multiple_of_8", "usage": {}}
+            if d % 16:
+                return {"safe": False, "reason": "fa_head_dim_not_multiple_of_16", "usage": {}}
+            usage = _capacity_usage_fa(bm=bm, bn=bn, d=d, elem=elem, stages=num_stages)
+
+        elif operator == "chunk_o":
+            bk = _positive_int(cfg, "BK")
+            bv = _positive_int(cfg, "BV")
+            bt = max(1, int(case["BT"]))
+            if bk % 16 or bv % 16:
+                return {"safe": False, "reason": "chunk_tile_not_multiple_of_16", "usage": {}}
+            usage = _capacity_usage_chunk(bt=bt, bk=bk, bv=bv, elem=elem, stages=num_stages)
+        else:
+            return {"safe": False, "reason": f"unsupported_operator:{operator}", "usage": {}}
+    except Exception as exc:
+        return {"safe": False, "reason": f"invalid_config:{type(exc).__name__}:{exc}", "usage": {}}
+
+    ok, reason = _capacity_ok(usage)
+    return {
+        "safe": bool(ok),
+        "reason": reason if ok else f"conservative_capacity:{reason}",
+        "usage": dict(usage),
+        "aicore_num": cores,
+        "dtype_bytes": elem,
+        "num_stages": int(num_stages),
+        "performance_label_used": False,
+        "msprof_label_used": False,
+    }
diff --git a/third_party/ascend/backend/runtime/precompile_selection_v6.py b/third_party/ascend/backend/runtime/precompile_selection_v6.py
