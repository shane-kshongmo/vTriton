+#!/usr/bin/env python3
+"""V5.3 leakage-clean deployable candidate expansion on the native Ascend autotuner.
+
+Three explicit experiment modes:
+  * official: source B0 -> native autotuner.
+  * ours_cold_cert: static safety -> DECA source ranking -> persistent safety
+    registry; only registry misses are isolated-smoked using a physically
+    separate safety compile cache -> K safe configs -> fresh native autotuner.
+  * ours_warm_cert: same expansion/static/ranking but safety is registry lookup
+    only. UNKNOWN candidates are skipped; no destructive online launch occurs.
+
+Safety certificates are campaign-scoped. Historical V5.1/V5.2 evidence is not
+accepted by the V5.3 experiment campaign. Ranking is frozen and hashed before
+any registry lookup, while each method's native TRITON_CACHE_DIR remains fresh.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any, Mapping
+
+HERE = Path(__file__).resolve().parent
+EXP = HERE.parent
+CAL = EXP / "vtriton_new_ops_calibration"
+for p in (HERE, CAL):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+
+def write_json(path: Path, obj: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
+
+
+def _cfg_sig(cfg: Mapping[str, Any]) -> str:
+    return json.dumps(dict(cfg), sort_keys=True, separators=(",", ":"))
+
+
+class RegistryCoverageError(RuntimeError):
+    """Warm registry cannot provide the requested compile budget."""
+
+
+def _paths_overlap(a: Path, b: Path) -> bool:
+    a = a.resolve(); b = b.resolve()
+    try:
+        a.relative_to(b); return True
+    except ValueError:
+        pass
+    try:
+        b.relative_to(a); return True
+    except ValueError:
+        return False
+
+
+def _ranking_digest(rows: list[dict[str, Any]]) -> str:
+    payload = [
+        {
+            "config_signature": _cfg_sig(r["config"]),
+            "score_us_proxy": float((r.get("precompile_source_prefilter") or {}).get("score_us_proxy", 0.0)),
+            "core_imbalance": float((r.get("precompile_source_prefilter") or {}).get("core_imbalance", 0.0)),
+        }
+        for r in rows
+    ]
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _forbidden_ranking_input_paths(obj: Any, prefix: str = "$") -> list[str]:
+    forbidden = ("benchmark", "latency", "msprof", "winner", "result_json", "hardware_label")
+    hits: list[str] = []
+    if isinstance(obj, Mapping):
+        for key, value in obj.items():
+            path = f"{prefix}.{key}"
+            low = str(key).lower()
+            if any(tok in low for tok in forbidden):
+                hits.append(path)
+            hits.extend(_forbidden_ranking_input_paths(value, path))
+    elif isinstance(obj, list):
+        for i, value in enumerate(obj):
+            hits.extend(_forbidden_ranking_input_paths(value, f"{prefix}[{i}]"))
+    return hits
+
+
+def _prepare_once(repo: Path, operator: str, case: dict[str, Any], rep_cfg: dict[str, Any]):
+    t0 = time.perf_counter()
+    import torch
+    import torch_npu  # noqa: F401
+    from operator_adapters import load_module, prepare, reference
+    module, source = load_module(repo, operator)
+    tensors = prepare(operator, case, rep_cfg, "npu")
+    ref = reference(operator, case, tensors)
+    torch.npu.synchronize()
+    return torch, module, tensors, ref, source, time.perf_counter() - t0
+
+
+def _rank_args(operator: str, case: Mapping[str, Any]) -> dict[str, Any]:
+    if operator == "flash_attention_npu_v8":
+        return {
+            "MAX_Q_LEN": int(case["q_len"]), "MAX_K_LEN": int(case["k_len"]),
+            "BATCH_SIZE": int(case["batch"]), "q_head": int(case["q_heads"]),
+            "QK_DIM": int(case["head_dim"]), "causal": bool(case.get("causal", True)),
+        }
+    return {
+        "T": int(case["T"]), "H": int(case["H"]), "HV": int(case["HV"]),
+        "K": int(case["K"]), "V": int(case["V"]), "N": int(case["batch"]),
+        "batch": int(case["batch"]), "BT": int(case["BT"]),
+    }
+
+
+def _to_triton_config(operator: str, cfg: Mapping[str, Any]):
+    import triton
+    kw = dict(cfg)
+    if operator == "chunk_o":
+        kw["num_core"] = int(kw.pop("AICORE_NUM"))
+    return triton.Config(kw, num_warps=4, num_stages=3)
+
+
+def _from_tuner_config(operator: str, config) -> dict[str, Any]:
+    kw = dict(config.kwargs)
+    if operator == "chunk_o" and "num_core" in kw:
+        kw["AICORE_NUM"] = int(kw.pop("num_core"))
+    return {str(k): v for k, v in kw.items()}
+
+
+def _median_ms(value: Any) -> float:
+    if isinstance(value, (int, float)):
+        return float(value)
+    if isinstance(value, (list, tuple)) and value:
+        return float(value[0])
+    return float(value)
+
+
+def _native_tune(*, operator: str, case: dict[str, Any], module, tensors, ref, torch,
+                 selected_cfgs: list[dict[str, Any]], candidate_value_batch_mode: bool = False,
+                 capture_compiled_ir: bool = False) -> dict[str, Any]:
+    from backend.runtime.autotuner import AutoTilingTuner
+    from operator_adapters import unwrap_jit
+    if not selected_cfgs:
+        raise RuntimeError("native autotune received an empty config list")
+
+    if operator == "flash_attention_npu_v8":
+        fn = unwrap_jit(module.fwd_kernel)
+        configs = [_to_triton_config(operator, c) for c in selected_cfgs]
+        tuner = AutoTilingTuner(
+            fn, fn.arg_names, configs, [], None, None,
+            hints={
+                **(
+                    {"disable_candidate_value_time_prune": True}
+                    if candidate_value_batch_mode
+                    else {"force_explicit_cv_time_prune": True}
+                ),
+                "capture_compiled_ir": bool(capture_compiled_ir),
+            },
+        )
+        grid = lambda meta: (int(meta["AICORE_NUM"]),)
+        dtype_code = 19 if case["dtype"] == "float16" else 14
+        t0 = time.perf_counter()
+        tuner[grid](
+            tensors["q"], tensors["k"], tensors["v"], tensors["o"], tensors["l"],
+            tensors["q_arg"], tensors["k_arg"], tensors["mask"], tensors["cuq"], tensors["cuk"],
+            int(case["q_heads"]), int(case["kv_heads"]), tensors["scale"],
+            QK_DIM=int(case["head_dim"]), V_DIM=int(case["head_dim"]), MASK_FN=1,
+            SPARSE_OPT=False, DTYPE=dtype_code,
+            MAX_Q_LEN=int(case["q_len"]), MAX_K_LEN=int(case["k_len"]), BATCH_SIZE=int(case["batch"]),
+            multibuffer=True, enable_mixed_cv=True, enable_auto_bind_sub_block=True,
+            sync_solver=True, limit_auto_multi_buffer_of_local_buffer="no-limit",
+            set_workspace_multibuffer=2,
+        )
+        native_wall = time.perf_counter() - t0
+    else:
+        fn = unwrap_jit(module.chunk_fwd_kernel_o_npu)
+        configs = [_to_triton_config(operator, c) for c in selected_cfgs]
+        tuner = AutoTilingTuner(
+            fn, fn.arg_names, configs, [], None, None,
+            hints={
+                **(
+                    {"disable_candidate_value_time_prune": True}
+                    if candidate_value_batch_mode
+                    else {"force_explicit_cv_time_prune": True}
+                ),
+                "capture_compiled_ir": bool(capture_compiled_ir),
+            },
+        )
+        grid = lambda meta: (int(meta["num_core"]),)
+        t0 = time.perf_counter()
+        tuner[grid](
+            tensors["q"], tensors["k"], tensors["v"], tensors["h"],
+            None, None, tensors["o"], None, None, tensors["scale"],
+            int(case["T"]), int(case["H"]), int(case["HV"]), int(case["K"]), int(case["V"]),
+            int(case["batch"]), int(tensors["total_chunks"]), BT=int(case["BT"]),
+            USE_G=False, USE_G_GAMMA=False,
+            STATE_V_FIRST=bool(case.get("state_v_first", False)), IS_VARLEN=False,
+        )
+        native_wall = time.perf_counter() - t0
+
+    torch.npu.synchronize()
+
+    timings = dict(getattr(tuner, "configs_timings", {}) or {})
+    raw_best = getattr(tuner, "best_config", None)
+    if raw_best is None and timings:
+        raw_best = min(timings, key=lambda c: _median_ms(timings[c]))
+    if raw_best is None:
+        raise RuntimeError("native AutoTilingTuner did not produce best_config")
+
+    # IMPORTANT: the output buffer left by AutoTilingTuner is not guaranteed to
+    # correspond to tuner.best_config.  Older candidate-value versions checked
+    # that stale buffer and could therefore report correctness=True for an
+    # invalid winner.  Explicitly replay candidates in measured-time order on
+    # clean output buffers and choose the fastest *correct* candidate.  This is
+    # a correctness eligibility guard, not an additional performance ranking.
+    from operator_adapters import launch as launch_fixed
+
+    tol = 4e-2 if case["dtype"] == "bfloat16" else 2e-2
+
+    def _clean_replay_tensors():
+        replay = dict(tensors)
+        replay["o"] = torch.empty_like(tensors["o"])
+        if operator == "flash_attention_npu_v8":
+            replay["l"] = torch.empty_like(tensors["l"])
+        return replay
+
+    ordered = sorted(
+        timings.keys(),
+        key=lambda c: (_median_ms(timings[c]), _cfg_sig(_from_tuner_config(operator, c))),
+    )
+    if raw_best not in ordered:
+        ordered.insert(0, raw_best)
+
+    replay0 = time.perf_counter()
+    replay_attempts = []
+    best = None
+    best_cfg = None
+    best_timing = None
+    best_correctness = None
+    for candidate in ordered:
+        cfg = _from_tuner_config(operator, candidate)
+        replay_tensors = _clean_replay_tensors()
+        out_tensor = launch_fixed(operator, module, case, cfg, replay_tensors)
+        torch.npu.synchronize()
+        finite = bool(torch.isfinite(out_tensor).all().item())
+        ok = finite and bool(torch.allclose(out_tensor, ref, atol=tol, rtol=tol, equal_nan=False))
+        diff = (out_tensor.float() - ref.float()).abs()
+        max_abs = float(diff.max().item()) if finite else float("inf")
+        rec = {
+            "config": cfg,
+            "config_signature": _cfg_sig(cfg),
+            "benchmark_latency_ms": _median_ms(timings[candidate]) if candidate in timings else None,
+            "finite": finite,
+            "allclose": ok,
+            "max_abs_error": max_abs,
+        }
+        replay_attempts.append(rec)
+        if ok:
+            best = candidate
+            best_cfg = cfg
+            best_timing = rec["benchmark_latency_ms"]
+            best_correctness = {
+                "allclose": True, "finite": True, "max_abs_error": max_abs,
+                "atol": tol, "rtol": tol,
+            }
+            break
+
+    replay_wall = time.perf_counter() - replay0
+    if best is None or best_cfg is None or best_correctness is None:
+        raise RuntimeError(
+            "native AutoTilingTuner produced no correctness-valid winner after explicit replay; "
+            f"attempts={replay_attempts}"
+        )
+
+    raw_best_cfg = _from_tuner_config(operator, raw_best)
+    raw_best_valid = any(
+        r["config_signature"] == _cfg_sig(raw_best_cfg) and r["allclose"]
+        for r in replay_attempts
+    )
+    rough = getattr(tuner, "last_rough_timings", {}) or {}
+    compiled = list(getattr(tuner, "last_compiled_configs", []) or [])
+    after_time_prune = list(getattr(tuner, "last_time_pruned_configs", []) or [])
+    final_bench = list(timings.keys())
+    compiled_ir_records = []
+    if capture_compiled_ir:
+        for c, artifacts in dict(getattr(tuner, "last_compiled_ir_by_config", {}) or {}).items():
+            rec = {"config": _from_tuner_config(operator, c)}
+            for key in ("ttir", "npuir", "ttir_path", "npuir_path", "available_keys", "capture_error"):
+                if key in artifacts:
+                    rec[key] = artifacts[key]
+            compiled_ir_records.append(rec)
+    return {
+        # Private in-memory payload. V6.8 consumes this after the already-paid
+        # native compile and strips it before writing result JSON. Older callers
+        # never request capture, so their output is unchanged.
+        "_compiled_ir_records": compiled_ir_records,
+        "winner": {"config": best_cfg, "config_signature": _cfg_sig(best_cfg),
+                   "benchmark_latency_ms": best_timing},
+        "correctness": best_correctness,
+        "native": {
+            "raw_autotuner_best_config": raw_best_cfg,
+            "raw_autotuner_best_valid_on_replay": raw_best_valid,
+            "winner_replay_correctness_guard": True,
+            "winner_replay_attempts": replay_attempts,
+            "winner_replay_validation_wall_s": replay_wall,
+            "autotuner_class": type(tuner).__name__,
+            "compile_parallel": bool(getattr(tuner, "compile_parallel", False)),
+            "candidate_value_batch_mode": bool(candidate_value_batch_mode),
+            "native_time_prune_disabled_for_external_batch_controller": bool(candidate_value_batch_mode),
+            "input_config_count": len(configs), "compiled_count": len(compiled),
+            "rough_bench_count": len(rough),
+            "rough_prune_skipped_reason": getattr(tuner, "rough_prune_skipped_reason", None),
+            "after_time_budget_prune_count": len(after_time_prune) if after_time_prune else len(final_bench),
+            "final_benchmark_count": len(final_bench),
+            "compile_time_s": float(getattr(tuner, "compile_time", 0.0) or 0.0),
+            "measure_time_s": float(getattr(tuner, "measure_time", 0.0) or 0.0),
+            "prune_time_s": float(getattr(tuner, "prune_time", 0.0) or 0.0),
+            "native_autotune_wall_s": native_wall,
+            "native_autotune_plus_winner_validation_wall_s": native_wall + replay_wall,
+            "cv_warmup": getattr(tuner, "cv_warmup", None), "cv_repeat": getattr(tuner, "cv_repeat", None),
+            "rough_timings_ms": [
+                {"config": _from_tuner_config(operator, cfg), "latency_ms": float(val)}
+                for cfg, val in rough.items()
+            ],
+            "final_timings": [
+                {"config": _from_tuner_config(operator, cfg), "timing": val, "median_ms": _median_ms(val)}
+                for cfg, val in timings.items()
+            ],
+            "compile_failed_count": len(getattr(tuner, "_compile_failed_configs", []) or []),
+            "runtime_failed_count": len(getattr(tuner, "runtime_failure_records", {}) or {}),
+        },
+    }
+
+
+def _run_isolated_smoke(*, repo: Path, operator: str, case_index: int,
+                        cfg: Mapping[str, Any], cache_dir: Path, output: Path,
+                        timeout_s: int) -> dict[str, Any]:
+    """Run one safety candidate in its own process group and compile cache."""
+    worker = HERE / "candidate_safety_smoke.py"
+    cmd = [
+        sys.executable, str(worker), "--repo", str(repo), "--operator", operator,
+        "--case-index", str(case_index),
+        "--config-json", json.dumps(dict(cfg), sort_keys=True, separators=(",", ":")),
+        "--cache-dir", str(cache_dir), "--output", str(output),
+    ]
+    output.parent.mkdir(parents=True, exist_ok=True)
+    started = time.perf_counter()
+    worker_env = os.environ.copy()
+    worker_env["TRITON_DUMP_DIR"] = str((cache_dir / "triton_dump").resolve())
+    proc = subprocess.Popen(
+        cmd, cwd=repo, env=worker_env, text=True,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
+    )
+    try:
+        stdout, stderr = proc.communicate(timeout=max(30, int(timeout_s)))
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        unreaped = False
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            # A D-state Ascend runtime process may ignore SIGKILL until the
+            # driver call returns. Do not block the supervisor indefinitely.
+            stdout, stderr = "", ""
+            unreaped = True
+        rec = {
+            "operator": operator, "case_index": case_index, "config": dict(cfg),
+            "status": "timeout_unreaped" if unreaped else "timeout", "returncode": 124,
+            "supervisor_wall_s": time.perf_counter() - started,
+            "stdout_tail": (stdout or "")[-4000:], "stderr_tail": (stderr or "")[-12000:],
+            "process_group_killed": True, "process_unreaped_after_sigkill": unreaped,
+        }
+        write_json(output, rec)
+        return rec
+
+    rec: dict[str, Any] = {}
+    if output.is_file():
+        try:
+            rec = json.loads(output.read_text(encoding="utf-8"))
+        except Exception:
+            rec = {}
+    rec.update({
+        "returncode": int(proc.returncode), "supervisor_wall_s": time.perf_counter() - started,
+        "stdout_tail": (stdout or "")[-4000:], "stderr_tail": (stderr or "")[-12000:],
+        "process_group_isolated": True,
+    })
+    rec.setdefault("status", "safe" if proc.returncode == 0 else "runtime_fault")
+    write_json(output, rec)
+    return rec
+
+
+def _static_filter_rows(operator: str, case: Mapping[str, Any], rows: list[dict[str, Any]]):
+    from backend.runtime.precompile_safety import check_source_safety
+    t0 = time.perf_counter()
+    kept, rejected = [], []
+    for row in rows:
+        cfg = dict(row["config"])
+        gate = check_source_safety(
+            operator, case, cfg,
+            dtype_bytes=2 if str(case.get("dtype")) in {"float16", "bfloat16"} else 4,
+            num_stages=3,
+        )
+        rr = {**row, "source_safety": gate}
+        if gate.get("safe", False):
+            kept.append(rr)
+        else:
+            rejected.append(rr)
+    return kept, rejected, time.perf_counter() - t0
+
+
+def _select_certified(*, repo: Path, operator: str, case_index: int, case: Mapping[str, Any],
+                      ranked_rows: list[dict[str, Any]], target_k: int,
+                      official_rows: list[dict[str, Any]], mode: str,
+                      registry_path: Path, safety_cache_root: Path,
+                      output_dir: Path, timeout_s: int, campaign_id: str):
+    """Apply execution-safety evidence strictly after ranking is frozen.
+
+    V5.3 has no built-in geometry whitelist and no B0/source-official safety
+    privilege. Every statically legal candidate follows the same registry rule.
+    Warm mode accepts only certificates produced by the current campaign.
+    """
+    from backend.runtime.safety_registry import SafetyRegistry, certificate_payload
+
+    registry = SafetyRegistry(registry_path)
+    selected: list[dict[str, Any]] = []
+    records: list[dict[str, Any]] = []
+    counts = {
+        "registry_safe": 0, "registry_unsafe": 0, "registry_unknown": 0,
+        "registry_foreign_campaign": 0, "cold_smoke_safe": 0,
+        "cold_smoke_unsafe": 0,
+    }
+    smoke_wall = 0.0
+    t0 = time.perf_counter()
+    smoke_root = output_dir / "safety_certification"
+    smoke_root.mkdir(parents=True, exist_ok=True)
+    canary_cfg = dict(official_rows[0]["config"])
+
+    for rank_idx, row in enumerate(ranked_rows, 1):
+        if len(selected) >= target_k:
+            break
+        cfg = dict(row["config"])
+        rec: dict[str, Any] = {"rank": rank_idx, "config": cfg, "origin_stage": row.get("origin_stage")}
+        payload = certificate_payload(repo=repo, operator=operator, case=case, cfg=cfg)
+
+        stored = registry.lookup(payload)
+        if stored is not None:
+            status = str(stored.get("status", "")).upper()
+            evidence = dict(stored.get("evidence") or {})
+            stored_campaign = str(evidence.get("campaign_id", ""))
+            rec["registry"] = {"key": stored.get("key"), "status": status, "campaign_id": stored_campaign}
+            if stored_campaign != campaign_id:
+                counts["registry_foreign_campaign"] += 1
+                stored = None
+            elif status == "SAFE":
+                counts["registry_safe"] += 1
+                rec["decision"] = "keep_registry_safe_current_campaign"
+                selected.append(row); records.append(rec); continue
+            elif status == "UNSAFE":
+                counts["registry_unsafe"] += 1
+                rec["decision"] = "reject_registry_unsafe_current_campaign"
+                records.append(rec); continue
+
+        counts["registry_unknown"] += 1
+        if mode == "warm":
+            rec["decision"] = "skip_registry_unknown_warm"
+            records.append(rec)
+            continue
+
+        candidate_cache = safety_cache_root / f"rank_{rank_idx:04d}_{payload['source_sha256'][:8]}"
+        shutil.rmtree(candidate_cache, ignore_errors=True)
+        candidate_cache.mkdir(parents=True, exist_ok=True)
+        probe_path = smoke_root / f"rank_{rank_idx:04d}.json"
+        probe = _run_isolated_smoke(
+            repo=repo, operator=operator, case_index=case_index, cfg=cfg,
+            cache_dir=candidate_cache, output=probe_path, timeout_s=timeout_s,
+        )
+        smoke_wall += float(probe.get("supervisor_wall_s", 0.0) or 0.0)
+        rec["runtime_probe"] = probe
+        if probe.get("status") == "safe" and int(probe.get("returncode", 1)) == 0:
+            registry.record(payload, status="SAFE", evidence={
+                "kind": "isolated_first_launch", "campaign_id": campaign_id,
+                "probe_path": str(probe_path), "correctness": probe.get("correctness"),
+            })
+            counts["cold_smoke_safe"] += 1
+            rec["decision"] = "keep_cold_certified_safe"
+            selected.append(row); records.append(rec); continue
+
+        registry.record(payload, status="UNSAFE", evidence={
+            "kind": "isolated_first_launch_fault", "campaign_id": campaign_id,
+            "probe_path": str(probe_path), "status": probe.get("status"),
+            "error_type": probe.get("error_type"), "error_tail": str(probe.get("error", ""))[-2000:],
+        })
+        counts["cold_smoke_unsafe"] += 1
+        rec["decision"] = "reject_cold_certified_unsafe"
+        records.append(rec)
+
+        if probe.get("process_unreaped_after_sigkill"):
+            write_json(smoke_root / "records_partial.json", {"records": records})
+            raise RuntimeError(
+                f"isolated safety process at rank {rank_idx} could not be reaped after SIGKILL; aborting shared-device experiment"
+            )
+
+        time.sleep(1.0)
+        canary_cache = safety_cache_root / f"canary_after_rank_{rank_idx:04d}"
+        shutil.rmtree(canary_cache, ignore_errors=True); canary_cache.mkdir(parents=True, exist_ok=True)
+        canary_path = smoke_root / f"recovery_canary_after_rank_{rank_idx:04d}.json"
+        canary = _run_isolated_smoke(
+            repo=repo, operator=operator, case_index=case_index, cfg=canary_cfg,
+            cache_dir=canary_cache, output=canary_path, timeout_s=timeout_s,
+        )
+        smoke_wall += float(canary.get("supervisor_wall_s", 0.0) or 0.0)
+        rec["recovery_canary"] = canary
+        if not (canary.get("status") == "safe" and int(canary.get("returncode", 1)) == 0):
+            write_json(smoke_root / "records_partial.json", {"records": records})
+            raise RuntimeError(
+                f"device did not recover after isolated fault at rank {rank_idx}; known-safe B0 canary failed"
+            )
+
+    total_wall = time.perf_counter() - t0
+    summary = {
+        "schema_version": "candidate_value_v53_safety_registry_v1",
+        "mode": mode, "campaign_id": campaign_id, "target_k": target_k,
+        "ranked_input": len(ranked_rows), "selected": len(selected),
+        "registry_path": str(registry_path),
+        "safety_cache_root": str(safety_cache_root) if mode == "cold" else None,
+        "counts": counts, "registry_stats_after": registry.stats(),
+        "smoke_wall_s": smoke_wall, "total_wall_s": total_wall, "records": records,
+        "historical_geometry_whitelist_used": False,
+        "source_official_safety_privilege": False,
+        "candidate_performance_labels_used": False,
+    }
+    write_json(output_dir / "safety_gate.json", summary)
+    if len(selected) < target_k:
+        msg = f"safety registry coverage insufficient: selected {len(selected)} < target_k {target_k}"
+        if mode == "warm":
+            raise RegistryCoverageError(msg)
+        raise RuntimeError(msg)
+    return selected, summary
+
+
+def add_expansion_args(ap: argparse.ArgumentParser) -> None:
+    ap.add_argument("--expansion-seed-limit", type=int, default=64)
+    ap.add_argument("--s1-generation-per-seed", type=int, default=32)
+    ap.add_argument("--s1-anchor-budget", type=int, default=12)
+    ap.add_argument("--s1-max-new", type=int, default=48)
+    ap.add_argument("--s2-max-domain-product", type=int, default=512)
+    ap.add_argument("--s2-candidates-per-region", type=int, default=4)
+    ap.add_argument("--s2-sparse-region-threshold", type=int, default=1)
+    ap.add_argument("--s2-max-new", type=int, default=64)
+    ap.add_argument("--s3-max-new", type=int, default=96)
+    ap.add_argument("--s3-factorial-reserve", type=int, default=24)
+    ap.add_argument("--s3-generations", type=int, default=2)
+    ap.add_argument("--s3-parent-k", type=int, default=12)
+    ap.add_argument("--s3-population", type=int, default=32)
+    ap.add_argument("--s3-mutation-per-parent", type=int, default=8)
+    ap.add_argument("--seed", type=int, default=17)
+
+
+def run(args: argparse.Namespace) -> dict[str, Any]:
+    repo = args.repo.resolve(); out = args.output_dir.resolve(); out.mkdir(parents=True, exist_ok=True)
+    native_cache = args.cache_dir.resolve()
+    if args.reset_cache and native_cache.exists():
+        shutil.rmtree(native_cache)
+    native_cache.mkdir(parents=True, exist_ok=True)
+    if args.method != "official":
+        registry_path = args.safety_registry.resolve()
+        safety_cache_path = args.safety_cache_dir.resolve()
+        if _paths_overlap(native_cache, safety_cache_path):
+            raise RuntimeError(f"native/safety cache paths overlap: {native_cache} vs {safety_cache_path}")
+        if _paths_overlap(native_cache, registry_path.parent):
+            raise RuntimeError(f"native cache overlaps safety registry directory: {native_cache} vs {registry_path.parent}")
+    # Native cache is never passed to certification workers.
+    os.environ["TRITON_CACHE_DIR"] = str(native_cache)
+    os.environ["TRITON_DUMP_DIR"] = str(out / "triton_dump")
+    os.environ.setdefault("TRITON_AUTOTUNE_PARALLEL_COMPILE", "1")
+
+    import fresh_end_to_end_value_eval as helper
+    from cases import get_cases
+    from backend.runtime.precompile_source_prefilter import rank_configs, ranking_model_provenance
+    from triton.runtime.autotuner import Config
+
+    case = dict(get_cases(args.operator)[args.case_index])
+    process0 = time.perf_counter()
+    preflight0 = time.perf_counter()
+    official_gen0 = time.perf_counter()
+    official_rows = helper.official_pool(args.operator)
+    official_generation_wall = time.perf_counter() - official_gen0
+    expansion_wall = static_wall = prefilter_wall = cert_wall = 0.0
+    full_pool_count = len(official_rows); legal_pool_count = len(official_rows)
+    pool_meta: dict[str, Any] = {"stage_origin_counts": {"B0": len(official_rows), "S1": 0, "S2": 0, "S3": 0}}
+    safety_summary = None; static_rejected_rows: list[dict[str, Any]] = []
+
+    if args.method == "official":
+        selected_rows = list(official_rows)
+        selected_cfgs = [dict(r["config"]) for r in selected_rows]
+    else:
+        gen0 = time.perf_counter()
+        pool, pool_meta = helper.build_model_free_pool(repo, args.operator, case, helper.expansion_namespace(args))
+        expansion_wall = time.perf_counter() - gen0
+        full_pool_count = len(pool)
+        expansion_stats = dict(pool_meta.get("expansion_stats") or {})
+        modeling = dict(expansion_stats.get("modeling") or {})
+        runtime_model = dict(expansion_stats.get("model_runtime") or {})
+        if not bool(expansion_stats.get("generation_only")):
+            raise RuntimeError("V5.3 requires generation_only=True for S1/S2/S3")
+        if not bool(modeling.get("generation_only_no_model_scoring")):
+            raise RuntimeError("V5.3 expansion contract violated: generation model scoring enabled")
+        if any(int(runtime_model.get(k, 0) or 0) for k in (
+            "light_attempted", "light_succeeded", "formal_attempted", "formal_succeeded", "fallback_used"
+        )):
+            raise RuntimeError(f"V5.3 expansion unexpectedly invoked a model: {runtime_model}")
+        write_json(out / "candidate_pool.json", pool_meta)
+
+        # V5.3: hard source-safety executes BEFORE the single performance ranking.
+        legal_rows, static_rejected_rows, static_wall = _static_filter_rows(args.operator, case, list(pool))
+        legal_pool_count = len(legal_rows)
+        write_json(out / "static_safety.json", {
+            "full_pool_count": full_pool_count, "legal_pool_count": legal_pool_count,
+            "static_rejected_count": len(static_rejected_rows), "rejected": static_rejected_rows,
+        })
+        if not legal_rows:
+            raise RuntimeError("static safety removed the entire expanded pool")
+
+        triton_configs = [Config(dict(row["config"]), num_warps=4, num_stages=3) for row in legal_rows]
+        rank_opts = {
+            "operator_family": "flash_attention" if args.operator == "flash_attention_npu_v8" else "chunk_o",
+            "hardware_profile": "ascend_910b3_v4", "light_detect_hardware": False, "num_cores": 20,
+            "dtype_bytes": 2 if case["dtype"] in ("float16", "bfloat16") else 4,
+            "causal": bool(case.get("causal", True)),
+        }
+        rank_args = _rank_args(args.operator, case)
+        model_provenance = ranking_model_provenance()
+        effective_ranking_input = {
+            "operator": args.operator, "case_index": args.case_index,
+            "case": case, "configs": [dict(c.kwargs) for c in triton_configs],
+            "rank_args": rank_args, "rank_opts": rank_opts,
+        }
+        forbidden_hits = _forbidden_ranking_input_paths(effective_ranking_input)
+        if forbidden_hits:
+            raise RuntimeError(f"forbidden performance-like fields entered ranking input: {forbidden_hits}")
+        write_json(out / "ranking_input_manifest.json", {
+            "schema_version": "candidate_value_v53_ranking_input_v1",
+            "effective_ranking_input": effective_ranking_input,
+            "model_provenance": model_provenance,
+            "forbidden_ranking_input_paths": forbidden_hits,
+        })
+        rank0 = time.perf_counter()
+        ranked_cfgs, records = rank_configs(triton_configs, rank_args, rank_opts)
+        prefilter_wall = time.perf_counter() - rank0
+        row_by_sig = {_cfg_sig(row["config"]): row for row in legal_rows}
+        ranking_rows = []
+        for cfg in ranked_cfgs:
+            raw = dict(cfg.kwargs); row = dict(row_by_sig[_cfg_sig(raw)])
+            ranking_rows.append({**row, "precompile_source_prefilter": dict(records[cfg])})
+
+        ranking_digest_before_safety = _ranking_digest(ranking_rows)
+        write_json(out / "ranking_freeze.json", {
+            "schema_version": "candidate_value_v53_ranking_freeze_v1",
+            "ranking_digest": ranking_digest_before_safety,
+            "ranked_count": len(ranking_rows),
+            "safety_registry_read_before_ranking": False,
+            "historical_v51_v52_evidence_read": False,
+            "forbidden_ranking_input_paths": forbidden_hits,
+            "model_provenance": model_provenance,
+        })
+        n0 = len(official_rows)
+        k = min(len(ranking_rows), max(1, int(math.ceil(float(args.budget_ratio) * n0))))
+        cert0 = time.perf_counter()
+        cert_mode = "cold" if args.method == "ours_cold_cert" else "warm"
+        selected_rows, safety_summary = _select_certified(
+            repo=repo, operator=args.operator, case_index=args.case_index, case=case,
+            ranked_rows=ranking_rows, target_k=k, official_rows=official_rows, mode=cert_mode,
+            registry_path=args.safety_registry.resolve(), safety_cache_root=args.safety_cache_dir.resolve(),
+            output_dir=out, timeout_s=args.safety_smoke_timeout_s, campaign_id=args.registry_campaign_id,
+        )
+        cert_wall = time.perf_counter() - cert0
+        ranking_digest_after_safety = _ranking_digest(ranking_rows)
+        if ranking_digest_after_safety != ranking_digest_before_safety:
+            raise RuntimeError("ranking changed after safety lookup/certification")
+        write_json(out / "leakage_audit.json", {
+            "schema_version": "candidate_value_v53_leakage_audit_v1",
+            "ranking_digest_before_safety": ranking_digest_before_safety,
+            "ranking_digest_after_safety": ranking_digest_after_safety,
+            "ranking_immutable_across_safety": True,
+            "candidate_latency_labels_used_for_ranking": False,
+            "candidate_msprof_labels_used_for_ranking": False,
+            "candidate_winner_labels_used_for_ranking": False,
+            "safety_registry_read_before_ranking": False,
+            "historical_v51_v52_registry_seed_used": False,
+            "historical_hardware_valid_geometry_whitelist_used": False,
+            "expansion_generation_only": True,
+            "expansion_light_ttir_attempted": int(runtime_model.get("light_attempted", 0) or 0),
+            "expansion_formal_attempted": int(runtime_model.get("formal_attempted", 0) or 0),
+            "source_official_safety_privilege": False,
+            "external_hardware_microbenchmark_calibration_used": bool(model_provenance.get("uses_external_hardware_microbenchmark_calibration")),
+            "external_calibration_candidate_independent": bool(model_provenance.get("external_calibration_is_case_candidate_independent")),
+            "forbidden_ranking_input_paths": forbidden_hits,
+            "pass": True,
+        })
+        selected_cfgs = [dict(r["config"]) for r in selected_rows]
+        write_json(out / "precompile_ranked_pool.json", {
+            "schema_version": "candidate_value_v53_precompile_rank_v1",
+            "operator": args.operator, "case_index": args.case_index,
+            "full_pool_count": full_pool_count, "legal_pool_count": legal_pool_count,
+            "static_rejected_count": len(static_rejected_rows),
+            "official_count_reference": n0, "budget_ratio": float(args.budget_ratio),
+            "compile_budget": k, "b0_privileged": False,
+            "model_kind": "deca_source_frontend_v3", "shared_deca_execution_core": True,
+            "certified_selected": [dict(r["config"]) for r in selected_rows], "ranked": ranking_rows,
+        })
+
+    preflight_wall = time.perf_counter() - preflight0
+
+    # Parent NPU context and native compilation begin only after safety selection.
+    torch, module, tensors, ref, source, setup_wall = _prepare_once(repo, args.operator, case, dict(official_rows[0]["config"]))
+    native = _native_tune(operator=args.operator, case=case, module=module, tensors=tensors,
+                          ref=ref, torch=torch, selected_cfgs=selected_cfgs)
+    native_wall = float(native["native"]["native_autotune_wall_s"])
+    autotune_wall = preflight_wall + native_wall
+    winner = native["winner"]
+    winner["origin_stage"] = next(
+        (r.get("origin_stage") for r in selected_rows if _cfg_sig(r["config"]) == winner["config_signature"]),
+        "B0" if args.method == "official" else None,
+    )
+
+    msprof = None
+    if args.run_msprof:
+        env = os.environ.copy()
+        msprof = helper.profile_winner(repo, CAL / "worker.py", args.operator, args.case_index, winner,
+                                       out / "msprof_winner", env, args.msprof_warmup, args.msprof_iterations)
+
+    result = {
+        "schema_version": "candidate_value_native_autotune_v5_3",
+        "method": args.method, "operator": args.operator, "case_index": args.case_index,
+        "case": case, "source": str(source), "native_cache_dir": str(native_cache),
+        "safety_registry": None if args.method == "official" else str(args.safety_registry.resolve()),
+        "safety_cache_dir": None if args.method != "ours_cold_cert" else str(args.safety_cache_dir.resolve()),
+        "official_count": len(official_rows), "full_pool_count": full_pool_count,
+        "legal_pool_count": legal_pool_count, "static_rejected_count": len(static_rejected_rows),
+        "compile_budget": len(selected_cfgs),
+        "selected_origin_counts": {
+            stage: sum(str(r.get("origin_stage")) == stage for r in selected_rows)
+            for stage in ("B0", "S1", "S2", "S3")
+        },
+        "winner": winner, "winner_msprof": msprof, "correctness": native["correctness"],
+        "native_autotuner": native["native"], "safety_gate": safety_summary,
+        "timing": {
+            "setup_outside_autotune_wall_s": setup_wall,
+            "official_candidate_generation_wall_s": official_generation_wall,
+            "candidate_generation_or_expansion_wall_s": expansion_wall,
+            "static_safety_wall_s": static_wall,
+            "precompile_source_prefilter_wall_s": prefilter_wall,
+            "safety_certification_or_lookup_wall_s": cert_wall,
+            "full_vtriton_formal_wall_s": 0.0, "deca_dsr_wall_s": 0.0,
+            "native_autotuner_wall_s": native_wall, "autotune_core_wall_s": autotune_wall,
+            "whole_process_wall_s_including_setup_and_winner_msprof": time.perf_counter() - process0,
+            "winner_msprof_included_in_autotune_core": False,
+        },
+        "pool_meta": pool_meta,
+        "ranking_digest": None if args.method == "official" else ranking_digest_before_safety,
+        "leakage_audit_path": None if args.method == "official" else str(out / "leakage_audit.json"),
+        "registry_campaign_id": None if args.method == "official" else args.registry_campaign_id,
+        "contract": {
+            "online_full_vtriton_formal": False, "online_deca_dsr": False,
+            "shared_deca_execution_core": True, "source_frontend_model_kind": "deca_source_frontend_v3",
+            "static_safety_before_performance_rank": args.method != "official",
+            "prefilter_before_compile": True, "prefilter_uses_ttir": False,
+            "safety_registry_has_performance_labels": False,
+            "historical_geometry_whitelist_used": False,
+            "historical_v51_v52_registry_seed_used": False,
+            "expansion_generation_only_no_model_scoring": args.method != "official",
+            "ranking_frozen_before_safety_lookup": args.method != "official",
+            "external_hardware_microbenchmark_calibration_used": args.method != "official",
+            "external_hardware_calibration_is_candidate_independent": args.method != "official",
+            "safety_and_native_compile_cache_physically_separate": args.method != "official",
+            "warm_cert_never_launches_unknown_config": args.method == "ours_warm_cert",
+            "b0_privileged": False, "native_parallel_compile_reused": True,
+            "native_one_shot_rough_benchmark_reused_when_it_can_prune": True,
+            "native_time_budget_prune_reused": True, "native_final_benchmark_selects_winner": True,
+            "msprof_selects_winner": False,
+        },
+    }
+    write_json(out / "result.json", result)
+    print(json.dumps({
+        "method": args.method, "operator": args.operator, "case_index": args.case_index,
+        "pool": full_pool_count, "legal_pool": legal_pool_count, "compile_budget": len(selected_cfgs),
+        "compiled": native["native"]["compiled_count"], "final_bench": native["native"]["final_benchmark_count"],
+        "autotune_s": autotune_wall, "winner": winner,
+    }, ensure_ascii=False))
+    print("OUTPUT=", out / "result.json")
+    return result
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo", type=Path, required=True)
+    ap.add_argument("--output-dir", type=Path, required=True)
+    ap.add_argument("--cache-dir", type=Path, required=True, help="fresh native autotuner compile cache")
+    ap.add_argument("--reset-cache", action="store_true")
+    ap.add_argument("--method", choices=("official", "ours_cold_cert", "ours_warm_cert"), required=True)
+    ap.add_argument("--operator", choices=("flash_attention_npu_v8", "chunk_o"), required=True)
+    ap.add_argument("--case-index", type=int, required=True)
+    ap.add_argument("--budget-ratio", type=float, default=1.0)
+    ap.add_argument("--safety-registry", type=Path, default=Path("/tmp/vtriton_safety_registry_v52.json"))
+    ap.add_argument("--safety-cache-dir", type=Path, default=Path("/tmp/vtriton_safety_cache_v52"))
+    ap.add_argument("--safety-smoke-timeout-s", type=int, default=90)
+    ap.add_argument("--registry-campaign-id", default="v53_current_campaign")
+    ap.add_argument("--run-msprof", action="store_true")
+    ap.add_argument("--msprof-warmup", type=int, default=10)
+    ap.add_argument("--msprof-iterations", type=int, default=60)
+    add_expansion_args(ap)
+    args = ap.parse_args()
+    try:
