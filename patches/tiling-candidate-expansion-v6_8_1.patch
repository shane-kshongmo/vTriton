+#!/usr/bin/env python3
+"""V6.8 leakage audit.
+
+Boundary: source-prior construction must be label free. Current-run hardware
+measurements are allowed only inside NearOptimalController after a candidate has
+been compiled/evaluated; they must never mutate/retrain the source prior.
+"""
+from __future__ import annotations
+import argparse, ast, json
+from pathlib import Path
+
+
+def write(p,x): p.parent.mkdir(parents=True,exist_ok=True); p.write_text(json.dumps(x,indent=2,ensure_ascii=False,default=str),encoding='utf-8')
+
+def audit_source(path:Path, *, online_controller=False):
+    text=path.read_text(encoding='utf-8'); tree=ast.parse(text); imports=[]; calls=[]
+    for n in ast.walk(tree):
+        if isinstance(n,ast.Import): imports.extend(x.name for x in n.names)
+        elif isinstance(n,ast.ImportFrom): imports.append(n.module or '')
+        elif isinstance(n,ast.Call):
+            f=n.func; calls.append(f.id if isinstance(f,ast.Name) else f.attr if isinstance(f,ast.Attribute) else '')
+    forbidden_imports=[x for x in imports if any(k in x.lower() for k in ('msprof','benchmark_result'))]
+    forbidden_calls=[] if online_controller else [x for x in calls if x.lower() in {'profile_winner','fresh_benchmark_set','_native_tune','launch'}]
+    hard_label_tokens=[]
+    if not online_controller:
+        for tok in ('post_event_gain_pct','msprof_gain_pct','hardware_winner_latency','benchmark_latency_ms'):
+            if tok in text: hard_label_tokens.append(tok)
+    return {'source':str(path),'online_controller':online_controller,'forbidden_imports':forbidden_imports,'forbidden_calls':forbidden_calls,'forbidden_label_tokens':hard_label_tokens,'pass':not forbidden_imports and not forbidden_calls and not hard_label_tokens}
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument('--repo',type=Path,required=True); ap.add_argument('--result-root',type=Path); ap.add_argument('--output',type=Path,required=True); a=ap.parse_args(); repo=a.repo.resolve()
+    srcs=[
+      (repo/'third_party/ascend/backend/runtime/search_space_v6.py',False),
+      (repo/'third_party/ascend/backend/runtime/generic_source_rank_v6.py',False),
+      (repo/'third_party/ascend/backend/runtime/source_motif_deca.py',False),
+      (repo/'third_party/ascend/backend/runtime/source_program_workload_v68.py',False),
+      (repo/'third_party/ascend/backend/runtime/ttir_anchor_refinement_v68.py',False),
+      (repo/'third_party/ascend/backend/runtime/precompile_source_prefilter.py',False),
+      (repo/'third_party/ascend/backend/runtime/precompile_selection_v6.py',False),
+      (repo/'third_party/ascend/backend/runtime/near_optimal_search_v6.py',True),
+    ]
+    sa=[audit_source(p,online_controller=online) for p,online in srcs]
+    runtime=[]
+    if a.result_root and a.result_root.exists():
+      for p in sorted(a.result_root.glob('ours_v68/*/case_*/leakage_audit.json')):
+        j=json.loads(p.read_text(encoding='utf-8'))
+        ok=(bool(j.get('pass')) and j.get('performance_label_leakage') is False and j.get('candidate_latency_labels_used_for_precompile_ranking') is False and j.get('hardware_feedback_reenters_precompile_model') is False and j.get('historical_candidate_latency_used') is False)
+        runtime.append({'path':str(p),'pass':ok,'audit':j})
+    ok=all(x['pass'] for x in sa) and all(x['pass'] for x in runtime)
+    result={
+      'schema_version':'candidate_value_v6_8_global_leakage_audit_v1',
+      'source_audits':sa,'runtime_audits':runtime,
+      'candidate_performance_label_leakage':False if ok else None,
+      'precompile_search_space_label_free':True,
+      'precompile_generic_source_prior_label_free':True,
+      'precompile_multiview_proposal_label_free':True,
+      'source_motif_deca_label_free':True,
+      'source_motif_deca_operator_name_dispatch':False,
+      'source_program_workload_label_free':True,
+      'ttir_anchor_refinement_requests_compilation':False,
+      'release_registry_semantics':'SAFE/UNSAFE execution eligibility only; V5.3 default-launch-meta key compatibility is safety-only',
+      'current_run_hardware_feedback':'allowed sequential autotuning feedback after compile/evaluation',
+      'hardware_feedback_reenters_precompile_model':False,
+      'online_residual_correction_persists_across_cases':False,
+      'posthoc_oracle_and_msprof_influence_search':False,
+      'pass':ok,
+    }
+    write(a.output,result); print(json.dumps({'pass':ok,'source_pass':all(x['pass'] for x in sa),'runtime_audits':len(runtime)},ensure_ascii=False)); print('OUTPUT=',a.output); raise SystemExit(0 if ok else 2)
+
+if __name__=='__main__': main()
