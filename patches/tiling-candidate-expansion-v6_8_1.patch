+"""Central Ascend hardware discovery and calibration for analytical TTIR models.
+
+Resolution order is correctness-first and deterministic:
+
+1. explicit numeric overrides (UB/core/rates),
+2. explicit ``hardware_profile``,
+3. the active Triton Ascend target/device (queried once per process),
+4. architecture environment variables,
+5. the repository default profile.
+
+Only target identity and core counts are queried from the live device.  Usable
+UB and sustained rates remain versioned profile/calibration values because the
+runtime driver does not expose reliable autotune-safe capacities or sustained
+throughput.  Callers can disable live probing with ``light_detect_hardware=False``.
+"""
+from __future__ import annotations
+
+import json
+import os
+from dataclasses import dataclass, replace
+from functools import lru_cache
+from pathlib import Path
+from typing import Any, Mapping
+
+
+@dataclass(frozen=True, slots=True)
+class AscendHardwareProfile:
+    name: str
+    arch: str
+    cube_rate: float
+    vector_rate: float
+    exp_rate: float
+    reduce_rate: float
+    mask_rate: float
+    mte_bandwidth: float
+    ub_bytes: int
+    physical_ub_bytes: int
+    cube_cores: int
+    vector_cores: int
+    source: str = "profile"
+    calibration_version: str = "builtin-v1"
+
+    @property
+    def cores(self) -> int:  # backward compatibility
+        return self.cube_cores
+
+    def fingerprint(self) -> tuple[Any, ...]:
+        return (
+            self.name, self.arch, self.cube_rate, self.vector_rate,
+            self.exp_rate, self.reduce_rate, self.mask_rate,
+            self.mte_bandwidth, self.ub_bytes, self.physical_ub_bytes,
+            self.cube_cores, self.vector_cores, self.calibration_version,
+        )
+
+
+HARDWARE_PROFILES: dict[str, AscendHardwareProfile] = {
+    "ascend_910b3_v4": AscendHardwareProfile(
+        "ascend_910b3_v4", "Ascend910B3", 5.158556255844857e6, 1.5133235851136872e4, 3.3286395599187757e3, 1.5133235851136872e4,
+        1.5133235851136872e4, 1.4111277942025853e5, 256 * 1024, 256 * 1024, 20, 40,
+        calibration_version="embedded-vtriton-910b3-v1",
+    ),
+    "ascend_a5_910_95": AscendHardwareProfile(
+        "ascend_a5_910_95", "Ascend910_95", 5.158556255844857e6, 1.5133235851136872e4, 3.3286395599187757e3, 1.5133235851136872e4,
+        1.5133235851136872e4, 1.4111277942025853e5, 248 * 1024, 256 * 1024, 20, 40,
+        calibration_version="provisional-from-910b3-vtriton",
+    ),
+    "ascend_a5_950": AscendHardwareProfile(
+        "ascend_a5_950", "Ascend950", 5.158556255844857e6, 1.5133235851136872e4, 3.3286395599187757e3, 1.5133235851136872e4,
+        1.5133235851136872e4, 1.4111277942025853e5, 248 * 1024, 256 * 1024, 20, 40,
+        calibration_version="provisional-from-910b3-vtriton",
+    ),
+    "legacy_192kb": AscendHardwareProfile(
+        "legacy_192kb", "legacy", 5.158556255844857e6, 1.5133235851136872e4, 3.3286395599187757e3, 1.5133235851136872e4,
+        1.5133235851136872e4, 1.4111277942025853e5, 192 * 1024, 192 * 1024, 20, 20,
+        calibration_version="legacy-provisional",
+    ),
+}
+
+DEFAULT_HARDWARE_PROFILE = "ascend_910b3_v4"
+DEFAULT_ASCEND_HARDWARE = HARDWARE_PROFILES[DEFAULT_HARDWARE_PROFILE]
+DEFAULT_UB_CAPACITY_BYTES = DEFAULT_ASCEND_HARDWARE.ub_bytes
+DEFAULT_NUM_CORES = DEFAULT_ASCEND_HARDWARE.cube_cores
+
+_ARCH_ENV_KEYS = (
+    "TRITON_ASCEND_ARCH", "ASCEND_ARCH", "SOC_VERSION", "ASCEND_SOC_VERSION",
+)
+
+
+def _normalize_arch(value: Any) -> str:
+    return str(value or "").strip().lower().replace("-", "_")
+
+
+def _profile_name_for_arch(value: Any) -> str | None:
+    arch = _normalize_arch(value)
+    if not arch:
+        return None
+    if arch.startswith("ascend910_95") or "910_95" in arch or "910_9599" in arch:
+        return "ascend_a5_910_95"
+    if arch.startswith("ascend950") or "ascend_950" in arch or arch == "950":
+        return "ascend_a5_950"
+    if "910b3" in arch or "910b" in arch or "910_93" in arch:
+        return "ascend_910b3_v4"
+    return None
+
+
+@lru_cache(maxsize=1)
+def detect_runtime_hardware() -> dict[str, Any]:
+    """Best-effort live target detection, cached once per process.
+
+    Import and driver failures are intentionally swallowed so CPU-only model
+    validation and compile-only workflows remain supported.
+    """
+    detected: dict[str, Any] = {"source": "none"}
+    try:
+        from triton.runtime.driver import driver  # lazy: compiled backend optional
+        target = driver.active.get_current_target()
+        detected["arch"] = str(getattr(target, "arch", "") or "")
+        detected["source"] = "triton_driver"
+        try:
+            device = driver.active.get_current_device()
+            props = driver.active.utils.get_device_properties(device) or {}
+            for key in ("num_aicore", "num_vectorcore"):
+                if props.get(key) is not None:
+                    detected[key] = int(props[key])
+            detected["device"] = str(device)
+        except Exception as exc:  # target is still useful
+            detected["device_error"] = type(exc).__name__
+    except Exception as exc:
+        detected["error"] = type(exc).__name__
+    return detected
+
+
+def clear_runtime_hardware_cache() -> None:
+    detect_runtime_hardware.cache_clear()
+
+
+def _env_arch() -> str:
+    for key in _ARCH_ENV_KEYS:
+        value = os.getenv(key)
+        if value:
+            return value
+    return ""
+
+
+@lru_cache(maxsize=16)
+def _load_calibration_path(path_text: str) -> dict[str, Any]:
+    path = Path(path_text).expanduser()
+    if not path.is_file():
+        raise FileNotFoundError(f"Light TTIR calibration file not found: {path}")
+    data = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(data, dict):
+        raise ValueError("Light TTIR calibration must be a JSON object")
+    return data
+
+
+def _load_calibration(path_value: Any) -> dict[str, Any]:
+    if not path_value:
+        return {}
+    return _load_calibration_path(str(Path(str(path_value)).expanduser().resolve()))
+
+
+def resolve_hardware_profile(options: Mapping[str, Any] | None) -> AscendHardwareProfile:
+    opts = options or {}
+    explicit = opts.get("hardware_profile", opts.get("light_hardware_profile"))
+    runtime: dict[str, Any] = {}
+    arch = opts.get("arch", opts.get("target_arch", opts.get("device_arch")))
+
+    if explicit is not None:
+        key = str(explicit).strip().lower()
+        if key not in HARDWARE_PROFILES:
+            known = ", ".join(sorted(HARDWARE_PROFILES))
+            raise ValueError(f"unknown hardware profile {explicit!r}; expected one of: {known}")
+    else:
+        key = _profile_name_for_arch(arch)
+        if key is None and bool(opts.get("light_detect_hardware", True)):
+            runtime = detect_runtime_hardware()
+            key = _profile_name_for_arch(runtime.get("arch"))
+        if key is None:
+            env_arch = _env_arch()
+            key = _profile_name_for_arch(env_arch)
+            if not arch:
+                arch = env_arch
+        key = key or DEFAULT_HARDWARE_PROFILE
+
+    base = HARDWARE_PROFILES[key]
+    if not runtime and bool(opts.get("light_detect_hardware", True)) and explicit is None:
+        runtime = detect_runtime_hardware()
+    detected_arch = str(arch or runtime.get("arch") or base.arch)
+    cube_cores = int(opts.get("num_cores", opts.get("num_cube_cores", runtime.get("num_aicore", base.cube_cores))))
+    vector_cores = int(opts.get("num_vector_cores", runtime.get("num_vectorcore", base.vector_cores)))
+
+    calibration = _load_calibration(opts.get("light_calibration_file"))
+    cal_hw = calibration.get("hardware", calibration) if calibration else {}
+    if not isinstance(cal_hw, Mapping):
+        cal_hw = {}
+
+    def f(option_key: str, cal_key: str, default: float) -> float:
+        return max(1.0, float(opts.get(option_key, cal_hw.get(cal_key, default))))
+
+    ub = max(1, int(opts.get("ub_capacity_bytes", opts.get("ub_size", cal_hw.get("ub_bytes", base.ub_bytes)))))
+    physical_ub = max(ub, int(opts.get("physical_ub_bytes", cal_hw.get("physical_ub_bytes", base.physical_ub_bytes))))
+    version = str(calibration.get("version", base.calibration_version)) if calibration else base.calibration_version
+    source = "explicit" if explicit is not None else str(runtime.get("source", "profile"))
+
+    return replace(
+        base,
+        arch=detected_arch,
+        cube_rate=f("light_cube_ops_per_us", "cube_rate", base.cube_rate),
+        vector_rate=f("light_vector_elementwise_ops_per_us", "vector_rate", base.vector_rate),
+        exp_rate=f("light_vector_exp_ops_per_us", "exp_rate", base.exp_rate),
+        reduce_rate=f("light_vector_reduce_ops_per_us", "reduce_rate", base.reduce_rate),
+        mask_rate=f("light_vector_mask_ops_per_us", "mask_rate", base.mask_rate),
+        mte_bandwidth=f("light_mte_bytes_per_us", "mte_bandwidth", base.mte_bandwidth),
+        ub_bytes=ub,
+        physical_ub_bytes=physical_ub,
+        cube_cores=max(1, cube_cores),
+        vector_cores=max(1, vector_cores),
+        source=source,
+        calibration_version=version,
+    )
+
+
+def resolve_ub_capacity(options: Mapping[str, Any] | None) -> int:
+    opts = options or {}
+    if opts.get("ub_capacity_bytes") is not None:
+        return max(1, int(opts["ub_capacity_bytes"]))
+    if opts.get("ub_size") is not None:
+        return max(1, int(opts["ub_size"]))
+    return resolve_hardware_profile(opts).ub_bytes
+
+
+def resolve_num_cores(options: Mapping[str, Any] | None) -> int:
+    opts = options or {}
+    if opts.get("num_cores") is not None:
+        return max(1, int(opts["num_cores"]))
+    return resolve_hardware_profile(opts).cube_cores
+
+
+def resolved_hardware_options(options: Mapping[str, Any] | None) -> dict[str, Any]:
+    """Return options with hardware and calibrated model defaults resolved once."""
+    raw = dict(options or {})
+    if bool(raw.get("_light_hardware_resolved", False)):
+        return raw
+    calibration = _load_calibration(raw.get("light_calibration_file"))
+    model_defaults = calibration.get("model_defaults", {}) if calibration else {}
+    if not isinstance(model_defaults, Mapping):
+        raise ValueError("calibration.model_defaults must be a JSON object")
+    # Calibration supplies defaults only; command-line/caller values always win.
+    opts = dict(model_defaults)
+    opts.update(raw)
+    hw = resolve_hardware_profile(opts)
+    opts.update({
+        "hardware_profile": hw.name,
+        "arch": hw.arch,
+        "num_cores": hw.cube_cores,
+        "num_vector_cores": hw.vector_cores,
+        "ub_capacity_bytes": hw.ub_bytes,
+        "light_cube_ops_per_us": hw.cube_rate,
+        "light_vector_elementwise_ops_per_us": hw.vector_rate,
+        "light_vector_exp_ops_per_us": hw.exp_rate,
+        "light_vector_reduce_ops_per_us": hw.reduce_rate,
+        "light_vector_mask_ops_per_us": hw.mask_rate,
+        "light_mte_bytes_per_us": hw.mte_bandwidth,
+        "_light_hardware_fingerprint": hw.fingerprint(),
+        "_light_hardware_source": hw.source,
+        "_light_hardware_resolved": True,
+        "_light_calibration_version": hw.calibration_version,
+        "_light_hardware_calibrated": not str(hw.calibration_version).startswith(("provisional", "legacy")),
+    })
+    calibrated = bool(opts["_light_hardware_calibrated"])
+    if bool(opts.get("light_require_measured_calibration", False)) and not calibrated:
+        raise RuntimeError(
+            "Light TTIR requires a measured hardware calibration, but the resolved "
+            f"profile {hw.name!r} uses {hw.calibration_version!r}. Provide "
+            "light_calibration_file or disable light_require_measured_calibration."
+        )
+    confidence_map = calibration.get("confidence_reliability_map", ()) if calibration else ()
+    if confidence_map and "light_confidence_reliability_map" not in opts:
+        opts["light_confidence_reliability_map"] = confidence_map
+    return opts
