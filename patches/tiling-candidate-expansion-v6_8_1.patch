+    text = AUTOTUNER.read_text()
+    assert 'capture_compiled_ir = bool(self.hints.get("capture_compiled_ir", False))' in text
+    assert "if capture_compiled_ir:" in text
+    assert "self.last_compiled_ir_by_config" in text
