index 000000000..5c9e1498e
--- /dev/null
+++ b/third_party/ascend/backend/runtime/precompile_selection_v6.py
@@ -0,0 +1,429 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Final V6 generic proposal ordering.
+
+Search is parameter-schema driven.  Operator names are accepted only for
+backward-compatible diagnostics; they do not determine feature dimensions or
+selection rules.
+"""
+from __future__ import annotations
+
+import math
+import statistics
+from typing import Any, Mapping, Sequence
+
+from .search_space_v6 import (
+    SearchSpaceSpec,
+    config_signature,
+    direction_signature,
+    infer_search_space,
+    structural_coordinates,
+    structural_distance,
+)
+
+
+def _q25(values: Sequence[float]) -> float:
+    vals = sorted(float(v) for v in values)
+    if not vals:
+        return 0.0
+    if len(vals) == 1:
+        return vals[0]
+    pos = 0.25 * (len(vals) - 1)
+    lo, hi = int(math.floor(pos)), int(math.ceil(pos))
+    if lo == hi:
+        return vals[lo]
+    f = pos - lo
+    return vals[lo] * (1 - f) + vals[hi] * f
+
+
+def _source_score(row: Mapping[str, Any]) -> float:
+    rec = dict(row.get("precompile_source_prefilter") or {})
+    # consensus_rank_score is unitless and robust across operator families.
+    if "consensus_rank_score" in rec:
+        return float(rec["consensus_rank_score"])
+    try:
+        return float(rec["score_us_proxy"])
+    except Exception:
+        return float(row.get("source_prior_rank", row.get("raw_deca_rank", 10**9)))
+
+
+def _coordinate_cache(search_space: SearchSpaceSpec, rows: Sequence[Mapping[str, Any]]) -> dict[tuple, tuple[float, ...]]:
+    """Precompute normalized coordinates once per config.
+
+    V5/V6 prototypes repeatedly rebuilt structural feature coordinates inside
+    O(N^2) neighborhood loops.  Final V6 keeps the same exact distance but
+    removes that avoidable Python/object overhead.
+    """
+    return {
+        config_signature(r["config"]): structural_coordinates(search_space, r["config"])
+        for r in rows
+    }
+
+
+def _coord_distance(a: Sequence[float], b: Sequence[float]) -> float:
+    if not a:
+        return 0.0
+    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)) / len(a))
+
+
+def _nearest_neighbor_map(
+    search_space: SearchSpaceSpec, rows: Sequence[Mapping[str, Any]], k: int, coord_by_sig: Mapping[tuple, Sequence[float]],
+) -> dict[tuple, list[tuple]]:
+    """Return structural KNN with a vectorized fast path.
+
+    This keeps full-domain ranking practical for ~10^3-10^4 discrete configs.
+    It avoids the old repeated Python O(N^2) distance construction; the
+    fallback is intentionally simple for environments without NumPy.
+    """
+    sigs = [config_signature(r["config"]) for r in rows]
+    k = max(0, min(int(k), max(0, len(sigs) - 1)))
+    if k == 0:
+        return {s: [] for s in sigs}
+    try:
+        import numpy as np
+        arr = np.asarray([coord_by_sig[s] for s in sigs], dtype=np.float32)
+        if arr.ndim != 2 or arr.shape[1] == 0:
+            return {s: [x for x in sigs if x != s][:k] for s in sigs}
+        # SciPy's C KD-tree turns the common low-dimensional discrete tiling
+        # case into ~O(N log N).  It is optional; NumPy remains the fallback.
+        try:
+            from scipy.spatial import cKDTree
+            tree = cKDTree(arr)
+            _dist, idx = tree.query(arr, k=min(k + 1, len(sigs)))
+            if idx.ndim == 1:
+                idx = idx[:, None]
+            out = {}
+            for i, sig in enumerate(sigs):
+                out[sig] = [sigs[int(j)] for j in idx[i] if int(j) != i][:k]
+            return out
+        except Exception:
+            pass
+        out = {}
+        for i, sig in enumerate(sigs):
+            dist = np.sqrt(np.mean((arr - arr[i]) ** 2, axis=1))
+            dist[i] = np.inf
+            idx = np.argpartition(dist, k - 1)[:k]
+            idx = idx[np.argsort(dist[idx], kind="stable")]
+            out[sig] = [sigs[int(j)] for j in idx]
+        return out
+    except Exception:
+        out = {}
+        for sig in sigs:
+            ranked = sorted(
+                (( _coord_distance(coord_by_sig[sig], coord_by_sig[other]), other) for other in sigs if other != sig),
+                key=lambda x: (x[0], x[1]),
+            )
+            out[sig] = [other for _, other in ranked[:k]]
+        return out
+
+
+def annotate_multiview_relative(
+    operator_or_rows,
+    ranked_rows: Sequence[Mapping[str, Any]] | None = None,
+    official_configs: Sequence[Mapping[str, Any]] | None = None,
+    *,
+    search_space: SearchSpaceSpec | None = None,
+    parameter_domains: Mapping[str, Sequence[Any]] | None = None,
+    tunable_parameters: Sequence[str] | None = None,
+    anchor_k: int = 3,
+    local_k: int = 4,
+) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    """Attach label-free multi-anchor/local/stage confidence to novel rows.
+
+    Backward compatible call forms:
+      annotate_multiview_relative(operator, rows, official, ...)
+      annotate_multiview_relative(rows, official_configs=official, ...)
+    """
+    if isinstance(operator_or_rows, str):
+        rows = [dict(r) for r in (ranked_rows or ())]
+        official = [dict(c) for c in (official_configs or ())]
+        operator_name = operator_or_rows
+    else:
+        rows = [dict(r) for r in operator_or_rows]
+        official = [dict(c) for c in (official_configs or ranked_rows or ())]
+        operator_name = None
+
+    official_sigs = {config_signature(c) for c in official}
+    anchors = [r for r in rows if config_signature(r["config"]) in official_sigs]
+    novel = [r for r in rows if config_signature(r["config"]) not in official_sigs]
+    if not anchors:
+        raise ValueError("V6 requires complete Official B0 rows as anchors")
+
+    if search_space is None:
+        search_space = infer_search_space(
+            official,
+            [r["config"] for r in rows],
+            parameter_domains=parameter_domains,
+            tunable_parameters=tunable_parameters,
+        )
+
+    anchor_k = max(1, min(int(anchor_k), len(anchors)))
+    requested_local_k = max(0, int(local_k))
+    # Exact KNN is useful on small/medium pools, but a full-domain V6 run may
+    # contain thousands of configs.  Do not spend O(N^2) CPU work merely to
+    # decorate the proposal prior: the online controller performs the actual
+    # uncertainty/exploration search.  Large domains therefore use a neutral
+    # local-support factor while retaining multi-anchor/stage/rank views.
+    local_annotation_cap = 512
+    local_k = requested_local_k if len(novel) <= local_annotation_cap else 0
+    coord_by_sig = _coordinate_cache(search_space, rows)
+
+    first = []
+    for row in novel:
+        score = _source_score(row)
+        nearest = []
+        for anchor in anchors:
+            ascore = _source_score(anchor)
+            dist = _coord_distance(
+                coord_by_sig[config_signature(row["config"])],
+                coord_by_sig[config_signature(anchor["config"])],
+            )
+            # Relative advantage is only an ordering signal; it is deliberately
+            # not named or interpreted as hardware gain percent.
+            advantage = ascore - score
+            nearest.append((dist, ascore, config_signature(anchor["config"]), advantage, anchor))
+        nearest.sort(key=lambda x: (x[0], x[1], x[2]))
+        nearest = nearest[:anchor_k]
+        advantages = [float(x[3]) for x in nearest]
+        distances = [float(x[0]) for x in nearest]
+        primary = nearest[0][4]
+        rel = {
+            "primary_anchor_config": dict(primary["config"]),
+            "primary_anchor_distance": distances[0],
+            "anchor_count": len(nearest),
+            "anchor_advantages": advantages,
+            "anchor_median_advantage": statistics.median(advantages),
+            "anchor_p25_advantage": _q25(advantages),
+            "anchor_positive_fraction": sum(x > 0 for x in advantages) / len(advantages),
+            "structural_confidence": 1.0 / (1.0 + statistics.fmean(distances)),
+            "direction_signature": list(direction_signature(search_space, row["config"], primary["config"])),
+        }
+        rec = dict(row); rec["v6_relative"] = rel; first.append(rec)
+
+    by_sig = {config_signature(r["config"]): r for r in first}
+    neighbor_map = (
+        _nearest_neighbor_map(search_space, first, local_k, coord_by_sig)
+        if local_k > 0
+        else {config_signature(r["config"]): [] for r in first}
+    )
+    stage_universe = sorted({str(r.get("origin_stage", "unknown")) for r in first})
+    direction_stages: dict[tuple, set[str]] = {}
+    for row in first:
+        rel = row["v6_relative"]
+        if rel["anchor_median_advantage"] > 0 and rel["anchor_positive_fraction"] >= 0.5:
+            direction_stages.setdefault(tuple(rel["direction_signature"]), set()).add(str(row.get("origin_stage", "unknown")))
+
+    out = []
+    for row in first:
+        sig = config_signature(row["config"])
+        rel = dict(row["v6_relative"])
+        neighbor_sigs = neighbor_map.get(sig, [])
+        neighbors = [by_sig[x] for x in neighbor_sigs]
+        if neighbors:
+            local_pos = sum(x["v6_relative"]["anchor_median_advantage"] > 0 for x in neighbors) / len(neighbors)
+            local_dir = sum(tuple(x["v6_relative"]["direction_signature"]) == tuple(rel["direction_signature"]) for x in neighbors) / len(neighbors)
+            local_factor_pos = 0.5 + 0.5 * local_pos
+            local_factor_dir = 0.5 + 0.5 * local_dir
+            local_available = True
+        else:
+            # Neutral, not pessimistic: skipping KNN for a large domain is a
+            # performance optimization and must not lower a candidate's prior.
+            local_pos = local_dir = 0.5
+            local_factor_pos = local_factor_dir = 1.0
+            local_available = False
+        supported = sorted(direction_stages.get(tuple(rel["direction_signature"]), set()))
+        stage_support = len(supported) / max(1, len(stage_universe))
+        source_rec = dict(row.get("precompile_source_prefilter") or {})
+        disagreement = float(source_rec.get("rank_view_disagreement", 0.0) or 0.0)
+        semantic_coverage = min(1.0, max(0.0, float(source_rec.get("source_semantic_coverage", 0.0) or 0.0)))
+        # A specialized audited DECA view carries its own source semantics; for
+        # generic families, incomplete axis/extent recovery should reduce
+        # exploitation confidence rather than pretending the prior is equally
+        # informative.  This is label-free and only changes how strongly the
+        # queue trusts a source prior.
+        semantic_factor = 1.0 if bool(source_rec.get("specialized_deca_view_used")) else (0.5 + 0.5 * semantic_coverage)
+
+        factors = [
+            max(1e-6, float(rel["anchor_positive_fraction"])),
+            max(1e-6, float(rel["structural_confidence"])),
+            local_factor_pos,
+            local_factor_dir,
+            0.5 + 0.5 * stage_support,
+            1.0 / (1.0 + disagreement),
+            semantic_factor,
+        ]
+        confidence = math.prod(factors) ** (1.0 / len(factors))
+        robust = max(0.0, float(rel["anchor_p25_advantage"]))
+        rel.update({
+            "local_positive_fraction": local_pos,
+            "local_same_direction_fraction": local_dir,
+            "local_support_available": local_available,
+            "supported_origin_stages": supported,
+            "stage_support_fraction": stage_support,
+            "source_rank_disagreement": disagreement,
+            "source_semantic_coverage": semantic_coverage,
+            "source_semantic_confidence_factor": semantic_factor,
+            "multiview_confidence": confidence,
+            "robust_relative_advantage": robust,
+            "opportunity_score": robust * confidence,
+            "opportunity_score_is_not_hardware_gain": True,
+        })
+        rec = dict(row); rec["v6_relative"] = rel; out.append(rec)
+
+    out.sort(key=lambda r: (
+        -float(r["v6_relative"]["opportunity_score"]),
+        -float(r["v6_relative"]["multiview_confidence"]),
+        int(r.get("source_prior_rank", r.get("raw_deca_rank", 10**9))),
+        config_signature(r["config"]),
+    ))
+    return out, {
+        "policy": "generic_multi_anchor_local_stage_rank_fusion_v6",
+        "operator_name_used_by_search_policy": False,
+        "operator_name_for_diagnostics": operator_name,
+        "search_space": search_space.to_dict(),
+        "anchor_k": anchor_k,
+        "local_k_requested": requested_local_k,
+        "local_k_effective": local_k,
+        "local_annotation_cap": local_annotation_cap,
+        "candidate_performance_labels_used": False,
+        "candidate_msprof_labels_used": False,
+        "trained_parameters": [],
+    }
+
+
+def _farthest(search_space: SearchSpaceSpec, pool, selected, anchors, coord_by_sig=None):
+    if not pool:
+        return None
+    refs = list(selected) + list(anchors)
+    if not refs:
+        return pool[0]
+    coords = coord_by_sig or _coordinate_cache(search_space, list(pool) + refs)
+    def distance(r, x):
+        return _coord_distance(
+            coords[config_signature(r["config"])],
+            coords[config_signature(x["config"])],
+        )
+    return max(
+        pool,
+        key=lambda r: (
+            min(distance(r, x) for x in refs),
+            float(r["v6_relative"]["multiview_confidence"]),
+            -int(r.get("source_prior_rank", 10**9)),
+        ),
+    )
+
+
+def build_v6_proposal_queue(
+    operator_or_rows,
+    ranked_rows: Sequence[Mapping[str, Any]] | None = None,
+    official_configs: Sequence[Mapping[str, Any]] | None = None,
+    *,
+    search_space: SearchSpaceSpec | None = None,
+    parameter_domains: Mapping[str, Sequence[Any]] | None = None,
+    tunable_parameters: Sequence[str] | None = None,
+    anchor_k: int = 3,
+    local_k: int = 4,
+    max_anchor_distance: float = 1.50,
+    min_anchor_positive_fraction: float = 2 / 3,
+    max_novel_trials: int = 0,
+    proposal_queue_limit: int = 64,
+) -> dict[str, Any]:
+    if isinstance(operator_or_rows, str):
+        rows = [dict(r) for r in (ranked_rows or ())]
+        official = [dict(c) for c in (official_configs or ())]
+        opname = operator_or_rows
+    else:
+        rows = [dict(r) for r in operator_or_rows]
+        official = [dict(c) for c in (official_configs or ranked_rows or ())]
+        opname = None
+    if search_space is None:
+        search_space = infer_search_space(
+            official,
+            [r["config"] for r in rows],
+            parameter_domains=parameter_domains,
+            tunable_parameters=tunable_parameters,
+        )
+    official_sigs = {config_signature(c) for c in official}
+    anchors = [r for r in rows if config_signature(r["config"]) in official_sigs]
+    annotated, meta = annotate_multiview_relative(
+        opname or rows,
+        rows if opname else official,
+        official if opname else None,
+        search_space=search_space,
+        anchor_k=anchor_k,
+        local_k=local_k,
+    )
+    credible = [
+        r for r in annotated
+        if float(r["v6_relative"]["primary_anchor_distance"]) <= float(max_anchor_distance)
+        and float(r["v6_relative"]["anchor_positive_fraction"]) >= float(min_anchor_positive_fraction)
+        and float(r["v6_relative"]["robust_relative_advantage"]) > 0
+    ]
+    credible_sigs = {config_signature(r["config"]) for r in credible}
+    remaining = [r for r in annotated if config_signature(r["config"]) not in credible_sigs]
+    # Exploration is intentionally cheap here.  The online controller performs
+    # true adaptive structural exploration using current-run measurements.  The
+    # precompile queue only interleaves candidates with large B0 distance/model
+    # disagreement so registry scanning covers more than one prior basin.
+    explore = sorted(
+        remaining,
+        key=lambda r: (
+            -float(r["v6_relative"]["primary_anchor_distance"]),
+            -float(r["v6_relative"]["source_rank_disagreement"]),
+            int(r.get("source_prior_rank", 10**9)),
+            config_signature(r["config"]),
+        ),
+    )
+    exploit = list(credible)
+    requested_limit = int(proposal_queue_limit)
+    limit = (len(annotated) if requested_limit <= 0 else min(requested_limit, len(annotated))) if annotated else 0
+    # credible and remaining are disjoint by construction.  Interleave them
+    # directly instead of repeatedly rescanning the full annotated pool.  The
+    # previous fallback made a full-domain queue accidentally O(N^2) and spent
+    # most of its time rebuilding config signatures.
+    queue=[]; ei=xi=0
+    while len(queue) < limit and (ei < len(exploit) or xi < len(explore)):
+        prefer_explore = (len(queue) % 4 == 3)
+        if prefer_explore and xi < len(explore):
+            pick = explore[xi]; xi += 1; role = "explore"
+        elif (not prefer_explore) and ei < len(exploit):
+            pick = exploit[ei]; ei += 1; role = "exploit"
+        elif ei < len(exploit):
+            pick = exploit[ei]; ei += 1; role = "exploit"
+        else:
+            pick = explore[xi]; xi += 1; role = "explore"
+        queue.append({**pick, "proposal_rank": len(queue) + 1, "proposal_role": role})
+
+    return {
+        "policy": "v6_generic_best_first_prior_queue",
+        "operator_name_used_by_search_policy": False,
+        "official_baseline_count": len(official),
+        "proposal_queue": queue,
+        "proposal_queue_limit": int(proposal_queue_limit),
+        "proposal_queue_covers_full_declared_novel_domain": len(queue) == len(annotated),
+        # Kept for compatibility only. Final V6 search budget is controlled by
+        # the online NearOptimalController, not a fixed good-enough reserve.
+        "max_novel_trials_legacy": int(max_novel_trials),
+        "credible_candidate_count": len(credible),
+        "search_space": search_space.to_dict(),
+        "multi_view_meta": meta,
+        "candidate_performance_labels_used": False,
+        "candidate_msprof_labels_used": False,
+        "b0_preserved_by_policy": True,
+        "fixed_gain_early_stop_removed": True,
+    }
+
+
+def progressive_stage_decision(*args, **kwargs):
+    """Compatibility shim: final V6 never prunes S2/S3 for a near-optimal run.
+
+    Model-only stage early stopping can miss the best region and therefore is
+    incompatible with the near-optimal objective.  Performance is recovered by
+    incremental caches and sequential hardware evaluation instead.
+    """
+    stage = kwargs.get("stage_name", "unknown")
+    return {
+        "stage": stage,
+        "stop": False,
+        "reason": "near_optimal_mode_requires_declared_search_domain_coverage",
+        "candidate_performance_labels_used": False,
+    }
diff --git a/third_party/ascend/backend/runtime/precompile_source_prefilter.py b/third_party/ascend/backend/runtime/precompile_source_prefilter.py
new file mode 100644
index 000000000..995f93fdb
--- /dev/null
+++ b/third_party/ascend/backend/runtime/precompile_source_prefilter.py
@@ -0,0 +1,344 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Pre-compile analytical ranking for expanded Ascend autotune candidates.
+
+This module is intentionally on the *pre-compile* critical path.  It consumes
+only runtime shape/meta arguments, Config values and versioned hardware
+constants.  It does not materialize TTIR/HIVM/DES, compile a kernel, benchmark
+hardware, read MSProf data or fit parameters from candidate latency labels.
+
+The online contract is recall-first: use the score to reduce a wide expansion
+reservoir to a compile budget, then let the native Ascend AutoTilingTuner keep
+its ordinary parallel-compile -> rough-NPU-time prune -> final benchmark path.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from functools import lru_cache
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from triton.runtime.autotuner import Config
+
+from .a5_hardware_model import resolve_hardware_profile
+from .deca_execution_core import (
+    aggregate_scalar_costs_round_robin,
+    build_logical_tasks,
+)
+
+
+
+
+def _sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as fh:
+        for block in iter(lambda: fh.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def ranking_model_provenance() -> dict[str, Any]:
+    """Return auditable provenance for the compile-free ranking model.
+
+    The hardware constants come from candidate-independent CCE microbenchmarks.
+    They are external hardware calibration, not latency labels from the six
+    operator cases being ranked.
+    """
+    here = Path(__file__).resolve()
+    calib = here.parent / "vtriton_vendor/perfbound/calibration/data/calib_910b3_v1.json"
+    core = here.parent / "deca_execution_core.py"
+    motif = here.parent / "source_motif_deca.py"
+    sources = []
+    if calib.is_file():
+        try:
+            data = json.loads(calib.read_text(encoding="utf-8"))
+            def walk(x):
+                if isinstance(x, dict):
+                    if isinstance(x.get("source"), str):
+                        sources.append(x["source"])
+                    for v in x.values(): walk(v)
+                elif isinstance(x, list):
+                    for v in x: walk(v)
+            walk(data)
+        except Exception:
+            pass
+    return {
+        "model_kind": "deca_source_frontend_v3+source_motif_deca_v66",
+        "prefilter_source": str(here),
+        "prefilter_source_sha256": _sha256(here),
+        "deca_core_source": str(core),
+        "deca_core_source_sha256": _sha256(core) if core.is_file() else None,
+        "source_motif_deca_source": str(motif),
+        "source_motif_deca_source_sha256": _sha256(motif) if motif.is_file() else None,
+        "hardware_calibration_file": str(calib),
+        "hardware_calibration_sha256": _sha256(calib) if calib.is_file() else None,
+        "hardware_calibration_sources": sorted(set(sources)),
+        "uses_candidate_latency_labels": False,
+        "uses_candidate_msprof_labels": False,
+        "uses_candidate_winner_labels": False,
+        "uses_safety_registry_for_score": False,
+        "source_motif_operator_name_dispatch": False,
+        "source_motif_uses_ttir": False,
+        "uses_external_hardware_microbenchmark_calibration": True,
+        "external_calibration_is_case_candidate_independent": True,
+        "trained_parameters_from_candidate_cases": [],
+    }
+
+
+def _value(args: Mapping[str, Any], *names: str, default: Any = None) -> Any:
+    for name in names:
+        if name in args and args[name] is not None:
+            return args[name]
+    return default
+
+
+def _int(args: Mapping[str, Any], *names: str, default: int = 1) -> int:
+    value = _value(args, *names, default=default)
+    try:
+        return max(1, int(value))
+    except Exception:
+        return max(1, int(default))
+
+
+def _dtype_bytes(all_args: Mapping[str, Any], options: Mapping[str, Any]) -> int:
+    if options.get("dtype_bytes") is not None:
+        return max(1, int(options["dtype_bytes"]))
+    for value in all_args.values():
+        dtype = str(getattr(value, "dtype", "")).lower()
+        if "float32" in dtype:
+            return 4
+        if "float16" in dtype or "bfloat16" in dtype or "half" in dtype:
+            return 2
+    return 2
+
+
+def _config_sig(cfg: Config) -> tuple:
+    return (
+        tuple(sorted(cfg.kwargs.items())),
+        cfg.num_warps,
+        cfg.num_stages,
+        cfg.num_ctas,
+        cfg.maxnreg,
+    )
+
+
+@lru_cache(maxsize=1)
+def _control_constants() -> dict[str, float]:
+    path = Path(__file__).resolve().parent / "vtriton_vendor/perfbound/calibration/data/calib_910b3_v1.json"
+    if not path.is_file():
+        return {"handoff_us": 0.0, "pipe_us": 0.0}
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+        clock = max(1e-9, float((data.get("core") or {}).get("clock_freq_ghz", 1.85)))
+        handoff = max(0.0, float(data.get("mandatory_handoff_cycles", 0.0) or 0.0))
+        pipe = max(0.0, float(data.get("pipe_barrier_cycles_per_iter", 0.0) or 0.0))
+        return {
+            "handoff_us": handoff / clock / 1000.0,
+            "pipe_us": pipe / clock / 1000.0,
+        }
+    except Exception:
+        return {"handoff_us": 0.0, "pipe_us": 0.0}
+
+
+def _flash_score(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any], hw) -> dict[str, Any]:
+    kw = cfg.kwargs
+    bm = max(1, int(kw.get("BLOCK_M", kw.get("BM", 1))))
+    bn = max(1, int(kw.get("BLOCK_N", kw.get("BN", 1))))
+    cores = max(1, int(kw.get("AICORE_NUM", options.get("num_cores", hw.cube_cores))))
+    q_len = _int(all_args, "MAX_Q_LEN", "q_len", "Q_LEN", default=1)
+    k_len = _int(all_args, "MAX_K_LEN", "k_len", "K_LEN", default=q_len)
+    batch = _int(all_args, "BATCH_SIZE", "batch", "B", "N", default=1)
+    q_heads = _int(all_args, "q_head", "q_heads", "Q_HEADS", "H", default=1)
+    d = _int(all_args, "QK_DIM", "HEAD_DIM", "head_dim", "K", default=64)
+    causal = bool(_value(all_args, "causal", "CAUSAL", default=options.get("causal", True)))
+    elem = _dtype_bytes(all_args, options)
+    ctrl = _control_constants()
+
+    cube_per_inner = 4.0 * bm * bn * d
+    vector_per_inner = 8.0 * bm * bn
+    fixed_bytes = float(2 * bm * d * elem)
+    stream_bytes = float(2 * bn * d * elem)
+
+    case = {
+        "q_len": q_len, "k_len": k_len, "batch": batch,
+        "q_heads": q_heads, "causal": causal,
+    }
+    tasks = build_logical_tasks(
+        "flash_attention_npu_v8", case,
+        {"BLOCK_M": bm, "BLOCK_N": bn, "AICORE_NUM": cores},
+    )
+    costs: list[float] = []
+    for task in tasks:
+        inner = int(task.inner_iterations)
+        cube_us = inner * cube_per_inner / max(1.0, hw.cube_rate)
+        vector_us = inner * vector_per_inner / max(1.0, hw.vector_rate)
+        mte_us = (fixed_bytes + inner * stream_bytes) / max(1.0, hw.mte_bandwidth)
+        control_us = inner * (2.0 * ctrl["handoff_us"] + ctrl["pipe_us"])
+        costs.append(max(cube_us, vector_us, mte_us) + control_us)
+
+    score, imbalance, _ = aggregate_scalar_costs_round_robin(costs, cores)
+    total_inner = sum(t.inner_iterations for t in tasks)
+    return {
+        "score_us_proxy": float(score),
+        "core_imbalance": float(imbalance),
+        "task_count": len(costs),
+        "total_inner_iterations": int(total_inner),
+        "cores": cores,
+        "bm": bm,
+        "bn": bn,
+    }
+
+
+def _chunk_score(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any], hw) -> dict[str, Any]:
+    kw = cfg.kwargs
+    bk = max(1, int(kw.get("BK", kw.get("BLOCK_K", 1))))
+    bv = max(1, int(kw.get("BV", kw.get("BLOCK_V", 1))))
+    cores = max(1, int(kw.get("AICORE_NUM", kw.get("num_core", options.get("num_cores", hw.cube_cores)))))
+    t = _int(all_args, "T", default=1)
+    h = _int(all_args, "H", default=1)
+    hv = _int(all_args, "HV", default=h)
+    k = _int(all_args, "K", default=1)
+    v = _int(all_args, "V", default=1)
+    batch = _int(all_args, "N", "batch", "B", default=1)
+    bt = _int(all_args, "BT", default=64)
+    elem = _dtype_bytes(all_args, options)
+    ctrl = _control_constants()
+
+    tasks = build_logical_tasks(
+        "chunk_o",
+        {"T": t, "BT": bt, "batch": batch, "HV": hv, "K": k, "V": v},
+        {"BK": bk, "BV": bv, "AICORE_NUM": cores},
+    )
+    task_count = len(tasks)
+    inner = max((x.inner_iterations for x in tasks), default=0)
+
+    cube_inner = 2.0 * bt * bk * bv + 2.0 * bt * bk * bt
+    cube_fixed = 2.0 * bt * bt * bv
+    vector_fixed = float(3 * bt * bv + 2 * bt * bt)
+    stream_bytes = float((bt * bk + bk * bt + bk * bv) * elem)
+    fixed_bytes = float(2 * bt * bv * elem)
+
+    cube_us = (inner * cube_inner + cube_fixed) / max(1.0, hw.cube_rate)
+    vector_us = vector_fixed / max(1.0, hw.vector_rate)
+    mte_us = (inner * stream_bytes + fixed_bytes) / max(1.0, hw.mte_bandwidth)
+    control_us = inner * (2.0 * ctrl["handoff_us"] + ctrl["pipe_us"]) + ctrl["handoff_us"]
+    task_cost = max(cube_us, vector_us, mte_us) + control_us
+    score, imbalance, _ = aggregate_scalar_costs_round_robin([task_cost] * task_count, cores)
+    return {
+        "score_us_proxy": float(score),
+        "core_imbalance": float(imbalance),
+        "task_count": int(task_count),
+        "total_inner_iterations": int(task_count * inner),
+        "cores": cores,
+        "bk": bk,
+        "bv": bv,
+    }
+
+
+def score_config(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any] | None = None) -> dict[str, Any]:
+    opts = dict(options or {})
+    family = str(opts.get("operator_family", "flash_attention")).lower()
+    hw = resolve_hardware_profile({
+        "hardware_profile": opts.get("hardware_profile", "ascend_910b3_v4"),
+        "light_detect_hardware": bool(opts.get("light_detect_hardware", False)),
+        "num_cores": int(opts.get("num_cores", 20)),
+    })
+    if family in {"flash_attention", "flash_attention_npu_v8", "fa"}:
+        detail = _flash_score(cfg, all_args, opts, hw)
+        model_kind = "deca_source_frontend_v3_audited_fa"
+    elif family in {"chunk", "chunk_o", "chunk_o_npu"}:
+        detail = _chunk_score(cfg, all_args, opts, hw)
+        model_kind = "deca_source_frontend_v3_audited_chunk"
+    else:
+        # V6.6 production genericity: the native precompile path can consume
+        # the same operator-name-free motif Source-DECA as the V6 search prior.
+        # This keeps FA/chunk's audited equations as the strongest path while
+        # making GEMM/reduction/elementwise/scan/atomic handwritten kernels
+        # rankable without adding another operator-name branch here.
+        from .search_space_v6 import infer_search_space, canonical_config_mapping
+        from .source_motif_deca import infer_source_motif, score_motif_deca
+        spec = infer_search_space(
+            [cfg], [cfg],
+            parameter_domains=opts.get("parameter_domains"),
+            tunable_parameters=opts.get("tunable_parameter"),
+            split_params=opts.get("split_params"),
+            tiling_params=opts.get("tiling_params"),
+            reduction_axes=opts.get("reduction_axes"),
+        )
+        motif_meta = infer_source_motif(spec, options=opts)
+        motif = score_motif_deca(
+            canonical_config_mapping(cfg),
+            search_space=spec,
+            all_args=all_args,
+            options=opts,
+            motif_meta=motif_meta,
+        )
+        if motif is None:
+            # Neutral source-only fallback: keep the candidate rankable.  This
+            # is not a latency prediction; generic consensus ranking can still
+            # use its independent geometry/resource views.
+            tile = 1.0
+            for value in cfg.kwargs.values():
+                if isinstance(value, (int, float)) and not isinstance(value, bool) and float(value) > 0:
+                    tile *= max(1.0, float(value))
+            detail = {
+                "score_us_proxy": float(tile),
+                "core_imbalance": 0.0,
+                "task_count": 1,
+                "total_inner_iterations": 1,
+                "motif": "generic_unknown",
+                "motif_confidence": 0.0,
+            }
+            model_kind = "generic_source_fallback_v66"
+        else:
+            detail = {
+                **motif,
+                "score_us_proxy": float(motif["motif_score_proxy"]),
+                "core_imbalance": max(0.0, 1.0 - float(motif.get("wave_efficiency", 1.0))),
+                "task_count": int(motif.get("logical_task_count", 1)),
+                "total_inner_iterations": int(motif.get("logical_task_count", 1)) * int(motif.get("reduction_loop_count", 1)),
+            }
+            model_kind = "source_motif_deca_v66"
+    return {
+        **detail,
+        "model_kind": model_kind,
+        "operator_family": family,
+        "hardware_profile": hw.name,
+        "calibration_version": hw.calibration_version,
+        "uses_ttir": False,
+        "uses_hivm": False,
+        "uses_des": False,
+        "uses_hardware_latency_labels": False,
+        "uses_candidate_latency_labels": False,
+        "uses_msprof_labels": False,
+        "uses_candidate_msprof_labels": False,
+        "uses_external_hardware_microbenchmark_calibration": True,
+        "trained_parameters": [],
+    }
+
+
+def rank_configs(configs: Sequence[Config], all_args: Mapping[str, Any],
+                 options: Mapping[str, Any] | None = None) -> tuple[list[Config], dict[Config, dict[str, Any]]]:
+    opts = dict(options or {})
+    records = {cfg: score_config(cfg, all_args, opts) for cfg in configs}
+    ranked = sorted(
+        configs,
+        key=lambda cfg: (
+            float(records[cfg]["score_us_proxy"]),
+            float(records[cfg]["core_imbalance"]),
+            _config_sig(cfg),
+        ),
+    )
+    for rank, cfg in enumerate(ranked, 1):
+        records[cfg]["rank"] = rank
+    return ranked, records
+
+
+def resolve_compile_budget(*, official_count: int, pool_count: int,
+                           options: Mapping[str, Any] | None = None) -> int:
+    opts = dict(options or {})
+    if opts.get("precompile_top_k") is not None:
+        return min(pool_count, max(1, int(opts["precompile_top_k"])))
+    ratio = float(opts.get("precompile_budget_ratio", 1.0))
+    return min(pool_count, max(1, int(math.ceil(max(0.0, ratio) * max(1, official_count)))))
