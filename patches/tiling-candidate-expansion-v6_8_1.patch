index 000000000..684746110
--- /dev/null
+++ b/third_party/ascend/backend/runtime/generic_source_rank_v6.py
@@ -0,0 +1,590 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Low-cost, label-free source ranking used by final V6.
+
+The key design change from V5.x is that V6 never requires an operator-specific
+absolute score to be globally accurate.  It builds a consensus prior from cheap
+source-visible views and uses that prior only to order hardware evaluations.
+
+Every metadata-searchable handwritten kernel receives the generic
+Triton-Ascend metadata/resource views.  A specialized source analyzer is only
+an optional extra view: the generic ranker probes the analyzer capability at
+runtime and never owns an operator-name whitelist.  V6.6 also adds operator-name-free motif Source-DECA (GEMM, reduction,
+elementwise/memory, attention-mixed, scan/recurrent and irregular-atomic)
+from AutoTiling metadata plus optional source AST.  Audited FA/chunk analyzers
+remain an additional stronger view rather than the only DECA path.
+"""
+from __future__ import annotations
+
+import math
+import statistics
+from typing import Any, Mapping, Sequence
+
+from .search_space_v6 import SearchSpaceSpec, config_signature, structural_coordinates, split_config_mapping
+
+
+def _num(v: Any, default: float = 0.0) -> float:
+    try:
+        return float(v)
+    except Exception:
+        return float(default)
+
+
+def _dtype_bytes_generic(all_args: Mapping[str, Any], options: Mapping[str, Any]) -> int:
+    """Best-effort element width for generic resource-pressure diagnostics.
+
+    This is deliberately candidate-label free.  The value comes from an
+    explicit runtime option or tensor dtype already present in launch context.
+    """
+    if options.get("dtype_bytes") is not None:
+        try:
+            return max(1, int(options["dtype_bytes"]))
+        except Exception:
+            pass
+    for value in all_args.values():
+        dtype = str(getattr(value, "dtype", "") or "").lower()
+        if "float64" in dtype or "int64" in dtype:
+            return 8
+        if "float32" in dtype or "int32" in dtype:
+            return 4
+        if "float16" in dtype or "bfloat16" in dtype or "half" in dtype or "int16" in dtype:
+            return 2
+        if "int8" in dtype or "uint8" in dtype or "bool" in dtype:
+            return 1
+    return 2
+
+
+def _tensor_arg_count(all_args: Mapping[str, Any]) -> int:
+    count = 0
+    for value in all_args.values():
+        if getattr(value, "dtype", None) is not None and (getattr(value, "shape", None) is not None or getattr(value, "numel", None) is not None):
+            count += 1
+    return max(1, count)
+
+
+def _try_specialized_source_view(
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any],
+) -> tuple[dict[tuple, dict[str, Any]], dict[str, Any]]:
+    """Try an optional family analyzer without hard-coding family names here.
+
+    The specialized frontend is a capability provider.  Unsupported families
+    simply return an empty view and continue through the generic path.  This
+    means adding a future GEMM/reduction analyzer does not require editing the
+    generic search/ranking algorithm.
+    """
+    family = str(options.get("operator_family", "generic")).lower()
+    out: dict[tuple, dict[str, Any]] = {}
+    try:
+        from triton.runtime.autotuner import Config
+        from .precompile_source_prefilter import score_config
+        for row in rows:
+            cfgd = dict(row["config"])
+            kwargs, meta = split_config_mapping(cfgd)
+            cfg = Config(
+                kwargs,
+                num_warps=int(meta.get("num_warps", row.get("num_warps", 4)) or 4),
+                num_stages=int(meta.get("num_stages", row.get("num_stages", 3)) or 3),
+                num_ctas=int(meta.get("num_ctas", row.get("num_ctas", 1)) or 1),
+                maxnreg=meta.get("maxnreg", row.get("maxnreg")),
+            )
+            record = dict(score_config(cfg, all_args, options))
+            # Capability contract: only audited family-specific records are
+            # exposed as the strong specialized view. V6.6 score_config also
+            # supports generic motif-DECA for native precompile ranking, but
+            # that generic capability is fused separately below and must not
+            # masquerade as an audited specialized analyzer.
+            if "audited_" in str(record.get("model_kind", "")):
+                out[config_signature(cfgd)] = record
+        return out, {
+            "available": bool(out),
+            "operator_family": family,
+            "provider": "precompile_source_prefilter.score_config",
+            "capability_contract": "audited_family_specific_only",
+            "fallback_reason": None if out else "no_audited_family_specific_analyzer",
+        }
+    except Exception as exc:
+        # An unsupported family is expected.  Generic Source remains complete.
+        return {}, {
+            "available": False,
+            "operator_family": family,
+            "provider": "precompile_source_prefilter.score_config",
+            "fallback_reason": f"{type(exc).__name__}:{exc}",
+        }
+
+
+def _metadata_role(axis_name: str, declared_role: str, options: Mapping[str, Any]) -> str:
+    """Recover AutoTiling axis semantics before using conservative name hints.
+
+    V6.1 often received a SearchSpaceSpec inferred only from parameter domains,
+    so split/tiling/reduction semantics were lost even when the surrounding
+    AutoTiling metadata knew them.  V6.3 consumes those metadata fields directly
+    and only falls back to neutral naming when metadata is absent.
+    """
+    if declared_role and declared_role != "generic":
+        return declared_role
+    split_params = {str(k): str(v) for k, v in dict(options.get("split_params", {}) or {}).items()}
+    tiling_params = {str(k): str(v) for k, v in dict(options.get("tiling_params", {}) or {}).items()}
+    reduction_axes = {str(x) for x in (options.get("reduction_axes", []) or [])}
+    for axis, param in split_params.items():
+        if param == axis_name:
+            return "reduction_split" if axis in reduction_axes else "split"
+    for axis, param in tiling_params.items():
+        if param == axis_name:
+            return "reduction_tile" if axis in reduction_axes else "tile"
+
+    # Conservative neutral-name fallback.  These are parameter semantics rather
+    # than operator dispatch.  Ambiguous BLOCK_SIZE on row-wise kernels is left
+    # generic unless the runtime metadata resolves it.
+    u = axis_name.upper()
+    if u in {"BK", "BLOCK_K", "BLOCK_SIZE_K"} or u.endswith("_K"):
+        return "reduction_tile"
+    if u in {"BM", "BLOCK_M", "BLOCK_SIZE_M", "BN", "BLOCK_N", "BLOCK_SIZE_N"} or u.endswith("_M") or u.endswith("_N"):
+        return "split"
+    if u == "BLOCK_SIZE":
+        return "split" if not ("M" in options.get("runtime_arg_names", ()) and "N" in options.get("runtime_arg_names", ())) else "generic"
+    return declared_role or "generic"
+
+
+def _weighted_rank_fusion(
+    normalized: Mapping[str, Mapping[tuple, float]],
+    weights: Mapping[str, float],
+    *,
+    per_sig_weight_scale: Mapping[tuple, Mapping[str, float]] | None = None,
+):
+    """Fuse ordinal views with optional candidate-specific confidence scales.
+
+    V6.3 uses this to attenuate semantic-dependent generic views when runtime
+    metadata cannot resolve their axis extents.  Geometry-only views remain
+    available, while a weakly understood kernel is not treated as if its
+    reduction/work proxy were as trustworthy as an audited family analyzer.
+    """
+    fused: dict[tuple, float] = {}
+    disagreement: dict[tuple, float] = {}
+    effective_weights: dict[tuple, dict[str, float]] = {}
+    if not normalized:
+        return fused, disagreement, effective_weights
+    sigs = next(iter(normalized.values())).keys()
+    scales = per_sig_weight_scale or {}
+    for sig in sigs:
+        smap = dict(scales.get(sig, {}) or {})
+        pairs = []
+        effective_weights[sig] = {}
+        for name, vals in normalized.items():
+            w = max(0.0, float(weights.get(name, 1.0))) * max(0.0, float(smap.get(name, 1.0)))
+            effective_weights[sig][name] = w
+            pairs.append((w, float(vals[sig])))
+        denom = sum(w for w, _ in pairs) or 1.0
+        fused[sig] = sum(w * v for w, v in pairs) / denom
+        expanded = [v for w, v in pairs for _ in range(max(1, int(round(w * 4))))]
+        disagreement[sig] = statistics.pstdev(expanded) if len(expanded) > 1 else 0.0
+    return fused, disagreement, effective_weights
+
+
+def _axis_runtime_extent(axis_name: str, role: str, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> int | None:
+    # Prefer explicit mapping produced by official AutoTiling metadata.
+    param_to_axis = dict(options.get("parameter_to_axis", {}) or {})
+    axis = param_to_axis.get(axis_name)
+    axis_sizes = dict(options.get("axis_sizes", {}) or {})
+    if axis in axis_sizes:
+        try:
+            return max(1, int(axis_sizes[axis]))
+        except Exception:
+            pass
+
+    # Neutral argument-name fallbacks.  These are parameter semantics, not
+    # operator dispatch; unknown kernels simply omit this view.
+    u = axis_name.upper()
+    candidates = []
+    if u.endswith("_M") or u in {"BM", "BLOCK_M", "BLOCK_SIZE_M"}:
+        candidates = ("M", "MAX_Q_LEN", "N_CTX")
+    elif u.endswith("_N") or u in {"BN", "BLOCK_N", "BLOCK_SIZE_N"}:
+        candidates = ("N", "MAX_K_LEN", "N_CTX")
+    elif u.endswith("_K") or u in {"BK", "BLOCK_K", "BLOCK_SIZE_K"}:
+        candidates = ("K", "HEAD_DIM", "QK_DIM")
+    elif "BLOCK_SIZE" in u or u.endswith("BLOCK"):
+        candidates = ("N", "n_elements", "numel", "n_cols")
+    for key in candidates:
+        if key in all_args:
+            try:
+                return max(1, int(all_args[key]))
+            except Exception:
+                pass
+    return None
+
+
+def _generic_record(spec: SearchSpaceSpec, cfg: Mapping[str, Any], all_args: Mapping[str, Any], options: Mapping[str, Any]) -> dict[str, Any]:
+    d = dict(cfg)
+    split_programs = 1
+    reduction_loops = 1
+    padded_ratio = 1.0
+    tail_terms: list[float] = []
+    tile_volume = 1.0
+    output_tile_volume = 1.0
+    reduction_tile_volume = 1.0
+    resolved_extent_axes = 0
+    core_count = max(1, int(options.get("num_cores", 20) or 20))
+    dtype_bytes = _dtype_bytes_generic(all_args, options)
+    tensor_args = _tensor_arg_count(all_args)
+    try:
+        from .a5_hardware_model import resolve_ub_capacity
+        ub_capacity_bytes = max(1, int(resolve_ub_capacity(options)))
+    except Exception:
+        ub_capacity_bytes = 256 * 1024
+    launch_meta = {"warps": None, "pipeline": None, "cta_count": None, "register_limit": None}
+
+    for axis in spec.axes:
+        value = d.get(axis.name, axis.values[0])
+        if not isinstance(value, (int, float)) or float(value) <= 0:
+            continue
+        fv = float(value)
+        role = _metadata_role(axis.name, axis.semantic_role, options)
+        if role == "core_count":
+            core_count = max(1, int(fv))
+            continue
+        # Triton Config launch metadata is a real search coordinate, but it is
+        # not a tile extent.  Keep it in the structural record / residual
+        # feature coordinates without multiplying generic tile_volume.  This
+        # avoids imposing an unjustified universal direction such as "more
+        # warps/stages is always slower" on unfamiliar handwritten kernels.
+        if role in launch_meta:
+            launch_meta[role] = fv
+            continue
+        tile_volume *= max(1.0, fv)
+        if role == "reduction_tile":
+            reduction_tile_volume *= max(1.0, fv)
+        elif role in {"split", "tile"}:
+            output_tile_volume *= max(1.0, fv)
+        extent = _axis_runtime_extent(axis.name, role, all_args, options)
+        if extent is None:
+            continue
+        resolved_extent_axes += 1
+        pieces = max(1, int(math.ceil(extent / fv)))
+        axis_padded_ratio = (pieces * fv) / max(1.0, float(extent))
+        padded_ratio *= axis_padded_ratio
+        tail_terms.append(max(0.0, axis_padded_ratio - 1.0))
+        if role in {"split", "reduction_split"}:
+            split_programs *= pieces
+        elif role == "reduction_tile":
+            reduction_loops *= pieces
+
+    programs = max(1, split_programs)
+    waves = max(1, int(math.ceil(programs / max(1, core_count))))
+    wave_eff = programs / max(1.0, float(waves * core_count))
+    imbalance = 1.0 - min(1.0, wave_eff)
+    tail = max(0.0, padded_ratio - 1.0)
+    tail_fraction = statistics.fmean(tail_terms) if tail_terms else 0.0
+
+    # Generic workload proxies are deliberately unitless.  V6.5 separates
+    # invariant arithmetic volume from launch/control and resource pressure so
+    # the generic path is not dominated by a nearly-constant tile-volume term.
+    work = float(programs * reduction_loops) * max(1.0, tile_volume)
+    occupancy_penalty = abs(math.log2(max(1e-6, programs / max(1.0, core_count))))
+    program_overhead_proxy = float(programs)
+    reduction_depth_proxy = float(reduction_loops)
+    loop_control_proxy = float(programs * reduction_loops)
+
+    # Conservative UB pressure: only penalize the obviously-overfull side.  The
+    # generic model does not assume that smaller tiles are always faster.
+    working_set_multiplier = min(4.0, max(1.0, float(tensor_args)))
+    estimated_tile_working_set_bytes = max(1.0, tile_volume) * float(dtype_bytes) * working_set_multiplier
+    ub_pressure_ratio = estimated_tile_working_set_bytes / max(1.0, float(ub_capacity_bytes))
+    ub_overflow_pressure = max(0.0, ub_pressure_ratio - 0.75) ** 2
+
+    return {
+        "model_kind": "generic_source_structure_v6",
+        "task_count": programs,
+        "total_inner_iterations": programs * reduction_loops,
+        "waves": waves,
+        "wave_efficiency": wave_eff,
+        "core_imbalance": imbalance,
+        "tail_waste": tail,
+        "tail_fraction": tail_fraction,
+        "tile_volume": tile_volume,
+        "output_tile_volume": output_tile_volume,
+        "reduction_tile_volume": reduction_tile_volume,
+        "resolved_extent_axis_count": resolved_extent_axes,
+        "source_semantic_coverage": resolved_extent_axes / max(1, len([a for a in spec.axes if a.semantic_role not in launch_meta and a.semantic_role != "core_count"])),
+        "generic_work_proxy": work,
+        "program_overhead_proxy": program_overhead_proxy,
+        "reduction_depth_proxy": reduction_depth_proxy,
+        "loop_control_proxy": loop_control_proxy,
+        "estimated_tile_working_set_bytes": estimated_tile_working_set_bytes,
+        "ub_capacity_bytes": ub_capacity_bytes,
+        "ub_pressure_ratio": ub_pressure_ratio,
+        "ub_overflow_pressure": ub_overflow_pressure,
+        "dtype_bytes": dtype_bytes,
+        "tensor_arg_count": tensor_args,
+        "occupancy_penalty": occupancy_penalty,
+        "num_warps": launch_meta.get("warps"),
+        "num_stages": launch_meta.get("pipeline"),
+        "num_ctas": launch_meta.get("cta_count"),
+        "maxnreg": launch_meta.get("register_limit"),
+        "uses_hardware_latency_labels": False,
+        "uses_msprof_labels": False,
+    }
+
+
+def _rank01(values: Mapping[tuple, float]) -> dict[tuple, float]:
+    ordered = sorted(values, key=lambda s: (float(values[s]), s))
+    n = len(ordered)
+    if n <= 1:
+        return {s: 0.0 for s in ordered}
+    return {s: i / (n - 1) for i, s in enumerate(ordered)}
+
+
+def rank_rows_generic(
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    search_space: SearchSpaceSpec,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    """Return a generic consensus ordering without candidate performance labels."""
+    opts = dict(options or {})
+    opts.setdefault("runtime_arg_names", tuple(str(k) for k in all_args.keys()))
+    family = str(opts.get("operator_family", "generic")).lower()
+    records: dict[tuple, dict[str, Any]] = {}
+
+    # Specialized Source is an optional capability, not a family whitelist in
+    # the generic ranker. Unsupported families fall through to motif/generic
+    # views. V6.6 motif-DECA is operator-name-free and applies whenever source
+    # AST or AutoTiling axis semantics are sufficient to infer an execution
+    # motif.
+    special_by_sig, specialized_meta = _try_specialized_source_view(
+        rows, all_args=all_args, options=opts
+    )
+
+    # V6.8 Source++: optional compile-free per-program/core workload view.
+    # Disabled by default so V6.7.1 behavior remains bit-for-bit compatible.
+    program_by_sig = {}
+    program_meta = {
+        "available": False,
+        "model_kind": "source_program_workload_v68",
+        "disabled": not bool(opts.get("enable_source_program_workload_v68", False)),
+    }
+    if bool(opts.get("enable_source_program_workload_v68", False)):
+        try:
+            from .source_program_workload_v68 import score_rows_program_workload
+            program_by_sig, program_meta = score_rows_program_workload(
+                rows, search_space=search_space, all_args=all_args, options=opts
+            )
+        except Exception as exc:
+            program_by_sig, program_meta = {}, {
+                "available": False,
+                "model_kind": "source_program_workload_v68",
+                "fallback_reason": f"{type(exc).__name__}:{exc}",
+                "uses_candidate_latency_labels": False,
+            }
+
+    # V6.8 optional TTIR-anchor refinement.  It consumes only TTIR artifacts
+    # supplied by the caller from configs that were already compiled for B0 /
+    # bootstrap; this ranker never requests compilation itself.
+    anchor_by_sig = {}
+    anchor_meta = {
+        "available": False,
+        "model_kind": "ttir_anchor_refinement_v68",
+        "disabled": not bool(opts.get("enable_ttir_anchor_refinement_v68", False)),
+    }
+    if bool(opts.get("enable_ttir_anchor_refinement_v68", False)) and opts.get("ttir_anchor_records"):
+        try:
+            from .ttir_anchor_refinement_v68 import score_rows_ttir_anchors
+            anchor_by_sig, anchor_meta = score_rows_ttir_anchors(
+                rows, search_space=search_space,
+                anchors=list(opts.get("ttir_anchor_records") or ()),
+                max_neighbors=int(opts.get("ttir_anchor_max_neighbors", 3) or 3),
+                distance_scale=float(opts.get("ttir_anchor_distance_scale", 0.35) or 0.35),
+            )
+        except Exception as exc:
+            anchor_by_sig, anchor_meta = {}, {
+                "available": False,
+                "model_kind": "ttir_anchor_refinement_v68",
+                "fallback_reason": f"{type(exc).__name__}:{exc}",
+                "requests_compilation": False,
+                "uses_candidate_latency_labels": False,
+            }
+
+    try:
+        from .source_motif_deca import score_rows_motif_deca
+        motif_by_sig, motif_meta = score_rows_motif_deca(
+            rows, search_space=search_space, all_args=all_args, options=opts
+        )
+    except Exception as exc:
+        motif_by_sig, motif_meta = {}, {
+            "available": False,
+            "model_kind": "source_motif_deca_v66",
+            "fallback_reason": f"{type(exc).__name__}:{exc}",
+            "operator_name_dispatch": False,
+            "uses_candidate_latency_labels": False,
+        }
+
+    for row0 in rows:
+        row = dict(row0)
+        cfg = dict(row["config"])
+        sig = config_signature(cfg)
+        generic = _generic_record(search_space, cfg, all_args, opts)
+        special = special_by_sig.get(sig)
+        rec = dict(generic)
+        motif = motif_by_sig.get(sig)
+        program = program_by_sig.get(sig)
+        anchor = anchor_by_sig.get(sig)
+        rec["specialized_deca_view_used"] = bool(special)
+        rec["motif_deca_view_used"] = bool(motif)
+        rec["program_workload_view_used"] = bool(program)
+        rec["ttir_anchor_view_used"] = bool(anchor)
+        if program:
+            rec.update({f"program_{k}": v for k, v in program.items()})
+        if anchor:
+            rec.update({f"anchor_{k}": v for k, v in anchor.items()})
+        if motif:
+            rec.update({f"motif_{k}": v for k, v in motif.items()})
+            rec["source_motif"] = motif.get("motif")
+            rec["source_motif_confidence"] = float(motif.get("motif_confidence", 0.0) or 0.0)
+        else:
+            rec["source_motif"] = None
+            rec["source_motif_confidence"] = 0.0
+        if special:
+            rec.update({f"deca_{k}": v for k, v in special.items()})
+            rec["score_us_proxy"] = float(special.get("score_us_proxy", 0.0) or 0.0)
+        elif motif:
+            # Compatibility field only. Motif Source-DECA is ordinal, not a
+            # calibrated microsecond prediction.
+            rec["score_us_proxy"] = float(motif.get("motif_score_proxy", generic["generic_work_proxy"]))
+        else:
+            # Only a monotone ordinal placeholder. Do not label it microseconds.
+            rec["score_us_proxy"] = float(generic["generic_work_proxy"])
+        records[sig] = rec
+
+    views: dict[str, dict[tuple, float]] = {
+        "tail": {s: _num(r.get("tail_fraction", r.get("tail_waste"))) for s, r in records.items()},
+        "imbalance": {s: _num(r.get("core_imbalance")) for s, r in records.items()},
+        "occupancy": {s: _num(r.get("occupancy_penalty")) for s, r in records.items()},
+        "reduction_loops": {s: _num(r.get("reduction_depth_proxy")) for s, r in records.items()},
+        "loop_control": {s: _num(r.get("loop_control_proxy")) for s, r in records.items()},
+        "ub_overflow": {s: _num(r.get("ub_overflow_pressure")) for s, r in records.items()},
+    }
+    default_weights = {
+        "tail": 1.25,
+        "imbalance": 1.0,
+        "occupancy": 0.75,
+        "reduction_loops": 0.55,
+        "loop_control": 0.35,
+        "ub_overflow": 0.45,
+    }
+    if motif_by_sig:
+        views["motif_deca"] = {
+            s: _num(records[s].get("motif_motif_score_proxy"), float("inf"))
+            for s in records
+        }
+        # Stronger than generic workload, weaker than an audited family DECA.
+        # Candidate-specific motif confidence below scales this further.
+        default_weights["motif_deca"] = 1.30
+    if special_by_sig:
+        views["deca"] = {s: _num(records[s].get("score_us_proxy"), float("inf")) for s in records}
+        default_weights["deca"] = 1.75
+    if program_by_sig:
+        views["program_workload"] = {
+            s: _num(records[s].get("program_program_workload_score"), float("inf"))
+            for s in records
+        }
+        default_weights["program_workload"] = float(opts.get("source_program_workload_weight_v68", 1.10) or 1.10)
+    if anchor_by_sig:
+        views["ttir_anchor"] = {
+            s: _num(records[s].get("anchor_ttir_anchor_penalty"), float("inf"))
+            for s in records
+        }
+        default_weights["ttir_anchor"] = float(opts.get("ttir_anchor_weight_v68", 0.60) or 0.60)
+    if not special_by_sig and not motif_by_sig:
+        # Generic arithmetic volume is a weak tie-breaker; launch/control and
+        # resource-pressure views now carry more of the generic discrimination.
+        views["generic_work"] = {s: _num(r.get("generic_work_proxy")) for s, r in records.items()}
+        default_weights["generic_work"] = 0.20
+
+    view_weights = dict(default_weights)
+    view_weights.update({str(k): float(v) for k, v in dict(opts.get("source_view_weights", {}) or {}).items()})
+    normalized = {name: _rank01(vals) for name, vals in views.items()}
+    # Semantic-dependent generic views are trusted in proportion to how many
+    # tunable axes have runtime-resolved extents.  Tail/imbalance/occupancy and
+    # audited DECA retain their base weights.
+    per_sig_scale = {}
+    for sig, rec in records.items():
+        cov = min(1.0, max(0.0, float(rec.get("source_semantic_coverage", 0.0) or 0.0)))
+        floor = 0.20 + 0.80 * cov
+        motif_conf = min(1.0, max(0.0, float(rec.get("source_motif_confidence", 0.0) or 0.0)))
+        motif_scale = motif_conf
+        if rec.get("specialized_deca_view_used"):
+            # Do not double-count essentially the same DECA structural trend
+            # when the audited FA/chunk frontend is available. Motif-DECA is
+            # retained as a weak consistency vote.
+            motif_scale *= 0.35
+        program_conf = min(1.0, max(0.0, float(rec.get("program_semantic_confidence", 0.0) or 0.0)))
+        # Audited FA/chunk Source-DECA already contains exact task assignment
+        # and per-task inner-loop work. Keep the generic V6.8 program view as a
+        # weak consistency vote there, but let it carry full weight for motifs
+        # that do not have a specialized frontend.
+        if special_by_sig:
+            program_conf *= 0.35
+        anchor_conf = min(1.0, max(0.0, float(rec.get("anchor_ttir_anchor_confidence", 0.0) or 0.0)))
+        per_sig_scale[sig] = {
+            "reduction_loops": floor,
+            "loop_control": floor,
+            "ub_overflow": floor,
+            "generic_work": floor,
+            "motif_deca": motif_scale,
+            "program_workload": program_conf,
+            "ttir_anchor": anchor_conf,
+        }
+    fused, disagreement, effective_weights = _weighted_rank_fusion(
+        normalized, view_weights, per_sig_weight_scale=per_sig_scale
+    )
+    for sig in records:
+        records[sig]["consensus_rank_score"] = fused[sig]
+        records[sig]["rank_view_disagreement"] = disagreement[sig]
+        records[sig]["rank_views"] = {name: normalized[name][sig] for name in normalized}
+        records[sig]["rank_view_weights"] = {name: float(view_weights.get(name, 1.0)) for name in normalized}
+        records[sig]["rank_view_effective_weights"] = effective_weights[sig]
+        records[sig]["semantic_dependent_weight_scale"] = 0.20 + 0.80 * min(1.0, max(0.0, float(records[sig].get("source_semantic_coverage", 0.0) or 0.0)))
+
+    ranked_input = sorted(rows, key=lambda row: (
+        fused[config_signature(row["config"])],
+        disagreement[config_signature(row["config"])],
+        config_signature(row["config"]),
+    ))
+    out = []
+    for idx, row0 in enumerate(ranked_input, 1):
+        row = dict(row0); sig = config_signature(row["config"])
+        out.append({
+            **row,
+            "raw_deca_rank": idx,  # compatibility name; now means source-prior rank
+            "source_prior_rank": idx,
+            "precompile_source_prefilter": records[sig],
+        })
+    return out, {
+        "model_kind": "v6_3_semantic_confidence_weighted_consensus_source_prior",
+        "model_revision": "v6_5_generic_role_resource_views_v1",
+        "motif_deca_revision": "v6_6_source_motif_deca_v1",
+        "operator_family": family,
+        "specialized_deca_view_used": bool(special_by_sig),
+        "specialized_analyzer_capability": specialized_meta,
+        "motif_deca_view_used": bool(motif_by_sig),
+        "motif_deca_capability": motif_meta,
+        "motif_deca_operator_name_dispatch": False,
+        "motif_deca_uses_ttir": False,
+        "motif_deca_uses_hivm": False,
+        "motif_deca_uses_des": False,
+        "source_program_workload_v68_used": bool(program_by_sig),
+        "source_program_workload_v68_capability": program_meta,
+        "ttir_anchor_refinement_v68_used": bool(anchor_by_sig),
+        "ttir_anchor_refinement_v68_capability": anchor_meta,
+        "ttir_anchor_refinement_requests_compilation": False,
+        "generic_fallback_available": True,
+        "generic_ranker_has_operator_family_whitelist": False,
+        "views": list(normalized),
+        "view_weights": {name: float(view_weights.get(name, 1.0)) for name in normalized},
+        "autotiling_axis_semantics_consumed": True,
+        "source_semantic_coverage_mean": statistics.fmean([float(r.get("source_semantic_coverage", 0.0)) for r in records.values()]) if records else 0.0,
+        "candidate_performance_labels_used": False,
+        "candidate_msprof_labels_used": False,
+        "trained_parameters": [],
+    }
