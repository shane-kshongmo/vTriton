+"""Optional lightweight calibration layer for universal TTIR model."""
+
+def calibrate_latency(score, features, options):
+    """Deterministic correction hook. Can be replaced by learned model."""
+    if not options.get("enable_ttir_calibration", False):
+        return score
+    correction = 1.0
+    if features.irregularity > 0.3:
+        correction += 0.15 * features.irregularity
+    if features.ub_pressure > 1.0:
+        correction += 0.1
+    return score * correction
diff --git a/third_party/ascend/backend/runtime/ttir_dag_model.py b/third_party/ascend/backend/runtime/ttir_dag_model.py
