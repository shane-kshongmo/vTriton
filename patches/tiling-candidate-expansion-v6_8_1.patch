index 000000000..f7ad0c04b
--- /dev/null
+++ b/third_party/ascend/backend/runtime/ttir_anchor_refinement_v68.py
@@ -0,0 +1,134 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Low-incremental-cost TTIR anchor refinement for Source++ V6.8.
+
+Unlike Full-vTriton, this module never requests compilation itself.  It only
+consumes TTIR that is already available from configurations compiled for B0 or
+bootstrap.  The extracted structure becomes a weak local ranking view for
+nearby, still-uncompiled candidates.
+"""
+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from .search_space_v6 import SearchSpaceSpec, config_signature, structural_distance
+from .ttir_kernel_template import extract_kernel_template
+from .ttir_pointer_analysis import analyze_pointer_access
+
+
+def _load_ttir(anchor: Mapping[str, Any]) -> str | None:
+    text = anchor.get("ttir") or anchor.get("ttir_text")
+    if isinstance(text, str) and text.strip():
+        return text
+    path = anchor.get("ttir_path")
+    if path:
+        p = Path(str(path))
+        if p.is_file():
+            return p.read_text(encoding="utf-8", errors="replace")
+    return None
+
+
+def extract_anchor_features(anchor: Mapping[str, Any]) -> dict[str, Any] | None:
+    text = _load_ttir(anchor)
+    if not text:
+        return None
+    cfg = dict(anchor.get("config") or {})
+    template = extract_kernel_template(
+        text,
+        family_key=("v68_anchor", config_signature(cfg)),
+        allow_text_fallback=True,
+    )
+    ptr = analyze_pointer_access(template)
+    counts = dict(template.operation_counts or {})
+    op_total = float(sum(max(0, int(v)) for v in counts.values()))
+    unknown_n = float(len(template.unknown_tt_ops or ()))
+    # Label-free structural complexity.  Absolute value is unimportant; only
+    # anchor-to-anchor ordering is used.
+    penalty = (
+        0.30 * math.log1p(op_total)
+        + 0.45 * float(template.persistent_loop_count)
+        + 0.65 * float(ptr.indirect_access_ratio)
+        + 0.25 * float(ptr.masked_access_ratio)
+        + 0.35 * max(0.0, 1.0 - float(ptr.contiguous_score))
+        + 0.20 * max(0.0, 1.0 - float(ptr.stride_score))
+        + 0.30 * unknown_n
+        + (0.35 if template.has_atomic else 0.0)
+    )
+    confidence = min(0.98, max(0.05, float(template.confidence) * float(ptr.confidence)))
+    return {
+        "config": cfg,
+        "structural_penalty": float(penalty),
+        "confidence": float(confidence),
+        "ttir_sha256": template.ttir_sha256,
+        "persistent_loop_count": int(template.persistent_loop_count),
+        "operation_count_total": int(op_total),
+        "unknown_op_count": int(unknown_n),
+        "pointer_indirect_ratio": float(ptr.indirect_access_ratio),
+        "pointer_masked_ratio": float(ptr.masked_access_ratio),
+        "pointer_contiguous_score": float(ptr.contiguous_score),
+        "extractor": template.extractor,
+    }
+
+
+def score_rows_ttir_anchors(
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    search_space: SearchSpaceSpec,
+    anchors: Sequence[Mapping[str, Any]],
+    max_neighbors: int = 3,
+    distance_scale: float = 0.35,
+) -> tuple[dict[tuple, dict[str, Any]], dict[str, Any]]:
+    feats = [f for a in anchors if (f := extract_anchor_features(a)) is not None]
+    if not feats:
+        return {}, {
+            "model_kind": "ttir_anchor_refinement_v68",
+            "available": False,
+            "anchor_count": 0,
+            "uses_candidate_latency_labels": False,
+            "requests_compilation": False,
+        }
+    out: dict[tuple, dict[str, Any]] = {}
+    scale = max(1e-6, float(distance_scale))
+    k = max(1, int(max_neighbors))
+    for row in rows:
+        cfg = dict(row.get("config") or {})
+        neighbors = []
+        for f in feats:
+            dist = structural_distance(search_space, cfg, f["config"])
+            # Exponential locality; exact/nearby compiled structures dominate.
+            w = float(f["confidence"]) * math.exp(-dist / scale)
+            neighbors.append((dist, -w, w, f))
+        neighbors.sort(key=lambda x: (x[0], x[1], config_signature(x[3]["config"])))
+        chosen = neighbors[:k]
+        denom = sum(x[2] for x in chosen)
+        if denom <= 1e-12:
+            continue
+        penalty = sum(x[2] * float(x[3]["structural_penalty"]) for x in chosen) / denom
+        nearest = chosen[0][0]
+        confidence = min(1.0, sum(x[2] for x in chosen) / max(1, len(chosen))) * math.exp(-nearest / scale)
+        out[config_signature(cfg)] = {
+            "model_kind": "ttir_anchor_refinement_v68",
+            "ttir_anchor_penalty": float(penalty),
+            "ttir_anchor_confidence": float(max(0.0, min(1.0, confidence))),
+            "nearest_anchor_distance": float(nearest),
+            "neighbor_count": len(chosen),
+            "anchor_ttirs": [x[3]["ttir_sha256"] for x in chosen],
+            "uses_ttir": True,
+            "uses_hivm": False,
+            "uses_des": False,
+            "requests_compilation": False,
+            "uses_candidate_latency_labels": False,
+        }
+    return out, {
+        "model_kind": "ttir_anchor_refinement_v68",
+        "available": bool(out),
+        "anchor_count": len(feats),
+        "max_neighbors": k,
+        "distance_scale": scale,
+        "uses_ttir": True,
+        "uses_hivm": False,
+        "uses_des": False,
+        "requests_compilation": False,
+        "uses_candidate_latency_labels": False,
+    }
