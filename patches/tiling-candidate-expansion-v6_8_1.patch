+#!/usr/bin/env python3
+"""Offline/isolated V6.8 stability-aware safety-frontier certification for FA/Chunk regression cases.
+
+This tool is deliberately outside production timing. It consumes the label-free
+V6.8 Source++ proposal queue and spends certification budget on a mixture of high-value,
+high-uncertainty and direction-diverse UNKNOWN candidates.  It writes only
+SAFE/UNSAFE execution evidence to SafetyRegistry. No latency, winner, rank, score
+or MSProf measurement is persisted in the registry.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+EXP = HERE.parent
+CAL = EXP / "vtriton_new_ops_calibration"
+for p in (HERE, CAL):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+from native_autotune_v53 import _run_isolated_smoke, write_json  # noqa: E402
+
+
+def _opp(row):
+    return max(0.0, float(((row.get("v6_relative") or {}).get("opportunity_score", 0.0)) or 0.0))
+
+
+def _conf(row):
+    return min(1.0, max(0.0, float(((row.get("v6_relative") or {}).get("multiview_confidence", 0.0)) or 0.0)))
+
+
+def _disagreement(row):
+    return max(0.0, float(((row.get("precompile_source_prefilter") or {}).get("rank_view_disagreement", 0.0)) or 0.0))
+
+
+def _direction_key(row):
+    rel = dict(row.get("v6_relative") or {})
+    return tuple(rel.get("direction_signature") or ()), str(row.get("origin_stage", "unknown"))
+
+
+def select_v68_certification_frontier(
+    unknown_rows, *, max_select: int, exploit_fraction: float = 0.50, uncertainty_fraction: float = 0.25
+):
+    """Label-free value/uncertainty/diversity mix for offline Safety probes.
+
+    Input rows may contain a private ``_proposal_rank`` field used only in the
+    certification output.  The returned selection never enters SafetyRegistry
+    evidence, so performance/rank provenance remains clean.
+    """
+    pool = [dict(r) for r in unknown_rows]
+    cap = min(len(pool), max(0, int(max_select)))
+    if cap <= 0:
+        return []
+    exploit_n = min(cap, max(0, int(round(cap * max(0.0, min(1.0, float(exploit_fraction)))))))
+    uncertainty_n = min(cap - exploit_n, max(0, int(round(cap * max(0.0, min(1.0, float(uncertainty_fraction)))))))
+
+    selected = []
+    selected_sigs = set()
+    def sig(r):
+        return repr(sorted(dict(r["config"]).items()))
+    def add(rows, n, role):
+        added = 0
+        for row in rows:
+            s = sig(row)
+            if s in selected_sigs:
+                continue
+            selected_sigs.add(s)
+            selected.append({**row, "_certification_role": role})
+            added += 1
+            if added >= n or len(selected) >= cap:
+                break
+
+    exploit = sorted(pool, key=lambda r: (-_opp(r), -_conf(r), int(r.get("_proposal_rank", 10**9)), sig(r)))
+    add(exploit, exploit_n, "value")
+
+    uncertain = sorted(pool, key=lambda r: (-_disagreement(r), -_opp(r), int(r.get("_proposal_rank", 10**9)), sig(r)))
+    add(uncertain, uncertainty_n, "uncertainty")
+
+    # Spend the rest across distinct parameter directions/origin stages first.
+    diverse = sorted(pool, key=lambda r: (-float((r.get("v6_relative") or {}).get("primary_anchor_distance", 0.0) or 0.0), -_disagreement(r), int(r.get("_proposal_rank", 10**9)), sig(r)))
+    seen_dirs = {_direction_key(r) for r in selected}
+    diverse_first = [r for r in diverse if _direction_key(r) not in seen_dirs]
+    add(diverse_first, cap - len(selected), "direction_diverse")
+    add(diverse, cap - len(selected), "fill")
+    return selected[:cap]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo", type=Path, required=True)
+    ap.add_argument("--result-root", type=Path, required=True,
+                    help="V6.8 result root containing ours_v68/.../selection_plan.json")
+    ap.add_argument("--operator", choices=("flash_attention_npu_v8", "chunk_o"), required=True)
+    ap.add_argument("--case-index", type=int, required=True)
+    ap.add_argument("--registry", type=Path, required=True)
+    ap.add_argument("--campaign-id", required=True)
+    ap.add_argument("--cache-root", type=Path, required=True)
+    ap.add_argument("--output", type=Path, required=True)
+    ap.add_argument("--max-certify", type=int, default=24,
+                    help="Maximum UNKNOWN candidates to probe in this invocation")
+    ap.add_argument("--adaptive-extra-certify", type=int, default=0,
+                    help="Optional second-wave UNKNOWN probes when first-wave SAFE yield is high")
+    ap.add_argument("--adaptive-min-safe-rate", type=float, default=0.90,
+                    help="Minimum first-wave SAFE fraction required to spend adaptive extra certification budget")
+    ap.add_argument("--exploit-fraction", type=float, default=0.50,
+                    help="Fraction of certification budget reserved for highest Source opportunity/confidence")
+    ap.add_argument("--uncertainty-fraction", type=float, default=0.25,
+                    help="Fraction reserved for highest Source-view disagreement; remainder is direction-diverse")
+    ap.add_argument("--timeout-s", type=int, default=120)
+    ap.add_argument("--max-unsafe", type=int, default=1,
+                    help="Abort certification after this many newly observed UNSAFE candidates")
+    args = ap.parse_args()
+
+    repo = args.repo.resolve()
+    result_root = args.result_root.resolve()
+    case_dir = result_root / "ours_v68" / args.operator / f"case_{args.case_index}"
+    plan_path = case_dir / "selection_plan.json"
+    official_path = result_root / "official" / args.operator / f"case_{args.case_index}" / "result.json"
+    if not plan_path.is_file():
+        raise FileNotFoundError(plan_path)
+    if not official_path.is_file():
+        raise FileNotFoundError(official_path)
+
+    from cases import get_cases
+    from backend.runtime.safety_registry import SafetyRegistry, certificate_identity, certificate_payload
+    from backend.runtime.search_space_v6 import split_config_mapping
+
+    case = dict(get_cases(args.operator)[args.case_index])
+    plan = json.loads(plan_path.read_text(encoding="utf-8"))
+    official = json.loads(official_path.read_text(encoding="utf-8"))
+    proposals = list(plan.get("proposal_queue") or [])
+    canary_cfg = dict(official["winner"]["config"])
+
+    registry = SafetyRegistry(args.registry)
+    identity = certificate_identity(repo=repo, operator=args.operator)
+    cache_root = args.cache_root.resolve()
+    cache_root.mkdir(parents=True, exist_ok=True)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+
+    records = []
+    newly_probed = 0
+    new_safe = 0
+    new_unsafe = 0
+    existing_safe = 0
+    existing_unsafe = 0
+    foreign = 0
+    unknown_skipped_budget = 0
+    t0 = time.perf_counter()
+
+    def payload_for(cfg):
+        kwargs, meta = split_config_mapping(cfg)
+        return certificate_payload(
+            repo=repo,
+            operator=args.operator,
+            case=case,
+            cfg=kwargs,
+            identity=identity,
+            num_warps=int(meta.get("num_warps", 4)),
+            num_stages=int(meta.get("num_stages", 3)),
+            num_ctas=int(meta.get("num_ctas", 1)),
+            maxnreg=meta.get("maxnreg"),
+        )
+
+    # First classify the whole proposal frontier without launching UNKNOWNs.
+    unknown_frontier = []
+    for rank, row in enumerate(proposals, 1):
+        cfg = dict(row["config"])
+        payload = payload_for(cfg)
+        stored, key_mode = registry.lookup_compatible(payload)
+        if stored is not None:
+            status = str(stored.get("status", "")).upper()
+            campaign = str((stored.get("evidence") or {}).get("campaign_id", ""))
+            if campaign != str(args.campaign_id):
+                foreign += 1
+                records.append({"proposal_rank": rank, "config": cfg, "decision": "foreign_campaign_existing", "status": status, "campaign_id": campaign, "key_mode": key_mode})
+                continue
+            if status == "SAFE":
+                existing_safe += 1
+                records.append({"proposal_rank": rank, "config": cfg, "decision": "already_safe", "key_mode": key_mode})
+                continue
+            if status == "UNSAFE":
+                existing_unsafe += 1
+                records.append({"proposal_rank": rank, "config": cfg, "decision": "already_unsafe", "key_mode": key_mode})
+                continue
+        unknown_frontier.append({**dict(row), "_proposal_rank": rank, "_payload": payload, "_key_mode": key_mode})
+
+    initial_selected = select_v68_certification_frontier(
+        unknown_frontier,
+        max_select=max(0, int(args.max_certify)),
+        exploit_fraction=args.exploit_fraction,
+        uncertainty_fraction=args.uncertainty_fraction,
+    )
+    selected_unknown = list(initial_selected)
+    selected_sigs = {repr(sorted(dict(r["config"]).items())) for r in selected_unknown}
+    adaptive_second_wave_selected = 0
+
+    def probe_selected(selected_rows):
+        nonlocal newly_probed, new_safe, new_unsafe
+        for selected in selected_rows:
+            rank = int(selected["_proposal_rank"])
+            cfg = dict(selected["config"])
+            payload = dict(selected["_payload"])
+            role = str(selected.get("_certification_role", "unknown"))
+            if int(args.max_unsafe) > 0 and new_unsafe >= int(args.max_unsafe):
+                break
+
+            newly_probed += 1
+            candidate_cache = cache_root / args.operator / f"case_{args.case_index}" / f"rank_{rank:04d}"
+            shutil.rmtree(candidate_cache, ignore_errors=True)
+            candidate_cache.mkdir(parents=True, exist_ok=True)
+            probe_path = args.output.parent / "probes" / f"rank_{rank:04d}.json"
+            probe_path.parent.mkdir(parents=True, exist_ok=True)
+            probe = _run_isolated_smoke(
+                repo=repo, operator=args.operator, case_index=args.case_index, cfg=cfg,
+                cache_dir=candidate_cache, output=probe_path, timeout_s=args.timeout_s,
+            )
+            safe = probe.get("status") == "safe" and int(probe.get("returncode", 1)) == 0
+            if safe:
+                registry.record(payload, status="SAFE", evidence={
+                    "kind": "v6_7_guided_frontier_certification",
+                    "campaign_id": args.campaign_id,
+                    "probe_path": str(probe_path),
+                    "correctness": probe.get("correctness"),
+                })
+                new_safe += 1
+                decision = "new_safe"
+            else:
+                registry.record(payload, status="UNSAFE", evidence={
+                    "kind": "v6_7_guided_frontier_certification_fault",
+                    "campaign_id": args.campaign_id,
+                    "probe_path": str(probe_path),
+                    "status": probe.get("status"),
+                    "error_type": probe.get("error_type"),
+                    "error_tail": str(probe.get("error", ""))[-2000:],
+                })
+                new_unsafe += 1
+                decision = "new_unsafe"
+
+            rec = {
+                "proposal_rank": rank, "config": cfg, "certification_role": role,
+                "decision": decision, "probe_status": probe.get("status"),
+                "returncode": probe.get("returncode"),
+                "process_unreaped_after_sigkill": bool(probe.get("process_unreaped_after_sigkill")),
+            }
+            records.append(rec)
+            if probe.get("process_unreaped_after_sigkill"):
+                write_json(args.output, {"status": "abort_unreaped_child", "records": records})
+                raise RuntimeError("isolated certification child could not be reaped; abort")
+
+            if not safe:
+                time.sleep(1.0)
+                canary_cache = cache_root / args.operator / f"case_{args.case_index}" / f"canary_after_rank_{rank:04d}"
+                shutil.rmtree(canary_cache, ignore_errors=True)
+                canary_cache.mkdir(parents=True, exist_ok=True)
+                canary_path = args.output.parent / "canaries" / f"after_rank_{rank:04d}.json"
+                canary_path.parent.mkdir(parents=True, exist_ok=True)
+                canary = _run_isolated_smoke(
+                    repo=repo, operator=args.operator, case_index=args.case_index, cfg=canary_cfg,
+                    cache_dir=canary_cache, output=canary_path, timeout_s=args.timeout_s,
+                )
+                rec["recovery_canary"] = {"status": canary.get("status"), "returncode": canary.get("returncode"), "path": str(canary_path)}
+                if not (canary.get("status") == "safe" and int(canary.get("returncode", 1)) == 0):
+                    write_json(args.output, {"status": "abort_canary_failed", "records": records})
+                    raise RuntimeError("device recovery canary failed after unsafe certification candidate")
+
+        return
+
+    probe_selected(initial_selected)
+
+    first_wave_probed = newly_probed
+    first_wave_safe = new_safe
+    first_wave_unsafe = new_unsafe
+    first_wave_safe_rate = (
+        float(first_wave_safe) / max(1, first_wave_safe + first_wave_unsafe)
+    )
+
+    # V6.5 observed 59 SAFE / 1 UNSAFE across the guided frontier.  V6.7 can
+    # spend a second offline wave only when this *current invocation* shows the
+    # same high SAFE yield.  This cost remains outside production autotune time.
+    extra_cap = max(0, int(args.adaptive_extra_certify))
+    if (
+        extra_cap > 0
+        and first_wave_probed > 0
+        and first_wave_safe_rate >= float(args.adaptive_min_safe_rate)
+        and (int(args.max_unsafe) <= 0 or new_unsafe < int(args.max_unsafe))
+    ):
+        remaining = [
+            r for r in unknown_frontier
+            if repr(sorted(dict(r["config"]).items())) not in selected_sigs
+        ]
+        extra = select_v68_certification_frontier(
+            remaining,
+            max_select=extra_cap,
+            exploit_fraction=args.exploit_fraction,
+            uncertainty_fraction=args.uncertainty_fraction,
+        )
+        adaptive_second_wave_selected = len(extra)
+        selected_unknown.extend(extra)
+        selected_sigs.update(repr(sorted(dict(r["config"]).items())) for r in extra)
+        probe_selected(extra)
+
+    unknown_skipped_budget = sum(
+        1 for r in unknown_frontier
+        if repr(sorted(dict(r["config"]).items())) not in selected_sigs
+    )
+
+    summary = {
+        "schema_version": "candidate_value_v6_7_frontier_certification_v1",
+        "operator": args.operator,
+        "case_index": args.case_index,
+        "campaign_id": args.campaign_id,
+        "proposal_count": len(proposals),
+        "certification_policy": "v6_7_adaptive_value_uncertainty_direction_diverse",
+        "exploit_fraction": float(args.exploit_fraction),
+        "uncertainty_fraction": float(args.uncertainty_fraction),
+        "selected_unknown_count": len(selected_unknown),
+        "initial_selected_unknown_count": len(initial_selected),
+        "adaptive_second_wave_selected": adaptive_second_wave_selected,
+        "first_wave_safe_rate": first_wave_safe_rate,
+        "adaptive_min_safe_rate": float(args.adaptive_min_safe_rate),
+        "newly_probed": newly_probed,
+        "new_safe": new_safe,
+        "new_unsafe": new_unsafe,
+        "existing_safe": existing_safe,
+        "existing_unsafe": existing_unsafe,
+        "foreign_campaign": foreign,
+        "unknown_skipped_budget": unknown_skipped_budget,
+        "wall_s": time.perf_counter() - t0,
+        "candidate_performance_labels_used": False,
+        "msprof_labels_used": False,
+        "records": records,
+        "registry_stats_after": registry.stats(),
+    }
+    write_json(args.output, summary)
+    print(json.dumps({k: summary[k] for k in ("operator","case_index","newly_probed","new_safe","new_unsafe","existing_safe","existing_unsafe","wall_s")}, ensure_ascii=False))
+    print("OUTPUT=", args.output)
+
+
+if __name__ == "__main__":
+    main()
