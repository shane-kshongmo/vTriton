+#!/usr/bin/env python3
+from __future__ import annotations
+import argparse,json,statistics
+from pathlib import Path
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument('--root',type=Path,required=True); ap.add_argument('--output',type=Path,required=True); a=ap.parse_args()
+    rows=[]
+    for op in ('flash_attention_npu_v8','chunk_o'):
+        for idx in range(3):
+            p=a.root/op/f'case_{idx}.json'
+            if not p.is_file(): continue
+            j=json.loads(p.read_text()); rows.append(j)
+    names=('source_v67','source_pp_v68','source_pp_ttir_anchor_v68')
+    agg={}
+    for name in names:
+        ms=[r['metrics'][name] for r in rows if name in r.get('metrics',{})]
+        agg[name]={
+          'cases':len(ms),
+          'mean_regret_at_1_pct':statistics.fmean(float(m['regret_at_1_pct']) for m in ms) if ms else None,
+          'mean_regret_at_3_pct':statistics.fmean(float(m['regret_at_3_pct']) for m in ms) if ms else None,
+          'mean_regret_at_5_pct':statistics.fmean(float(m['regret_at_5_pct']) for m in ms) if ms else None,
+          'k_to_1pct_cases_reached':sum(m.get('k_to_1pct') is not None for m in ms),
+          'mean_k_to_1pct_reached_only':statistics.fmean(float(m['k_to_1pct']) for m in ms if m.get('k_to_1pct') is not None) if any(m.get('k_to_1pct') is not None for m in ms) else None,
+        }
+    out={'schema_version':'candidate_value_v6_8_ranker_ab_summary_v1','rows':rows,'aggregate':agg}
+    a.output.parent.mkdir(parents=True,exist_ok=True); a.output.write_text(json.dumps(out,indent=2,ensure_ascii=False),encoding='utf-8')
+    print('='*120); print('V6.8 RANKER A/B SUMMARY'); print('='*120)
+    for name in names: print(name, agg[name])
+    print('OUTPUT=',a.output)
+if __name__=='__main__': main()
diff --git a/third_party/ascend/experiments/candidate_value_eval/validate_native_v68_pair.py b/third_party/ascend/experiments/candidate_value_eval/validate_native_v68_pair.py
