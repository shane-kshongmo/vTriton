+#!/usr/bin/env python3
+"""Isolated one-launch safety/correctness probe for a fixed expanded Config.
+
+A 507015/AICore exception may poison the process that launched the bad kernel.
+This worker therefore validates exactly one candidate and exits.  The parent
+V5.1 autotune process never launches an unverified novel candidate.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+HERE = Path(__file__).resolve().parent
+CAL = HERE.parent / "vtriton_new_ops_calibration"
+if str(CAL) not in sys.path:
+    sys.path.insert(0, str(CAL))
+
+
+def _write(path: Path, obj: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo", type=Path, required=True)
+    ap.add_argument("--operator", choices=("flash_attention_npu_v8", "chunk_o"), required=True)
+    ap.add_argument("--case-index", type=int, required=True)
+    ap.add_argument("--config-json", required=True)
+    ap.add_argument("--cache-dir", type=Path, required=True)
+    ap.add_argument("--output", type=Path, required=True)
+    args = ap.parse_args()
+
+    args.cache_dir.mkdir(parents=True, exist_ok=True)
+    os.environ["TRITON_CACHE_DIR"] = str(args.cache_dir.resolve())
+    os.environ["TRITON_DUMP_DIR"] = str((args.cache_dir / "triton_dump").resolve())
+    os.environ.setdefault("TRITON_AUTOTUNE_PARALLEL_COMPILE", "1")
+    started = time.perf_counter()
+    cfg = json.loads(args.config_json)
+    result: dict[str, Any] = {
+        "operator": args.operator,
+        "case_index": args.case_index,
+        "config": cfg,
+        "status": "error",
+    }
+    rc = 2
+    try:
+        import torch
+        import torch_npu  # noqa: F401
+        from cases import get_cases
+        from operator_adapters import load_module, launch, prepare, reference
+
+        case = dict(get_cases(args.operator)[args.case_index])
+        module, source = load_module(args.repo.resolve(), args.operator)
+        tensors = prepare(args.operator, case, cfg, "npu")
+        ref = reference(args.operator, case, tensors)
+        torch.npu.synchronize()
+
+        tol = 4e-2 if case["dtype"] == "bfloat16" else 2e-2
+        replay_count = 3
+        attempts = []
+        first_launch_wall = None
+        total_launch_wall = 0.0
+        ok = True
+        for i in range(replay_count):
+            st = dict(tensors)
+            st["o"] = torch.empty_like(tensors["o"])
+            if args.operator == "flash_attention_npu_v8":
+                st["l"] = torch.empty_like(tensors["l"])
+            launch0 = time.perf_counter()
+            out = launch(args.operator, module, case, cfg, st)
+            torch.npu.synchronize()
+            launch_wall = time.perf_counter() - launch0
+            total_launch_wall += launch_wall
+            if first_launch_wall is None:
+                first_launch_wall = launch_wall
+            primary_finite = bool(torch.isfinite(out).all().item())
+            primary_ok = primary_finite and bool(torch.allclose(out, ref, atol=tol, rtol=tol, equal_nan=False))
+            aux_finite = True
+            if args.operator == "flash_attention_npu_v8":
+                aux_finite = bool(torch.isfinite(st["l"]).all().item())
+            attempt_ok = primary_ok and aux_finite
+            max_abs = float((out.float() - ref.float()).abs().max().item()) if primary_finite else float("inf")
+            attempts.append({
+                "attempt": i + 1, "allclose": primary_ok, "primary_finite": primary_finite,
+                "auxiliary_finite": aux_finite, "max_abs_error": max_abs, "launch_wall_s": launch_wall,
+            })
+            if not attempt_ok:
+                ok = False
+                break
+        ok = ok and len(attempts) == replay_count
+        result.update({
+            "status": "safe" if ok else "incorrect",
+            "source": str(source),
+            "correctness": {
+                "allclose": ok, "finite": ok, "auxiliary_finite": ok,
+                "max_abs_error": max((a["max_abs_error"] for a in attempts), default=float("inf")),
+                "atol": tol, "rtol": tol,
+                "stability_replays_required": replay_count, "attempts": attempts,
+            },
+            "first_launch_wall_s": first_launch_wall,
+            "total_replay_wall_s": total_launch_wall,
+        })
+        rc = 0 if ok else 3
+    except BaseException as exc:  # process exits immediately after recording the fault
+        result.update({
+            "status": "runtime_fault",
+            "error_type": type(exc).__name__,
+            "error": str(exc)[-16000:],
+        })
+        rc = 2
+    finally:
+        result["worker_wall_s"] = time.perf_counter() - started
+        _write(args.output, result)
+    return rc
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
