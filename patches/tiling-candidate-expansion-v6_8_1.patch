new file mode 100644
index 000000000..ac5e04f19
--- /dev/null
+++ b/third_party/ascend/backend/runtime/search_space_v6.py
@@ -0,0 +1,394 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Generic search-space description for V6 near-optimal autotuning.
+
+The search policy must not know operator names.  It consumes the same metadata
+already used by Triton-Ascend AutoTilingTuner: explicit tunable_parameter,
+parameter_domains, split_params/tiling_params, and the Config kwargs produced by
+TileGenerator/CVTileGenerator.
+
+This module intentionally contains no performance labels and no hardware
+measurements.  It only normalizes discrete tunable coordinates and structural
+model features for ranking/search.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, asdict
+import itertools
+import math
+from typing import Any, Mapping, Sequence
+
+
+# Triton compile/launch metadata that live on ``triton.Config`` rather than
+# inside ``Config.kwargs``.  Final V6 treats them as ordinary search
+# coordinates when the official tuner exposes more than one value (or when a
+# caller declares an explicit domain), but splits them back out before
+# constructing/launching a Config.
+TRITON_LAUNCH_META_AXES = ("num_warps", "num_stages", "num_ctas", "maxnreg")
+
+
+def canonical_config_mapping(cfg: Any) -> dict[str, Any]:
+    """Return one canonical mapping containing kwargs *and* launch metadata.
+
+    Accepted inputs are a plain mapping, a mapping with a nested ``kwargs``
+    field, or a Config-like object carrying ``kwargs/num_warps/num_stages``.
+    ``None`` launch metadata is omitted so fixed/unsupported fields do not
+    accidentally become search axes.
+    """
+    if isinstance(cfg, Mapping):
+        raw = dict(cfg)
+        nested = raw.pop("kwargs", None)
+        out = dict(nested) if isinstance(nested, Mapping) else {}
+        out.update(raw)
+        return out
+    kwargs = getattr(cfg, "kwargs", None)
+    if kwargs is None:
+        raise TypeError(f"unsupported config type for V6 search space: {type(cfg)!r}")
+    out = dict(kwargs)
+    for name in TRITON_LAUNCH_META_AXES:
+        value = getattr(cfg, name, None)
+        if value is not None:
+            out[name] = value
+    return out
+
+
+def split_config_mapping(cfg: Any) -> tuple[dict[str, Any], dict[str, Any]]:
+    """Split a canonical V6 coordinate back into kernel kwargs + Config meta."""
+    d = canonical_config_mapping(cfg)
+    meta = {}
+    for name in TRITON_LAUNCH_META_AXES:
+        if name in d:
+            meta[name] = d.pop(name)
+    return d, meta
+
+
+def observed_launch_meta_domains(configs: Sequence[Any]) -> dict[str, list[Any]]:
+    """Collect launch-meta values exposed by Official/generated Configs."""
+    domains: dict[str, list[Any]] = {}
+    for name in TRITON_LAUNCH_META_AXES:
+        vals = []
+        seen = set()
+        for cfg in configs:
+            d = canonical_config_mapping(cfg)
+            if name not in d or d[name] is None:
+                continue
+            key = (type(d[name]).__name__, repr(d[name]))
+            if key not in seen:
+                seen.add(key); vals.append(d[name])
+        if vals:
+            if all(isinstance(v, (int, float, bool)) for v in vals):
+                vals = sorted(vals, key=lambda x: float(x))
+            domains[name] = vals
+    return domains
+
+
+@dataclass(frozen=True)
+class SearchAxis:
+    name: str
+    values: tuple[Any, ...]
+    source: str
+    semantic_role: str = "generic"
+
+    def ordinal(self, value: Any) -> float:
+        if not self.values:
+            return 0.0
+        try:
+            idx = self.values.index(value)
+        except ValueError:
+            # Numeric values outside the explicit domain are projected to the
+            # nearest ordered value for distance only; legality is handled by
+            # the generator/static checker, not here.
+            if isinstance(value, (int, float)) and all(isinstance(v, (int, float)) for v in self.values):
+                idx = min(range(len(self.values)), key=lambda i: (abs(float(self.values[i]) - float(value)), i))
+            else:
+                return 0.0
+        if len(self.values) == 1:
+            return 0.0
+        return float(idx) / float(len(self.values) - 1)
+
+
+@dataclass(frozen=True)
+class SearchSpaceSpec:
+    axes: tuple[SearchAxis, ...]
+    official_count: int
+    cardinality: int
+    metadata_source: str
+    operator_name_required_by_search_policy: bool = False
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "axes": [asdict(a) for a in self.axes],
+            "official_count": self.official_count,
+            "cardinality": self.cardinality,
+            "metadata_source": self.metadata_source,
+            "operator_name_required_by_search_policy": self.operator_name_required_by_search_policy,
+        }
+
+
+def _role(name: str, *, split_params: Mapping[str, str] | None = None,
+          tiling_params: Mapping[str, str] | None = None,
+          reduction_axes: Sequence[str] | None = None) -> str:
+    """Best-effort role from official autotune metadata, then neutral names.
+
+    Role annotations only affect diagnostics.  Search distance is defined over
+    every axis uniformly, so a missing role never makes an operator unsupported.
+    """
+    split_params = dict(split_params or {})
+    tiling_params = dict(tiling_params or {})
+    reduction_axes = set(reduction_axes or ())
+    for axis, param in split_params.items():
+        if str(param) == name:
+            return "reduction_split" if axis in reduction_axes else "split"
+    for axis, param in tiling_params.items():
+        if str(param) == name:
+            return "reduction_tile" if axis in reduction_axes else "tile"
+    u = name.upper()
+    if u in {"NUM_SM", "NUM_SMS", "AICORE_NUM", "NUM_CORES"} or "CORE" in u:
+        return "core_count"
+    if "WARP" in u:
+        return "warps"
+    if "STAGE" in u or "MULTIBUFFER" in u:
+        return "pipeline"
+    if u in {"NUM_CTAS", "CTA_COUNT", "NUM_CTA"} or "CTA" in u:
+        return "cta_count"
+    if u in {"MAXNREG", "MAX_NREG", "MAX_REGISTERS"} or "NREG" in u:
+        return "register_limit"
+    # Conservative operator-agnostic geometry fallback for the common Triton
+    # M/N/K naming convention.  Official split/tiling metadata above always
+    # takes precedence.  Ambiguous single-axis BLOCK_SIZE remains generic.
+    if u in {"BK", "BLOCK_K", "BLOCK_SIZE_K"} or u.endswith("_K"):
+        return "reduction_tile"
+    if u in {"BM", "BLOCK_M", "BLOCK_SIZE_M", "BN", "BLOCK_N", "BLOCK_SIZE_N"} or u.endswith("_M") or u.endswith("_N"):
+        return "split"
+    return "generic"
+
+
+def infer_search_space(
+    official_configs: Sequence[Any],
+    candidate_configs: Sequence[Any] | None = None,
+    *,
+    parameter_domains: Mapping[str, Sequence[Any]] | None = None,
+    tunable_parameters: Sequence[str] | None = None,
+    split_params: Mapping[str, str] | None = None,
+    tiling_params: Mapping[str, str] | None = None,
+    reduction_axes: Sequence[str] | None = None,
+) -> SearchSpaceSpec:
+    """Infer a generic finite search space from Triton-Ascend metadata.
+
+    Precedence is deliberately aligned with AutoTilingTuner:
+      1. explicit tunable_parameter;
+      2. explicit parameter_domains;
+      3. numeric/boolean Config kwargs observed in official+expanded configs.
+
+    This means kernels using the official TileGenerator/CVTileGenerator need no
+    operator-specific parameter-name table inside V6.
+    """
+    official = [canonical_config_mapping(c) for c in official_configs]
+    candidates = [canonical_config_mapping(c) for c in (candidate_configs or official_configs)]
+    domains = {str(k): list(v) for k, v in dict(parameter_domains or {}).items()}
+    observed_meta = observed_launch_meta_domains(list(official_configs) + list(candidate_configs or ()))
+    # Explicit launch-meta domains are authoritative.  Otherwise a launch-meta
+    # field becomes a search axis only when the tuner actually exposed >1
+    # observed value; a single observed value is preserved as a fixed field.
+    for name, vals in observed_meta.items():
+        domains.setdefault(name, list(vals))
+
+    if tunable_parameters:
+        names = [str(x) for x in tunable_parameters]
+        launch_names = [
+            name for name in TRITON_LAUNCH_META_AXES
+            if name in domains and (name in set(map(str, tunable_parameters)) or len(domains[name]) > 1)
+        ]
+        names.extend(name for name in launch_names if name not in names)
+        metadata_source = "tunable_parameter+launch_meta" if launch_names else "tunable_parameter"
+    elif domains:
+        names = list(domains)
+        metadata_source = "parameter_domains"
+    else:
+        names = sorted({
+            str(k)
+            for cfg in candidates
+            for k, v in cfg.items()
+            if isinstance(v, (int, float, bool)) and not isinstance(v, complex)
+        })
+        metadata_source = "config_kwargs"
+
+    axes: list[SearchAxis] = []
+    for name in names:
+        vals = list(domains.get(name, ()))
+        if not vals:
+            vals = [cfg[name] for cfg in candidates if name in cfg]
+        # Stable deterministic de-duplication.  Numeric domains are ordered;
+        # categorical domains retain first appearance.
+        seen = set(); unique = []
+        for v in vals:
+            key = (type(v).__name__, repr(v))
+            if key not in seen:
+                seen.add(key); unique.append(v)
+        if unique and all(isinstance(v, (int, float, bool)) for v in unique):
+            unique = sorted(unique, key=lambda x: float(x))
+        if not unique:
+            continue
+        axes.append(SearchAxis(
+            name=name,
+            values=tuple(unique),
+            source=("parameter_domains" if name in domains else "observed_configs"),
+            semantic_role=_role(
+                name,
+                split_params=split_params,
+                tiling_params=tiling_params,
+                reduction_axes=reduction_axes,
+            ),
+        ))
+
+    cardinality = 1
+    for axis in axes:
+        cardinality *= max(1, len(axis.values))
+
+    return SearchSpaceSpec(
+        axes=tuple(axes),
+        official_count=len(official),
+        cardinality=int(cardinality),
+        metadata_source=metadata_source,
+    )
+
+
+def config_signature(cfg: Any) -> tuple:
+    return tuple(sorted((str(k), v) for k, v in canonical_config_mapping(cfg).items()))
+
+
+def structural_coordinates(spec: SearchSpaceSpec, cfg: Any) -> tuple[float, ...]:
+    d = canonical_config_mapping(cfg)
+    return tuple(axis.ordinal(d.get(axis.name, axis.values[0])) for axis in spec.axes)
+
+
+def structural_distance(spec: SearchSpaceSpec, a: Mapping[str, Any], b: Mapping[str, Any]) -> float:
+    xa = structural_coordinates(spec, a)
+    xb = structural_coordinates(spec, b)
+    if not xa:
+        return 0.0
+    return math.sqrt(sum((x - y) ** 2 for x, y in zip(xa, xb)) / len(xa))
+
+
+def direction_signature(spec: SearchSpaceSpec, cfg: Mapping[str, Any], anchor: Mapping[str, Any]) -> tuple[int, ...]:
+    c = structural_coordinates(spec, cfg)
+    a = structural_coordinates(spec, anchor)
+    out = []
+    for x, y in zip(c, a):
+        d = x - y
+        out.append(1 if d > 1e-12 else (-1 if d < -1e-12 else 0))
+    return tuple(out)
+
+
+def record_features(spec: SearchSpaceSpec, row: Mapping[str, Any]) -> tuple[float, ...]:
+    """Generic feature vector used for local residual correction.
+
+    The first dimensions are tunable coordinates.  Remaining dimensions are
+    source-visible white-box execution descriptors if the ranker produced them.
+    Missing descriptors are zero-filled; no operator dispatch occurs here.
+    """
+    cfg = dict(row.get("config") or {})
+    rec = dict(row.get("precompile_source_prefilter") or row.get("source_model") or {})
+    coords = list(structural_coordinates(spec, cfg))
+
+    def flog(key: str) -> float:
+        v = rec.get(key)
+        try:
+            return math.log2(max(1.0, float(v)))
+        except Exception:
+            return 0.0
+
+    def f(key: str) -> float:
+        try:
+            return float(rec.get(key, 0.0) or 0.0)
+        except Exception:
+            return 0.0
+
+    coords.extend([
+        flog("task_count"),
+        flog("total_inner_iterations"),
+        f("core_imbalance"),
+        f("tail_fraction") if "tail_fraction" in rec else f("tail_waste"),
+        f("ub_utilization"),
+        f("wave_efficiency"),
+    ])
+    return tuple(coords)
+
+
+def materialize_discrete_domain(
+    official_configs: Sequence[Any],
+    *,
+    parameter_domains: Mapping[str, Sequence[Any]],
+    tunable_parameters: Sequence[str] | None = None,
+    parameter_defaults: Mapping[str, Any] | None = None,
+    launch_meta_domains: Mapping[str, Sequence[Any]] | None = None,
+    materialization_cap: int = 4096,
+) -> tuple[list[dict[str, Any]] | None, dict[str, Any]]:
+    """Materialize the complete explicit finite tunable domain when affordable.
+
+    Materialization is compile-free and label-free.  Returning ``None`` means
+    the exact Cartesian domain is larger than the caller's cap; callers must
+    then use a lazy/expansion fallback and report that the declared domain is
+    not the complete explicit Cartesian space.
+    """
+    domains = {str(k): list(v) for k, v in dict(parameter_domains or {}).items()}
+    explicit_launch = {str(k): list(v) for k, v in dict(launch_meta_domains or {}).items()}
+    domains.update(explicit_launch)
+    observed_meta = observed_launch_meta_domains(official_configs)
+    for name, vals in observed_meta.items():
+        domains.setdefault(name, list(vals))
+    names = [str(x) for x in (tunable_parameters or domains.keys()) if str(x) in domains]
+    # Preserve/expand Config-level metadata even when the kernel's explicit
+    # tunable_parameter list only names constexpr kwargs.  Multiple observed
+    # values mean the official tuner already treated the field as tunable.
+    for name in TRITON_LAUNCH_META_AXES:
+        if name in explicit_launch or (name in domains and len(domains[name]) > 1):
+            if name not in names:
+                names.append(name)
+    defaults = canonical_config_mapping(parameter_defaults or {})
+    cardinality = 1
+    for name in names:
+        cardinality *= max(1, len(domains.get(name, ())))
+    meta = {
+        "schema_version": "candidate_value_v6_explicit_domain_v1",
+        "axes": names,
+        "launch_meta_axes": [name for name in names if name in TRITON_LAUNCH_META_AXES],
+        "cardinality": int(cardinality),
+        "materialization_cap": int(materialization_cap),
+        "complete_cartesian_domain_materialized": False,
+        "candidate_performance_labels_used": False,
+    }
+    if not names or any(not domains.get(name) for name in names):
+        meta["fallback_reason"] = "missing_or_empty_explicit_domain"
+        return None, meta
+    if int(materialization_cap) > 0 and cardinality > int(materialization_cap):
+        meta["fallback_reason"] = "cardinality_exceeds_materialization_cap"
+        return None, meta
+
+    # Preserve fixed kwargs that are common across Official B0, then overlay
+    # explicit defaults and the Cartesian tunables.
+    common: dict[str, Any] = {}
+    if official_configs:
+        canonical_official = [canonical_config_mapping(c) for c in official_configs]
+        keys = set.intersection(*(set(c) for c in canonical_official)) if canonical_official else set()
+        for key in keys:
+            vals = [c.get(key) for c in canonical_official]
+            if all(v == vals[0] for v in vals) and key not in names:
+                common[str(key)] = vals[0]
+    common.update({str(k): v for k, v in defaults.items() if str(k) not in names})
+
+    out = []
+    for values in itertools.product(*(domains[name] for name in names)):
+        cfg = dict(common)
+        cfg.update({name: value for name, value in zip(names, values)})
+        out.append(cfg)
+
+    # B0 may include an explicit legal value omitted from declared domains.  Do
+    # not silently lose it; union it into the materialized domain.
+    seen = {config_signature(c) for c in out}
+    for cfg in official_configs:
+        d = canonical_config_mapping(cfg); sig = config_signature(d)
+        if sig not in seen:
+            seen.add(sig); out.append(d)
+    meta["complete_cartesian_domain_materialized"] = True
+    meta["materialized_count"] = len(out)
+    return out, meta
diff --git a/third_party/ascend/backend/runtime/source_motif_deca.py b/third_party/ascend/backend/runtime/source_motif_deca.py
new file mode 100644
index 000000000..5f6eb7e6b
--- /dev/null
+++ b/third_party/ascend/backend/runtime/source_motif_deca.py
@@ -0,0 +1,606 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Compile-free motif-based Source-DECA for generic handwritten Triton kernels.
+
+V6.6 generalizes the strong Source-DECA idea beyond the audited FA/chunk
+frontends.  The model never materializes TTIR/HIVM/DES and never consumes
+candidate latency/MSProf/winner labels.  It combines:
+
+* runtime AutoTiling axis semantics (split/tiling/reduction/core/grid metadata),
+* cheap source-AST operator signatures when source is available, and
+* versioned Ascend hardware constants,
+
+to infer a small execution motif and produce one *ordinal* DECA view.
+
+The motif layer is intentionally capability-based rather than operator-name
+based.  Supported motifs are:
+  gemm_like, reduction_like, elementwise_memory, attention_mixed,
+  scan_recurrent, irregular_atomic.
+Unknown/ambiguous kernels fall back to the ordinary generic Source views.
+
+This module is a ranking prior, not a latency predictor or optimality proof.
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import math
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from .a5_hardware_model import resolve_hardware_profile
+from .search_space_v6 import SearchSpaceSpec, canonical_config_mapping
+
+
+_REDUCE_NAMES = {"sum", "max", "min", "argmax", "argmin", "reduce"}
+_SCAN_NAMES = {"cumsum", "cumprod", "cummax", "cummin", "associative_scan"}
+_EXP_NAMES = {"exp", "exp2", "log", "log2", "sigmoid", "tanh", "sqrt", "rsqrt"}
+
+
+def _call_leaf(fn: ast.AST) -> str:
+    if isinstance(fn, ast.Name):
+        return fn.id
+    if isinstance(fn, ast.Attribute):
+        parts: list[str] = []
+        cur: ast.AST | None = fn
+        while isinstance(cur, ast.Attribute):
+            parts.append(cur.attr)
+            cur = cur.value
+        if isinstance(cur, ast.Name):
+            parts.append(cur.id)
+        return ".".join(reversed(parts))
+    return ""
+
+
+def _source_text(options: Mapping[str, Any]) -> tuple[str | None, dict[str, Any]]:
+    """Resolve source without requiring compilation.
+
+    Accepted hooks are intentionally generic so production runtime can pass its
+    kernel object while standalone audits can pass source_path/function_name.
+    """
+    if isinstance(options.get("source_text"), str) and options.get("source_text"):
+        return str(options["source_text"]), {"origin": "explicit_source_text"}
+
+    kernel_fn = options.get("kernel_fn")
+    if kernel_fn is not None:
+        try:
+            return inspect.getsource(kernel_fn), {"origin": "inspect_kernel_fn"}
+        except Exception as exc:
+            kernel_error = f"{type(exc).__name__}:{exc}"
+        else:  # pragma: no cover
+            kernel_error = None
+    else:
+        kernel_error = None
+
+    source_path = options.get("source_path")
+    function_name = options.get("function_name")
+    if source_path:
+        p = Path(str(source_path)).expanduser()
+        if p.is_file():
+            try:
+                text = p.read_text(encoding="utf-8", errors="replace")
+                if function_name:
+                    tree = ast.parse(text)
+                    for node in ast.walk(tree):
+                        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == str(function_name):
+                            segment = ast.get_source_segment(text, node)
+                            if segment:
+                                return segment, {
+                                    "origin": "source_path_function",
+                                    "source_path": str(p),
+                                    "function_name": str(function_name),
+                                    "kernel_fn_error": kernel_error,
+                                }
+                return text, {
+                    "origin": "source_path_file",
+                    "source_path": str(p),
+                    "function_name": None if function_name is None else str(function_name),
+                    "kernel_fn_error": kernel_error,
+                }
+            except Exception as exc:
+                return None, {
+                    "origin": "unavailable",
+                    "source_path": str(p),
+                    "error": f"{type(exc).__name__}:{exc}",
+                    "kernel_fn_error": kernel_error,
+                }
+    return None, {"origin": "unavailable", "kernel_fn_error": kernel_error}
+
+
+def analyze_source_signature(options: Mapping[str, Any] | None = None) -> dict[str, Any]:
+    """Return label-free source operation/structure signature."""
+    opts = dict(options or {})
+    text, origin = _source_text(opts)
+    base = {
+        "available": False,
+        "source_origin": origin,
+        "tl_dot_count": 0,
+        "reduction_count": 0,
+        "scan_count": 0,
+        "atomic_count": 0,
+        "load_count": 0,
+        "store_count": 0,
+        "expensive_math_count": 0,
+        "program_id_count": 0,
+        "for_loop_count": 0,
+        "while_loop_count": 0,
+        "if_count": 0,
+        "constexpr_args": [],
+        "uses_ttir": False,
+        "uses_hivm": False,
+        "uses_des": False,
+        "uses_candidate_latency_labels": False,
+    }
+    if not text:
+        return base
+    try:
+        tree = ast.parse(text)
+    except SyntaxError:
+        # inspect.getsource may preserve indentation of a nested function.
+        try:
+            import textwrap
+            tree = ast.parse(textwrap.dedent(text))
+        except Exception as exc:
+            return {**base, "parse_error": f"{type(exc).__name__}:{exc}"}
+
+    calls: list[str] = []
+    constexpr: list[str] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            calls.append(_call_leaf(node.func))
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            for arg in list(node.args.args) + list(node.args.kwonlyargs):
+                ann = ast.unparse(arg.annotation) if arg.annotation is not None and hasattr(ast, "unparse") else ""
+                if "constexpr" in ann:
+                    constexpr.append(arg.arg)
+
+    tl_calls = [
+        c for c in calls
+        if c.startswith("tl.") or c.startswith("triton.language.")
+    ]
+    leaves = [c.split(".")[-1] for c in tl_calls if c]
+    return {
+        **base,
+        "available": True,
+        "tl_dot_count": sum(x == "dot" for x in leaves),
+        "reduction_count": sum(x in _REDUCE_NAMES for x in leaves),
+        "scan_count": sum(x in _SCAN_NAMES for x in leaves),
+        "atomic_count": sum(x.startswith("atomic_") for x in leaves),
+        "load_count": sum(x == "load" for x in leaves),
+        "store_count": sum(x == "store" for x in leaves),
+        "expensive_math_count": sum(x in _EXP_NAMES for x in leaves),
+        "program_id_count": sum(x == "program_id" for x in leaves),
+        "for_loop_count": sum(isinstance(n, ast.For) for n in ast.walk(tree)),
+        "while_loop_count": sum(isinstance(n, ast.While) for n in ast.walk(tree)),
+        "if_count": sum(isinstance(n, ast.If) for n in ast.walk(tree)),
+        "constexpr_args": sorted(set(constexpr)),
+        "call_leaves": sorted(set(leaves)),
+    }
+
+
+def _role_map(spec: SearchSpaceSpec, options: Mapping[str, Any]) -> dict[str, str]:
+    split_params = {str(k): str(v) for k, v in dict(options.get("split_params", {}) or {}).items()}
+    tiling_params = {str(k): str(v) for k, v in dict(options.get("tiling_params", {}) or {}).items()}
+    reduction_axes = {str(x) for x in (options.get("reduction_axes", []) or [])}
+    out: dict[str, str] = {}
+    for axis in spec.axes:
+        role = str(axis.semantic_role or "generic")
+        if role != "generic":
+            out[axis.name] = role
+            continue
+        found = None
+        for ax, param in split_params.items():
+            if param == axis.name:
+                found = "reduction_split" if ax in reduction_axes else "split"
+                break
+        if found is None:
+            for ax, param in tiling_params.items():
+                if param == axis.name:
+                    found = "reduction_tile" if ax in reduction_axes else "tile"
+                    break
+        out[axis.name] = found or "generic"
+    return out
+
+
+def _refine_roles_for_motif(roles: Mapping[str, str], motif: str) -> dict[str, str]:
+    """Resolve common neutral Triton parameter names after motif detection.
+
+    Official split/tiling metadata has precedence.  This only fills axes that
+    remain generic, and it deliberately separates scheduling/control knobs from
+    geometric tile extents.
+    """
+    out = dict(roles)
+    for name, role in list(out.items()):
+        u = str(name).upper()
+        if "GROUP_SIZE" in u or "TRESH" in u or "THRESH" in u or u.startswith("TILE_MIX") or u in {"UNIT_FLAG", "STAGE"}:
+            out[name] = "schedule_control"
+            continue
+        if role != "generic":
+            continue
+        if u.startswith("R") and "BLOCK" in u or "REDUCE" in u:
+            out[name] = "reduction_tile"
+        elif u.startswith(("X", "Y", "Z")) and "BLOCK" in u:
+            out[name] = "split"
+        elif u in {"BLOCK_SIZE", "BLOCK", "VBLOCK"}:
+            out[name] = "reduction_tile" if motif in {"reduction_like", "scan_recurrent"} else "split"
+        elif "BLOCK" in u:
+            out[name] = "reduction_tile" if (motif in {"reduction_like", "scan_recurrent"} and "R" in u) else "split"
+    return out
+
+
+def infer_source_motif(
+    spec: SearchSpaceSpec,
+    *,
+    options: Mapping[str, Any] | None = None,
+    source_signature: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Infer execution motif without operator-name dispatch."""
+    opts = dict(options or {})
+    sig = dict(source_signature or analyze_source_signature(opts))
+    roles = _role_map(spec, opts)
+    n_split = sum(r in {"split", "tile", "reduction_split"} for r in roles.values())
+    n_red = sum(r == "reduction_tile" for r in roles.values())
+    source_ok = bool(sig.get("available"))
+    dot = int(sig.get("tl_dot_count", 0) or 0)
+    redop = int(sig.get("reduction_count", 0) or 0)
+    scan = int(sig.get("scan_count", 0) or 0)
+    atomic = int(sig.get("atomic_count", 0) or 0)
+
+    if source_ok:
+        if scan:
+            motif, conf = "scan_recurrent", 0.88
+        elif dot and redop:
+            motif, conf = "attention_mixed", 0.90
+        elif dot:
+            motif, conf = "gemm_like", 0.92 if n_split >= 2 else 0.78
+        elif redop:
+            motif, conf = "reduction_like", 0.88 if (n_red or n_split) else 0.72
+        elif atomic:
+            motif, conf = "irregular_atomic", 0.45
+        else:
+            motif, conf = "elementwise_memory", 0.76 if n_split else 0.60
+        origin = "source_ast"
+    else:
+        if n_red and n_split >= 2:
+            motif, conf = "gemm_like", 0.62
+        elif n_red:
+            motif, conf = "reduction_like", 0.58
+        elif n_split:
+            motif, conf = "elementwise_memory", 0.52
+        else:
+            motif, conf = "generic_unknown", 0.0
+        origin = "autotiling_metadata"
+
+    roles = _refine_roles_for_motif(roles, motif)
+
+    # Axis-semantic completeness controls trust but never makes a kernel
+    # unsupported. Fixed launch-meta/core/scheduling coordinates are excluded.
+    semantic_axes = [
+        a for a in spec.axes
+        if roles.get(a.name, str(a.semantic_role)) not in {"core_count", "warps", "pipeline", "cta_count", "register_limit", "schedule_control"}
+    ]
+    resolved = sum(roles.get(a.name, "generic") != "generic" for a in semantic_axes)
+    axis_cov = resolved / max(1, len(semantic_axes))
+    if semantic_axes:
+        conf *= 0.65 + 0.35 * axis_cov
+    return {
+        "motif": motif,
+        "confidence": min(0.98, max(0.0, conf)),
+        "origin": origin,
+        "axis_semantic_coverage": axis_cov,
+        "axis_roles": roles,
+        "source_signature": sig,
+        "supported_by_motif_deca": motif != "generic_unknown",
+        "operator_name_used": False,
+    }
+
+
+def _dtype_bytes(all_args: Mapping[str, Any], options: Mapping[str, Any]) -> int:
+    if options.get("dtype_bytes") is not None:
+        try:
+            return max(1, int(options["dtype_bytes"]))
+        except Exception:
+            pass
+    for value in all_args.values():
+        dtype = str(getattr(value, "dtype", "") or "").lower()
+        if "64" in dtype:
+            return 8
+        if "32" in dtype:
+            return 4
+        if "16" in dtype or "half" in dtype:
+            return 2
+        if "8" in dtype or "bool" in dtype:
+            return 1
+    return 2
+
+
+def _runtime_extent(axis_name: str, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> int | None:
+    p2a = {str(k): str(v) for k, v in dict(options.get("parameter_to_axis", {}) or {}).items()}
+    sizes = dict(options.get("axis_sizes", {}) or {})
+    axis = p2a.get(axis_name)
+    if axis in sizes:
+        try:
+            return max(1, int(sizes[axis]))
+        except Exception:
+            pass
+
+    u = axis_name.upper()
+    names: tuple[str, ...] = ()
+    if u.endswith("_M") or u in {"BM", "BLOCK_M", "BLOCK_SIZE_M", "XBLOCK", "X0BLOCK"}:
+        names = ("M", "m", "X", "xnumel", "n_rows")
+    elif u.endswith("_N") or u in {"BN", "BLOCK_N", "BLOCK_SIZE_N", "YBLOCK"}:
+        names = ("N", "n", "Y", "n_cols", "N_CTX")
+    elif u.endswith("_K") or u in {"BK", "BLOCK_K", "BLOCK_SIZE_K", "RBLOCK", "R1BLOCK_SUB"}:
+        names = ("K", "k", "R", "rnumel", "HEAD_DIM", "QK_DIM")
+    elif "BLOCK_SIZE" in u or u.endswith("BLOCK") or u.endswith("BLOCK_SUB"):
+        names = ("N", "n_elements", "numel", "n_cols", "X", "xnumel", "R", "rnumel")
+    for name in names:
+        if name in all_args:
+            try:
+                return max(1, int(all_args[name]))
+            except Exception:
+                pass
+    return None
+
+
+def _geometry(
+    cfg: Mapping[str, Any],
+    spec: SearchSpaceSpec,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any],
+    motif_meta: Mapping[str, Any],
+) -> dict[str, Any]:
+    d = canonical_config_mapping(cfg)
+    roles = dict(motif_meta.get("axis_roles", {}) or {})
+    split_tiles: list[float] = []
+    split_extents: list[float] = []
+    reduction_tiles: list[float] = []
+    reduction_extents: list[float] = []
+    generic_tiles: list[float] = []
+    logical_tasks = 1
+    reduction_loops = 1
+    core_count = max(1, int(options.get("num_cores", 20) or 20))
+    tail_terms: list[float] = []
+    resolved = 0
+
+    for axis in spec.axes:
+        value = d.get(axis.name, axis.values[0])
+        if not isinstance(value, (int, float)) or isinstance(value, bool) or float(value) <= 0:
+            continue
+        fv = float(value)
+        role = roles.get(axis.name, str(axis.semantic_role or "generic"))
+        if role == "core_count":
+            core_count = max(1, int(fv)); continue
+        if role in {"warps", "pipeline", "cta_count", "register_limit", "schedule_control"}:
+            continue
+        extent = _runtime_extent(axis.name, all_args, options)
+        if extent is not None:
+            resolved += 1
+            pieces = max(1, int(math.ceil(float(extent) / fv)))
+            tail_terms.append(max(0.0, (pieces * fv / max(1.0, float(extent))) - 1.0))
+        else:
+            pieces = 1
+
+        if role in {"split", "tile", "reduction_split"}:
+            split_tiles.append(fv)
+            if extent is not None:
+                split_extents.append(float(extent))
+            logical_tasks *= pieces
+        elif role == "reduction_tile":
+            reduction_tiles.append(fv)
+            if extent is not None:
+                reduction_extents.append(float(extent))
+            reduction_loops *= pieces
+        else:
+            generic_tiles.append(fv)
+
+    waves = max(1, int(math.ceil(logical_tasks / max(1, core_count))))
+    wave_eff = logical_tasks / max(1.0, float(waves * core_count))
+    return {
+        "split_tiles": split_tiles,
+        "split_extents": split_extents,
+        "reduction_tiles": reduction_tiles,
+        "reduction_extents": reduction_extents,
+        "generic_tiles": generic_tiles,
+        "logical_tasks": max(1, logical_tasks),
+        "reduction_loops": max(1, reduction_loops),
+        "core_count": core_count,
+        "waves": waves,
+        "wave_efficiency": wave_eff,
+        "tail_fraction": sum(tail_terms) / len(tail_terms) if tail_terms else 0.0,
+        "resolved_extent_axes": resolved,
+    }
+
+
+def _prod(xs: Sequence[float], default: float = 1.0) -> float:
+    out = float(default)
+    for x in xs:
+        out *= max(1.0, float(x))
+    return out
+
+
+def score_motif_deca(
+    cfg: Mapping[str, Any],
+    *,
+    search_space: SearchSpaceSpec,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+    motif_meta: Mapping[str, Any] | None = None,
+) -> dict[str, Any] | None:
+    """Score one config with a generic source motif.
+
+    Returned ``motif_score_proxy`` is only ordinal.  It intentionally has no
+    microsecond label because source-only motif estimates are not calibrated
+    exact kernel latency predictions.
+    """
+    opts = dict(options or {})
+    meta = dict(motif_meta or infer_source_motif(search_space, options=opts))
+    motif = str(meta.get("motif", "generic_unknown"))
+    if motif == "generic_unknown":
+        return None
+
+    g = _geometry(cfg, search_space, all_args, opts, meta)
+    sig = dict(meta.get("source_signature", {}) or {})
+    hw = resolve_hardware_profile({
+        "hardware_profile": opts.get("hardware_profile", "ascend_910b3_v4"),
+        "light_detect_hardware": bool(opts.get("light_detect_hardware", False)),
+        "num_cores": int(g["core_count"]),
+    })
+    elem = _dtype_bytes(all_args, opts)
+    split_tiles = list(g["split_tiles"])
+    red_tiles = list(g["reduction_tiles"])
+    split_extents = list(g["split_extents"])
+    red_extents = list(g["reduction_extents"])
+    output_tile = _prod(split_tiles)
+    output_extent = _prod(split_extents, default=output_tile)
+    red_tile = _prod(red_tiles)
+    red_extent = _prod(red_extents, default=red_tile)
+    tasks = int(g["logical_tasks"])
+    loops = int(g["reduction_loops"])
+    waves = int(g["waves"])
+    load_n = max(1, int(sig.get("load_count", 0) or 0))
+    store_n = max(1, int(sig.get("store_count", 0) or 0))
+    expensive_math_n = int(sig.get("expensive_math_count", 0) or 0)
+    reduction_ops = max(1, int(sig.get("reduction_count", 0) or 0))
+    atomic_n = max(1, int(sig.get("atomic_count", 0) or 0))
+
+    # Candidate-dependent per-task component work.  The equations intentionally
+    # prefer structural trends (reuse, reduction depth, memory traffic, wave
+    # packing) over false precision.
+    cube_work = 0.0
+    vector_work = 0.0
+    reduce_work = 0.0
+    mte_bytes = 0.0
+    serial_penalty = 0.0
+
+    if motif == "gemm_like":
+        dims = sorted(split_tiles, reverse=True)
+        bm = dims[0] if dims else max(1.0, math.sqrt(output_tile))
+        bn = dims[1] if len(dims) > 1 else max(1.0, output_tile / bm)
+        bk = red_tiles[0] if red_tiles else max(1.0, red_tile)
+        k_total = max(bk, red_extent)
+        cube_work = 2.0 * bm * bn * k_total
+        # A/B are streamed by K tiles; C is written once. Larger BM/BN buy
+        # reuse, while larger BK reduces loop/control count.
+        mte_bytes = ((bm + bn) * k_total + bm * bn) * elem
+        vector_work = 0.15 * bm * bn + expensive_math_n * bm * bn
+    elif motif == "attention_mixed":
+        dims = sorted(split_tiles, reverse=True)
+        bm = dims[0] if dims else max(1.0, math.sqrt(output_tile))
+        bn = red_tiles[0] if red_tiles else (dims[1] if len(dims) > 1 else max(1.0, bm))
+        inner = max(1.0, red_extent / max(1.0, bn))
+        head = 1.0
+        for key in ("HEAD_DIM", "head_dim", "QK_DIM", "K"):
+            if key in all_args:
+                try: head = max(1.0, float(all_args[key])); break
+                except Exception: pass
+        cube_work = 4.0 * bm * bn * head * inner
+        reduce_work = reduction_ops * bm * bn * inner
+        vector_work = (6.0 + expensive_math_n * 4.0) * bm * bn * inner
+        mte_bytes = (2.0 * bm * head + 2.0 * bn * head * inner) * elem
+        serial_penalty = 0.15 * inner
+    elif motif == "reduction_like":
+        task_out = max(1.0, output_tile)
+        rtotal = max(1.0, red_extent)
+        reduce_work = reduction_ops * task_out * rtotal
+        vector_work = task_out * rtotal * (1.0 + 2.0 * expensive_math_n)
+        mte_bytes = (load_n * task_out * rtotal + store_n * task_out) * elem
+        serial_penalty = math.log2(max(1.0, red_tile)) * 0.05 + max(0, loops - 1) * 0.08
+    elif motif == "scan_recurrent":
+        task_out = max(1.0, output_tile)
+        rtotal = max(1.0, red_extent if red_extents else output_tile)
+        vector_work = task_out * rtotal * (1.0 + expensive_math_n)
+        mte_bytes = (load_n + store_n) * task_out * rtotal * elem
+        # Scan has a real sequential dependency.  This is an ordinal depth
+        # penalty, not a calibrated cycle model.
+        serial_penalty = math.log2(max(2.0, rtotal)) * 0.30 + max(0, loops - 1) * 0.20
+    elif motif == "irregular_atomic":
+        elems = max(1.0, output_tile)
+        vector_work = elems
+        mte_bytes = (load_n + store_n + atomic_n) * elems * elem
+        contention = max(1.0, tasks / max(1.0, float(g["core_count"])))
+        serial_penalty = atomic_n * math.log2(1.0 + contention) * 0.75
+    else:  # elementwise_memory
+        elems = max(1.0, output_tile)
+        vector_work = elems * (1.0 + expensive_math_n * 3.0)
+        mte_bytes = (load_n + store_n) * elems * elem
+
+    # Convert component work to a common ordering scale using only external
+    # candidate-independent hardware constants.  ``waves`` captures persistent
+    # task/core packing; tail and sequential penalties are dimensionless.
+    cube_t = cube_work / max(1.0, float(hw.cube_rate))
+    vector_t = vector_work / max(1.0, float(hw.vector_rate))
+    reduce_t = reduce_work / max(1.0, float(hw.reduce_rate))
+    mte_t = mte_bytes / max(1.0, float(hw.mte_bandwidth))
+    per_task = max(cube_t, vector_t, reduce_t, mte_t)
+    loop_overhead = (max(0, loops - 1) * 0.02 + serial_penalty) * max(per_task, 1e-9)
+    score = waves * (per_task + loop_overhead)
+    score *= 1.0 + 0.35 * max(0.0, float(g["tail_fraction"]))
+    score *= 1.0 + 0.20 * max(0.0, 1.0 - float(g["wave_efficiency"]))
+
+    return {
+        "model_kind": "source_motif_deca_v66",
+        "motif": motif,
+        "motif_confidence": float(meta.get("confidence", 0.0) or 0.0),
+        "motif_origin": meta.get("origin"),
+        "motif_score_proxy": float(score),
+        "logical_task_count": tasks,
+        "reduction_loop_count": loops,
+        "waves": waves,
+        "wave_efficiency": float(g["wave_efficiency"]),
+        "tail_fraction": float(g["tail_fraction"]),
+        "cube_work_proxy": float(cube_work),
+        "vector_work_proxy": float(vector_work),
+        "reduction_work_proxy": float(reduce_work),
+        "mte_bytes_proxy": float(mte_bytes),
+        "serial_dependency_penalty": float(serial_penalty),
+        "axis_semantic_coverage": float(meta.get("axis_semantic_coverage", 0.0) or 0.0),
+        "source_signature": sig,
+        "uses_ttir": False,
+        "uses_hivm": False,
+        "uses_des": False,
+        "uses_candidate_latency_labels": False,
+        "uses_candidate_msprof_labels": False,
+        "uses_candidate_winner_labels": False,
+        "uses_external_hardware_microbenchmark_calibration": True,
+        "operator_name_used": False,
+    }
+
+
+def score_rows_motif_deca(
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    search_space: SearchSpaceSpec,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> tuple[dict[tuple, dict[str, Any]], dict[str, Any]]:
+    from .search_space_v6 import config_signature
+
+    opts = dict(options or {})
+    source_sig = analyze_source_signature(opts)
+    motif_meta = infer_source_motif(search_space, options=opts, source_signature=source_sig)
+    out: dict[tuple, dict[str, Any]] = {}
+    for row in rows:
+        cfg = dict(row.get("config") or {})
+        score = score_motif_deca(
+            cfg,
+            search_space=search_space,
+            all_args=all_args,
+            options=opts,
+            motif_meta=motif_meta,
+        )
+        if score is not None:
+            out[config_signature(cfg)] = score
+    return out, {
+        "model_kind": "source_motif_deca_v66",
+        "motif": motif_meta.get("motif"),
+        "motif_confidence": motif_meta.get("confidence"),
+        "motif_origin": motif_meta.get("origin"),
+        "axis_semantic_coverage": motif_meta.get("axis_semantic_coverage"),
+        "source_signature": source_sig,
+        "available": bool(out),
+        "operator_name_dispatch": False,
+        "uses_ttir": False,
+        "uses_hivm": False,
+        "uses_des": False,
+        "uses_candidate_latency_labels": False,
+    }
