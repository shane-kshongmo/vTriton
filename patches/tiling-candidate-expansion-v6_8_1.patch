+def _mixed_vector_report(cfg, all_args, options, template, family):
+    """Light TTIR adapter for LLM-specific mixed vector ops.
+
+    Covers MoE Top-K routing, Rotary Embedding, KV cache projection, Concat/Split.
+    These are multi-stage vector ops with irregular UB patterns; cube_time=0.
+    """
+    block = _cfg_int(cfg, "BLOCK_SIZE", "XBLOCK", "XBLOCK_SIZE", default=1024)
+    n = max(1, int(all_args.get("N", all_args.get("n_elements", 1))))
+    cores = _effective_cores_for_config(cfg, options)
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+
+    programs = math.ceil(n / block)
+    active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+    loop_count = 1
+    iterations = mtp
+
+    # Work: multi-stage vector ops
+    if family in {"moe_topk", "moe_router"}:
+        # topk + softmax + gather: ~5 stages, reduction-heavy
+        stages = 5
+        reduce_ops = 4 * n
+        elementwise_ops = 3 * n
+    elif family in {"rotary_embedding"}:
+        # cos/sin + mul + concat: ~4 stages, elementwise-heavy
+        stages = 4
+        reduce_ops = 0
+        elementwise_ops = 6 * n
+    elif family in {"kv_cache_proj"}:
+        # reshape + matmul-like + dequant: ~3 stages (no real cube, just elementwise mul)
+        stages = 3
+        reduce_ops = n
+        elementwise_ops = 4 * n
+    else:  # concat/split
+        stages = 2
+        reduce_ops = 0
+        elementwise_ops = n
+
+    r = _hw_rates(options)
+    vector_time = (reduce_ops / r["reduce_rate"]) + (elementwise_ops / r["elem_rate"])
+    cube_time = 0.0
+
+    # Memory: typically 2-3 inputs + 1 output, multi-pass
+    issued_bytes = dtype_bytes * n * (stages + 1)
+    mte_time = issued_bytes / r["mte_bw"]
+
+    # UB: multi-stage, each stage needs a buffer
+    ub_peak = float(block * dtype_bytes * stages)
+    ub_capacity = float(resolve_ub_capacity(options))
+    ub_util = ub_peak / ub_capacity
+
+    tail_waste = max(0.0, 1.0 - n / max(1.0, programs * block))
+    memory_redundancy = (programs * block) / max(1.0, n)
+
+    grid_time = max(cube_time, vector_time, mte_time)
+    loop_overhead = iterations * float(options.get("light_loop_cost_us", 0.008))
+    handoff_overhead = iterations * 2.0 * float(options.get("light_handoff_cost_us", 0.004))
+    tail_penalty = tail_waste * float(options.get("light_tail_penalty_us", 0.5))
+    imbalance_penalty = load_imbalance * float(options.get("light_imbalance_penalty_us", 0.5))
+    # Mixed ops have less predictable UB; tighten capacity risk threshold
+    capacity_risk = float(options.get("light_capacity_risk_weight", 2.0)) * max(0.0, ub_util - 0.7) ** 2
+    score = grid_time + loop_overhead + handoff_overhead + tail_penalty + imbalance_penalty + capacity_risk
+
+    bottleneck, confidence = _bottleneck_and_confidence(
+        cube_time, vector_time, mte_time, active_ratio, ub_util, options, template)
+    # Mixed ops have lower confidence due to irregular patterns
+    confidence = min(confidence, 0.4)
+    sig, region = _structural_sig(active_ratio, load_imbalance, loop_count, ub_util, tail_waste, bottleneck)
+
+    return LightTTIRReport(
+        score=score, grid_time=grid_time, cube_time=cube_time, vector_time=vector_time,
+        mte_time=mte_time, loop_overhead=loop_overhead, handoff_overhead=handoff_overhead,
+        tail_penalty=tail_penalty, imbalance_penalty=imbalance_penalty, capacity_risk=capacity_risk,
+        active_program_ratio=active_ratio, load_imbalance=load_imbalance,
+        max_tiles_per_program=mtp, loop_count=loop_count,
+        memory_redundancy=memory_redundancy, ub_peak_bytes=ub_peak,
+        ub_utilization=ub_util, ub_headroom_bytes=max(0.0, ub_capacity - ub_peak),
+        tail_waste=tail_waste, bottleneck=bottleneck, confidence=confidence,
+        structural_signature=sig, level1_region=region,
+        template_family=template.family_key if template is not None else (),
+        template_sha256=template.ttir_sha256 if template is not None else "",
+        template_extractor=template.extractor if template is not None else "mixed_vector",
+        template_confidence=template.confidence if template is not None else 0.0,
+        template_unknown_ops=template.unknown_tt_ops if template is not None else (),
+    )
+
