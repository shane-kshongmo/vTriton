+        for kw_arg, kw_default in zip(
+                func_node.args.kwonlyargs,
+                func_node.args.kw_defaults,
+        ):
+            if kw_default is None:
+                continue
+            if isinstance(kw_arg, ast.arg):
+                defaulted.add(kw_arg.arg)
+        return list(defaulted)
