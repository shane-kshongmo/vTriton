+def _generic_ttir_fallback(cfg, all_args, options, template):
+    """Universal TTIR-structure-driven model for unknown operator families.
+
+    The fallback does not dispatch on ``operator_family``.  Instead it infers a
+    small execution motif from TTIR structure and config names:
+
+    * dot + exp/reduce -> attention-like mixed Cube/Vector pipeline;
+    * dot              -> GEMM-like Cube pipeline;
+    * reduce           -> reduction pipeline;
+    * otherwise        -> elementwise / memory pipeline.
+
+    This keeps the model generic while avoiding the previous ``product of all
+    BLOCK_*`` approximation, which badly distorted grid size, loop count and
+    cross-family score scale.  The output remains an analytical estimate, not a
+    hardware-calibrated latency.
+    """
+    prepared = options.get("_light_prepared_static_analysis")
+    prepared_sha = options.get("_light_prepared_template_sha256")
+    if prepared is not None and prepared_sha == getattr(template, "ttir_sha256", ""):
+        dag_report, memory_report, universal_features = prepared
+    else:
+        dag_report, memory_report, universal_features = _static_analysis(template, options)
+    cores = _effective_cores_for_config(cfg, {**dict(options), "num_cores": resolve_num_cores(options)})
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+    rates = _hw_rates(options)
+    counts = dict(getattr(template, "operation_counts", {}) or {})
+    kwargs = getattr(cfg, "kwargs", {}) or {}
+
+    def _arg_int(*names, default=1):
+        for name in names:
+            value = all_args.get(name)
+            if isinstance(value, int) and value > 0:
+                return int(value)
+        return max(1, int(default))
+
+    dot_count = int(sum(v for k, v in counts.items() if k.startswith("tt.dot")))
+    reduce_count = int(sum(v for k, v in counts.items() if k.startswith("tt.reduce")))
+    exp_count = int(sum(v for k, v in counts.items() if "exp" in k.lower()))
+    atomic_count = int(sum(v for k, v in counts.items() if "atomic" in k.lower()))
+    vector_count = int(sum(v for k, v in counts.items() if any(
+        token in k.lower() for token in ("exp", "reduce", "add", "mul", "where", "extern_elementwise")
+    )))
+    load_count = int(sum(v for k, v in counts.items() if k.startswith("tt.load")))
+    store_count = int(sum(v for k, v in counts.items() if k.startswith("tt.store")))
+
+    is_attention_motif = dot_count >= 2 and (reduce_count > 0 or exp_count > 0)
+    is_dot_motif = dot_count > 0 and not is_attention_motif
+    is_reduce_motif = reduce_count > 0 and dot_count == 0
+
+    cube_time = vector_time = mte_time = 0.0
+    memory_redundancy = 1.0
+    tail_waste = 0.0
+    loop_count = 1
+    programs = 1
+    issued_bytes = 0.0
+    ub_peak = float(dtype_bytes)
+
+    effective_bw = rates["mte_bw"] * max(0.05, float(memory_report.bandwidth_scale))
+
+    if is_attention_motif:
+        bm = _cfg_int(cfg, "BLOCK_M", "BM", default=32)
+        bn = _cfg_int(cfg, "BLOCK_N", "BN", default=32)
+        nq = _arg_int("MAX_Q_LEN", "NQ", "N_CTX", "N", default=1)
+        nk = _arg_int("MAX_K_LEN", "NK", "N_CTX", default=nq)
+        hd = _arg_int("HEAD_DIM", "QK_DIM", default=64)
+        z = _arg_int("Z", "BATCH", default=1)
+        heads = _arg_int("H", "HEADS", default=1)
+        causal = bool(all_args.get("CAUSAL", all_args.get("causal", False)))
+
+        programs = max(1, math.ceil(nq / bm) * z * heads)
+        loop_count = max(1, math.ceil(nk / bn))
+        active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+        iterations = loop_count * mtp
+
+        cube_ops = max(1, dot_count) * 2.0 * bm * bn * hd * iterations
+        vector_ops = max(1, vector_count) * bm * bn * iterations
+        cube_time = cube_ops / rates["cube_rate"]
+        vector_time = (
+            exp_count * bm * bn * iterations / rates["exp_rate"]
+            + reduce_count * bm * bn * iterations / rates["reduce_rate"]
+            + max(0, vector_count - exp_count - reduce_count) * bm * bn * iterations / rates["elem_rate"]
+            + atomic_count * bm * bn * iterations / rates["elem_rate"]
+        )
+        q_bytes = bm * hd * dtype_bytes
+        kv_bytes = 2.0 * bn * hd * dtype_bytes
+        out_bytes = bm * hd * 4.0
+        issued_bytes = q_bytes * mtp + kv_bytes * iterations + out_bytes * mtp
+        mte_time = issued_bytes / effective_bw
+
+        useful_pairs = nq * nk * (0.5 if causal else 1.0)
+        issued_pairs = math.ceil(nq / bm) * bm * math.ceil(nk / bn) * bn
+        tail_waste = max(0.0, 1.0 - useful_pairs / max(1.0, issued_pairs))
+        memory_redundancy = issued_pairs / max(1.0, useful_pairs)
+        score_bytes = bm * bn * 4.0
+        row_state = bm * 8.0
+        ub_peak = max(
+            q_bytes + kv_bytes + score_bytes + row_state,
+            2.0 * score_bytes + row_state + out_bytes,
+            q_bytes + kv_bytes + score_bytes + out_bytes,
+        )
+
+    elif is_dot_motif:
+        bm = _cfg_int(cfg, "BLOCK_M", "BM", default=64)
+        bn = _cfg_int(cfg, "BLOCK_N", "BN", default=64)
+        bk = _cfg_int(cfg, "BLOCK_K", "BK", default=32)
+        M = _arg_int("M", default=1)
+        N = _arg_int("N", default=1)
+        K = _arg_int("K", default=1)
+
+        programs = max(1, math.ceil(M / bm) * math.ceil(N / bn))
+        loop_count = max(1, math.ceil(K / bk))
+        active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+        iterations = loop_count * mtp
+
+        cube_ops = max(1, dot_count) * 2.0 * bm * bn * bk * iterations
+        cube_time = cube_ops / rates["cube_rate"]
+        vector_time = max(0, vector_count) * bm * bn * mtp / rates["elem_rate"]
+        load_bytes_iter = (bm * bk + bn * bk) * dtype_bytes * max(1, load_count / 2.0)
+        store_bytes_tile = bm * bn * 4.0 * max(1, store_count)
+        issued_bytes = load_bytes_iter * iterations + store_bytes_tile * mtp
+        mte_time = issued_bytes / effective_bw
+
+        issued_m = math.ceil(M / bm) * bm
+        issued_n = math.ceil(N / bn) * bn
+        issued_k = math.ceil(K / bk) * bk
+        useful = M * N * K
+        issued = issued_m * issued_n * issued_k
+        tail_waste = max(0.0, 1.0 - useful / max(1.0, issued))
+        memory_redundancy = issued / max(1.0, useful)
+        stages = max(1, int(getattr(cfg, "num_stages", 1)))
+        ub_peak = (bm * bk + bn * bk) * dtype_bytes * stages + bm * bn * 4.0
+
+    elif is_reduce_motif:
+        xb = _cfg_int(cfg, "XBLOCK", "BLOCK_M", "BLOCK_SIZE", default=1)
+        rb = _cfg_int(cfg, "RBLOCK_SIZE", "BLOCK_N", "BLOCK_R", default=128)
+        rows = _arg_int("M", "ROWS", default=1)
+        cols = _arg_int("N", "COLS", "HIDDEN_SIZE", default=1)
+
+        programs = max(1, math.ceil(rows / xb))
+        loop_count = max(1, math.ceil(cols / rb))
+        active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+        iterations = loop_count * mtp
+        tile_elems = xb * rb
+
+        reduce_ops = max(1, reduce_count) * tile_elems * iterations
+        elem_ops = max(1, vector_count - reduce_count) * tile_elems * iterations
+        vector_time = reduce_ops / rates["reduce_rate"] + elem_ops / rates["elem_rate"]
+        issued_bytes = (max(1, load_count) + max(1, store_count)) * tile_elems * dtype_bytes * iterations
+        mte_time = issued_bytes / effective_bw
+
+        issued_rows = math.ceil(rows / xb) * xb
+        issued_cols = math.ceil(cols / rb) * rb
+        useful = rows * cols
+        issued = issued_rows * issued_cols
+        tail_waste = max(0.0, 1.0 - useful / max(1.0, issued))
+        memory_redundancy = issued / max(1.0, useful)
+        ub_peak = tile_elems * dtype_bytes * (2.0 + min(2.0, reduce_count))
+
+    else:
+        block = _cfg_int(cfg, "BLOCK_SIZE", "XBLOCK", "BLOCK_M", "BLOCK_N", default=256)
+        numel = _arg_int("numel", "n_elements", default=0)
+        if numel <= 0:
+            M = _arg_int("M", default=1)
+            N = _arg_int("N", default=1)
+            numel = max(1, M * N)
+        programs = max(1, math.ceil(numel / block))
+        loop_count = max(1, int(getattr(template, "persistent_loop_count", 0) or 1))
+        active_ratio, load_imbalance, mtp = _grid_state_and_imbalance(programs, cores)
+        iterations = loop_count * mtp
+
+        elems = block * iterations
+        vector_time = max(1, vector_count + atomic_count) * elems / rates["elem_rate"]
+        issued_bytes = (max(1, load_count) + max(1, store_count)) * elems * dtype_bytes
+        mte_time = issued_bytes / effective_bw
+        issued = programs * block
+        tail_waste = max(0.0, 1.0 - numel / max(1.0, issued))
+        memory_redundancy = issued / max(1.0, numel)
+        ub_peak = block * dtype_bytes * max(2.0, load_count + store_count)
+
+    # Structural universal roofline is retained as a conservative floor.  It is
+    # deliberately secondary to the dynamically instantiated motif quantities.
+    universal_floor = calibrate_latency(
+        universal_roofline_score(universal_features, rates, memory_report),
+        universal_features, options,
+    )
+    vector_time = max(vector_time, universal_floor * 0.10)
+    mte_time = max(mte_time, universal_floor * 0.20)
+
+    ub_capacity = float(resolve_ub_capacity(options))
+    ub_peak = min(float(ub_peak), ub_capacity * 1.5)
+    ub_util = ub_peak / ub_capacity
+
+    grid_time = max(cube_time, vector_time, mte_time)
+    loop_overhead = loop_count * mtp * float(options.get("light_loop_cost_us", 0.008))
+    handoff_count = max(1.0, float(getattr(dag_report, "phase_count", 1)))
+    handoff_overhead = loop_count * mtp * handoff_count * float(options.get("light_handoff_cost_us", 0.004))
+    tail_penalty = tail_waste * float(options.get("light_tail_penalty_us", 0.5))
+    imbalance_penalty = load_imbalance * float(options.get("light_imbalance_penalty_us", 0.5))
+    capacity_risk = float(options.get("light_capacity_risk_weight", 2.0)) * max(0.0, ub_util - 0.85) ** 2
+    dependency = (
+        float(options.get("light_dag_dependency_us", 0.001))
+        * (dag_report.critical_path + 0.15 * getattr(dag_report, "dependency_edges", 0))
+        * max(1, loop_count)
+        / max(1.0, dag_report.parallelism)
+    )
+    pipeline = estimate_pipeline_time(
+        mte=mte_time,
+        compute=max(cube_time, vector_time),
+        dependency=dependency,
+    )
+    score = pipeline.total + loop_overhead + handoff_overhead + tail_penalty + imbalance_penalty + capacity_risk
+
+    bottleneck, _ = _bottleneck_and_confidence(
+        cube_time, vector_time, mte_time, active_ratio, ub_util, options, template)
+    sig, region = _structural_sig(
+        active_ratio, load_imbalance, loop_count, ub_util, tail_waste, bottleneck)
+
+    confidence = 0.35
+    if is_attention_motif or is_dot_motif or is_reduce_motif:
+        confidence += 0.08
+    if dag_report.parallelism > 1.5:
+        confidence += 0.04
+    if getattr(template, "unknown_tt_ops", ()):
+        confidence -= min(0.15, 0.03 * len(template.unknown_tt_ops))
+    if bool(options.get("light_template_out_of_domain", False)):
+        confidence -= 0.15
+    if bool(options.get("light_unknown_opcode", False)):
+        confidence -= 0.10
+    confidence = min(0.55, max(0.05, confidence))
+
+    return LightTTIRReport(
+        score=score, grid_time=grid_time, cube_time=cube_time, vector_time=vector_time,
+        mte_time=mte_time, loop_overhead=loop_overhead, handoff_overhead=handoff_overhead,
+        tail_penalty=tail_penalty, imbalance_penalty=imbalance_penalty, capacity_risk=capacity_risk,
+        active_program_ratio=active_ratio, load_imbalance=load_imbalance,
+        max_tiles_per_program=mtp, loop_count=loop_count,
+        memory_redundancy=memory_redundancy, ub_peak_bytes=ub_peak,
+        ub_utilization=ub_util, ub_headroom_bytes=max(0.0, ub_capacity - ub_peak),
+        tail_waste=tail_waste, bottleneck=bottleneck, confidence=confidence,
+        structural_signature=sig, level1_region=region,
+        template_family=template.family_key if template is not None else (),
+        template_sha256=template.ttir_sha256 if template is not None else "",
+        template_extractor=template.extractor if template is not None else "generic_fallback",
+        template_confidence=template.confidence if template is not None else 0.0,
+        template_unknown_ops=template.unknown_tt_ops if template is not None else (),
+    )
+
+def _canonical_family(family: str) -> str:
+    value = str(family).lower()
+    if value in {"flash_attention", "fa", "attention"}:
+        return "flash_attention"
+    if value in {"matmul", "matmul_bias", "cube", "cube_dominant_mix", "gemm", "linear"}:
+        return "gemm"
+    if value in {"softmax", "vector_reduction", "layer_norm", "rmsnorm", "vector_multi_reduction"}:
+        return "reduction"
+    if value in {"vector", "vector_add", "elementwise", "activation", "gelu", "silu", "swish"}:
+        return "elementwise"
+    if value in {"moe_topk", "moe_router", "rotary_embedding", "kv_cache_proj", "concat", "split"}:
+        return "mixed_vector"
+    return value
+
+
+def _proxy_template_for_family(family: str) -> KernelTemplate:
+    """Structured proxy used only by CPU/legacy experiments without compiled TTIR.
+
+    Production paths should supply a real KernelTemplate.  The proxy keeps the
+    universal base available for compatibility tests and is explicitly marked
+    as lower confidence.
+    """
+    fam = _canonical_family(family)
+    counts = {
+        "flash_attention": {"tt.load": 3, "tt.dot": 2, "tt.exp": 1, "tt.reduce": 2,
+                            "tt.add": 2, "tt.mul": 2, "tt.store": 1},
+        "gemm": {"tt.load": 2, "tt.dot": 1, "tt.store": 1},
+        "reduction": {"tt.load": 1, "tt.reduce": 2, "tt.add": 3, "tt.mul": 2, "tt.store": 1},
+        "elementwise": {"tt.load": 2, "tt.add": 1, "tt.mul": 1, "tt.store": 1},
+        "mixed_vector": {"tt.load": 2, "tt.reduce": 1, "tt.add": 2, "tt.atomic_add": 1, "tt.store": 1},
+    }.get(fam, {"tt.load": 1, "tt.add": 1, "tt.store": 1})
+    return KernelTemplate(
+        family_key=("proxy", fam), ttir_sha256=f"proxy:{fam}", extractor="structured_proxy",
+        grid_axes=(0,), persistent_loop_count=1, tensor_ptr_shapes=(),
+        operation_counts=counts, has_dot=counts.get("tt.dot", 0) > 0,
+        has_reduce=counts.get("tt.reduce", 0) > 0, has_exp=counts.get("tt.exp", 0) > 0,
+        has_load=True, has_store=True,
+        has_atomic=any("atomic" in k for k in counts), unknown_tt_ops=(), confidence=0.55,
+    )
+
+
+def _specialized_report_for_family(family: str, cfg, all_args, opts, template):
+    fam = _canonical_family(family)
+    if fam == "flash_attention":
+        return _fa_report(cfg, all_args, opts, template)
+    if fam == "gemm":
+        return _gemm_report(cfg, all_args, opts, template)
+    if fam == "reduction":
+        return _reduction_report(cfg, all_args, opts, template, str(family).lower())
+    if fam == "elementwise":
+        return _elementwise_report(cfg, all_args, opts, template, str(family).lower())
+    if fam == "mixed_vector":
+        return _mixed_vector_report(cfg, all_args, opts, template, str(family).lower())
+    return None
+
+
+def _residual_gate(family: str, specialized: LightTTIRReport, base: LightTTIRReport,
+                   template: KernelTemplate, options: Mapping[str, Any]) -> float:
+    fam = _canonical_family(family)
+    defaults = {
+        "flash_attention": 0.18,
+        "gemm": 0.30,
+        "reduction": 0.25,
+        "elementwise": 0.20,
+        "mixed_vector": 0.16,
+    }
+    prior = float(options.get(f"light_{fam}_residual_weight", defaults.get(fam, 0.0)))
+    feature_coverage = 1.0 - min(0.75, 0.08 * len(getattr(template, "unknown_tt_ops", ()) or ()))
+    confidence = min(float(template.confidence), float(specialized.confidence), max(0.25, float(base.confidence)))
+    gate = prior * feature_coverage * max(0.25, confidence)
+    if base.ub_utilization >= 1.0 or specialized.ub_utilization >= 1.0:
+        gate *= 0.7
+    return min(float(options.get("light_residual_gate_max", 0.45)), max(0.0, gate))
+
+
+def _blend_component(base_value: float, specialized_value: float, weight: float, clip_ratio: float) -> float:
+    span = clip_ratio * max(abs(base_value), 1e-9)
+    delta = max(-span, min(span, specialized_value - base_value))
+    return base_value + weight * delta
+
+
+def _fuse_universal_and_specialized(family: str, base: LightTTIRReport,
+                                    specialized: LightTTIRReport, template: KernelTemplate,
+                                    options: Mapping[str, Any]) -> LightTTIRReport:
+    """Universal base + confidence-gated family residual.
+
+    All supported families share the universal
+    hardware scale; specialized adapters can only apply bounded residuals, so
+    heterogeneous scores remain comparable.
+    """
+    weight = _residual_gate(family, specialized, base, template, options)
+    clip_ratio = max(0.0, float(options.get("light_residual_clip_ratio", 0.30)))
+    span = clip_ratio * max(abs(base.score), 1e-9)
+    raw_delta = specialized.score - base.score
+    residual = max(-span, min(span, raw_delta))
+    score = max(0.0, base.score + weight * residual)
+    confidence = min(0.95, max(base.confidence, 0.65 * base.confidence + 0.35 * specialized.confidence))
+    return replace(
+        base,
+        score=score,
+        grid_time=_blend_component(base.grid_time, specialized.grid_time, weight, clip_ratio),
+        cube_time=_blend_component(base.cube_time, specialized.cube_time, weight, clip_ratio),
+        vector_time=_blend_component(base.vector_time, specialized.vector_time, weight, clip_ratio),
+        mte_time=_blend_component(base.mte_time, specialized.mte_time, weight, clip_ratio),
+        ub_peak_bytes=_blend_component(base.ub_peak_bytes, specialized.ub_peak_bytes, weight, clip_ratio),
+        ub_utilization=_blend_component(base.ub_utilization, specialized.ub_utilization, weight, clip_ratio),
+        confidence=confidence,
+        base_score=float(base.score),
+        specialized_score=float(specialized.score),
+        residual_score=float(residual),
+        residual_weight=float(weight),
+        score_mode="universal_plus_residual",
+        motif=_canonical_family(family),
+        template_extractor=template.extractor,
+        template_confidence=template.confidence,
+        template_unknown_ops=template.unknown_tt_ops,
+    )
+
+
+def _resolved_score_mode(options: Mapping[str, Any]) -> str:
+    mode = str(options.get("light_score_mode", "auto")).lower()
+    if mode == "auto":
+        scope = str(options.get("light_pool_scope", "homogeneous")).lower()
+        mode = "universal" if scope in {"mixed", "heterogeneous", "multi_shape", "cross_family"} else "hybrid"
+    aliases = {"base": "universal", "specialized": "specialized_legacy", "legacy": "specialized_legacy"}
+    return aliases.get(mode, mode)
+
+
+def _validate_template(template: KernelTemplate, family: str, options: Mapping[str, Any]) -> None:
+    if not isinstance(template, KernelTemplate):
+        raise TypeError("light_ttir_template_provider must return KernelTemplate")
+    if not template.has_load or not template.has_store:
+        raise ValueError("TTIR template does not contain the required load/store structure")
+    canonical = _canonical_family(family)
+    if canonical in {"flash_attention", "gemm"} and not template.has_dot:
+        if canonical != "flash_attention" or not bool(options.get("light_allow_no_dot_fa", False)):
+            raise ValueError(f"{canonical} TTIR template contains no tt.dot")
+    requested_symbolic = {str(v) for v in options.get("light_template_parameters", ())}
+    declared_symbolic = set(getattr(template, "symbolic_parameters", ()) or ())
+    if requested_symbolic and not requested_symbolic.issubset(declared_symbolic):
+        missing = sorted(requested_symbolic - declared_symbolic)
+        raise ValueError(
+            "light_template_parameters require a provider template that declares "
+            f"the same symbolic parameters; missing={missing}"
+        )
+
+
+
+
+def _structural_group_key(cfg: Any, options: Mapping[str, Any]) -> tuple:
+    """Canonical grouping key shared with KernelTemplateCache.
+
+    The previous independent implementation ignored ordinary config kwargs and
+    made scores depend on candidate ordering.  Keep this wrapper for local
+    callers, but delegate to the one correctness-critical implementation.
+    """
+    return structural_family_key(cfg, options)
+
+
+def _resolve_template(
+    cfg: Any, all_args: Mapping[str, Any], options: Mapping[str, Any]
+) -> KernelTemplate:
+    provider = options.get("light_ttir_template_provider")
+    if callable(provider):
+        template = provider(cfg=cfg, all_args=all_args, options=options)
+    elif bool(options.get("allow_legacy_light_proxy", False)):
+        template = _proxy_template_for_family(str(options.get("operator_family", "flash_attention")))
+    else:
+        raise RuntimeError(
+            "Real Light TTIR requires light_ttir_template_provider; "
+            "set allow_legacy_light_proxy=True only for compatibility experiments"
+        )
+    _validate_template(template, str(options.get("operator_family", "flash_attention")), options)
+    return template
+
+
+def _coerce_adapter_report(value: Any) -> LightTTIRReport:
+    if isinstance(value, LightTTIRReport):
+        return value
+    if isinstance(value, Mapping):
+        return LightTTIRReport(**value)
+    raise TypeError("light_ttir_adapter must return LightTTIRReport or mapping")
+
+def _bottleneck_name(value: int) -> str:
+    return {0: "grid", 1: "cube", 2: "vector", 3: "mte", 4: "buffer"}.get(int(value), "unknown")
+
+
+def _materialize_vector_reports(
+    details: Mapping[str, Any],
+    indices: Sequence[int] | None = None,
+    *,
+    score_mode: str,
+    motif: str,
+) -> List[LightTTIRReport]:
+    """Materialize diagnostics from the numeric source of truth.
+
+    S1/S2 score-only selection never calls this function.  Scalar and report
+    APIs do, which guarantees exact score/rank consistency without allocating
+    reports for candidates that will be discarded.
+    """
+    if indices is None:
+        indices = range(int(details.get("n", len(details["score"]))))
+    meta = {
+        "template_family": tuple(details.get("template_family", ())),
+        "template_sha256": str(details.get("template_sha256", "")),
+        "template_extractor": str(details.get("template_extractor", "generic")),
+        "template_confidence": float(details.get("template_confidence", 0.0)),
+        "template_unknown_ops": tuple(details.get("template_unknown_ops", ())),
+    }
+    reports: List[LightTTIRReport] = []
+    for raw_index in indices:
+        i = int(raw_index)
+        reports.append(LightTTIRReport(
+            score=float(details["score"][i]),
+            grid_time=float(details["grid_time"][i]),
+            cube_time=float(details["cube_time"][i]),
+            vector_time=float(details["vector_time"][i]),
+            mte_time=float(details["mte_time"][i]),
+            loop_overhead=float(details["loop_overhead"][i]),
+            handoff_overhead=float(details["handoff_overhead"][i]),
+            tail_penalty=float(details["tail_penalty"][i]),
+            imbalance_penalty=float(details["imbalance_penalty"][i]),
+            capacity_risk=float(details["capacity_risk"][i]),
+            active_program_ratio=float(details["active_program_ratio"][i]),
+            load_imbalance=float(details["load_imbalance"][i]),
+            max_tiles_per_program=int(details["max_tiles_per_program"][i]),
+            loop_count=int(details["loop_count"][i]),
+            memory_redundancy=float(details["memory_redundancy"][i]),
+            ub_peak_bytes=float(details["ub_peak_bytes"][i]),
+            ub_utilization=float(details["ub_utilization"][i]),
+            ub_headroom_bytes=float(details["ub_headroom_bytes"][i]),
+            tail_waste=float(details["tail_waste"][i]),
+            bottleneck=_bottleneck_name(int(details["bottleneck_id"][i])),
+            confidence=float(details["confidence"][i]),
+            structural_signature=tuple(map(int, details["structural_signature"][i])),
+            level1_region=tuple(map(int, details["level1_region"][i])),
+            base_score=float(details["base_score"][i]),
+            specialized_score=float(details["specialized_score"][i]),
+            residual_score=float(details["residual_score"][i]),
+            residual_weight=float(details["residual_weight"][i]),
+            score_mode=score_mode,
+            motif=motif,
+            base_bottleneck=_bottleneck_name(int(details.get("base_bottleneck_id", details["bottleneck_id"])[i])),
+            fused_bottleneck=_bottleneck_name(int(details.get("fused_bottleneck_id", details["bottleneck_id"])[i])),
+            selection_region=tuple(map(int, details["level1_region"][i])),
+            **meta,
+        ))
+    return reports
