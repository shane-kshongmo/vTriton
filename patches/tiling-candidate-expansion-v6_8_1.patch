+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Cumulative candidate expansion for Ascend autotuning.
+
+B0 is the untouched output of the official TileGenerator/CVTileGenerator.
+S1 is a bounded multi-radius local expansion. S2 is a hardware-resource-aware
+coverage expansion driven by UB/core/wave/tail regions. S3 is a multi-generation,
+cost-model-guided evolutionary expansion. Hard pruning is conservative and is
+kept separate from cost-model ranking.
+"""
+from __future__ import annotations
+
+import copy
+import itertools
+import math
+import random
+import time
+from dataclasses import dataclass
+from typing import Any, Dict, Iterable, List, Mapping, Sequence, Tuple
+
+from triton.runtime.autotuner import Config
+
+from .light_guided_policy import expansion_guidance, filter_values
+from .a5_hardware_model import resolve_ub_capacity
+from .model_context import model_context_signature
+from .ttir_kernel_template import structural_family_key
+
+from .light_ttir_model import (
+    LightTTIRBatchScores, LightTTIRReport,
+    evaluate_light_ttir, evaluate_light_ttir_scores_batch,
+    evaluate_light_ttir_s1, evaluate_light_ttir_s2, generic_region,
+)
+
+
+def _sig(cfg: Config) -> Tuple:
+    return (tuple(sorted(cfg.kwargs.items())), cfg.num_warps, cfg.num_stages, cfg.num_ctas, cfg.maxnreg)
+
+
+def _model_context_key(all_args: Mapping[str, Any], opts: Mapping[str, Any], namespace: str) -> str:
+    return model_context_signature(all_args, opts, namespace=namespace)
+
+
+def _light_numeric_cache_key(cfg: Config, all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> tuple:
+    return (_model_context_key(all_args, opts, "candidate_light_score"), _sig(cfg))
+
+
+def _clone(cfg: Config, kwargs: Dict[str, Any]) -> Config:
+    return Config(kwargs=kwargs, num_warps=cfg.num_warps, num_stages=cfg.num_stages,
+                  num_ctas=cfg.num_ctas, maxnreg=cfg.maxnreg, pre_hook=cfg.pre_hook,
+                  ir_override=cfg.ir_override)
+
+
+def _dedupe(configs: Iterable[Config]) -> List[Config]:
+    out, seen = [], set()
+    for cfg in configs:
+        key = _sig(cfg)
+        if key not in seen:
+            seen.add(key)
+            out.append(cfg)
+    return out
+
+
+def _divisors(n: int) -> List[int]:
+    if not isinstance(n, int) or n <= 0:
+        return []
+    vals = set()
+    for i in range(1, math.isqrt(n) + 1):
+        if n % i == 0:
+            vals.update((i, n // i))
+    return sorted(vals)
+
+
+def _runtime_bound(name: str, all_args: Mapping[str, Any], observed: Sequence[int]) -> int:
+    upper = name.upper()
+    preferred = []
+    if upper.endswith("_M") or upper in {"BM", "BLOCK_M"}:
+        preferred = ["N_CTX", "MAX_Q_LEN", "M", "SEQ_LEN", "N"]
+    elif upper.endswith("_N") or upper in {"BN", "BLOCK_N"}:
+        preferred = ["N_CTX", "MAX_K_LEN", "MAX_Q_LEN", "N", "SEQ_LEN", "M"]
+    elif upper.endswith("_K") or upper in {"BK", "BLOCK_K"}:
+        preferred = ["HEAD_DIM", "QK_DIM", "V_DIM", "K"]
+    for key in preferred:
+        value = all_args.get(key)
+        if isinstance(value, int) and value > 0:
+            return value
+    return max(observed) if observed else 1
+
+
+def _legal_values(name: str, configs: Sequence[Config], all_args: Mapping[str, Any],
+                  options: Mapping[str, Any]) -> List[int]:
+    """Build an explicit, auditable domain rather than a divisor-only space."""
+    observed = sorted({cfg.kwargs.get(name) for cfg in configs if isinstance(cfg.kwargs.get(name), int)})
+    bound = _runtime_bound(name, all_args, observed)
+    custom_domains = options.get("parameter_domains", {})
+    custom = custom_domains.get(name) or custom_domains.get(name.upper())
+    default_tiles = options.get("default_tile_values", (1, 2, 4, 8, 16, 24, 32, 48, 64, 80,
+                                                         96, 128, 160, 192, 224, 256, 384,
+                                                         512, 768, 1024))
+    vals = set(observed) | set(_divisors(bound)) | {int(v) for v in (custom or default_tiles)}
+    allow_tail = bool(all_args.get("__allow_tail_tiles__", options.get("allow_tail_tiles", True)))
+    alignment = max(1, int(options.get("parameter_alignment", {}).get(name, 1)))
+    return sorted(v for v in vals if isinstance(v, int) and 0 < v <= bound
+                  and v % alignment == 0 and (allow_tail or bound % v == 0))
+
+
+def _basic_legal(cfg: Config, all_args: Mapping[str, Any]) -> bool:
+    for name, value in cfg.kwargs.items():
+        if not isinstance(value, int) or value <= 0:
+            continue
+        upper = name.upper()
+        if upper in {"BM", "BN", "BLOCK_M", "BLOCK_N"}:
+            n_ctx = all_args.get("N_CTX", all_args.get("MAX_Q_LEN"))
+            if (not bool(all_args.get("__allow_tail_tiles__", True))
+                    and isinstance(n_ctx, int) and n_ctx > 0 and n_ctx % value != 0):
+                return False
+        if upper in {"BK", "BLOCK_K"}:
+            head_dim = all_args.get("HEAD_DIM", all_args.get("QK_DIM"))
+            if (bool(all_args.get("__require_head_dim_divisible__", True))
+                    and isinstance(head_dim, int) and head_dim > 0 and head_dim % value != 0):
+                return False
+    return True
+
+
+def _neighbor(values: Sequence[int], value: int, offsets: Sequence[int]) -> List[int]:
+    if value not in values:
+        return []
+    idx = values.index(value)
+    return [values[idx + off] for off in offsets if 0 <= idx + off < len(values)]
+
+
+def _nearest_legal(values: Sequence[int], target: float) -> int | None:
+    if not values:
+        return None
+    return min(values, key=lambda v: (abs(v - target), v))
+
+
+def _mutate_one(cfg: Config, spaces: Mapping[str, Sequence[int]], offsets: Sequence[int],
+                scale_factors: Sequence[float] = (), numeric_steps: Sequence[int] = ()) -> List[Config]:
+    """Generate explicit single-axis mutation families.
+
+    ``offsets`` are indices in the ordered legal domain, while scale factors and
+    numeric steps act on the value itself and are projected back to that domain.
+    Keeping the families separate makes the search semantics auditable.
+    """
+    children = []
+    for name, values in spaces.items():
+        current = cfg.kwargs.get(name)
+        if not isinstance(current, int):
+            continue
+        targets = set(_neighbor(values, current, offsets))
+        for factor in scale_factors:
+            nearest = _nearest_legal(values, current * float(factor))
+            if nearest is not None:
+                targets.add(nearest)
+        for step in numeric_steps:
+            for target in (current - int(step), current + int(step)):
+                nearest = _nearest_legal(values, target)
+                if nearest is not None:
+                    targets.add(nearest)
+        targets.discard(current)
+        for new_value in sorted(targets):
+            kwargs = dict(cfg.kwargs)
+            kwargs[name] = new_value
+            children.append(_clone(cfg, kwargs))
+    return children
+
+
+def _structural_anchors(base: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                        budget: int, options: Mapping[str, Any]) -> List[Config]:
+    """Inject bounded small/extreme anchors for every structural family.
+
+    The former implementation cloned only ``base[0]`` and could silently omit
+    alternative stage/layout/algorithm families.  Anchors are now distributed
+    round-robin across canonical structural families and across M/N/K axes.
+    """
+    if budget <= 0 or not base:
+        return []
+    family_representatives: Dict[tuple, Config] = {}
+    for cfg in base:
+        family_representatives.setdefault(structural_family_key(cfg, options), cfg)
+    axis_names = {
+        "m": next((n for n in spaces if n.upper() in {"BM", "BLOCK_M"}), None),
+        "n": next((n for n in spaces if n.upper() in {"BN", "BLOCK_N"}), None),
+        "k": next((n for n in spaces if n.upper() in {"BK", "BLOCK_K"}), None),
+    }
+    templates: List[tuple[Config, Dict[str, int]]] = []
+    for cfg in family_representatives.values():
+        anchor_values: Dict[str, List[int | None]] = {}
+        for role, name in axis_names.items():
+            if name is None:
+                continue
+            values = list(spaces[name])
+            targets = (1, 2, 4, 8) if role == "m" else ((8, 16, 24, 32, 64, 128) if role == "n" else (8, 16, 32, 64, 128))
+            chosen: List[int] = []
+            for target in targets:
+                value = _nearest_legal(values, target)
+                if value is not None and value not in chosen:
+                    chosen.append(value)
+            if values:
+                for value in (values[0], values[-1]):
+                    if value not in chosen:
+                        chosen.append(value)
+            anchor_values[name] = chosen
+        # Generic fallback: older code required an M-like axis and therefore
+        # produced no structural anchors for 1-D handwritten kernels such as
+        # vector_add/softmax/layer_norm.  V6 distributes anchors across *all*
+        # tunable axes; M/N/K names are only used to choose slightly richer
+        # target sets when present.
+        primary = axis_names["m"] or next(iter(spaces), None)
+        if primary is None:
+            continue
+        if primary not in anchor_values:
+            values = list(spaces.get(primary, ()))
+            anchor_values[primary] = _axis_sample(values, 6) if values else []
+        companions = [n for n in spaces if n != primary]
+        for primary_value in anchor_values[primary]:
+            kwargs = dict(cfg.kwargs); kwargs[primary] = primary_value
+            templates.append((cfg, kwargs))
+            for companion in companions:
+                values = anchor_values.get(companion)
+                if values is None:
+                    values = _axis_sample(list(spaces.get(companion, ())), 4)
+                for value in list(values)[:3]:
+                    kw = dict(kwargs); kw[companion] = value
+                    templates.append((cfg, kw))
+    out = [_clone(cfg, kwargs) for cfg, kwargs in templates]
+    out = sorted(_dedupe(out), key=_sig)
+    return out[:budget]
+
+
+def _small_block_anchors(base: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                         budget: int, options: Mapping[str, Any] | None = None) -> List[Config]:
+    """Backward-compatible wrapper for tests and external users."""
+    return _structural_anchors(base, spaces, budget, options or {})
+
+
+def _cross(parents: Sequence[Config], tunable: Sequence[str], max_pairs: int, rng: random.Random,
+           min_distance: float = 0.0) -> List[Config]:
+    pairs = [(a, b) for a, b in itertools.combinations(parents, 2)
+             if _distance(a, b, tunable) >= min_distance]
+    rng.shuffle(pairs)
+    children = []
+    for left, right in pairs[:max_pairs]:
+        if not tunable:
+            continue
+        if len(tunable) == 2:
+            # The only novel two-dimensional recombinations are the two mixed
+            # children. Random masks also produce unchanged parent duplicates.
+            a, b = tunable
+            for source, donor in ((left, right), (right, left)):
+                kwargs = dict(source.kwargs)
+                if b in donor.kwargs:
+                    kwargs[b] = donor.kwargs[b]
+                children.append(_clone(source, kwargs))
+            continue
+        mask = rng.randrange(1, 1 << len(tunable))
+        kwargs = dict(left.kwargs)
+        for idx, name in enumerate(tunable):
+            if mask & (1 << idx) and name in right.kwargs:
+                kwargs[name] = right.kwargs[name]
+        children.append(_clone(left, kwargs))
+    return children
+
+
+def _novel(base: Sequence[Config], candidates: Iterable[Config], all_args: Mapping[str, Any]) -> List[Config]:
+    seen = {_sig(cfg) for cfg in base}
+    out = []
+    for cfg in _dedupe(candidates):
+        if not _basic_legal(cfg, all_args) or _sig(cfg) in seen:
+            continue
+        seen.add(_sig(cfg))
+        out.append(cfg)
+    return out
+
+
+
+def _pairwise_local(cfg: Config, spaces: Mapping[str, Sequence[int]], offsets: Sequence[int]) -> List[Config]:
+    """Jointly perturb two tunable parameters inside a bounded local neighbourhood."""
+    children: List[Config] = []
+    names = [name for name in spaces if isinstance(cfg.kwargs.get(name), int)]
+    for left, right in itertools.combinations(names, 2):
+        left_values = _neighbor(spaces[left], cfg.kwargs[left], offsets)
+        right_values = _neighbor(spaces[right], cfg.kwargs[right], offsets)
+        for lv, rv in itertools.product(left_values, right_values):
+            kwargs = dict(cfg.kwargs)
+            kwargs[left], kwargs[right] = lv, rv
+            children.append(_clone(cfg, kwargs))
+    return children
+
+
+def _resource_metrics(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> Dict[str, float]:
+    """Operator-family-aware analytical proxies used by S2 selection.
+
+    These are ranking/coverage proxies, not profiler counters.  The caller must
+    pass ``operator_family`` in candidate_expansion_options.  Legacy callers
+    default to the original Flash-Attention model.
+    """
+    family = str(options.get("operator_family", "generic")).lower()
+    cores = max(1, int(options.get("num_cores", 20)))
+    kw = cfg.kwargs
+
+    def block(*names, default=1):
+        for name in names:
+            value = kw.get(name)
+            if isinstance(value, int) and value > 0:
+                return value
+        return default
+
+    def finish(programs, padded, useful, ub_bytes, memory, compute, tile_ratio=1.0, divisible_axes=0):
+        waves = max(1, math.ceil(programs / cores))
+        wave_eff = programs / (waves * cores)
+        tail = max(0.0, (padded - useful) / max(1, padded))
+        return {
+            "ub_utilization": float(ub_bytes) / max(1.0, float(resolve_ub_capacity(options))),
+            "programs": float(programs), "waves": float(waves), "wave_efficiency": float(wave_eff),
+            "tail_waste": float(tail), "divisible_axes": float(divisible_axes),
+            "memory_proxy": float(memory), "compute_proxy": float(compute),
+            "core_imbalance": float(1.0 - wave_eff), "programs_per_core": float(programs / cores),
+            "tile_ratio": float(tile_ratio),
+        }
+
+    if family in {"vector", "vector_add"}:
+        n = max(1, int(all_args.get("N", all_args.get("n_elements", all_args.get("numel", 1)))))
+        b = block("BLOCK_SIZE", "XBLOCK", "XBLOCK_SIZE")
+        programs = math.ceil(n / b)
+        return finish(programs, programs * b, n, 3 * b * 2, 3 * b * 2, b, divisible_axes=int(n % b == 0))
+
+    if family in {"softmax", "vector_reduction", "layer_norm", "vector_multi_reduction"}:
+        rows = max(1, int(all_args.get("M", all_args.get("n_rows", 1))))
+        cols = max(1, int(all_args.get("N", all_args.get("n_cols", 1))))
+        b = block("BLOCK_SIZE", "RBLOCK_SIZE")
+        xblock = block("XBLOCK", "XBLOCK_SIZE", default=1)
+        programs = math.ceil(rows / xblock)
+        padded_cols = math.ceil(cols / b) * b
+        passes = 3 if family in {"layer_norm", "vector_multi_reduction"} else 2
+        ub = xblock * b * 4 * (3 if passes == 3 else 2)
+        memory = rows * cols * (4 if passes == 3 else 2)
+        compute = rows * padded_cols * passes
+        return finish(programs, rows * padded_cols, rows * cols, ub, memory, compute,
+                      tile_ratio=b / max(1, xblock), divisible_axes=int(cols % b == 0))
+
+    if family in {"matmul", "matmul_bias", "cube", "cube_dominant_mix", "gemm", "linear"}:
+        m = max(1, int(all_args.get("M", 1))); n = max(1, int(all_args.get("N", 1))); k = max(1, int(all_args.get("K", 1)))
+        bm = block("BLOCK_M", "BLOCK_SIZE_M"); bn = block("BLOCK_N", "BLOCK_SIZE_N"); bk = block("BLOCK_K", "BLOCK_SIZE_K")
+        mt, nt, kt = math.ceil(m / bm), math.ceil(n / bn), math.ceil(k / bk)
+        programs = mt * nt
+        padded = mt * bm * nt * bn * kt * bk
+        useful = m * n * k
+        # Quantization-aware byte accounting (MXFP4/MXFP8).
+        quant_dtype = str(options.get("quant_dtype", "")).lower()
+        if quant_dtype == "mxfp4":
+            elem_bytes = 0.5; scale_bytes_per_block = 1; mxfp_block = 32
+        elif quant_dtype == "mxfp8":
+            elem_bytes = 1.0; scale_bytes_per_block = 1; mxfp_block = 32
+        else:
+            elem_bytes = max(1, int(options.get("dtype_bytes", 2))); scale_bytes_per_block = 0; mxfp_block = 1
+        a_b = bm * bk * elem_bytes; b_b = bn * bk * elem_bytes
+        scale_iter = (math.ceil(bm * bk / mxfp_block) + math.ceil(bn * bk / mxfp_block)) * scale_bytes_per_block
+        ub = (a_b + b_b) + (bn * bk) * elem_bytes + bm * bn * 4 + scale_iter + bm * bn * 4
+        memory = mt * nt * kt * (a_b + b_b + scale_iter) + m * n * 4
+        compute = 2 * padded
+        return finish(programs, padded, useful, ub, memory, compute,
+                      tile_ratio=bn / max(1, bm), divisible_axes=int(m % bm == 0)+int(n % bn == 0)+int(k % bk == 0))
+
+    if family in {"chunk", "chunk_o", "chunk_o_npu"}:
+        # Persistent chunk_o geometry used only for model-free S2 coverage.
+        # It mirrors the uploaded kernel's task_num = ceil(V/BV)*HV*total_chunks
+        # and K-loop = ceil(K/BK); these are coverage coordinates, not a
+        # replacement for Full vTriton performance prediction.
+        t = max(1, int(all_args.get("T", 1)))
+        bt = max(1, int(all_args.get("BT", 64)))
+        batch = max(1, int(all_args.get("batch", all_args.get("B", 1))))
+        hv = max(1, int(all_args.get("HV", all_args.get("H", 1))))
+        k = max(1, int(all_args.get("K", 1)))
+        v = max(1, int(all_args.get("V", 1)))
+        bk = block("BK", "BLOCK_K")
+        bv = block("BV", "BLOCK_V")
+        total_chunks = batch * math.ceil(t / bt)
+        v_tiles = math.ceil(v / bv)
+        k_loops = math.ceil(k / bk)
+        programs = v_tiles * hv * total_chunks
+        padded = total_chunks * hv * v_tiles * bv * k_loops * bk
+        useful = total_chunks * hv * v * k
+        elem = max(1, int(options.get("dtype_bytes", 2)))
+        ub = (2 * bt * bk + bk * bv) * elem + (bt * bt + bt * bv) * 4
+        memory = programs * k_loops * (2 * bt * bk + bk * bv) * elem
+        compute = programs * k_loops * (2 * bt * bt * bk + 2 * bt * bk * bv)
+        return finish(programs, padded, useful, ub, memory, compute,
+                      tile_ratio=bv / max(1, bk),
+                      divisible_axes=int(k % bk == 0) + int(v % bv == 0))
+
+    if family in {"flash_attention", "flash_attention_npu_v8", "fa"}:
+        bm = block("BLOCK_M", "BM"); bn = block("BLOCK_N", "BN")
+        n = max(1, int(all_args.get("N_CTX", all_args.get("MAX_Q_LEN", all_args.get("N", 1)))))
+        h = max(1, int(all_args.get("H", 1))); z = max(1, int(all_args.get("Z", 1)))
+        programs = math.ceil(n / bm) * math.ceil(n / bn) * h * z
+        padded = math.ceil(n / bm) * bm * math.ceil(n / bn) * bn
+        breakdown = analytic_cost_model(cfg, all_args, options)
+        result = finish(programs, padded, n * n, breakdown.ub_pressure * float(resolve_ub_capacity(options)),
+                        breakdown.memory, breakdown.compute, bn / max(1, bm), int(n % bm == 0)+int(n % bn == 0))
+        result["core_imbalance"] = breakdown.core_imbalance
+        return result
+
+    # Fully generic fallback for an unfamiliar handwritten kernel.  It uses all
+    # integer tunables rather than pretending the kernel is FlashAttention.
+    # The values are coverage coordinates only; performance ordering is handled
+    # by the generic V6 source-prior ranker and hardware racing.
+    numeric = [(str(k), int(v)) for k, v in kw.items() if isinstance(v, int) and int(v) > 0]
+    core_names = {"AICORE_NUM", "NUM_SM", "NUM_SMS", "NUM_CORES", "NUM_CORE"}
+    tile = [(n, v) for n, v in numeric if n.upper() not in core_names and "CORE" not in n.upper()]
+    core_val = next((v for n, v in numeric if n.upper() in core_names or "CORE" in n.upper()), cores)
+    tile_volume = math.prod(v for _, v in tile) if tile else 1
+    # When no axis binding is known, one logical task per core is the safest
+    # neutral coverage assumption; it does not remove any search direction.
+    programs = max(1, int(core_val))
+    padded = max(1, tile_volume)
+    useful = padded
+    ub = min(float(resolve_ub_capacity(options)), float(tile_volume * max(1, int(options.get("dtype_bytes", 2))) * 4))
+    return finish(programs, padded, useful, ub, padded, padded,
+                  tile_ratio=1.0, divisible_axes=0)
+
+
+def _bucket(value: float, cuts: Sequence[float]) -> int:
+    for idx, cut in enumerate(cuts):
+        if value < cut:
+            return idx
+    return len(cuts)
+
+
+def _resource_region(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> Tuple[int, ...]:
+    """Map a candidate to a compact execution-state region.
+
+    Light TTIR uses the two-level design from the technical proposal: the
+    region id contains only grid state, loop state and primary bottleneck.
+    Buffer/tail/redundancy stay as continuous in-region ranking objectives.
+    """
+    if not bool(options.get("generation_only", False)):
+        report = _light_report(cfg, all_args, options, score_mode="universal")
+        if report is not None:
+            return tuple(generic_region(report))
+    m = _resource_metrics(cfg, all_args, options)
+    return (
+        _bucket(m["wave_efficiency"], options.get("s2_wave_efficiency_cuts", (0.50, 0.75, 0.90))),
+        _bucket(m["waves"], options.get("s2_wave_count_cuts", (1.5, 2.5, 4.5, 8.5))),
+        2 if m["memory_proxy"] > m["compute_proxy"] else 1,
+    )
+
+
+def _deterministic_subsample(items: Sequence[Any], limit: int) -> List[Any]:
+    """Evenly sample an ordered domain while retaining both endpoints."""
+    values = list(items)
+    if limit <= 0:
+        return []
+    if len(values) <= limit:
+        return values
+    if limit == 1:
+        return [values[len(values) // 2]]
+    indices = sorted({round(i * (len(values) - 1) / (limit - 1)) for i in range(limit)})
+    return [values[i] for i in indices]
+
+
+def _axis_sample(values: Sequence[int], max_values: int = 5) -> List[int]:
+    return _deterministic_subsample(sorted(set(values)), max_values)
+
+
+def _resource_aware_candidates(base: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                               all_args: Mapping[str, Any], options: Mapping[str, Any]) -> Tuple[List[Config], Dict[str, Any]]:
+    """Coverage-first S2 reservoir over a strictly bounded legal domain.
+
+    Light TTIR ranks representatives *after* the region domain has been built;
+    it no longer removes entire directions before coverage analysis.  The
+    global ``s2_max_domain_product`` bound applies after all structural
+    templates and auxiliary axis pairs are combined.
+    """
+    names = [name for name in spaces if any(isinstance(c.kwargs.get(name), int) for c in base)]
+    if not names:
+        return [], {"covered_before": 0, "reservoir": 0, "target_regions": 0, "emitted": 0}
+
+    region_counts: Dict[Tuple[int, ...], int] = {}
+    for cfg in base:
+        region = _resource_region(cfg, all_args, options)
+        region_counts[region] = region_counts.get(region, 0) + 1
+
+    max_domain_product = max(1, int(options.get("s2_max_domain_product", 4096)))
+    per_region = max(1, int(options.get("s2_candidates_per_region", 2)))
+    sparse_threshold = max(0, int(options.get("s2_sparse_region_threshold", 1)))
+    template_limit = max(1, int(options.get("s2_template_count", 4)))
+    family_reps: Dict[tuple, Config] = {}
+    for cfg in base:
+        family_reps.setdefault(structural_family_key(cfg, options), cfg)
+    seed_templates = list(family_reps.values())[:template_limit]
+
+    candidate_specs: List[tuple[Config, Dict[str, Any]]] = []
+    primary = [n for n in names if n.upper() in {"BM", "BN", "BLOCK_M", "BLOCK_N"}]
+    pair_axes: List[tuple[str, str]] = []
+    if len(primary) >= 2:
+        pair_axes.append((primary[0], primary[1]))
+    for pair in itertools.combinations(names, 2):
+        if pair not in pair_axes:
+            pair_axes.append(pair)
+
+    # Allocate deterministic quotas across structural templates and axis pairs.
+    buckets = max(1, len(seed_templates) * max(1, len(pair_axes)))
+    per_bucket = max(1, max_domain_product // buckets)
+    for template in seed_templates:
+        for left, right in pair_axes:
+            pairs = list(itertools.product(spaces[left], spaces[right]))
+            pairs = _deterministic_subsample(pairs, per_bucket)
+            for lv, rv in pairs:
+                kwargs = dict(template.kwargs); kwargs[left] = lv; kwargs[right] = rv
+                candidate_specs.append((template, kwargs))
+        # Preserve single-axis extremes/medians for every tunable.
+        for name in names:
+            for value in _axis_sample(spaces[name], 5):
+                kwargs = dict(template.kwargs); kwargs[name] = value
+                candidate_specs.append((template, kwargs))
+        # Small orthogonal three-axis sample for interactions not visible in BMxBN.
+        if len(names) >= 3:
+            triple = names[:3]
+            axes = [_axis_sample(spaces[name], 3) for name in triple]
+            for values in itertools.product(*axes):
+                kwargs = dict(template.kwargs); kwargs.update(dict(zip(triple, values)))
+                candidate_specs.append((template, kwargs))
+
+    candidate_specs = _deterministic_subsample(candidate_specs, max_domain_product)
+    reservoir = _novel(base, (_clone(template, kwargs) for template, kwargs in candidate_specs), all_args)
+    # Enforce the bound *after* legality/deduplication too.
+    reservoir = _deterministic_subsample(sorted(reservoir, key=_sig), max_domain_product)
+    reservoir_before_filter = len(reservoir)
+
+    # Coverage stage removes only explicit hard UB violations when requested.
+    # Near-capacity candidates remain available as representatives.
+    hard_ub_filter = bool(options.get("s2_hard_ub_filter", False))
+    hard_ub_threshold = float(options.get("s2_hard_ub_threshold", 1.0))
+    kept: List[Config] = []
+    hard_ub_dropped = near_capacity = 0
+    for cfg in reservoir:
+        if bool(options.get("generation_only", False)):
+            # No model-driven UB or Light-TTIR filtering in accuracy-audit mode.
+            kept.append(cfg)
+            continue
+        report = _light_report(cfg, all_args, options, score_mode="universal")
+        if report is not None:
+            if report.ub_utilization >= float(options.get("light_near_capacity_threshold", 0.85)):
+                near_capacity += 1
+            if hard_ub_filter and report.ub_utilization > hard_ub_threshold:
+                hard_ub_dropped += 1
+                continue
+        kept.append(cfg)
+    reservoir = kept
+
+    by_region: Dict[Tuple[int, ...], List[Config]] = {}
+    for cfg in reservoir:
+        by_region.setdefault(_resource_region(cfg, all_args, options), []).append(cfg)
+    target_regions = [r for r in by_region if region_counts.get(r, 0) <= sparse_threshold]
+    emitted: List[Config] = []
+    region_summary: Dict[str, int] = {}
+    for region in sorted(target_regions):
+        candidates = by_region[region]
+        if bool(options.get("generation_only", False)):
+            chosen = _diverse_seed_subset(candidates, names, min(per_region, len(candidates)))
+        else:
+            scores = {c: _score(c, all_args, options) for c in candidates}
+            chosen = _diverse_top_k(
+                candidates, scores, names, min(per_region, len(candidates)),
+                float(options.get("diversity_weight", 0.08)),
+            )
+        emitted.extend(chosen)
+        region_summary[str(region)] = len(chosen)
+
+    return _dedupe(emitted), {
+        "covered_before": len(region_counts),
+        "reservoir": len(reservoir),
+        "reservoir_before_filter": reservoir_before_filter,
+        "max_domain_product": max_domain_product,
+        "hard_ub_dropped": hard_ub_dropped,
+        "near_capacity_retained": near_capacity - hard_ub_dropped,
+        "target_regions": len(target_regions),
+        "covered_after_generation": len(set(region_counts) | set(by_region)),
+        "emitted": len(emitted),
+        "region_representatives": region_summary,
+        "coverage_order": ("legal_domain_then_region_then_deterministic_diversity"
+                           if bool(options.get("generation_only", False))
+                           else "legal_domain_then_region_then_light_rank"),
+    }
+
+
+def _cost_guided_mutations(parent: Config, spaces: Mapping[str, Sequence[int]], all_args: Mapping[str, Any],
+                           options: Mapping[str, Any], limit: int) -> List[Config]:
+    """Rank global single-axis mutations while guaranteeing coverage of every axis."""
+    if limit <= 0:
+        return []
+    by_axis: Dict[str, List[Config]] = {}
+    for name, values in spaces.items():
+        current = parent.kwargs.get(name)
+        if not isinstance(current, int):
+            continue
+        axis_children: List[Config] = []
+        for value in values:
+            if value == current:
+                continue
+            kwargs = dict(parent.kwargs)
+            kwargs[name] = value
+            axis_children.append(_clone(parent, kwargs))
+        axis_children = _dedupe(axis_children)
+        axis_children.sort(key=lambda c: _score(c, all_args, options))
+        if axis_children:
+            by_axis[name] = axis_children
+    if not by_axis:
+        return []
+
+    per_axis = max(1, limit // len(by_axis))
+    selected: List[Config] = []
+    residual: List[Config] = []
+    for name in sorted(by_axis):
+        children = by_axis[name]
+        selected.extend(children[:per_axis])
+        residual.extend(children[per_axis:])
+    residual.sort(key=lambda c: _score(c, all_args, options))
+    selected.extend(residual[:max(0, limit - len(selected))])
+    return _dedupe(selected)[:limit]
+
+
+def _direct_multi_axis_mutations(parent: Config, spaces: Mapping[str, Sequence[int]],
+                                 all_args: Mapping[str, Any], options: Mapping[str, Any],
+                                 limit: int) -> List[Config]:
+    """Score direct two-axis mutations to capture synergistic tile changes.
+
+    This avoids the evolutionary failure mode where each single-axis
+    intermediate is poor but the joint mutation is good.
+    """
+    if limit <= 0:
+        return []
+    names = [name for name in spaces if isinstance(parent.kwargs.get(name), int)]
+    candidates: List[Config] = []
+    local_offsets = tuple(int(v) for v in options.get("s3_multi_axis_offsets", (-2, -1, 1, 2)))
+    for left, right in itertools.combinations(names, 2):
+        lv = set(_neighbor(spaces[left], parent.kwargs[left], local_offsets))
+        rv = set(_neighbor(spaces[right], parent.kwargs[right], local_offsets))
+        lv.update(_axis_sample(spaces[left], 4)); rv.update(_axis_sample(spaces[right], 4))
+        lv.discard(parent.kwargs[left]); rv.discard(parent.kwargs[right])
+        for a, b in itertools.product(sorted(lv), sorted(rv)):
+            kwargs = dict(parent.kwargs); kwargs[left] = a; kwargs[right] = b
+            candidates.append(_clone(parent, kwargs))
+    candidates = _dedupe(candidates)
+    raw_limit = max(limit, int(options.get("s3_multi_axis_raw_limit", max(32, limit * 8))))
+    candidates = _deterministic_subsample(sorted(candidates, key=_sig), raw_limit)
+    scores = {cfg: _score(cfg, all_args, options) for cfg in candidates}
+    return _diverse_top_k(candidates, scores, names, min(limit, len(candidates)),
+                          float(options.get("s3_multi_axis_diversity_weight", 0.12)))
+
+
+def _model_free_single_axis_mutations(parent: Config, spaces: Mapping[str, Sequence[int]],
+                                      limit: int) -> List[Config]:
+    """Deterministic S3 single-axis mutations with no cost-model reads."""
+    if limit <= 0:
+        return []
+    names = [name for name in spaces if isinstance(parent.kwargs.get(name), int)]
+    children: List[Config] = []
+    for name in names:
+        current = parent.kwargs[name]
+        values = sorted(set(int(v) for v in spaces[name] if isinstance(v, int)))
+        candidates = []
+        for value in _axis_sample(values, max(5, min(len(values), limit))):
+            if value == current:
+                continue
+            kwargs = dict(parent.kwargs); kwargs[name] = value
+            candidates.append(_clone(parent, kwargs))
+        children.extend(candidates)
+    return _deterministic_subsample(sorted(_dedupe(children), key=_sig), limit)
+
+
+def _model_free_multi_axis_mutations(parent: Config, spaces: Mapping[str, Sequence[int]],
+                                     options: Mapping[str, Any], limit: int) -> List[Config]:
+    """Deterministic joint mutations used by generation-only S3."""
+    if limit <= 0:
+        return []
+    names = [name for name in spaces if isinstance(parent.kwargs.get(name), int)]
+    candidates: List[Config] = []
+    for left, right in itertools.combinations(names, 2):
+        lv = [v for v in _axis_sample(spaces[left], 4) if v != parent.kwargs[left]]
+        rv = [v for v in _axis_sample(spaces[right], 4) if v != parent.kwargs[right]]
+        for a, b in itertools.product(lv, rv):
+            kwargs = dict(parent.kwargs); kwargs[left] = a; kwargs[right] = b
+            candidates.append(_clone(parent, kwargs))
+    raw_limit = max(limit, int(options.get("s3_multi_axis_raw_limit", max(32, limit * 8))))
+    candidates = _deterministic_subsample(sorted(_dedupe(candidates), key=_sig), raw_limit)
+    return _diverse_seed_subset(candidates, names, min(limit, len(candidates)))
+
+
+def _model_free_factorial_candidates(pool: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                                      options: Mapping[str, Any]) -> List[Config]:
+    """Bounded multi-axis factorial bank independent of any performance model."""
+    if not pool:
+        return []
+    names = [name for name in spaces if any(isinstance(c.kwargs.get(name), int) for c in pool)]
+    if len(names) < 2:
+        return []
+    names = names[:max(2, int(options.get("s3_factorial_max_axes", 3)))]
+    width = max(2, int(options.get("s3_factorial_core_width", 3)))
+    banks = [_axis_sample(spaces[name], width) for name in names]
+    template = sorted(pool, key=_sig)[0]
+    out: List[Config] = []
+    for values in itertools.product(*banks):
+        kwargs = dict(template.kwargs); kwargs.update(dict(zip(names, values)))
+        out.append(_clone(template, kwargs))
+    return sorted(_dedupe(out), key=_sig)
+
+
+def _marginal_factorial_candidates(pool: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                                    scores: Mapping[Config, float], options: Mapping[str, Any]) -> List[Config]:
+    """Build a bounded factorial bank from strong marginal axis values.
+
+    The bank is ordered by the sum of per-axis marginal ranks, rather than by
+    Cartesian iteration order.  This preserves jointly promising tuples such
+    as the fourth-best M value combined with the best N and second-best K,
+    while keeping the reserved exploration budget deterministic.
+    """
+    if not pool:
+        return []
+    names = [name for name in spaces if any(isinstance(cfg.kwargs.get(name), int) for cfg in pool)]
+    if len(names) < 2:
+        return []
+    names = names[:max(2, int(options.get("s3_factorial_max_axes", 3)))]
+    core_width = max(1, int(options.get("s3_factorial_core_width", 4)))
+
+    ranked_values: Dict[str, List[int]] = {}
+    rank_maps: Dict[str, Dict[int, int]] = {}
+    banks: Dict[str, List[int]] = {}
+    for name in names:
+        marginal: Dict[int, float] = {}
+        for cfg in pool:
+            value = cfg.kwargs.get(name)
+            if isinstance(value, int):
+                marginal[value] = min(marginal.get(value, math.inf), float(scores.get(cfg, math.inf)))
+        ranked = [value for value, _ in sorted(marginal.items(), key=lambda item: (item[1], item[0]))]
+        ranked_values[name] = ranked
+        rank_maps[name] = {value: idx for idx, value in enumerate(ranked)}
+        bank = list(ranked[:core_width])
+        legal = sorted(set(int(v) for v in spaces.get(name, ()) if isinstance(v, int)))
+        # Two-axis kernels can afford endpoint coverage in the same factorial
+        # bank.  For three axes, endpoints are added as one-axis substitutions
+        # below to avoid a cubic explosion.
+        if len(names) == 2 and legal:
+            for value in (legal[0], legal[-1], legal[len(legal) // 2]):
+                if value not in bank:
+                    bank.append(value)
+        banks[name] = bank
+
+    template = min(pool, key=lambda cfg: float(scores.get(cfg, math.inf)))
+
+    def priority(values: tuple[int, ...]) -> tuple[Any, ...]:
+        ranks = tuple(rank_maps[name].get(value, len(rank_maps[name]) + 8) for name, value in zip(names, values))
+        return (sum(ranks), max(ranks), ranks, values)
+
+    tuples = list(itertools.product(*(banks[name] for name in names)))
+    tuples.sort(key=priority)
+    generated: List[Config] = []
+    for values in tuples:
+        kwargs = dict(template.kwargs); kwargs.update(dict(zip(names, values)))
+        generated.append(_clone(template, kwargs))
+
+    if len(names) >= 3:
+        core_tuples = list(itertools.product(*(ranked_values[name][:core_width] for name in names)))
+        core_tuples.sort(key=priority)
+        for values in core_tuples:
+            base_kwargs = dict(zip(names, values))
+            for name in names:
+                legal = sorted(set(int(v) for v in spaces.get(name, ()) if isinstance(v, int)))
+                if not legal:
+                    continue
+                for value in (legal[0], legal[-1], legal[len(legal) // 2]):
+                    kwargs = dict(template.kwargs); kwargs.update(base_kwargs); kwargs[name] = value
+                    generated.append(_clone(template, kwargs))
+    return _dedupe(generated)
+
+
+@dataclass(frozen=True)
+class CostBreakdown:
+    score: float
+    compute: float
+    memory: float
+    ub_pressure: float
+    core_imbalance: float
+
+
+def analytic_cost_model(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> CostBreakdown:
+    """Legacy parameter-only analytic proxy; this is **not** Light TTIR.
+
+    The proxy never reads TTIR, builds a DAG, or uses KernelTemplate features.
+    It remains only for explicit compatibility experiments
+    (``allow_legacy_light_proxy=True``) and for S3 when the caller explicitly
+    permits ``allow_analytic_formal_fallback``.  Normal S1/S2 execution uses
+    the staged Light TTIR Universal/residual APIs instead.  Lower is better.
+    """
+    family = str(options.get("operator_family", "generic")).lower()
+    cores = max(1, int(options.get("num_cores", 20)))
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+
+    if family in {"matmul", "matmul_bias", "cube", "cube_dominant_mix", "gemm", "linear"}:
+        # GEMM branch (quantization-aware for MXFP4/MXFP8).
+        bm = int(cfg.kwargs.get("BLOCK_M", cfg.kwargs.get("BLOCK_SIZE_M", cfg.kwargs.get("BM", 1))))
+        bn = int(cfg.kwargs.get("BLOCK_N", cfg.kwargs.get("BLOCK_SIZE_N", cfg.kwargs.get("BN", 1))))
+        bk = int(cfg.kwargs.get("BLOCK_K", cfg.kwargs.get("BLOCK_SIZE_K", cfg.kwargs.get("BK", 1))))
+        m = max(1, int(all_args.get("M", 1)))
+        n = max(1, int(all_args.get("N", 1)))
+        k = max(1, int(all_args.get("K", 1)))
+        quant_dtype = str(options.get("quant_dtype", "")).lower()
+        if quant_dtype == "mxfp4":
+            elem_bytes = 0.5; scale_bytes_per_block = 1; mxfp_block = 32
+        elif quant_dtype == "mxfp8":
+            elem_bytes = 1.0; scale_bytes_per_block = 1; mxfp_block = 32
+        else:
+            elem_bytes = dtype_bytes; scale_bytes_per_block = 0; mxfp_block = 1
+        tiles = math.ceil(m / max(1, bm)) * math.ceil(n / max(1, bn))
+        waves = math.ceil(tiles / cores)
+        core_imbalance = (waves * cores - tiles) / max(1, waves * cores)
+        compute = (2 * bm * bn * max(1, bk)) / max(1.0, float(options.get("compute_scale", 65536.0)))
+        a_b = bm * bk * elem_bytes; b_b = bn * bk * elem_bytes
+        scale_iter = (math.ceil(bm * bk / mxfp_block) + math.ceil(bn * bk / mxfp_block)) * scale_bytes_per_block
+        memory = (a_b + b_b + scale_iter) / max(1.0, float(options.get("memory_scale", 65536.0)))
+        ub_est = a_b + b_b + bm * bn * 4 + scale_iter + bm * bn * 4
+        ub_size = resolve_ub_capacity(options)
+        ub_pressure = ub_est / ub_size
+        tiny_penalty = float(options.get("tiny_block_penalty", 0.0)) * (1.0 / max(1, bm) + 1.0 / max(1, bn))
+        score = (waves * max(compute, memory)
+                 + float(options.get("ub_weight", 3.0)) * max(0.0, ub_pressure - 0.65) ** 2
+                 + float(options.get("imbalance_weight", 1.0)) * core_imbalance
+                 + tiny_penalty)
+        return CostBreakdown(score, compute, memory, ub_pressure, core_imbalance)
+
+    # Flash Attention / backward-compatible default.
+    bm = int(cfg.kwargs.get("BLOCK_M", cfg.kwargs.get("BM", 1)))
+    bn = int(cfg.kwargs.get("BLOCK_N", cfg.kwargs.get("BN", 1)))
+    bk = int(cfg.kwargs.get("BLOCK_K", cfg.kwargs.get("BK", all_args.get("HEAD_DIM", all_args.get("QK_DIM", 1)))))
+    n = max(1, int(all_args.get("N_CTX", all_args.get("MAX_Q_LEN", all_args.get("N", 1)))))
+    h = max(1, int(all_args.get("H", 1)))
+    z = max(1, int(all_args.get("Z", 1)))
+
+    tiles = math.ceil(n / max(1, bm)) * math.ceil(n / max(1, bn)) * h * z
+    waves = math.ceil(tiles / cores)
+    core_imbalance = (waves * cores - tiles) / max(1, waves * cores)
+    compute = (bm * bn * max(1, bk)) / max(1.0, float(options.get("compute_scale", 65536.0)))
+    memory = dtype_bytes * (bm * bk + bn * bk + bm * bn) / max(1.0, float(options.get("memory_scale", 65536.0)))
+    ub_est = dtype_bytes * (bm * bk + 2 * bn * bk + 2 * bm * bn) + 8 * bm
+    ub_size = resolve_ub_capacity(options)
+    ub_pressure = ub_est / ub_size
+    tiny_penalty = float(options.get("tiny_block_penalty", 0.0)) * (1.0 / max(1, bm) + 1.0 / max(1, bn))
+    score = (waves * max(compute, memory)
+             + float(options.get("ub_weight", 3.0)) * max(0.0, ub_pressure - 0.65) ** 2
+             + float(options.get("imbalance_weight", 1.0)) * core_imbalance
+             + tiny_penalty)
+    return CostBreakdown(score, compute, memory, ub_pressure, core_imbalance)
+
+
+def _runtime_model_stats(opts: Mapping[str, Any]) -> Dict[str, Any]:
+    if isinstance(opts, dict):
+        return opts.setdefault("_runtime_model_stats", {
+            "light_attempted": 0, "light_succeeded": 0, "light_failed": 0,
+            "formal_attempted": 0, "formal_succeeded": 0, "formal_failed": 0,
+            "fallback_used": 0, "failure_reasons": {},
+        })
+    return {}
+
+
+def _record_model_failure(opts: Mapping[str, Any], kind: str, exc: Exception) -> None:
+    stats = _runtime_model_stats(opts)
+    if not stats:
+        return
+    stats[f"{kind}_failed"] += 1
+    reason = f"{type(exc).__name__}: {exc}"
+    stats["failure_reasons"][reason] = stats["failure_reasons"].get(reason, 0) + 1
+
+
+def _light_score_cache(opts: Mapping[str, Any]) -> Dict[Any, Any]:
+    if isinstance(opts, dict):
+        return opts.setdefault("_candidate_light_score_cache", {})
+    return {}
+
+
+def _store_light_score_cache(
+    configs: Sequence[Config],
+    numeric: LightTTIRBatchScores,
+    all_args: Mapping[str, Any],
+    opts: Mapping[str, Any],
+) -> None:
+    """Store one already-computed numeric batch under the active model context."""
+    cache = _light_score_cache(opts)
+    for i, cfg in enumerate(configs):
+        cache[_light_numeric_cache_key(cfg, all_args, opts)] = (
+            float(numeric.score[i]), float(numeric.ub_utilization[i]),
+            float(numeric.load_imbalance[i]), float(numeric.tail_waste[i]),
+            int(numeric.region_id[i]),
+        )
+
+
+def _prime_light_score_cache(configs: Sequence[Config], all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> None:
+    cache = _light_score_cache(opts)
+    missing = [c for c in configs if _light_numeric_cache_key(c, all_args, opts) not in cache]
+    if not missing:
+        return
+    numeric = evaluate_light_ttir_scores_batch(missing, all_args, opts)
+    _store_light_score_cache(missing, numeric, all_args, opts)
+
