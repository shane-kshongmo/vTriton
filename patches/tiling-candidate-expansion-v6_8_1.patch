+
+"""Pipeline overlap model for Light TTIR."""
+from dataclasses import dataclass
+
+@dataclass(frozen=True)
+class PipelineReport:
+    mte: float
+    compute: float
+    stall: float
+    total: float
+
+def estimate_pipeline_time(mte, compute, dependency=0.0):
+    # MTE and compute can overlap; dependency prevents full overlap.
+    total=max(mte,compute)+dependency
+    return PipelineReport(mte,compute,dependency,total)
