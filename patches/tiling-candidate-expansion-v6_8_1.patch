@@ -0,0 +1,253 @@
+#!/usr/bin/env python3
+"""Static coverage audit for final V6 generic handwritten-kernel search.
+
+This audit intentionally distinguishes search-policy genericity from standalone
+benchmark-adapter coverage.  A repository ``@triton.jit`` helper is not
+necessarily an independently autotunable operator.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+
+HISTORICAL_REGISTRY = Path("third_party/ascend/experiments/repo_handwritten_hardware_experiment.py")
+EXACT_REGRESSION_ADAPTERS = {
+    "flash_attention_npu_v8": "third_party/ascend/experiments/vtriton_new_ops_calibration/operator_adapters.py",
+    "chunk_o": "third_party/ascend/experiments/vtriton_new_ops_calibration/operator_adapters.py",
+}
+
+
+def write_json(path: Path, obj: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
+
+
+def _registry_specs(path: Path) -> list[dict[str, Any]]:
+    """Extract literal OperatorSpec entries without importing torch_npu."""
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    reg = None
+    for node in tree.body:
+        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and node.target.id == "REGISTRY":
+            reg = node.value
+            break
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "REGISTRY" for t in node.targets):
+            reg = node.value
+            break
+    if not isinstance(reg, ast.Dict):
+        raise RuntimeError(f"Unable to parse REGISTRY from {path}")
+    rows = []
+    for k, v in zip(reg.keys, reg.values):
+        if not isinstance(k, ast.Constant) or not isinstance(v, ast.Call):
+            continue
+        kw = {x.arg: x.value for x in v.keywords if x.arg}
+        def lit(name, default=None):
+            try:
+                return ast.literal_eval(kw[name])
+            except Exception:
+                return default
+        rows.append({
+            "name": str(k.value),
+            "source_rel": lit("source_rel"),
+            "function_name": lit("function_name"),
+            "family": lit("family"),
+            "tunables": list(lit("tunables", ())),
+            "domains": dict(lit("domains", {}) or {}),
+            "case_count": len(lit("cases", ()) or ()),
+        })
+    return rows
+
+
+def _decorator_is_triton_jit(node: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    for dec in node.decorator_list:
+        text = ast.unparse(dec) if hasattr(ast, "unparse") else ""
+        if re.search(r"(^|\.)jit(?:\(|$)", text):
+            return True
+    return False
+
+
+def _constexpr_args(node: ast.FunctionDef | ast.AsyncFunctionDef) -> list[str]:
+    out = []
+    args = list(node.args.args) + list(node.args.kwonlyargs)
+    for arg in args:
+        ann = ast.unparse(arg.annotation) if arg.annotation is not None and hasattr(ast, "unparse") else ""
+        if "constexpr" in ann:
+            out.append(arg.arg)
+    return out
+
+
+
+
+def _call_leaf(fn: ast.AST) -> str:
+    if isinstance(fn, ast.Name):
+        return fn.id
+    if isinstance(fn, ast.Attribute):
+        parts = []
+        cur = fn
+        while isinstance(cur, ast.Attribute):
+            parts.append(cur.attr); cur = cur.value
+        if isinstance(cur, ast.Name):
+            parts.append(cur.id)
+        return ".".join(reversed(parts))
+    return ""
+
+
+def _source_motif(node: ast.FunctionDef | ast.AsyncFunctionDef, *, tunable: bool) -> tuple[str, str]:
+    """Mirror V6.6 source-AST motif categories for repository coverage audit."""
+    if not tunable:
+        return "jit_helper_or_fixed", "none"
+    calls = [_call_leaf(x.func) for x in ast.walk(node) if isinstance(x, ast.Call)]
+    tl_calls = [c for c in calls if c.startswith("tl.") or c.startswith("triton.language.")]
+    leaves = [c.split(".")[-1] for c in tl_calls if c]
+    dot = sum(x == "dot" for x in leaves)
+    reduction = sum(x in {"sum","max","min","argmax","argmin","reduce"} for x in leaves)
+    scan = sum(x in {"cumsum","cumprod","cummax","cummin","associative_scan"} for x in leaves)
+    atomic = sum(x.startswith("atomic_") for x in leaves)
+    if scan:
+        return "scan_recurrent", "high"
+    if dot and reduction:
+        return "attention_mixed", "high"
+    if dot:
+        return "gemm_like", "high"
+    if reduction:
+        return "reduction_like", "high"
+    if atomic:
+        return "irregular_atomic", "low"
+    return "elementwise_memory", "medium"
+
+
+def scan_repo(repo: Path) -> list[dict[str, Any]]:
+    roots = [repo / "third_party/ascend/tutorials", repo / "third_party/ascend/unittest"]
+    rows = []
+    for root in roots:
+        if not root.exists():
+            continue
+        for path in sorted(root.rglob("*.py")):
+            try:
+                tree = ast.parse(path.read_text(encoding="utf-8", errors="replace"))
+            except SyntaxError:
+                continue
+            for node in ast.walk(tree):
+                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and _decorator_is_triton_jit(node):
+                    constexpr = _constexpr_args(node)
+                    motif, motif_confidence = _source_motif(node, tunable=bool(constexpr))
+                    rows.append({
+                        "source_rel": str(path.relative_to(repo)),
+                        "function_name": node.name,
+                        "constexpr_args": constexpr,
+                        "has_tunable_like_constexpr": bool(constexpr),
+                        "source_motif_v66": motif,
+                        "source_motif_confidence_v66": motif_confidence,
+                    })
+    return rows
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo", type=Path, required=True)
+    ap.add_argument("--output", type=Path, required=True)
+    args = ap.parse_args()
+    repo = args.repo.resolve()
+
+    registry = _registry_specs(repo / HISTORICAL_REGISTRY)
+    registered = {(r["source_rel"], r["function_name"]): r for r in registry}
+    scanned = scan_repo(repo)
+
+    classified = []
+    for row in scanned:
+        key = (row["source_rel"], row["function_name"])
+        if key in registered:
+            cls = "direct_standalone_v6_adapter"
+            detail = "historical exact-source launch/reference adapter; generic V6 search space inferred from tunable schema"
+        elif not row["has_tunable_like_constexpr"]:
+            cls = "jit_helper_or_fixed_kernel"
+            detail = "no constexpr search axis detected; not automatically counted as independent autotune target"
+        else:
+            cls = "metadata_searchable_runtime_context_required"
+            detail = "generic V6 search policy can consume tunable metadata; standalone audit needs launch/reference context"
+        classified.append({**row, "classification": cls, "detail": detail})
+
+    direct = [x for x in classified if x["classification"] == "direct_standalone_v6_adapter"]
+    metadata = [x for x in classified if x["classification"] == "metadata_searchable_runtime_context_required"]
+    helpers = [x for x in classified if x["classification"] == "jit_helper_or_fixed_kernel"]
+    tunable_rows = [x for x in classified if x["has_tunable_like_constexpr"]]
+    motif_counts: dict[str, int] = {}
+    confidence_counts: dict[str, int] = {}
+    for row in tunable_rows:
+        motif = str(row.get("source_motif_v66", "generic_unknown"))
+        conf = str(row.get("source_motif_confidence_v66", "none"))
+        motif_counts[motif] = motif_counts.get(motif, 0) + 1
+        confidence_counts[conf] = confidence_counts.get(conf, 0) + 1
+    motif_supported = sum(v for k, v in motif_counts.items() if k != "generic_unknown")
+    motif_high_medium = sum(
+        1 for row in tunable_rows
+        if str(row.get("source_motif_confidence_v66")) in {"high", "medium"}
+    )
+
+    missing_registry_sources = [r for r in registry if not (repo / r["source_rel"]).is_file()]
+    empty_domains = [r["name"] for r in registry if any(not vals for vals in r["domains"].values())]
+
+    result = {
+        "schema_version": "candidate_value_v6_handwritten_coverage_audit_v2",
+        "search_policy_operator_name_dispatch": False,
+        "search_space_metadata_precedence": [
+            "Triton-Ascend hints.tunable_parameter",
+            "candidate_expansion parameter_domains",
+            "split_params / tiling_params",
+            "observed official/generated Config kwargs",
+            "Config.num_warps / num_stages / num_ctas / maxnreg",
+        ],
+        "triton_ascend_alignment": {
+            "official_autotiler": "AutoTilingTuner",
+            "official_metadata": ["tunable_parameter", "split_params", "tiling_params", "axis_info", "Config.num_warps", "Config.num_stages", "Config.num_ctas"],
+            "official_generators": ["TileGenerator", "CVTileGenerator"],
+            "v6_reuses_official_b0": True,
+            "v6_does_not_require_operator_name_for_search_axes": True,
+            "v6_core_count_axes_supported": ["AICORE_NUM", "NUM_SM", "NUM_SMS", "NUM_CORES", "num_cores", "*CORE*"],
+            "v6_launch_meta_axes_supported": ["num_warps", "num_stages", "num_ctas", "maxnreg"],
+            "launch_meta_domain_policy": "explicit domain or multiple observed Official/generated values",
+        },
+        "historical_exact_handwritten_registry": registry,
+        "exact_regression_adapters": EXACT_REGRESSION_ADAPTERS,
+        "repo_scan_counts": {
+            "jit_functions_scanned": len(classified),
+            "direct_standalone_v6_adapter": len(direct),
+            "metadata_searchable_runtime_context_required": len(metadata),
+            "jit_helper_or_fixed_kernel": len(helpers),
+        },
+        "source_motif_v66": {
+            "operator_name_dispatch": False,
+            "motifs": motif_counts,
+            "confidence": confidence_counts,
+            "tunable_like_jit_count": len(tunable_rows),
+            "motif_deca_structurally_applicable_count": motif_supported,
+            "motif_deca_structurally_applicable_ratio": motif_supported / max(1, len(tunable_rows)),
+            "high_or_medium_source_confidence_count": motif_high_medium,
+            "high_or_medium_source_confidence_ratio": motif_high_medium / max(1, len(tunable_rows)),
+            "low_confidence_motif_policy": "keep generic views + weak motif vote + hardware exploration; do not claim equal accuracy",
+        },
+        "classification": classified,
+        "semantics": {
+            "all_handwritten_search_policy_applicable": True,
+            "standalone_npu_runner_requires_runtime_reference_adapter": True,
+            "production_autotuner_already_has_runtime_launch_context": True,
+            "jit_function_count_is_not_claimed_as_independent_operator_count": True,
+            "v66_source_motif_deca_available_for_tunable_like_jit": True,
+            "v66_fa_chunk_are_not_required_for_motif_deca": True,
+        },
+        "missing_registry_sources": missing_registry_sources,
+        "empty_registry_domains": empty_domains,
+        "pass": not missing_registry_sources and not empty_domains and len(registry) >= 8,
+    }
+    write_json(args.output, result)
+    print(json.dumps({"pass": result["pass"], **result["repo_scan_counts"], "historical_registry": len(registry)}, ensure_ascii=False))
+    print("OUTPUT=", args.output)
+    raise SystemExit(0 if result["pass"] else 2)
+
+
+if __name__ == "__main__":
+    main()
