@@ -0,0 +1,75 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Universal TTIR roofline features without operator-family assumptions."""
+from __future__ import annotations
+from dataclasses import dataclass, asdict
+from .a5_hardware_model import DEFAULT_UB_CAPACITY_BYTES
+from .universal_memory_model import analyze_memory_pattern
+
+
+@dataclass(frozen=True)
+class UniversalTTIRFeatures:
+    load_ops: int
+    store_ops: int
+    dot_ops: int
+    reduce_ops: int
+    vector_ops: int
+    atomic_ops: int
+    tensor_bytes: float
+    arithmetic_ops: float
+    memory_bytes: float
+    arithmetic_intensity: float
+    irregularity: float
+    ub_pressure: float
+    memory_confidence: float = 0.0
+    control_ops: int = 0
+
+    def to_dict(self):
+        return asdict(self)
+
+
+def extract_universal_features(template, dtype_bytes=2, ub_capacity=DEFAULT_UB_CAPACITY_BYTES):
+    counts = dict(getattr(template, "operation_counts", {}) or {})
+    tensor_shapes = tuple(getattr(template, "tensor_ptr_shapes", ()) or ())
+    load_ops = sum(v for k, v in counts.items() if "load" in k)
+    store_ops = sum(v for k, v in counts.items() if "store" in k)
+    dot_ops = sum(v for k, v in counts.items() if "dot" in k or "mma" in k)
+    reduce_ops = sum(v for k, v in counts.items() if "reduce" in k)
+    atomic_ops = sum(v for k, v in counts.items() if "atomic" in k)
+    control_ops = sum(v for k, v in counts.items() if k.startswith(("scf.", "cf.")))
+    vector_ops = sum(v for k, v in counts.items() if (
+        k.startswith(("arith.", "math.")) or any(x in k for x in (
+            "exp", "add", "mul", "div", "sub", "where", "extern_elementwise", "histogram"
+        ))
+    ))
+
+    tensor_bytes = 0
+    for shape in tensor_shapes:
+        size = max(dtype_bytes, 1)
+        for dim in shape:
+            size *= max(1, int(dim))
+        tensor_bytes = max(tensor_bytes, size)
+
+    arithmetic_ops = dot_ops * 256 + reduce_ops * 64 + vector_ops * 32 + atomic_ops * 32
+    memory_bytes = (load_ops + store_ops) * max(dtype_bytes, 1) * 256
+    ai = arithmetic_ops / max(memory_bytes, 1.0)
+    unknown = len(getattr(template, "unknown_tt_ops", ()) or ())
+    total = max(1, sum(counts.values()))
+    irregularity = min(1.0, unknown / total + atomic_ops / total + 0.25 * control_ops / total)
+    ub_pressure = min(2.0, tensor_bytes * 2 / max(1, ub_capacity))
+    mem_report = analyze_memory_pattern(template)
+    return UniversalTTIRFeatures(
+        load_ops, store_ops, dot_ops, reduce_ops, vector_ops, atomic_ops,
+        float(tensor_bytes), float(arithmetic_ops), float(memory_bytes),
+        float(ai), float(irregularity), float(ub_pressure),
+        float(mem_report.pointer_confidence), int(control_ops),
+    )
+
+
+def universal_roofline_score(features, rates, memory_report=None):
+    compute = features.arithmetic_ops / max(1.0, rates["cube_rate"])
+    memory = features.memory_bytes / max(1.0, rates["mte_bw"])
+    if memory_report is not None:
+        memory = memory / max(0.1, memory_report.bandwidth_scale)
+    vector = (features.vector_ops + features.reduce_ops) * 256 / max(1.0, rates["elem_rate"])
+    sync = features.atomic_ops * 0.02 + features.control_ops * 0.002
+    return max(compute, memory, vector) + sync
diff --git a/third_party/ascend/backend/runtime/vtriton_capture.py b/third_party/ascend/backend/runtime/vtriton_capture.py
new file mode 100644
index 000000000..93e4ead1f
--- /dev/null
+++ b/third_party/ascend/backend/runtime/vtriton_capture.py
@@ -0,0 +1,221 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Robust NPUIR capture for native vTriton scoring.
+
+The Ascend Triton backend does not expose post-HIVM NPUIR through
+``CompiledKernel.asm`` on every runtime version.  vTriton's vendored launcher
+already provides a supported secondary ``bishengir-compile`` capture hook.  The
+helpers in this module install that hook once and associate a synchronous
+compile with the captured NPUIR.
+
+A compile may legitimately hit Triton's cache.  In that case the command log
+does not grow; the newest valid NPUIR emitted by an immediately preceding
+compile remains the correct artifact and is intentionally reused.
+"""
+from __future__ import annotations
+
+import importlib.util
+import os
+import subprocess
+import sys
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+_CAPTURE_LOCK = threading.RLock()
+_INSTALLATIONS: dict[tuple[str, str], Any] = {}
+
+
+def _default_vendor_launcher() -> Path:
+    return (
+        Path(__file__).resolve().parent
+        / "vtriton_vendor/source/tools/common/triton_dsl_dump_launcher.py"
+    )
+
+
+def install_vendor_npuir_capture(
+    dump_root: str | Path,
+    *,
+    launcher_path: str | Path | None = None,
+) -> Any:
+    """Install vTriton's compile-command/NPUIR hook exactly once.
+
+    The hook patches ``subprocess.run`` process-wide.  Reinstalling it nests
+    wrappers and resets the vendored file counter, so this function is
+    deliberately idempotent for each ``(launcher, dump_root)`` pair.
+    """
+
+    root = Path(dump_root).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    launcher = Path(launcher_path or os.environ.get(
+        "VTRITON_DSL_DUMP_LAUNCHER", _default_vendor_launcher()
+    )).resolve()
+    if not launcher.is_file():
+        raise FileNotFoundError(f"missing vTriton dump launcher: {launcher}")
+
+    key = (str(launcher), str(root))
+    with _CAPTURE_LOCK:
+        existing = _INSTALLATIONS.get(key)
+        if existing is not None:
+            return existing
+
+        # A worker can import the same launcher under another module name.  If
+        # subprocess.run already belongs to that launcher, preserve the wrapper
+        # instead of nesting it.  The current root is still recorded locally.
+        run_module = getattr(subprocess.run, "__module__", "")
+        run_qualname = getattr(subprocess.run, "__qualname__", "")
+        if (
+            "triton_dsl_dump_launcher" in run_module
+            and "_install_compile_command_capture" in run_qualname
+        ):
+            _INSTALLATIONS[key] = sys.modules.get(run_module, subprocess.run)
+            return _INSTALLATIONS[key]
+
+        module_name = f"_native_vtriton_dump_{abs(hash(key))}"
+        spec = importlib.util.spec_from_file_location(module_name, str(launcher))
+        if spec is None or spec.loader is None:
+            raise RuntimeError(f"cannot load vTriton dump launcher: {launcher}")
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[module_name] = module
+        spec.loader.exec_module(module)
+
+        installer = getattr(module, "_install_compile_command_capture", None)
+        if not callable(installer):
+            raise RuntimeError(
+                "vTriton dump launcher does not expose "
+                "_install_compile_command_capture"
+            )
+        installer(str(root))
+        _INSTALLATIONS[key] = module
+        return module
+
+
+def _valid_npuir(path: Path) -> bool:
+    if not path.is_file():
+        return False
+    try:
+        if path.stat().st_size <= 0:
+            return False
+        text = path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return False
+    stripped = text.lstrip()
+    return (
+        "func.func" in text
+        or "builtin.module" in text
+        or stripped.startswith("module")
+    )
+
+
+@dataclass(frozen=True)
+class CaptureSnapshot:
+    command_count: int
+    npuir_count: int
+
+
+class CapturedNPUIRResolver:
+    """Resolve the NPUIR corresponding to a synchronous Triton compile."""
+
+    command_log_name = "tritonsim_hivm_compile_commands.jsonl"
+
+    def __init__(
+        self,
+        dump_root: str | Path,
+        *,
+        launcher_path: str | Path | None = None,
+        wait_seconds: float = 5.0,
+    ) -> None:
+        self.dump_root = Path(dump_root).resolve()
+        self.dump_root.mkdir(parents=True, exist_ok=True)
+        self.command_log = self.dump_root / self.command_log_name
+        self.wait_seconds = max(0.0, float(wait_seconds))
+        install_vendor_npuir_capture(
+            self.dump_root,
+            launcher_path=launcher_path,
+        )
+
+    def _command_count(self) -> int:
+        if not self.command_log.is_file():
+            return 0
+        return sum(
+            1
+            for line in self.command_log.read_text(
+                encoding="utf-8", errors="replace"
+            ).splitlines()
+            if line.strip()
+        )
+
+    def _valid_files(self) -> list[Path]:
+        return [
+            path
+            for path in self.dump_root.rglob("*.npuir.mlir")
+            if _valid_npuir(path)
+        ]
+
+    def snapshot(self) -> CaptureSnapshot:
+        return CaptureSnapshot(
+            command_count=self._command_count(),
+            npuir_count=len(self._valid_files()),
+        )
+
+    def resolve_after(
+        self,
+        compiled: Any,
+        before: CaptureSnapshot,
+    ) -> Mapping[str, Any]:
+        """Return ``compiled`` plus captured NPUIR text and audit metadata.
+
+        A zero command delta is not an error: it means the compile hit Triton's
+        cache.  The newest valid NPUIR is reused in that case.
+        """
+
+        deadline = time.monotonic() + self.wait_seconds
+        after_commands = self._command_count()
+        files = self._valid_files()
+        while not files and time.monotonic() < deadline:
+            time.sleep(0.05)
+            after_commands = self._command_count()
+            files = self._valid_files()
+
+        if not files:
+            available = []
+            asm = getattr(compiled, "asm", None)
+            if isinstance(asm, Mapping):
+                available = sorted(str(key) for key in asm)
+            raise RuntimeError(
+                "No valid NPUIR is available after Triton compilation. "
+                f"dump_root={self.dump_root}, "
+                f"before_commands={before.command_count}, "
+                f"after_commands={after_commands}, "
+                f"before_npuir={before.npuir_count}, "
+                f"compiled_asm_keys={available}"
+            )
+
+        npuir_path = max(
+            files,
+            key=lambda path: (
+                path.stat().st_mtime_ns,
+                path.stat().st_size,
+                str(path),
+            ),
+        )
+        text = npuir_path.read_text(encoding="utf-8", errors="replace")
+        delta = after_commands - before.command_count
+        return {
+            "compiled_kernel": compiled,
+            "npuir": text,
+            "npuir_path": str(npuir_path),
+            "capture_command_delta": delta,
+            "capture_cache_hit": delta == 0,
+            "capture_before_npuir_count": before.npuir_count,
+            "capture_after_npuir_count": len(files),
+        }
+
+    def compile(
+        self,
+        compile_callback: Callable[[], Any],
+    ) -> Mapping[str, Any]:
+        before = self.snapshot()
+        compiled = compile_callback()
+        return self.resolve_after(compiled, before)
diff --git a/third_party/ascend/experiments/candidate_value_eval/analyze_v68_ranking.py b/third_party/ascend/experiments/candidate_value_eval/analyze_v68_ranking.py
new file mode 100644
