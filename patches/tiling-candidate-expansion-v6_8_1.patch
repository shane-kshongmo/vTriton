+def test_stable_compile_validate_requires_all_replays(monkeypatch):
+    seq = [True, True, True]
+    def fake(**kwargs):
+        ok = seq.pop(0)
+        return {
+            "config": dict(kwargs["cfg"]),
+            "compile_first_launch_wall_s": 0.01,
+            "correctness": {"finite": ok, "allclose": ok},
+            "error": None,
+            "state": {},
+        }
+    monkeypatch.setattr(m, "_compile_validate_one", fake)
+    out = m._stable_compile_validate_one(
+        operator="chunk_o", case={}, module=None, tensors={}, ref=None,
+        torch=None, cfg={"BK": 32}, replays=3,
+    )
+    assert out["correctness"]["stability_pass"] is True
+    assert out["correctness"]["stability_replays_completed"] == 3
+
+
+def test_stable_compile_validate_quarantines_intermittent_failure(monkeypatch):
+    seq = [True, False, True]
+    def fake(**kwargs):
+        ok = seq.pop(0)
+        return {
+            "config": dict(kwargs["cfg"]),
+            "compile_first_launch_wall_s": 0.01,
+            "correctness": {"finite": ok, "allclose": ok},
+            "error": None,
+            "state": {},
+        }
+    monkeypatch.setattr(m, "_compile_validate_one", fake)
+    out = m._stable_compile_validate_one(
+        operator="chunk_o", case={}, module=None, tensors={}, ref=None,
+        torch=None, cfg={"BK": 32}, replays=3,
+    )
+    assert out["correctness"]["stability_pass"] is False
+    assert out["correctness"]["stability_replays_completed"] == 2
+    assert out["error"] == "stability_replay_failed"
+
+
+def test_native_tune_stable_filters_fast_unstable_candidate(monkeypatch):
+    c0 = {"BK": 16}
+    c1 = {"BK": 32}
+    c2 = {"BK": 64}
+    def fake_native(**kwargs):
+        return {
+            "winner": {"config": c0, "benchmark_latency_ms": 1.0},
+            "correctness": {"allclose": True, "finite": True},
+            "native": {
+                "native_autotune_plus_winner_validation_wall_s": 1.0,
+                "final_timings": [
+                    {"config": c0, "median_ms": 1.0},
+                    {"config": c1, "median_ms": 1.1},
+                    {"config": c2, "median_ms": 1.2},
+                ],
+            },
+        }
+    def fake_stable(**kwargs):
+        stable = kwargs["cfg"] != c0
+        return {
+            "correctness": {"stability_pass": stable},
+            "error": None if stable else "stability_replay_failed",
+        }
+    monkeypatch.setattr(m, "_native_tune", fake_native)
+    monkeypatch.setattr(m, "_stable_compile_validate_one", fake_stable)
+    out = m._native_tune_stable(
+        operator="chunk_o", case={}, module=None, tensors={}, ref=None, torch=None,
+        selected_cfgs=[c0, c1, c2], candidate_value_batch_mode=True, stability_replays=3,
+    )
+    assert out["winner"]["config"] == c1
+    assert [r["config"] for r in out["native"]["final_timings"]] == [c1, c2]
+    assert len(out["native"]["final_timings_unfiltered"]) == 3
