+from pathlib import Path
+import sys
+ROOT=Path(__file__).resolve().parents[3]
+RUNTIME=ROOT/'third_party/ascend/backend/runtime'
+import types
+if 'backend' not in sys.modules:
+    b=types.ModuleType('backend'); b.__path__=[str(RUNTIME.parent)]; sys.modules['backend']=b
+if 'backend.runtime' not in sys.modules:
+    r=types.ModuleType('backend.runtime'); r.__path__=[str(RUNTIME)]; sys.modules['backend.runtime']=r
+from backend.runtime.search_space_v6 import infer_search_space
+from backend.runtime.ttir_anchor_refinement_v68 import extract_anchor_features, score_rows_ttir_anchors
+
+TTIR='''module {\n  tt.func public @kernel() {\n    %pid = tt.get_program_id x : i32\n    tt.return\n  }\n}\n'''
+
+def test_anchor_extract_is_structural_and_label_free():
+    feat=extract_anchor_features({'config':{'BLOCK_M':64},'ttir':TTIR})
+    assert feat is not None
+    assert feat['ttir_sha256']
+    assert feat['structural_penalty'] >= 0
+
+
+def test_anchor_view_requests_no_compilation_and_is_local():
+    rows=[{'config':{'BLOCK_M':32}},{'config':{'BLOCK_M':64}},{'config':{'BLOCK_M':128}}]
+    spec=infer_search_space([{'BLOCK_M':64}],[r['config'] for r in rows],parameter_domains={'BLOCK_M':[32,64,128]},tunable_parameters=['BLOCK_M'])
+    scored,meta=score_rows_ttir_anchors(rows,search_space=spec,anchors=[{'config':{'BLOCK_M':64},'ttir':TTIR}],max_neighbors=1,distance_scale=0.35)
+    assert meta['available'] is True
+    assert meta['requests_compilation'] is False
+    assert meta['uses_hivm'] is False and meta['uses_des'] is False
+    vals=list(scored.values())
+    exact=next(v for k,v in scored.items() if v['nearest_anchor_distance']==0)
+    assert exact['ttir_anchor_confidence'] >= max(v['ttir_anchor_confidence'] for v in vals)
