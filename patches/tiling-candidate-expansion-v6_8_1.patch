+
+def test_balanced_program_assignment_scores_better():
+    official=[{'BLOCK_M':64,'AICORE_NUM':2}]
+    cand=[{'BLOCK_M':64,'AICORE_NUM':2},{'BLOCK_M':128,'AICORE_NUM':4}]
+    spec=infer_search_space(official,cand,parameter_domains={'BLOCK_M':[64,128],'AICORE_NUM':[2,4]},tunable_parameters=['BLOCK_M','AICORE_NUM'])
+    opts={'num_cores':4,'parameter_to_axis':{'BLOCK_M':'M'},'axis_sizes':{'M':128}}
+    balanced=score_program_workload(cand[0],search_space=spec,all_args={'M':128},options=opts)
+    sparse=score_program_workload(cand[1],search_space=spec,all_args={'M':128},options=opts)
+    assert balanced['active_core_fraction'] == 1.0
+    assert sparse['active_core_fraction'] == 0.25
+    assert balanced['program_workload_score'] < sparse['program_workload_score']
+    assert balanced['uses_ttir'] is False
+
+
+def test_tail_workload_is_explicit_not_just_program_count():
+    cfg={'BLOCK_M':64,'AICORE_NUM':2}
+    spec=infer_search_space([cfg],[cfg],parameter_domains={'BLOCK_M':[64],'AICORE_NUM':[2]},tunable_parameters=['BLOCK_M','AICORE_NUM'])
+    rec=score_program_workload(cfg,search_space=spec,all_args={'M':100},options={'parameter_to_axis':{'BLOCK_M':'M'},'axis_sizes':{'M':100}})
+    assert rec['tail_task_fraction'] > 0
+    assert rec['tail_work_fraction'] > 0
+    assert len(rec['per_core_loads']) == 2
