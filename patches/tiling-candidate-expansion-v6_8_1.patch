+from __future__ import annotations
+
+from pathlib import Path
+import sys, types
+
+ROOT = Path(__file__).resolve().parents[3]
+RUNTIME = ROOT / 'third_party/ascend/backend/runtime'
+if 'backend' not in sys.modules:
+    b = types.ModuleType('backend'); b.__path__ = [str(RUNTIME.parent)]; sys.modules['backend'] = b
+if 'backend.runtime' not in sys.modules:
+    r = types.ModuleType('backend.runtime'); r.__path__ = [str(RUNTIME)]; sys.modules['backend.runtime'] = r
+
+# CPU-only Config stub: the Source model only needs kwargs + launch metadata.
+if 'triton' not in sys.modules:
+    triton = types.ModuleType('triton'); triton.__path__ = []
+    runtime = types.ModuleType('triton.runtime'); runtime.__path__ = []
+    autotuner = types.ModuleType('triton.runtime.autotuner')
+    class Config:
+        def __init__(self, kwargs, num_warps=4, num_stages=3, num_ctas=1, maxnreg=None):
+            self.kwargs = dict(kwargs); self.num_warps=num_warps; self.num_stages=num_stages; self.num_ctas=num_ctas; self.maxnreg=maxnreg
+    autotuner.Config = Config
+    runtime.autotuner = autotuner; triton.runtime = runtime
+    sys.modules['triton'] = triton; sys.modules['triton.runtime'] = runtime; sys.modules['triton.runtime.autotuner'] = autotuner
+
+from triton.runtime.autotuner import Config
+from backend.runtime.precompile_source_prefilter import score_config, rank_configs
+
+
+def test_native_precompile_prefilter_unknown_family_uses_motif_deca_not_error():
+    cfgs = [
+        Config({'BLOCK_SIZE_M':32,'BLOCK_SIZE_N':32,'BLOCK_SIZE_K':32}),
+        Config({'BLOCK_SIZE_M':64,'BLOCK_SIZE_N':64,'BLOCK_SIZE_K':64}),
+    ]
+    opts = {
+        'operator_family':'brand_new_gemm_family',
+        'source_text':'def k(a,b,c,BLOCK_SIZE_M: tl.constexpr,BLOCK_SIZE_N: tl.constexpr,BLOCK_SIZE_K: tl.constexpr):\n    tl.store(c,tl.dot(tl.load(a),tl.load(b)))\n',
+        'parameter_domains':{'BLOCK_SIZE_M':[32,64],'BLOCK_SIZE_N':[32,64],'BLOCK_SIZE_K':[32,64]},
+        'tunable_parameter':['BLOCK_SIZE_M','BLOCK_SIZE_N','BLOCK_SIZE_K'],
+        'split_params':{'m':'BLOCK_SIZE_M','n':'BLOCK_SIZE_N'},
+        'tiling_params':{'k':'BLOCK_SIZE_K'},
+        'reduction_axes':['k'],
+        'parameter_to_axis':{'BLOCK_SIZE_M':'m','BLOCK_SIZE_N':'n','BLOCK_SIZE_K':'k'},
+        'axis_sizes':{'m':512,'n':512,'k':512},
+        'num_cores':20,
+        'light_detect_hardware':False,
+    }
+    rec = score_config(cfgs[0], {}, opts)
+    assert rec['model_kind'] == 'source_motif_deca_v66'
+    assert rec['motif'] == 'gemm_like'
+    assert rec['uses_ttir'] is False
+    ranked, records = rank_configs(cfgs, {}, opts)
+    assert len(ranked) == 2 and len(records) == 2
+
+
+def test_native_precompile_prefilter_elementwise_family_is_supported():
+    cfg = Config({'BLOCK_SIZE':256})
+    opts = {
+        'operator_family':'future_vector_family',
+        'source_text':'def k(a,o,BLOCK_SIZE: tl.constexpr):\n    tl.store(o,tl.load(a)+1)\n',
+        'parameter_domains':{'BLOCK_SIZE':[64,128,256,512]},
+        'tunable_parameter':['BLOCK_SIZE'],
+        'num_cores':20,
+        'light_detect_hardware':False,
+    }
+    rec = score_config(cfg, {'N':1000000}, opts)
+    assert rec['model_kind'] == 'source_motif_deca_v66'
+    assert rec['motif'] == 'elementwise_memory'
diff --git a/third_party/ascend/experiments/test_safety_registry_v61.py b/third_party/ascend/experiments/test_safety_registry_v61.py
