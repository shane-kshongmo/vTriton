+#!/usr/bin/env python3
+"""V6.8 Source++ / zero-extra-compile TTIR-anchor near-optimal search harness.
+
+V6.8 keeps the V6 safety/optimality contract and extends the compile-free Source prior with
+finding genuinely faster configs, not merely minimizing autotune overhead.
+
+Key changes versus V6.8.1:
+  * retain unified Official B0 + release-SAFE bootstrap so every searchable case
+    receives a real novel-config opportunity without serialized first-novel JIT;
+  * prefetch up to three high-value SAFE novel candidates into the unified B0
+    native compile when the Official cost model says that is affordable;
+  * calibrate continuation value-per-cost with the bootstrap hardware evidence
+    already paid for in the current run, avoiding V6.5 false-high rescue value;
+  * permit at most one hardware-supported rescue beyond the normal soft budget;
+  * expose proposal-guided safety-frontier priorities for offline certification;
+  * keep production value stops explicitly heuristic.  Exact/certified
+    near-optimality still requires the existing strict domain/safety contract.
+
+The search engine remains operator-agnostic.  This file is only the existing
+FA/chunk regression adapter; generic handwritten integration remains under the
+runtime/search-space layer.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import shutil
+import statistics
+import sys
+import time
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
