+#!/usr/bin/env python3
+"""V6.8 static audit for operator-name-free Source Motif-DECA coverage."""
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+
+from audit_handwritten_v6_coverage import scan_repo, _registry_specs, HISTORICAL_REGISTRY
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--repo', type=Path, required=True)
+    ap.add_argument('--output', type=Path, required=True)
+    args = ap.parse_args()
+    repo = args.repo.resolve()
+    scanned = scan_repo(repo)
+    tunable = [x for x in scanned if x['has_tunable_like_constexpr']]
+    helpers = [x for x in scanned if not x['has_tunable_like_constexpr']]
+    motifs = Counter(str(x.get('source_motif_v66')) for x in tunable)
+    confidence = Counter(str(x.get('source_motif_confidence_v66')) for x in tunable)
+    high_medium = sum(confidence[k] for k in ('high', 'medium'))
+    registry = _registry_specs(repo / HISTORICAL_REGISTRY)
+    by_key = {(x['source_rel'], x['function_name']): x for x in scanned}
+    direct = []
+    for r in registry:
+        row = by_key.get((r['source_rel'], r['function_name']), {})
+        direct.append({
+            'operator': r['name'],
+            'historical_family': r['family'],
+            'source_motif_v67': row.get('source_motif_v66'),
+            'source_motif_confidence_v67': row.get('source_motif_confidence_v66'),
+            'source_rel': r['source_rel'],
+            'function_name': r['function_name'],
+        })
+    audit_pass = len(tunable) > 0 and all(x.get('source_motif_v66') for x in tunable)
+    result = {
+        'schema_version': 'candidate_value_source_motif_v67_audit_v1',
+        'pass': audit_pass,
+        'operator_name_dispatch': False,
+        'uses_ttir': False,
+        'uses_hivm': False,
+        'uses_des': False,
+        'uses_candidate_latency_labels': False,
+        'jit_functions_scanned': len(scanned),
+        'tunable_like_jit_count': len(tunable),
+        'helper_or_fixed_count': len(helpers),
+        'motif_counts': dict(sorted(motifs.items())),
+        'confidence_counts': dict(sorted(confidence.items())),
+        'motif_structural_coverage_ratio': sum(motifs.values()) / max(1, len(tunable)),
+        'high_medium_confidence_ratio': high_medium / max(1, len(tunable)),
+        'direct_exact_adapter_examples': direct,
+        'motif_policy': {
+            'gemm_like': 'cube/reuse/reduction-depth/core-wave Source-DECA',
+            'reduction_like': 'vector/reduction-depth/MTE/core-wave Source-DECA',
+            'elementwise_memory': 'MTE/vector/tail/core-wave Source-DECA',
+            'attention_mixed': 'dot+reduction/inner-loop/MTE/core-wave Source-DECA',
+            'scan_recurrent': 'sequential-depth/vector/MTE/core-wave Source-DECA',
+            'irregular_atomic': 'low-confidence atomic/contention/MTE view + generic fallback',
+        },
+        'accuracy_contract': 'coverage is structural capability, not equal ranking accuracy; Oracle/Regret@K hardware validation remains required per motif/family',
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding='utf-8')
+    print(json.dumps({
+        'jit': len(scanned), 'tunable': len(tunable), 'helpers': len(helpers),
+        'motifs': dict(motifs), 'high_medium_ratio': result['high_medium_confidence_ratio'],
+        'pass': audit_pass,
+    }, ensure_ascii=False))
+    print('OUTPUT=', args.output)
+
+
+if __name__ == '__main__':
+    main()
