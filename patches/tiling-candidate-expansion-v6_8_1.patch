index 000000000..2ef807101
--- /dev/null
+++ b/third_party/ascend/backend/runtime/ttir_dag_model.py
@@ -0,0 +1,171 @@
+"""Lightweight TTIR/MLIR SSA dependency analysis.
+
+The text fallback now builds def-use edges from SSA values and keeps phase
+heuristics only when operands/results cannot be recovered.  It is still not a
+cycle-accurate simulator, but it is materially closer to the actual IR than an
+operation-order chain.
+"""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import List
+
+
+@dataclass
+class TTIRNode:
+    op: str
+    cost: float = 0.0
+    memory: float = 0.0
+    users: list = field(default_factory=list)
+    phase: str = "other"
+    depth: float = 0.0
+    operands: tuple[str, ...] = ()
+    results: tuple[str, ...] = ()
+
+
+@dataclass
+class TTIRDAGReport:
+    nodes: list
+    cube_ops: int
+    vector_ops: int
+    memory_ops: int
+    critical_path: float
+    parallelism: float
+    dependency_edges: int = 0
+    phase_count: int = 0
+    memory_to_compute_edges: int = 0
+    compute_to_memory_edges: int = 0
+    ssa_edges: int = 0
+    loop_carried_edges: int = 0
+
+
+_OP_RE = re.compile(r'"?([A-Za-z_][A-Za-z0-9_]*\.[A-Za-z0-9_.$-]+)"?')
+_SSA_RE = re.compile(r'%[A-Za-z0-9_.$-]+')
+_RESULT_PREFIX = re.compile(r'^\s*((?:%[A-Za-z0-9_.$-]+\s*,\s*)*%[A-Za-z0-9_.$-]+)\s*=\s*(.*)$')
+
+
+def _phase(op: str) -> str:
+    value = op.lower()
+    if any(x in value for x in ("load", "make_tensor_ptr", "advance", "addptr")):
+        return "load"
+    if "store" in value:
+        return "store"
+    if "dot" in value or "mma" in value:
+        return "cube"
+    if any(token in value for token in ("reduce", "exp", "where", "histogram", "atomic", "arith.", "math.")):
+        return "vector"
+    return "other"
+
+
+def _cost(phase: str, op: str) -> float:
+    low = op.lower()
+    if phase == "cube":
+        return 2.0
+    if phase == "vector":
+        if "reduce" in low:
+            return 1.0
+        if "exp" in low:
+            return 0.8
+        if "atomic" in low:
+            return 1.5
+        return 0.35
+    if phase in {"load", "store"}:
+        return 0.30
+    if low.startswith("scf.") or low.startswith("cf."):
+        return 0.15
+    return 0.10
+
+
+def _parse_sequence(template):
+    text = getattr(template, "ttir_text", "") or ""
+    parsed = []
+    if isinstance(text, str) and text:
+        for line in text.splitlines():
+            line = line.split("//", 1)[0].strip()
+            if not line or line in {"{", "}"}:
+                continue
+            results: tuple[str, ...] = ()
+            body = line
+            match = _RESULT_PREFIX.match(line)
+            if match:
+                results = tuple(_SSA_RE.findall(match.group(1)))
+                body = match.group(2)
+            op_match = _OP_RE.search(body)
+            if not op_match:
+                continue
+            op = op_match.group(1)
+            operands = tuple(v for v in _SSA_RE.findall(body[op_match.end():]) if v not in results)
+            parsed.append((op, operands, results))
+        if parsed:
+            return parsed
+    counts = dict(getattr(template, "operation_counts", {}) or {})
+    ordered = []
+    for phase in ("load", "cube", "vector", "other", "store"):
+        for op, count in sorted(counts.items()):
+            if _phase(op) == phase:
+                ordered.extend((op, (), ()) for _ in range(int(count)))
+    return ordered
+
+
+def build_ttir_dag(template):
+    seq = _parse_sequence(template)
+    nodes = [TTIRNode(op=op, phase=_phase(op), cost=_cost(_phase(op), op), operands=operands, results=results)
+             for op, operands, results in seq]
+    if not nodes:
+        nodes = [TTIRNode(op="unknown", phase="other", cost=1.0)]
+
+    cube = sum(n.phase == "cube" for n in nodes)
+    vec = sum(n.phase == "vector" for n in nodes)
+    mem = sum(n.phase in {"load", "store"} for n in nodes)
+    producer: dict[str, int] = {}
+    last_by_phase: dict[str, int] = {}
+    dependency_edges = memory_to_compute = compute_to_memory = 0
+    ssa_edges = loop_edges = 0
+    phases = []
+
+    for idx, node in enumerate(nodes):
+        parents: set[int] = set()
+        ssa_parents: set[int] = set()
+        for operand in node.operands:
+            if operand in producer:
+                ssa_parents.add(producer[operand])
+        parents.update(ssa_parents)
+        ssa_edges += len(ssa_parents)
+        # Conservative fallback only when no SSA parent is available.
+        if not parents:
+            if node.phase in {"cube", "vector"} and "load" in last_by_phase:
+                parents.add(last_by_phase["load"])
+            elif node.phase == "store":
+                for phase in ("cube", "vector"):
+                    if phase in last_by_phase:
+                        parents.add(last_by_phase[phase])
+        if node.op.startswith("scf.yield"):
+            loop_edges += len(parents)
+        parent_depth = max((nodes[p].depth for p in parents), default=0.0)
+        node.depth = parent_depth + node.cost
+        for parent in sorted(parents):
+            nodes[parent].users.append(idx)
+            if nodes[parent].phase in {"load", "store"} and node.phase in {"cube", "vector"}:
+                memory_to_compute += 1
+            if nodes[parent].phase in {"cube", "vector"} and node.phase in {"load", "store"}:
+                compute_to_memory += 1
+        dependency_edges += len(parents)
+        for result in node.results:
+            producer[result] = idx
+        last_by_phase[node.phase] = idx
+        if not phases or phases[-1] != node.phase:
+            phases.append(node.phase)
+
+    critical = max(1.0, max(n.depth for n in nodes))
+    total_work = sum(max(0.05, n.cost) for n in nodes)
+    parallelism = max(1.0, total_work / critical)
+    return TTIRDAGReport(
+        nodes=nodes,
+        cube_ops=int(cube), vector_ops=int(vec), memory_ops=int(mem),
+        critical_path=float(critical), parallelism=float(parallelism),
+        dependency_edges=int(dependency_edges), phase_count=len(phases),
+        memory_to_compute_edges=int(memory_to_compute),
+        compute_to_memory_edges=int(compute_to_memory),
+        ssa_edges=int(ssa_edges), loop_carried_edges=int(loop_edges),
+    )
diff --git a/third_party/ascend/backend/runtime/ttir_kernel_template.py b/third_party/ascend/backend/runtime/ttir_kernel_template.py
