+def _rank_rows_source_pp(operator, case, official_cfgs, rows, args, *, ttir_anchor_records=None,
+                         enable_program_workload=True, enable_ttir_anchor=False):
+    """V6.8 ranking wrapper: V6.7 Source + compile-free per-program workload + optional paid-already TTIR anchors."""
+    import fresh_end_to_end_value_eval as helper
+    from backend.runtime.search_space_v6 import infer_search_space
+    from backend.runtime.generic_source_rank_v6 import rank_rows_generic
+
+    all_args, opts = helper._local_case_expansion_spec(operator, dict(case), args)
+    # These are structural/runtime semantics only.  No candidate latency label is
+    # injected into the Source prior.
+    opts = dict(opts)
+    opts["enable_source_program_workload_v68"] = bool(enable_program_workload)
+    opts["source_program_workload_weight_v68"] = float(getattr(args, "source_program_workload_weight", 1.10))
+    opts["enable_ttir_anchor_refinement_v68"] = bool(enable_ttir_anchor and ttir_anchor_records)
+    opts["ttir_anchor_records"] = list(ttir_anchor_records or ())
+    opts["ttir_anchor_weight_v68"] = float(getattr(args, "ttir_anchor_weight", 0.60))
+    opts["ttir_anchor_max_neighbors"] = int(getattr(args, "ttir_anchor_max_neighbors", 3))
+    opts["ttir_anchor_distance_scale"] = float(getattr(args, "ttir_anchor_distance_scale", 0.35))
+
+    spec = infer_search_space(
+        official_cfgs, [r["config"] for r in rows],
+        parameter_domains=opts.get("parameter_domains"),
+        tunable_parameters=opts.get("tunable_parameter"),
+        split_params=opts.get("split_params"),
+        tiling_params=opts.get("tiling_params"),
+        reduction_axes=opts.get("reduction_axes"),
+    )
+    ranked, provenance = rank_rows_generic(rows, search_space=spec, all_args=all_args, options=opts)
+    return ranked, spec, provenance, all_args, opts
+
+
+def _persist_ttir_anchor_records(records, out_dir: Path):
+    """Persist captured TTIR outside result JSON; return small path-based anchor records."""
+    import hashlib
+    out_dir.mkdir(parents=True, exist_ok=True)
+    saved = []
+    for rec in records or ():
+        cfg = dict(rec.get("config") or {})
+        ttir = rec.get("ttir")
+        if not isinstance(ttir, str) or not ttir.strip():
+            continue
+        sig = repr(_cfg_sig(cfg)).encode("utf-8")
+        stem = hashlib.sha256(sig).hexdigest()[:16]
+        path = out_dir / f"anchor_{stem}.ttir"
+        path.write_text(ttir, encoding="utf-8")
+        saved.append({
+            "config": cfg,
+            "ttir_path": str(path),
+            "ttir_sha256": hashlib.sha256(ttir.encode("utf-8")).hexdigest(),
+            "captured_from_already_paid_native_compile": True,
+        })
+    return saved
+
