+#!/usr/bin/env python3
+"""V6.3 generic near-optimal search harness for the two calibration operators.
+
+V6.3 replaces per-candidate first-launch JIT with small adaptive batches that
+reuse native AutoTiling parallel compile.  Hardware observations still update
+the controller between batches, while a relative-to-Official wall budget keeps
+compile cost bounded for production experiments.
+
+The *search engine* is operator-agnostic and lives under backend/runtime.  This
+file is only a runtime adapter for the existing FA/chunk regression cases.
+All handwritten repository operators use the same engine through
+run_handwritten_v6.py.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import shutil
+import statistics
+import sys
+import time
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+HERE = Path(__file__).resolve().parent
+EXP = HERE.parent
+CAL = EXP / "vtriton_new_ops_calibration"
+for p in (HERE, CAL):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+from native_autotune_v53 import (  # noqa: E402
+    _cfg_sig,
+    _native_tune,
+    _paths_overlap,
+    _prepare_once,
+    _static_filter_rows,
+    add_expansion_args,
+    write_json,
+)
+
+
+def _generation_cache_key(*, source: Path, operator: str, case: Mapping[str, Any], expansion_options: Mapping[str, Any]) -> str:
+    """Deterministic label-free cache key for model-free S1/S2/S3 generation."""
+    payload = {
+        "schema": "candidate_generation_v6_v1",
+        "operator": str(operator),
+        "case": dict(case),
+        "source_sha256": hashlib.sha256(Path(source).read_bytes()).hexdigest(),
+        "expansion_options": {str(k): v for k, v in dict(expansion_options).items() if not str(k).startswith("_")},
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":"), default=str).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _load_or_build_generation_pool(*, helper, repo: Path, source: Path, operator: str, case: Mapping[str, Any], args):
+    ns = helper.expansion_namespace(args)
+    opts = dict(vars(ns)) if hasattr(ns, "__dict__") else {}
+    cache_root = getattr(args, "generation_cache_dir", None)
+    if cache_root is None:
+        t0 = time.perf_counter(); pool, meta = helper.build_model_free_pool(repo, operator, case, ns)
+        return pool, meta, time.perf_counter() - t0, False, None
+    root = Path(cache_root).resolve(); root.mkdir(parents=True, exist_ok=True)
+    key = _generation_cache_key(source=source, operator=operator, case=case, expansion_options=opts)
+    path = root / f"{key}.json"
+    if path.is_file():
+        t0 = time.perf_counter(); j = json.loads(path.read_text(encoding="utf-8"))
+        if j.get("schema_version") == "candidate_generation_v6_cache_v1":
+            return list(j["pool"]), dict(j["pool_meta"]), time.perf_counter() - t0, True, str(path)
+    t0 = time.perf_counter(); pool, meta = helper.build_model_free_pool(repo, operator, case, ns); wall = time.perf_counter() - t0
+    write_json(path, {
+        "schema_version": "candidate_generation_v6_cache_v1",
+        "hardware_performance_labels_stored": False,
+        "msprof_labels_stored": False,
+        "pool": pool, "pool_meta": meta,
+    })
+    return pool, meta, wall, False, str(path)
+
+
+def _event_batch_ms(di, fn, launches: int) -> float:
+    start = di.Event(enable_timing=True); end = di.Event(enable_timing=True)
+    start.record()
+    for _ in range(max(1, int(launches))):
+        fn()
+    end.record(); di.synchronize()
+    return float(start.elapsed_time(end))
+
+
+def _clean_state(operator: str, tensors: Mapping[str, Any], torch):
+    st = dict(tensors)
+    st["o"] = torch.empty_like(tensors["o"])
+    if operator == "flash_attention_npu_v8":
+        st["l"] = torch.empty_like(tensors["l"])
+    return st
+
+
+def _check_output(out, ref, *, dtype: str, torch) -> dict[str, Any]:
+    tol = 4e-2 if dtype == "bfloat16" else 2e-2
+    finite = bool(torch.isfinite(out).all().item())
+    ok = finite and bool(torch.allclose(out, ref, atol=tol, rtol=tol, equal_nan=False))
+    max_abs = float((out.float() - ref.float()).abs().max().item()) if finite else float("inf")
+    return {"finite": finite, "allclose": ok, "max_abs_error": max_abs, "atol": tol, "rtol": tol}
+
+
+def _compile_validate_one(*, operator, case, module, tensors, ref, torch, cfg):
+    """Compile/launch one candidate once on a clean output state.
+
+    This replaces repeated one-config AutoTilingTuner construction.  The first
+    JIT launch naturally includes compile cost in the measured wall time.
+    """
+    import triton
+    from operator_adapters import launch
+
+    st = _clean_state(operator, tensors, torch)
+    t0 = time.perf_counter()
+    try:
+        out = launch(operator, module, dict(case), dict(cfg), st)
+        triton.runtime.driver.active.get_device_interface().synchronize()
+        wall = time.perf_counter() - t0
+        corr = _check_output(out, ref, dtype=case["dtype"], torch=torch)
+        err = None
+    except Exception as exc:
+        wall = time.perf_counter() - t0
+        corr = {"finite": False, "allclose": False, "max_abs_error": float("inf")}
+        err = f"{type(exc).__name__}: {exc}"
+    return {"config": dict(cfg), "compile_first_launch_wall_s": wall, "correctness": corr, "error": err, "state": st}
+
+
+def _make_fn(operator, case, module, cfg, state):
+    from operator_adapters import launch
+    return lambda: launch(operator, module, dict(case), dict(cfg), state)
+
+
+def _measure_one(*, operator, case, module, cfg, state, target_ms, probe_launches, max_launches, rounds):
+    import triton
+    di = triton.runtime.driver.active.get_device_interface()
+    fn = _make_fn(operator, case, module, cfg, state)
+    probes = [_event_batch_ms(di, fn, probe_launches) / max(1, probe_launches) for _ in range(2)]
+    est = max(1e-6, statistics.median(probes))
+    launches = min(max(1, int(math.ceil(max(1.0, float(target_ms)) / est))), max(1, int(max_launches)))
+    vals = [_event_batch_ms(di, fn, launches) / launches for _ in range(max(1, int(rounds)))]
+    return {"estimate_ms": est, "launches": launches, "samples_ms": vals, "median_ms": statistics.median(vals)}
+
+
+def _pair_race(*, operator, case, module, tensors, ref, torch, incumbent_cfg, candidate_cfg,
+               target_ms=10.0, probe_launches=8, max_launches=4096, rounds=3,
+               min_signal_to_noise=2.0, min_absolute_gain_pct=0.10):
+    """Compare only incumbent vs new candidate; no historical re-racing."""
+    import triton
+    di = triton.runtime.driver.active.get_device_interface()
+    states = {}
+    validation = {}
+    for label, cfg in (("incumbent", incumbent_cfg), ("candidate", candidate_cfg)):
+        st = _clean_state(operator, tensors, torch)
+        try:
+            out = _make_fn(operator, case, module, cfg, st)()
+            di.synchronize()
+            corr = _check_output(out, ref, dtype=case["dtype"], torch=torch)
+        except Exception as exc:
+            corr = {"finite": False, "allclose": False, "max_abs_error": float("inf"), "error": f"{type(exc).__name__}: {exc}"}
+        validation[label] = corr; states[label] = st
+    if not validation["incumbent"].get("allclose"):
+        raise RuntimeError(f"incumbent lost correctness during V6 pair race: {validation}")
+    if not validation["candidate"].get("allclose"):
+        return {"accepted": False, "candidate_valid": False, "validation": validation, "reason": "candidate_correctness_failed"}
+
+    fns = {
+        "incumbent": _make_fn(operator, case, module, incumbent_cfg, states["incumbent"]),
+        "candidate": _make_fn(operator, case, module, candidate_cfg, states["candidate"]),
+    }
+    probe = {}
+    for label, fn in fns.items():
+        probe[label] = statistics.median([
+            _event_batch_ms(di, fn, probe_launches) / max(1, probe_launches) for _ in range(2)
+        ])
+    fastest = max(1e-6, min(probe.values()))
+    launches = min(max(1, int(math.ceil(max(1.0, float(target_ms)) / fastest))), max(1, int(max_launches)))
+    samples = {"incumbent": [], "candidate": []}
+    for r in range(max(1, int(rounds))):
+        order = ("incumbent", "candidate") if r % 2 == 0 else ("candidate", "incumbent")
+        for label in order:
+            samples[label].append(_event_batch_ms(di, fns[label], launches) / launches)
+    med = {k: statistics.median(v) for k, v in samples.items()}
+    mad = {k: statistics.median([abs(x - med[k]) for x in v]) if len(v) > 1 else 0.0 for k, v in samples.items()}
+    gain = (med["incumbent"] - med["candidate"]) / max(med["incumbent"], 1e-12) * 100.0
+    noise_pct = (float(min_signal_to_noise) * (mad["incumbent"] + mad["candidate"]) / max(med["incumbent"], 1e-12) * 100.0)
+    required = max(float(min_absolute_gain_pct), noise_pct)
+    accepted = gain > required
+    return {
+        "accepted": accepted,
+        "candidate_valid": True,
+        "gain_pct": gain,
+        "required_gain_pct": required,
+        "noise_margin_pct": noise_pct,
+        "launches_per_sample": launches,
+        "samples_ms": samples,
+        "median_ms": med,
+        "mad_ms": mad,
+        "validation": validation,
+        "reason": "statistically_clear_improvement" if accepted else "not_beyond_measurement_noise",
+    }
+
+
+def _release_safe_rows(*, repo: Path, operator: str, case: Mapping[str, Any], rows, registry_path: Path, campaign_id: str, limit: int):
+    """Resolve release-safety evidence without re-hashing invariant identity.
+
+    V6.1 also repairs compatibility with the exact V5.3 registry key shape.
+    Legacy reuse is allowed only for launch metadata equivalent to the V5.3
+    defaults; non-default warps/stages/ctas/maxnreg never inherit old SAFE.
+    """
+    from backend.runtime.safety_registry import (
+        SafetyRegistry,
+        certificate_identity,
+        certificate_payload,
+    )
+    from backend.runtime.search_space_v6 import split_config_mapping
+
+    registry = SafetyRegistry(registry_path)
+    identity = certificate_identity(repo=repo, operator=operator)
+    selected = []
+    records = []
+    counts = {
+        "safe": 0,
+        "unsafe": 0,
+        "unknown": 0,
+        "foreign_campaign": 0,
+        "legacy_v53_compat_hits": 0,
+        "current_v61_key_hits": 0,
+    }
+    t0 = time.perf_counter()
+    effective_limit = len(rows) if int(limit) <= 0 else max(1, int(limit))
+
+    for rank, row0 in enumerate(rows, 1):
+        if len(selected) >= effective_limit:
+            break
+        row = dict(row0)
+        cfg = dict(row["config"])
+        kernel_kwargs, launch_meta = split_config_mapping(cfg)
+        payload = certificate_payload(
+            repo=repo,
+            operator=operator,
+            case=case,
+            cfg=kernel_kwargs,
+            identity=identity,
+            num_warps=int(launch_meta.get("num_warps", 4)),
+            num_stages=int(launch_meta.get("num_stages", 3)),
+            num_ctas=int(launch_meta.get("num_ctas", 1)),
+            maxnreg=launch_meta.get("maxnreg"),
+        )
+        stored, key_mode = registry.lookup_compatible(payload)
+        rec = {
+            "proposal_rank": rank,
+            "config": cfg,
+            "origin_stage": row.get("origin_stage"),
+            "certificate_key_mode": key_mode,
+        }
+        if stored is None:
+            counts["unknown"] += 1
+            rec["decision"] = "skip_unknown"
+            records.append(rec)
+            continue
+
+        ev = dict(stored.get("evidence") or {})
+        status = str(stored.get("status", "")).upper()
+        if key_mode == "legacy_v53_equivalent_default_launch_meta":
+            counts["legacy_v53_compat_hits"] += 1
+        elif key_mode == "current_v61_key":
+            counts["current_v61_key_hits"] += 1
+
+        if str(ev.get("campaign_id", "")) != str(campaign_id):
+            counts["foreign_campaign"] += 1
+            rec["decision"] = "skip_foreign_campaign"
+        elif status == "SAFE":
+            counts["safe"] += 1
+            rec["decision"] = "keep_safe"
+            row["registry_scan_rank"] = rank
+            row["certificate_key_mode"] = key_mode
+            selected.append(row)
+        elif status == "UNSAFE":
+            counts["unsafe"] += 1
+            rec["decision"] = "skip_unsafe"
+        else:
+            counts["unknown"] += 1
+            rec["decision"] = "skip_unknown_status"
+        records.append(rec)
+
+    return selected, {
+        "schema_version": "candidate_value_v6_3_release_safety_lookup_v1",
+        "selected_safe": len(selected),
+        "input_proposal_count": len(rows),
+        "counts": counts,
+        "records": records,
+        "lookup_wall_s": time.perf_counter() - t0,
+        "identity_precomputed_once": True,
+        "v53_key_compatibility_enabled": True,
+        "v53_compatibility_requires_default_launch_meta": True,
+        "candidate_performance_labels_used": False,
+        "destructive_runtime_probe_used": False,
+    }
+
+
+def _rank_rows_generic(operator, case, official_cfgs, rows, args):
+    import fresh_end_to_end_value_eval as helper
+    from backend.runtime.search_space_v6 import infer_search_space
+    from backend.runtime.generic_source_rank_v6 import rank_rows_generic
+
+    all_args, opts = helper._local_case_expansion_spec(operator, dict(case), args)
+    # V6 uses the same explicit finite domains already declared for model-free
+    # expansion.  No parameter-name table exists inside the search policy.
+    spec = infer_search_space(
+        official_cfgs,
+        [r["config"] for r in rows],
+        parameter_domains=opts.get("parameter_domains"),
+        tunable_parameters=opts.get("tunable_parameter"),
+        split_params=opts.get("split_params"),
+        tiling_params=opts.get("tiling_params"),
+        reduction_axes=opts.get("reduction_axes"),
+    )
+    ranked, provenance = rank_rows_generic(rows, search_space=spec, all_args=all_args, options=opts)
+    return ranked, spec, provenance, all_args, opts
+
+
+def _digest(rows):
+    raw = json.dumps([dict(r["config"]) for r in rows], sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _native_timing_map(batch_result: Mapping[str, Any]) -> dict[tuple, float]:
+    out: dict[tuple, float] = {}
+    for rec in list((batch_result.get("native") or {}).get("final_timings") or []):
+        cfg = dict(rec.get("config") or {})
+        try:
+            out[_cfg_sig(cfg)] = float(rec.get("median_ms"))
+        except Exception:
+            continue
+    return out
+
+
+def _extra_wall_components(*, expansion_wall: float, static_wall: float, rank_wall: float, registry_wall: float,
+                           b0_seed_wall: float, batch_native_wall: float, batch_validation_wall: float,
+                           pair_race_wall: float) -> float:
+    return float(expansion_wall + static_wall + rank_wall + registry_wall + b0_seed_wall
+                 + batch_native_wall + batch_validation_wall + pair_race_wall)
+
+
+def _initial_candidate_cost_estimate_s(*, b0_native: Mapping[str, Any], b0_native_wall_s: float, official_count: int) -> float:
+    """Conservative all-in per-candidate cost seed from the current Official run.
+
+    V6.2 could only discover a batch overshoot after it happened.  V6.3 uses the
+    same-case Official native autotune as a label-free *cost* observation (never
+    a candidate performance score) to decide whether another batch fits the
+    production overhead budget.
+    """
+    n = max(1, int(official_count))
+    meta = dict((b0_native or {}).get("native") or {})
+    phase = float(meta.get("compile_time_s", 0.0) or 0.0) + float(meta.get("measure_time_s", 0.0) or 0.0)
+    wall = max(0.0, float(b0_native_wall_s))
+    # Prefer the larger observed all-in estimate. This intentionally errs on the
+    # side of not starting a batch that is likely to blow the relative budget.
+    return max(1e-3, phase / n, wall / n)
+
+
+def _update_candidate_cost_ewma(previous_s: float, *, batch_wall_s: float, novel_count: int, alpha: float) -> float:
+    if novel_count <= 0 or batch_wall_s <= 0:
+        return max(1e-3, float(previous_s))
+    obs = float(batch_wall_s) / max(1, int(novel_count))
+    a = min(1.0, max(0.0, float(alpha)))
+    return max(1e-3, a * obs + (1.0 - a) * max(1e-3, float(previous_s)))
+
+
+def _budgeted_batch_size(*, max_batch_size: int, remaining_novel: int, remaining_extra_s: float,
+                         estimated_candidate_s: float, safety_factor: float) -> int:
+    cap = min(max(0, int(max_batch_size)), max(0, int(remaining_novel)))
+    if cap <= 0:
+        return 0
+    if math.isinf(float(remaining_extra_s)):
+        return cap
+    if remaining_extra_s <= 0:
+        return 0
+    conservative_one = max(1e-6, float(estimated_candidate_s)) * max(1.0, float(safety_factor))
+    affordable = int(math.floor(float(remaining_extra_s) / conservative_one + 1e-12))
+    return max(0, min(cap, affordable))
+
+
+def run(args: argparse.Namespace) -> dict[str, Any]:
+    repo = args.repo.resolve(); out = args.output_dir.resolve(); out.mkdir(parents=True, exist_ok=True)
+    cache = args.cache_dir.resolve()
+    if args.reset_cache and cache.exists(): shutil.rmtree(cache)
+    cache.mkdir(parents=True, exist_ok=True)
+    os.environ["TRITON_CACHE_DIR"] = str(cache)
+    os.environ["TRITON_DUMP_DIR"] = str(out / "triton_dump")
+    os.environ.setdefault("TRITON_AUTOTUNE_PARALLEL_COMPILE", "1")
+
+    import fresh_end_to_end_value_eval as helper
+    from cases import get_cases
+    from backend.runtime.precompile_selection_v6 import build_v6_proposal_queue
+    from backend.runtime.near_optimal_search_v6 import NearOptimalController, finalize_declared_domain_status
+    from backend.runtime.search_space_v6 import materialize_discrete_domain
+
+    case = dict(get_cases(args.operator)[args.case_index])
+    process0 = time.perf_counter()
+    og0 = time.perf_counter(); official_rows = helper.official_pool(args.operator); official_generation_wall = time.perf_counter() - og0
+    official_cfgs = [dict(r["config"]) for r in official_rows]
+    official_sigs = {_cfg_sig(c) for c in official_cfgs}
+
+    # Tensor/reference setup stays outside autotune_core as in V5.x A/B.
+    torch, module, tensors, ref, source, setup_wall = _prepare_once(repo, args.operator, case, official_cfgs[0])
+
+    # B0 is benchmarked exactly once through the real Official native path.
+    # Final V6 redundantly re-raced all B0 configs afterwards; that changed the
+    # baseline semantics and added fixed overhead even when no novel candidate
+    # was release-safe.  V6.1 uses the correctness-replayed native winner as
+    # the immutable B0 guard.  A stable Event seed is measured only if there is
+    # at least one SAFE novel candidate to compare against.
+    b0_native = _native_tune(
+        operator=args.operator, case=case, module=module, tensors=tensors,
+        ref=ref, torch=torch, selected_cfgs=official_cfgs,
+    )
+    b0_native_wall = float(b0_native["native"]["native_autotune_plus_winner_validation_wall_s"])
+    incumbent_cfg = dict(b0_native["winner"]["config"])
+    incumbent_ms = None
+    original_b0_ms = None
+    b0_seed = None
+    b0_seed_wall = 0.0
+
