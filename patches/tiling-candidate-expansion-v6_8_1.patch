index 000000000..f3853c696
--- /dev/null
+++ b/third_party/ascend/backend/runtime/ttir_kernel_template.py
@@ -0,0 +1,243 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""TTIR template extraction and structural-family cache keys.
+
+Correctness rule: two configs may share a template only when every compile-time
+parameter that can change IR topology or concrete tensor shapes is identical.
+Parameters are excluded from the key only through the explicit
+``light_template_parameters`` option.  The default is therefore conservative:
+all config kwargs are structural.  Providers with genuinely symbolic templates
+may opt in to numeric instantiation for selected parameters.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import subprocess
+import tempfile
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any, Callable, Dict, Mapping, MutableMapping, Sequence, Tuple
+
+from .model_context import model_context_signature
+
+
+@dataclass(frozen=True)
+class KernelTemplate:
+    family_key: Tuple[Any, ...]
+    ttir_sha256: str
+    extractor: str
+    grid_axes: Tuple[int, ...]
+    persistent_loop_count: int
+    tensor_ptr_shapes: Tuple[Tuple[int, ...], ...]
+    operation_counts: Mapping[str, int]
+    has_dot: bool
+    has_reduce: bool
+    has_exp: bool
+    has_load: bool
+    has_store: bool
+    has_atomic: bool
+    unknown_tt_ops: Tuple[str, ...]
+    confidence: float
+    ttir_text: str = ""
+    # Parameters whose concrete values have been removed from the template and
+    # are safe to instantiate numerically.  Empty for ordinary compiled TTIR.
+    symbolic_parameters: Tuple[str, ...] = ()
+
+    def to_dict(self) -> Dict[str, Any]:
+        value = asdict(self)
+        value["operation_counts"] = dict(self.operation_counts)
+        return value
+
+
+# Capture registered and common MLIR dialect operations, not only tt.*.
+_MLIR_OP = re.compile(r'(?:(?:%[A-Za-z0-9_.$-]+(?:\s*,\s*%[A-Za-z0-9_.$-]+)*)\s*=\s*)?"?([A-Za-z_][A-Za-z0-9_]*\.[A-Za-z0-9_.$-]+)"?')
+_PID_AXIS = re.compile(r"tt\.get_program_id[^\n]*axis\s*=\s*([0-9]+)")
+_TENSOR_SHAPE = re.compile(r"tensor<((?:[0-9?]+x)+)[^>]+>")
+_KNOWN_PREFIXES = (
+    "tt.", "arith.", "math.", "scf.", "cf.", "tensor.", "builtin.",
+    "triton_gpu.", "ttg.", "gpu.", "llvm.", "func.",
+)
+
+
+def _operation_counts(ttir_text: str) -> Dict[str, int]:
+    counts: Dict[str, int] = {}
+    for line in ttir_text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("//"):
+            continue
+        for match in _MLIR_OP.finditer(stripped):
+            op = match.group(1)
+            counts[op] = counts.get(op, 0) + 1
+    return counts
+
+
+def _text_extract(ttir_text: str) -> Dict[str, Any]:
+    ops = _operation_counts(ttir_text)
+    axes = tuple(sorted({int(v) for v in _PID_AXIS.findall(ttir_text)}))
+    shapes = []
+    for raw in _TENSOR_SHAPE.findall(ttir_text):
+        dims = tuple(int(v) for v in raw.rstrip("x").split("x") if v.isdigit())
+        if dims:
+            shapes.append(dims)
+    persistent = sum(v for k, v in ops.items() if k.startswith("scf.for"))
+    unknown = tuple(sorted(op for op in ops if not op.startswith(_KNOWN_PREFIXES)))
+    return {
+        "grid_axes": axes,
+        "persistent_loop_count": persistent,
+        "tensor_ptr_shapes": tuple(shapes),
+        "operation_counts": ops,
+        "has_dot": any("dot" in op for op in ops),
+        "has_reduce": any("reduce" in op for op in ops),
+        "has_exp": any(op.startswith("math.exp") or ".exp" in op for op in ops),
+        "has_load": any("load" in op for op in ops),
+        "has_store": any("store" in op for op in ops),
+        "has_atomic": any("atomic" in op for op in ops),
+        "unknown_tt_ops": unknown,
+    }
+
+
+def _extract_json(stdout: str) -> Dict[str, Any]:
+    start = stdout.find("{")
+    if start < 0:
+        raise ValueError("vTriton ExtractTTIRInfo emitted no JSON")
+    depth = 0
+    for idx in range(start, len(stdout)):
+        char = stdout[idx]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return json.loads(stdout[start:idx + 1])
+    raise ValueError("vTriton ExtractTTIRInfo emitted incomplete JSON")
+
+
+def extract_kernel_template(
+    ttir_text: str,
+    family_key: Sequence[Any],
+    *,
+    tritonsim_opt: str | Path | None = None,
+    allow_text_fallback: bool = True,
+    symbolic_parameters: Sequence[str] = (),
+) -> KernelTemplate:
+    if not isinstance(ttir_text, str) or "module" not in ttir_text:
+        raise ValueError("A non-empty TTIR module string is required")
+    text_info = _text_extract(ttir_text)
+    extractor = "python_mlir_text_fallback"
+    confidence = 0.78
+    native: Dict[str, Any] | None = None
+    if tritonsim_opt:
+        binary = Path(tritonsim_opt)
+        if binary.is_file():
+            with tempfile.NamedTemporaryFile("w", suffix=".ttir.mlir", delete=False) as handle:
+                handle.write(ttir_text)
+                path = Path(handle.name)
+            try:
+                result = subprocess.run(
+                    [str(binary), str(path), "--allow-unregistered-dialect", "--extract-ttir-info"],
+                    check=True, capture_output=True, text=True,
+                )
+                native = _extract_json(result.stdout)
+                extractor = "vtriton_extract_ttir_info"
+                confidence = 0.95
+            finally:
+                path.unlink(missing_ok=True)
+        elif not allow_text_fallback:
+            raise FileNotFoundError(f"tritonsim-opt not found: {binary}")
+    elif not allow_text_fallback:
+        raise RuntimeError("tritonsim_opt is required when text fallback is disabled")
+
+    grid_axes = tuple(int(v) for v in (native or {}).get("grid_axes", text_info["grid_axes"]))
+    persistent = len((native or {}).get("persistent_loops", [])) if native else text_info["persistent_loop_count"]
+    native_shapes = (native or {}).get("tensor_ptr_shapes")
+    shapes = tuple(tuple(int(x) for x in shape) for shape in native_shapes) if native_shapes else text_info["tensor_ptr_shapes"]
+    if text_info["unknown_tt_ops"]:
+        confidence = max(0.10, confidence - min(0.25, 0.025 * len(text_info["unknown_tt_ops"])))
+    if extractor.startswith("python") and not ttir_text.strip():
+        confidence = min(confidence, 0.45)
+    return KernelTemplate(
+        family_key=tuple(family_key),
+        ttir_sha256=hashlib.sha256(ttir_text.encode("utf-8")).hexdigest(),
+        extractor=extractor,
+        grid_axes=grid_axes,
+        persistent_loop_count=int(persistent),
+        tensor_ptr_shapes=shapes,
+        operation_counts=dict(text_info["operation_counts"]),
+        has_dot=bool((native or {}).get("has_dot", text_info["has_dot"])),
+        has_reduce=bool(text_info["has_reduce"]),
+        has_exp=bool(text_info["has_exp"]),
+        has_load=bool(text_info["has_load"]),
+        has_store=bool(text_info["has_store"]),
+        has_atomic=bool(text_info["has_atomic"]),
+        unknown_tt_ops=text_info["unknown_tt_ops"],
+        confidence=confidence,
+        ttir_text=ttir_text,
+        symbolic_parameters=tuple(sorted(str(v) for v in symbolic_parameters)),
+    )
+
+
+def structural_family_key(cfg: Any, options: Mapping[str, Any]) -> Tuple[Any, ...]:
+    """Return the single canonical template/grouping key used everywhere.
+
+    By default every config kwarg is structural.  Exclusion is explicit and
+    safe only when the provider emits a shape-invariant/symbolic template.
+    ``light_structure_sensitive_parameters`` is retained as an additive legacy
+    option; it cannot make a parameter less structural.
+    """
+    kwargs = dict(getattr(cfg, "kwargs", {}) or {})
+    instantiable = {str(v) for v in options.get("light_template_parameters", ())}
+    forced = {str(v) for v in options.get("light_structure_sensitive_parameters", ())}
+    instantiable -= forced
+    structural_kwargs = tuple(sorted((k, v) for k, v in kwargs.items() if k not in instantiable))
+    return (
+        structural_kwargs,
+        getattr(cfg, "num_warps", None),
+        getattr(cfg, "num_stages", None),
+        getattr(cfg, "num_ctas", None),
+        getattr(cfg, "maxnreg", None),
+    )
+
+
+# Backward-compatible public name.
+def config_family_key(cfg: Any, options: Mapping[str, Any]) -> Tuple[Any, ...]:
+    return structural_family_key(cfg, options)
+
+
+class KernelTemplateCache:
+    """Lazily compile one representative per canonical structural family."""
+
+    def __init__(self, ir_provider: Callable[..., Mapping[str, Any]], *, tritonsim_opt=None,
+                 allow_text_fallback: bool = True):
+        self.ir_provider = ir_provider
+        self.tritonsim_opt = tritonsim_opt
+        self.allow_text_fallback = allow_text_fallback
+        self._cache: MutableMapping[Tuple[Any, ...], KernelTemplate] = {}
+        self.failures: Dict[str, str] = {}
+
+    def __call__(self, *, cfg, all_args=None, options=None) -> KernelTemplate:
+        opts = dict(options or {})
+        structural_key = structural_family_key(cfg, opts)
+        context_key = model_context_signature(all_args or {}, opts, namespace="ttir_template")
+        key = (structural_key, context_key)
+        if key in self._cache:
+            return self._cache[key]
+        try:
+            artifacts = self.ir_provider(cfg=cfg, all_args=all_args or {}, options=opts)
+            ttir = artifacts.get("ttir")
+            if not ttir:
+                raise RuntimeError(f"compiled artifact has no TTIR; available={sorted(artifacts)}")
+            template = extract_kernel_template(
+                str(ttir), structural_key, tritonsim_opt=self.tritonsim_opt,
+                allow_text_fallback=self.allow_text_fallback,
+                symbolic_parameters=tuple(opts.get("light_template_parameters", ())),
+            )
+            self._cache[key] = template
+            return template
+        except Exception as exc:
+            self.failures[repr(key)] = f"{type(exc).__name__}: {exc}"
+            raise
+
+    @property
+    def cache_size(self) -> int:
+        return len(self._cache)
