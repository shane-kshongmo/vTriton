+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Online adapters connecting Triton compilation artifacts to vTriton models."""
+from __future__ import annotations
+
+import copy
+import importlib
+import os
+import sys
+import tempfile
+import time
+import threading
+from pathlib import Path
+from typing import Any, Callable, Dict, Mapping, MutableMapping, Sequence
+
+from .model_context import (
+    config_signature as _config_signature, model_cache_key, stable_digest,
+)
+
+def _stable_digest(value: Any) -> str:
+    return stable_digest(value)
+
+
+def config_signature(cfg) -> tuple:
+    """Backward-compatible public wrapper around the shared signature."""
+    return _config_signature(cfg)
+
+def _mapping_from_object(value: Any) -> Dict[str, Any]:
+    if isinstance(value, Mapping):
+        return dict(value)
+    if hasattr(value, "to_dict") and callable(value.to_dict):
+        return dict(value.to_dict())
+    return {}
+
+
+def extract_compiled_ir(compiled: Any) -> Dict[str, Any]:
+    """Extract TTIR/NPUIR text from a Triton compiled-kernel result.
+
+    Triton versions expose artifacts under slightly different wrappers.  This
+    function intentionally checks a small set of documented/common containers
+    and returns metadata describing what was found instead of assuming one ABI.
+    """
+    seen: set[int] = set()
+    queue = [compiled]
+    result: Dict[str, Any] = {}
+    while queue:
+        obj = queue.pop(0)
+        if obj is None or id(obj) in seen:
+            continue
+        seen.add(id(obj))
+        if isinstance(obj, Mapping):
+            for key, value in obj.items():
+                lower = str(key).lower()
+                if isinstance(value, Path):
+                    value = str(value)
+                if isinstance(value, (str, bytes)):
+                    text = value.decode("utf-8", errors="replace") if isinstance(value, bytes) else value
+                    # Path-valued wrappers are common in Triton metadata. Read
+                    # them only when the key explicitly identifies an IR path.
+                    if lower.endswith("_path"):
+                        candidate = Path(text)
+                        if candidate.is_file():
+                            text = candidate.read_text(encoding="utf-8", errors="replace")
+                    if "npuir" in lower or "hivm" in lower:
+                        result.setdefault("npuir", text)
+                    elif lower.endswith("ttir") or lower == "ttir" or "ttir" in lower:
+                        result.setdefault("ttir", text)
+                elif isinstance(value, (Mapping, list, tuple)):
+                    queue.append(value)
+            continue
+        if isinstance(obj, (list, tuple)):
+            queue.extend(obj)
+            continue
+        for attr in ("asm", "artifacts", "kernel", "compiled_kernel", "module"):
+            if hasattr(obj, attr):
+                try:
+                    queue.append(getattr(obj, attr))
+                except Exception:
+                    pass
+        packed = getattr(obj, "packed_metadata", None)
+        if isinstance(packed, Mapping):
+            result.setdefault("metadata", dict(packed))
+    result["available_keys"] = sorted(k for k in result if k not in {"available_keys"})
+    return result
+
+
+class RuntimeCompiledIRProvider:
+    """Compile each Config once and expose its TTIR/NPUIR artifacts.
+
+    ``compile_callback`` must perform compile-only/warmup compilation and return
+    the compiled-kernel object.  The provider caches both compiled objects and
+    extracted IR by a shape/kernel/dtype/hardware-aware model context key, so
+    formal-model compilation is safely reused by the later benchmark cache.
+    """
+
+    def __init__(self, compile_callback: Callable[..., Any], artifact_dir: str | Path | None = None):
+        self.compile_callback = compile_callback
+        self.artifact_dir = Path(artifact_dir) if artifact_dir else None
+        self._cache: MutableMapping[tuple, Dict[str, Any]] = {}
+        self._lock = threading.RLock()
+        self.failures: Dict[str, str] = {}
+
+    def __call__(self, *, cfg, all_args=None, options=None) -> Dict[str, Any]:
+        args = all_args or {}
+        opts = options or {}
+        key = model_cache_key(cfg, args, opts, namespace="compiled_ir")
+        with self._lock:
+            if key in self._cache:
+                return dict(self._cache[key])
+        try:
+            compiled = self.compile_callback(cfg=cfg, all_args=args, options=opts)
+            artifacts = extract_compiled_ir(compiled)
+            artifacts["config_signature"] = repr(config_signature(cfg))
+            artifacts["model_cache_key"] = repr(key)
+            if self.artifact_dir:
+                self.artifact_dir.mkdir(parents=True, exist_ok=True)
+                stem = _stable_digest(key)
+                for ir_name in ("ttir", "npuir"):
+                    text = artifacts.get(ir_name)
+                    if isinstance(text, str):
+                        suffix = ".ttir.mlir" if ir_name == "ttir" else ".npuir.mlir"
+                        path = self.artifact_dir / f"{stem}{suffix}"
+                        path.write_text(text, encoding="utf-8")
+                        artifacts[f"{ir_name}_path"] = str(path)
+            with self._lock:
+                self._cache[key] = dict(artifacts)
+            return artifacts
+        except Exception as exc:
+            self.failures[repr(key)] = f"{type(exc).__name__}: {exc}"
+            raise
+
+
+def _default_grid(cfg, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> tuple[int, ...]:
+    explicit = options.get("formal_grid_dims")
+    if explicit:
+        return tuple(int(v) for v in explicit)
+    resolver = options.get("formal_grid_resolver")
+    if callable(resolver):
+        return tuple(int(v) for v in resolver(cfg=cfg, all_args=all_args, options=options))
+    family = str(options.get("operator_family", "flash_attention")).lower()
+    if family in {"flash_attention", "fa", "attention"}:
+        import math
+        kwargs = getattr(cfg, "kwargs", {})
+        bm = int(kwargs.get("BLOCK_M", kwargs.get("BM", 1)))
+        nq = int(all_args.get("MAX_Q_LEN", all_args.get("N_CTX", all_args.get("NQ", all_args.get("N", 1)))))
+        z = int(all_args.get("Z", all_args.get("BATCH", 1)))
+        h = int(all_args.get("H", all_args.get("HEADS", 1)))
+        return (max(1, math.ceil(nq / max(1, bm)) * z * h),)
+    if family in {"matmul", "matmul_bias", "cube", "cube_dominant_mix", "gemm", "linear"}:
+        import math
+        kwargs = getattr(cfg, "kwargs", {})
+        bm = int(kwargs.get("BLOCK_M", kwargs.get("BLOCK_SIZE_M", kwargs.get("BM", 1))))
+        bn = int(kwargs.get("BLOCK_N", kwargs.get("BLOCK_SIZE_N", kwargs.get("BN", 1))))
+        m = int(all_args.get("M", 1))
+        n = int(all_args.get("N", 1))
+        return (max(1, math.ceil(m / max(1, bm)) * math.ceil(n / max(1, bn))),)
+    raise ValueError("formal_grid_dims or formal_grid_resolver is required for this operator family")
+
+
+def _ensure_vtriton_import(vtriton_root: Path | None) -> None:
+    if vtriton_root:
+        root = str(vtriton_root)
+        if root not in sys.path:
+            sys.path.insert(0, root)
+
+
+class OnlineVTRITONCostModel:
+    """Run the complete vTriton NPUIR/DES/perfbound pipeline per Config.
+
+    Required runtime pieces:
+      * a RuntimeCompiledIRProvider returning ``npuir``;
+      * vTriton's Python ``perfbound`` package (vendored or external);
+      * a built ``tritonsim-hivm`` executable.
+
+    Missing formal artifacts are errors by default.  Set
+    ``formal_failure_policy='inf'`` only for exploratory runs where failed
+    formal candidates should receive infinite cost instead of aborting.
+    """
+
+    def __init__(
+        self,
+        ir_provider: Callable[..., Mapping[str, Any]],
+        *,
+        vtriton_root: str | Path | None = None,
+        tritonsim_hivm: str | Path | None = None,
+        hardware_config: str | Path | None = None,
+        calibration: str | Path | None = None,
+        artifact_dir: str | Path | None = None,
+        failure_policy: str = "raise",
+    ):
+        self.ir_provider = ir_provider
+        vendor_root = Path(__file__).resolve().parent / "vtriton_vendor"
+        self.vtriton_root = Path(vtriton_root) if vtriton_root else vendor_root
+        default_hivm = vendor_root / "build" / "bin" / "tritonsim-hivm"
+        default_hw = vendor_root / "source" / "configs" / "ascend_910b3_v4.json"
+        default_calib = vendor_root / "perfbound" / "calibration" / "data" / "calib_910b3_v1.json"
+        self.tritonsim_hivm = Path(tritonsim_hivm) if tritonsim_hivm else default_hivm
+        self.hardware_config = Path(hardware_config) if hardware_config else default_hw
+        self.calibration = Path(calibration) if calibration else default_calib
+        self.artifact_dir = Path(artifact_dir) if artifact_dir else None
+        self.failure_policy = str(failure_policy)
+        self._cache: MutableMapping[tuple, Dict[str, Any]] = {}
+        self.failures: Dict[str, str] = {}
+        self._lock = threading.RLock()
+        self._report_from_npuir = None
+        self._report_from_desgraph = None
+        self._load_calibration = None
+        self._calibration_db = None
+
+    def _load_api(self):
+        # Always prefer the source snapshot embedded in this repository.
+        # An explicit vtriton_root is still supported for controlled A/B tests.
+        _ensure_vtriton_import(self.vtriton_root)
+        run_report = importlib.import_module("perfbound.combine.run_report")
+        calib_loader = importlib.import_module("perfbound.calibration.calib_loader")
+        return run_report.report_from_npuir, run_report.report_from_desgraph, calib_loader.load_calibration
+
+    def _ensure_runtime(self):
+        if self._report_from_npuir is None:
+            self._report_from_npuir, self._report_from_desgraph, self._load_calibration = self._load_api()
+            self._calibration_db = self._load_calibration(self.calibration) if self.calibration else None
+
+    def __call__(self, *, cfg, all_args=None, options=None) -> Dict[str, Any]:
+        opts = options if options is not None else {}
+        args = all_args if all_args is not None else {}
+        runtime_identity = {
+            "vtriton_root": str(self.vtriton_root),
+            "tritonsim_hivm": str(self.tritonsim_hivm),
+            "hardware_config": str(self.hardware_config),
+            "calibration": str(self.calibration) if self.calibration else None,
+            "failure_policy": self.failure_policy,
+        }
+        key_options = dict(opts)
+        key_options["formal_runtime_identity"] = runtime_identity
+        key = model_cache_key(cfg, args, key_options, namespace="online_vtriton")
+        with self._lock:
+            if key in self._cache:
+                return dict(self._cache[key])
+        try:
+            if not self.tritonsim_hivm.is_file():
+                raise FileNotFoundError(f"vTriton tritonsim-hivm not found: {self.tritonsim_hivm}")
+            artifacts = self.ir_provider(cfg=cfg, all_args=args, options=opts)
+            npuir_text = artifacts.get("npuir")
+            npuir_path = artifacts.get("npuir_path")
+            if not npuir_path:
+                if not isinstance(npuir_text, str) or not npuir_text.strip():
+                    raise RuntimeError(
+                        "Compiled Config did not expose NPUIR. Configure the Triton build to retain "
+                        f"NPU IR artifacts; available={artifacts.get('available_keys', [])}"
+                    )
+                output_root = self.artifact_dir or Path(tempfile.gettempdir()) / "vtriton_autotune"
+                output_root.mkdir(parents=True, exist_ok=True)
+                npuir_file = output_root / f"{_stable_digest(key)}.npuir.mlir"
+                npuir_file.write_text(npuir_text, encoding="utf-8")
+                npuir_path = str(npuir_file)
+            self._ensure_runtime()
+            grid = _default_grid(cfg, args, opts)
+            des_path = None
+            if self.artifact_dir:
+                self.artifact_dir.mkdir(parents=True, exist_ok=True)
+                des_path = self.artifact_dir / f"{_stable_digest(key)}.des.json"
+            common = dict(
+                grid_dims=grid, calib_db=self._calibration_db,
+                n_cores=int(opts.get("num_cores", 20)),
+                occupancy=float(opts.get("formal_occupancy", 1.0)),
+                load_balance=float(opts.get("formal_load_balance", 1.0)),
+                kernel_name=str(opts.get("formal_kernel_name", "autotune_candidate")),
+                calibration_source=str(self.calibration) if self.calibration else None,
+            )
+            t_formal = time.perf_counter()
+            des_cache_hit = bool(des_path and des_path.is_file() and des_path.stat().st_size > 0)
+            if des_cache_hit:
+                report = self._report_from_desgraph(des_json=des_path, **common)
+            else:
+                report = self._report_from_npuir(
+                    npuir_path=npuir_path, hardware_config=self.hardware_config,
+                    tritonsim_hivm=str(self.tritonsim_hivm), des_json_path=des_path, **common)
+            formal_total_s = time.perf_counter() - t_formal
+            value = _mapping_from_object(report)
+            t_bound = float(value["t_bound_us"])
+            # S3 ranking score: t_bound is a conservative lower bound, so a
+            # smaller bound does NOT imply a faster kernel — configs with more
+            # unmodelled serial gaps simply get a lower (optimistic) bound.
+            # Add a conservatism penalty proportional to the serial-irreducible
+            # residual (the portion of T_bound not covered by Tier-1/Tier-2
+            # roofline floors) to counter the systematic bias towards configs
+            # the model "knows less about".  See STRICT_AUDIT_20260713.md and
+            # vtriton_vendor/source/README.md §"attainable headroom".
+            serial_us = float(value.get("t_serial_irreducible_us", 0.0) or 0.0)
+            grid_floor_us = float(value.get("t_grid_floor_us", 0.0) or 0.0)
+            core_floor_us = float(value.get("t_core_floor_us", 0.0) or 0.0)
+            roofline_floor_us = max(grid_floor_us, core_floor_us)
+            # residual = bound - roofline_floor is the part only serial-gap
+            # analysis could account for; penalise it because it carries the
+            # largest model uncertainty.
+            residual_us = max(0.0, t_bound - roofline_floor_us)
+            serial_penalty_weight = float(opts.get(
+                "formal_serial_penalty_weight", 0.5))
+            # binding_tier == "tier3" means the bound is set by serial-only
+            # analysis (no roofline floor is binding) — least trustworthy.
+            binding_tier = str(value.get("binding_tier", "") or "")
+            tier_penalty = float(opts.get(
+                "formal_tier3_penalty_us", 0.0)) if binding_tier.lower() == "tier3" else 0.0
+            ranking_score = t_bound + serial_penalty_weight * residual_us + tier_penalty
+            value.update({
+                "score": ranking_score,
+                "formal_time": t_bound,
+                "formal_time_us": t_bound,
+                "formal_ranking_score": ranking_score,
+                "formal_residual_us": residual_us,
+                "formal_serial_penalty_us": serial_penalty_weight * residual_us,
+                "formal_tier_penalty_us": tier_penalty,
+                "serial_time": serial_us,
+                "grid_time": grid_floor_us,
+                "core_time": core_floor_us,
+                "binding_component": value.get("binding_component"),
+                "binding_tier": value.get("binding_tier"),
+                "model_kind": "embedded_vtriton_npuir_hivm_perfbound",
+                "grid_dims": list(grid),
+                "npuir_path": str(npuir_path),
+                "des_json_path": str(des_path) if des_path else None,
+                "formal_des_cache_hit": des_cache_hit,
+                "formal_total_s": formal_total_s,
+            })
+            with self._lock:
+                self._cache[key] = dict(value)
+            return value
+        except Exception as exc:
+            message = f"{type(exc).__name__}: {exc}"
+            self.failures[repr(key)] = message
+            if self.failure_policy == "inf":
+                return {"score": float("inf"), "model_kind": "online_vtriton_failed", "error": message}
+            raise
+
+
+def make_online_vtriton_cost_model(ir_provider, **kwargs):
+    return OnlineVTRITONCostModel(ir_provider, **kwargs)
