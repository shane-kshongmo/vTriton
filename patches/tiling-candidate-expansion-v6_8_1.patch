+
+
+def _reserved_hint_keys():
+    tree = ast.parse(AUTOTUNER.read_text())
+    for node in tree.body:
+        if isinstance(node, ast.Assign):
+            for target in node.targets:
+                if isinstance(target, ast.Name) and target.id == "_RESERVED_HINT_KEYS":
+                    return set(ast.literal_eval(node.value))
+    raise AssertionError("_RESERVED_HINT_KEYS not found")
+
+
+def test_v681_capture_compiled_ir_is_runtime_reserved_hint():
+    keys = _reserved_hint_keys()
+    assert "capture_compiled_ir" in keys
