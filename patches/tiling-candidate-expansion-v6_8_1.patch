+"""Light TTIR guided candidate expansion policy.
+
+Uses Light TTIR execution features to bias S1/S2 search directions.
+It does not replace the formal TTIR model used by S3.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, Mapping, Sequence
+
+
+def expansion_guidance(report) -> Dict[str, Any]:
+    if report is None:
+        return {"preferred": "balanced", "axis": {}}
+    axis = {}
+    bottleneck = str(getattr(report, "bottleneck", "unknown"))
+    if bottleneck.lower() in {"memory", "mte", "memory_bound"}:
+        axis.update({"BLOCK_M": "increase", "BLOCK_N": "increase", "BM": "increase", "BN": "increase"})
+    elif bottleneck.lower() in {"compute", "cube", "compute_bound"}:
+        axis.update({"BLOCK_K": "increase", "BK": "increase"})
+    if float(getattr(report, "ub_utilization", 0.0)) > 0.85:
+        axis.update({"BLOCK_M": "decrease", "BLOCK_N": "decrease", "BM": "decrease", "BN": "decrease"})
+    if float(getattr(report, "active_program_ratio", 1.0)) < 0.5:
+        axis.update({"BLOCK_M": "decrease", "BLOCK_N": "decrease", "BM": "decrease", "BN": "decrease"})
+    return {"preferred": bottleneck, "axis": axis}
+
+
+def filter_values(values: Sequence[int], current: int, direction: str | None):
+    if direction == "increase":
+        return [v for v in values if v > current]
+    if direction == "decrease":
+        return [v for v in values if v < current]
+    return list(values)
