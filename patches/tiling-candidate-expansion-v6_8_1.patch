+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Compile-free per-program/core workload view for Source++ V6.8.
+
+This module distils the useful *execution semantics* of the Full-vTriton WB1/WB3
+workload model into the source/runtime side without materialising TTIR/HIVM/DES.
+It reconstructs output tiles, tail-weighted task costs and round-robin core
+ownership from SearchSpaceSpec + runtime axis extents.  The result is ordinal:
+it is a ranking view, not a latency prediction.
+"""
+from __future__ import annotations
+
+import itertools
+import math
+import statistics
+from typing import Any, Mapping, Sequence
+
+from .search_space_v6 import SearchSpaceSpec, config_signature
+from .source_motif_deca import infer_source_motif
+
+
+def _extent(axis_name: str, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> int | None:
+    p2a = {str(k): str(v) for k, v in dict(options.get("parameter_to_axis", {}) or {}).items()}
+    sizes = dict(options.get("axis_sizes", {}) or {})
+    axis = p2a.get(axis_name)
+    if axis in sizes:
+        try:
+            return max(1, int(sizes[axis]))
+        except Exception:
+            pass
+    u = axis_name.upper()
+    candidates: tuple[str, ...] = ()
+    if u.endswith("_M") or u in {"BM", "BLOCK_M", "BLOCK_SIZE_M", "XBLOCK", "X0BLOCK"}:
+        candidates = ("M", "m", "MAX_Q_LEN", "N_CTX", "X", "xnumel", "n_rows")
+    elif u.endswith("_N") or u in {"BN", "BLOCK_N", "BLOCK_SIZE_N", "YBLOCK"}:
+        candidates = ("N", "n", "MAX_K_LEN", "N_CTX", "Y", "n_cols")
+    elif u.endswith("_K") or u in {"BK", "BLOCK_K", "BLOCK_SIZE_K", "RBLOCK", "RBLOCK_SIZE", "R1BLOCK_SUB"}:
+        candidates = ("K", "k", "HEAD_DIM", "QK_DIM", "R", "rnumel")
+    elif "BLOCK_SIZE" in u or u.endswith("BLOCK") or u.endswith("BLOCK_SUB"):
+        candidates = ("N", "n_elements", "numel", "n_cols", "X", "xnumel", "R", "rnumel")
+    for name in candidates:
+        if name in all_args:
+            try:
+                return max(1, int(all_args[name]))
+            except Exception:
+                pass
+    return None
+
+
+def _role_map(spec: SearchSpaceSpec, options: Mapping[str, Any]) -> dict[str, str]:
+    meta = infer_source_motif(spec, options=options)
+    return {str(k): str(v) for k, v in dict(meta.get("axis_roles", {}) or {}).items()}
+
+
+def _tile_valid_fractions(extent: int, tile: float) -> list[float]:
+    t = max(1, int(round(float(tile))))
+    n = max(1, int(math.ceil(extent / t)))
+    out = []
+    for i in range(n):
+        valid = max(0, min(t, extent - i * t))
+        out.append(valid / float(t))
+    return out or [1.0]
+
+
+def _gini(values: Sequence[float]) -> float:
+    vals = sorted(max(0.0, float(x)) for x in values)
+    n = len(vals)
+    total = sum(vals)
+    if n <= 1 or total <= 0:
+        return 0.0
+    weighted = sum((i + 1) * v for i, v in enumerate(vals))
+    return max(0.0, min(1.0, (2.0 * weighted) / (n * total) - (n + 1.0) / n))
+
+
+def score_program_workload(
+    cfg: Mapping[str, Any],
+    *,
+    search_space: SearchSpaceSpec,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Return an operator-name-free tail-weighted per-core workload record."""
+    opts = dict(options or {})
+    roles = _role_map(search_space, opts)
+    d = dict(cfg)
+    core_count = max(1, int(opts.get("num_cores", 20) or 20))
+    split_fraction_axes: list[list[float]] = []
+    reduction_fraction_axes: list[list[float]] = []
+    resolved = 0
+
+    for axis in search_space.axes:
+        value = d.get(axis.name, axis.values[0])
+        if not isinstance(value, (int, float)) or float(value) <= 0:
+            continue
+        role = roles.get(axis.name, str(axis.semantic_role or "generic"))
+        if role == "core_count":
+            core_count = max(1, int(value))
+            continue
+        if role in {"warps", "pipeline", "cta_count", "register_limit", "schedule_control"}:
+            continue
+        extent = _extent(axis.name, all_args, opts)
+        if extent is None:
+            continue
+        resolved += 1
+        fractions = _tile_valid_fractions(extent, float(value))
+        if role in {"split", "tile", "reduction_split"}:
+            split_fraction_axes.append(fractions)
+        elif role == "reduction_tile":
+            reduction_fraction_axes.append(fractions)
+
+    # Every output-tile combination is one logical task.  Valid fractions make
+    # boundary tiles lighter, which is exactly the information missing from a
+    # pure `program_count % core_count` wave metric.
+    if split_fraction_axes:
+        task_output_fractions = [
+            math.prod(xs) for xs in itertools.product(*split_fraction_axes)
+        ]
+    else:
+        task_output_fractions = [1.0]
+
+    # Reduction tails affect the amount of serial/inner work of every output
+    # task.  Sum of valid fractions is the exact number of full-tile-equivalent
+    # iterations for one reduction axis; multiply for multiple axes.
+    reduction_equiv = 1.0
+    reduction_loop_count = 1
+    for fractions in reduction_fraction_axes:
+        reduction_equiv *= max(1e-9, sum(fractions))
+        reduction_loop_count *= max(1, len(fractions))
+
+    task_costs = [max(1e-9, f * reduction_equiv) for f in task_output_fractions]
+    core_loads = [0.0] * core_count
+    core_tasks = [0] * core_count
+    for tid, cost in enumerate(task_costs):
+        cid = tid % core_count
+        core_loads[cid] += cost
+        core_tasks[cid] += 1
+
+    active = [x for x in core_loads if x > 0]
+    mean_all = sum(core_loads) / len(core_loads) if core_loads else 0.0
+    max_load = max(core_loads, default=0.0)
+    min_active = min(active, default=0.0)
+    p95 = sorted(core_loads)[min(len(core_loads) - 1, max(0, int(math.ceil(0.95 * len(core_loads))) - 1))] if core_loads else 0.0
+    imbalance = max_load / mean_all - 1.0 if mean_all > 0 else 0.0
+    p95_ratio = p95 / mean_all if mean_all > 0 else 1.0
+    active_fraction = len(active) / max(1, core_count)
+    tail_task_fraction = sum(1 for x in task_output_fractions if x < 1.0 - 1e-12) / max(1, len(task_output_fractions))
+    tail_work_fraction = (
+        sum(c for c, frac in zip(task_costs, task_output_fractions) if frac < 1.0 - 1e-12)
+        / max(1e-12, sum(task_costs))
+    )
+
+    # One ordinal penalty: low active-core fraction, high max/mean load and
+    # strong tail heterogeneity are all undesirable.  This deliberately avoids
+    # hardware latency constants and candidate labels.
+    score = (
+        1.00 * max(0.0, imbalance)
+        + 0.35 * max(0.0, p95_ratio - 1.0)
+        + 0.50 * max(0.0, 1.0 - active_fraction)
+        + 0.30 * _gini(core_loads)
+        + 0.20 * tail_work_fraction
+    )
+
+    return {
+        "model_kind": "source_program_workload_v68",
+        "program_workload_score": float(score),
+        "logical_task_count": len(task_costs),
+        "reduction_loop_count": int(reduction_loop_count),
+        "reduction_full_tile_equivalent": float(reduction_equiv),
+        "core_count": int(core_count),
+        "active_core_fraction": float(active_fraction),
+        "max_core_load": float(max_load),
+        "mean_core_load": float(mean_all),
+        "min_active_core_load": float(min_active),
+        "max_to_mean_core_load": float(max_load / mean_all) if mean_all > 0 else 1.0,
+        "p95_to_mean_core_load": float(p95_ratio),
+        "core_load_imbalance": float(max(0.0, imbalance)),
+        "core_load_gini": float(_gini(core_loads)),
+        "tail_task_fraction": float(tail_task_fraction),
+        "tail_work_fraction": float(tail_work_fraction),
+        "per_core_task_counts": core_tasks,
+        "per_core_loads": core_loads,
+        "resolved_extent_axes": int(resolved),
+        "semantic_confidence": min(1.0, resolved / max(1, len([a for a in search_space.axes if roles.get(a.name) not in {"core_count", "warps", "pipeline", "cta_count", "register_limit", "schedule_control"}]))),
+        "uses_ttir": False,
+        "uses_hivm": False,
+        "uses_des": False,
+        "uses_candidate_latency_labels": False,
+    }
+
+
+def score_rows_program_workload(
+    rows: Sequence[Mapping[str, Any]],
+    *,
+    search_space: SearchSpaceSpec,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> tuple[dict[tuple, dict[str, Any]], dict[str, Any]]:
+    out: dict[tuple, dict[str, Any]] = {}
+    for row in rows:
+        cfg = dict(row.get("config") or {})
+        out[config_signature(cfg)] = score_program_workload(
+            cfg, search_space=search_space, all_args=all_args, options=options
+        )
+    confs = [float(x.get("semantic_confidence", 0.0)) for x in out.values()]
+    return out, {
+        "model_kind": "source_program_workload_v68",
+        "available": bool(out),
+        "mean_semantic_confidence": statistics.fmean(confs) if confs else 0.0,
+        "operator_name_dispatch": False,
+        "uses_ttir": False,
+        "uses_candidate_latency_labels": False,
+    }
diff --git a/third_party/ascend/backend/runtime/ttir_anchor_refinement_v68.py b/third_party/ascend/backend/runtime/ttir_anchor_refinement_v68.py
