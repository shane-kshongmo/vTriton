+
+def _vector_details_for_group(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any],
+    template: KernelTemplate,
+) -> tuple[Mapping[str, Any], str, str]:
+    family_raw = str(options.get("operator_family", "flash_attention")).lower()
+    family = _canonical_family(family_raw)
+    mode = _resolved_score_mode(options)
+    if mode not in {"universal", "hybrid", "specialized_legacy"}:
+        raise ValueError(f"unknown light_score_mode: {mode!r}")
+    static = _static_analysis(template, options)
+    if mode == "specialized_legacy":
+        details = _vector_specialized_batch(family, configs, all_args, options, template)
+        if details is None:
+            details = _vector_universal_batch(configs, all_args, options, template, static)
+            details["base_score"] = details["score"].copy()
+            return details, "universal_unknown", family
+        details["specialized_score"] = details["score"].copy()
+        return details, "specialized_legacy", family
+    base = _vector_universal_batch(configs, all_args, options, template, static)
+    base["base_score"] = base["score"].copy()
+    if mode == "universal":
+        return base, "universal", family
+    specialized = _vector_specialized_batch(family, configs, all_args, options, template)
+    if specialized is None:
+        return base, "universal_unknown", family
+    return _vector_fuse_batch(family, base, specialized, options, template), "universal_plus_residual", family
+
+
+def _evaluate_vectorized_unified(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any],
+) -> tuple[Mapping[str, Any], list[tuple[Sequence[int], Mapping[str, Any], str, str]]]:
+    """Evaluate a pool with live hardware resolved once and numeric arrays first."""
+    import numpy as np
+    if not configs:
+        empty = np.empty(0, dtype=np.float64)
+        empty_i = np.empty(0, dtype=np.int16)
+        details = {
+            "n": 0, "score": empty, "grid_time": empty, "cube_time": empty,
+            "vector_time": empty, "mte_time": empty, "loop_overhead": empty,
+            "handoff_overhead": empty, "tail_penalty": empty,
+            "imbalance_penalty": empty, "capacity_risk": empty,
+            "active_program_ratio": empty, "load_imbalance": empty,
+            "max_tiles_per_program": np.empty(0, dtype=np.int64),
+            "loop_count": np.empty(0, dtype=np.int64), "memory_redundancy": empty,
+            "ub_peak_bytes": empty, "ub_utilization": empty,
+            "ub_headroom_bytes": empty, "tail_waste": empty,
+            "bottleneck_id": empty_i, "base_bottleneck_id": empty_i.copy(),
+            "fused_bottleneck_id": empty_i.copy(), "confidence": empty,
+            "structural_signature": np.empty((0, 5), dtype=np.int16),
+            "level1_region": np.empty((0, 3), dtype=np.int16),
+            "base_score": empty, "specialized_score": empty,
+            "residual_score": empty, "residual_weight": empty,
+        }
+        return details, []
+
+    adapter = options.get("light_ttir_adapter")
+    if callable(adapter):
+        reports = [_coerce_adapter_report(adapter(cfg=cfg, all_args=all_args, options=options)) for cfg in configs]
+        return _reports_to_detail_arrays(reports), []
+
+    opts = resolved_hardware_options(options)
+    groups: Dict[tuple, List[Tuple[int, Any]]] = {}
+    for index, cfg in enumerate(configs):
+        groups.setdefault(_structural_group_key(cfg, opts), []).append((index, cfg))
+
+    numeric_names = (
+        "score", "grid_time", "cube_time", "vector_time", "mte_time",
+        "loop_overhead", "handoff_overhead", "tail_penalty", "imbalance_penalty",
+        "capacity_risk", "active_program_ratio", "load_imbalance",
+        "max_tiles_per_program", "loop_count", "memory_redundancy", "ub_peak_bytes",
+        "ub_utilization", "ub_headroom_bytes", "tail_waste", "bottleneck_id",
+        "confidence", "base_score", "specialized_score", "residual_score", "residual_weight",
+        "base_bottleneck_id", "fused_bottleneck_id",
+    )
+    merged: Dict[str, Any] = {"n": len(configs)}
+    for name in numeric_names:
+        dtype = np.int64 if name in {"max_tiles_per_program", "loop_count"} else (np.int16 if name in {"bottleneck_id", "base_bottleneck_id", "fused_bottleneck_id"} else np.float64)
+        merged[name] = np.empty(len(configs), dtype=dtype)
+    merged["structural_signature"] = np.empty((len(configs), 5), dtype=np.int16)
+    merged["level1_region"] = np.empty((len(configs), 3), dtype=np.int16)
+    materialization_groups: list[tuple[Sequence[int], Mapping[str, Any], str, str]] = []
+
+    for members in groups.values():
+        indices = [index for index, _ in members]
+        subconfigs = [cfg for _, cfg in members]
+        template = _resolve_template(subconfigs[0], all_args, opts)
+        local = dict(opts)
+        local["light_template_confidence_hint"] = float(template.confidence)
+
+        # Candidate expansion stages can independently regenerate the same
+        # Config.  Evaluate each canonical signature once, then scatter the
+        # numeric result back to every source position.  This is exact (not a
+        # score cache approximation) and also keeps report materialization in
+        # the same source-of-truth path.
+        if bool(local.get("light_deduplicate_configs", True)) and len(subconfigs) > 1:
+            signature_to_unique: Dict[tuple, int] = {}
+            unique_configs: List[Any] = []
+            inverse: List[int] = []
+            for cfg in subconfigs:
+                signature = config_signature(cfg)
+                unique_index = signature_to_unique.get(signature)
+                if unique_index is None:
+                    unique_index = len(unique_configs)
+                    signature_to_unique[signature] = unique_index
+                    unique_configs.append(cfg)
+                inverse.append(unique_index)
+        else:
+            unique_configs = subconfigs
+            inverse = list(range(len(subconfigs)))
+
+        unique_details, score_mode, motif = _vector_details_for_group(
+            unique_configs, all_args, local, template
+        )
+        inverse_array = np.asarray(inverse, dtype=np.int64)
+        details: Dict[str, Any] = dict(unique_details)
+        details["n"] = len(subconfigs)
+        for name in numeric_names:
+            details[name] = np.asarray(unique_details[name])[inverse_array]
+        details["structural_signature"] = np.asarray(unique_details["structural_signature"])[inverse_array, :]
+        details["level1_region"] = np.asarray(unique_details["level1_region"])[inverse_array, :]
+
+        for name in numeric_names:
+            merged[name][indices] = details[name]
+        merged["structural_signature"][indices, :] = details["structural_signature"]
+        merged["level1_region"][indices, :] = details["level1_region"]
+        materialization_groups.append((indices, details, score_mode, motif))
+    return merged, materialization_groups
+
+
+def _reports_to_detail_arrays(reports: Sequence[LightTTIRReport]) -> Mapping[str, Any]:
+    """Adapter compatibility path; built-in models use the vector hot path."""
+    import numpy as np
+    data: Dict[str, Any] = {"n": len(reports)}
+    float_fields = (
+        "score", "grid_time", "cube_time", "vector_time", "mte_time", "loop_overhead",
+        "handoff_overhead", "tail_penalty", "imbalance_penalty", "capacity_risk",
+        "active_program_ratio", "load_imbalance", "memory_redundancy", "ub_peak_bytes",
+        "ub_utilization", "ub_headroom_bytes", "tail_waste", "confidence", "base_score",
+        "specialized_score", "residual_score", "residual_weight",
+    )
+    for name in float_fields:
+        data[name] = np.fromiter((float(getattr(r, name)) for r in reports), dtype=np.float64, count=len(reports))
+    for name in ("max_tiles_per_program", "loop_count"):
+        data[name] = np.fromiter((int(getattr(r, name)) for r in reports), dtype=np.int64, count=len(reports))
+    mapping = {"grid": 0, "cube": 1, "vector": 2, "mte": 3, "buffer": 4}
+    data["bottleneck_id"] = np.fromiter((mapping.get(r.bottleneck, 5) for r in reports), dtype=np.int16, count=len(reports))
+    data["base_bottleneck_id"] = np.fromiter((mapping.get(r.base_bottleneck or r.bottleneck, 5) for r in reports), dtype=np.int16, count=len(reports))
+    data["fused_bottleneck_id"] = np.fromiter((mapping.get(r.fused_bottleneck or r.bottleneck, 5) for r in reports), dtype=np.int16, count=len(reports))
+    data["structural_signature"] = np.asarray([r.structural_signature for r in reports], dtype=np.int16)
+    data["level1_region"] = np.asarray([r.level1_region for r in reports], dtype=np.int16)
+    return data
+
+
+def _details_to_batch_scores(details: Mapping[str, Any]) -> LightTTIRBatchScores:
+    import numpy as np
+    level1 = np.asarray(details["level1_region"], dtype=np.int16)
+    region = (level1[:, 0] + 4 * level1[:, 1] + 32 * level1[:, 2]).astype(np.int16)
+    return LightTTIRBatchScores(
+        details["score"], details["grid_time"], details["ub_utilization"],
+        details["load_imbalance"], details["tail_waste"], details["confidence"],
+        details["bottleneck_id"], region, details["structural_signature"], level1,
+    )
+
+
+def evaluate_light_ttir(
+    cfg: Any,
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> LightTTIRReport:
+    """Evaluate one config through the numeric S1/S2 source of truth."""
+    return evaluate_light_ttir_batch([cfg], all_args, options)[0]
+
+
+def evaluate_light_ttir_scores_batch(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> LightTTIRBatchScores:
+    """Production S1/S2 API: no per-candidate report allocation."""
+    details, _ = _evaluate_vectorized_unified(configs, all_args, options or {})
+    return _details_to_batch_scores(details)
+
+
+def evaluate_light_ttir_batch(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> List[LightTTIRReport]:
+    """Materialize reports from exactly the production numeric path."""
+    details, groups = _evaluate_vectorized_unified(configs, all_args, options or {})
+    if not configs:
+        return []
+    if not groups:  # custom adapter compatibility
+        # Reconstruct minimal metadata from adapter reports is intentionally not
+        # supported here because _evaluate_vectorized_unified already consumed
+        # them. Re-run only custom adapters, which are outside the built-in hot path.
+        adapter = (options or {}).get("light_ttir_adapter")
+        return [_coerce_adapter_report(adapter(cfg=cfg, all_args=all_args, options=options or {})) for cfg in configs]
+    result: List[LightTTIRReport | None] = [None] * len(configs)
+    for indices, local, score_mode, motif in groups:
+        reports = _materialize_vector_reports(local, score_mode=score_mode, motif=motif)
+        for index, report in zip(indices, reports):
+            result[int(index)] = report
+    if any(report is None for report in result):
+        raise RuntimeError("internal Light TTIR vector materialization failure")
+    return [report for report in result if report is not None]
+
+
+
+def _slice_numeric_details(details: Mapping[str, Any], indices: Sequence[int]) -> Dict[str, Any]:
+    """Slice vector details while preserving scalar template metadata."""
+    import numpy as np
+    idx = np.asarray(indices, dtype=np.int64)
+    out: Dict[str, Any] = dict(details)
+    out["n"] = len(indices)
+    for name, value in details.items():
+        if isinstance(value, np.ndarray) and value.ndim >= 1 and value.shape[0] == int(details.get("n", value.shape[0])):
+            out[name] = value[idx]
+    return out
+
+
+def _primary_axis_value(cfg: Any, family: str) -> int:
+    kwargs = getattr(cfg, "kwargs", {}) or {}
+    names = ("BLOCK_M", "BM") if family == "flash_attention" else (
+        "BLOCK_M", "BLOCK_SIZE_M", "XBLOCK", "BLOCK_SIZE", "BM"
+    )
+    for name in names:
+        value = kwargs.get(name)
+        if isinstance(value, int) and value > 0:
+            return int(value)
+    return 1
+
+
+def _cap_selection_indices(indices: Sequence[int], max_candidates: int | None) -> Tuple[int, ...]:
+    """Apply a deterministic hard budget after conservative quota selection."""
+    ordered = tuple(int(i) for i in indices)
+    if max_candidates is None or int(max_candidates) < 0:
+        return ordered
+    return ordered[:max(0, int(max_candidates))]
+
+
+def evaluate_light_ttir_s1(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> LightTTIRS1Selection:
+    """Evaluate Universal on the full pool and select conservative S1 survivors.
+
+    This is the production entry point for B1 generation.  It never evaluates
+    an operator-specific residual, so stopping at B1 does not pay any S2 cost.
+    The returned Universal arrays are retained and can be passed directly to
+    :func:`evaluate_light_ttir_s2` without recomputation.
+    """
+    import numpy as np
+    from . import light_ttir_ranking as ranking
+
+    opts = resolved_hardware_options(options or {})
+    if not configs:
+        empty_opts = dict(opts)
+        empty_opts["light_score_mode"] = "universal"
+        empty = evaluate_light_ttir_scores_batch([], all_args, empty_opts)
+        return LightTTIRS1Selection((), empty, {}, 0.0, "empty")
+
+    family = _canonical_family(str(opts.get("operator_family", "flash_attention")).lower())
+    universal_opts = dict(opts)
+    universal_opts["light_score_mode"] = "universal"
+    universal_details, _ = _evaluate_vectorized_unified(configs, all_args, universal_opts)
+    universal = _details_to_batch_scores(universal_details)
+    u_scores = np.asarray(universal.score, dtype=np.float64)
+    confidences = np.asarray(universal.confidence, dtype=np.float64)
+    regions = [tuple(map(int, row)) for row in np.asarray(universal.level1_region)]
+    axes = [_primary_axis_value(cfg, family) for cfg in configs]
+
+    s1_fraction = ranking.adaptive_retention_fraction(
+        confidences,
+        min_fraction=float(opts.get("light_s1_min_fraction", 0.15)),
+        max_fraction=float(opts.get("light_s1_max_fraction", 0.45)),
+    )
+    if family == "flash_attention":
+        low_conf = float(np.mean(confidences)) < float(opts.get("light_low_confidence_threshold", 0.30))
+        selection = ranking.select_fa_robust_candidates(
+            u_scores, u_scores, regions, s1_fraction,
+            min_per_region=int(opts.get("light_min_per_region", 1)),
+            axis_keys=axes,
+            min_per_axis=1 if low_conf else 0,
+            include_hybrid=False,
+            preserve_axis_extremes=low_conf,
+        )
+    else:
+        selection = ranking.select_homogeneous_candidates(
+            u_scores, regions, s1_fraction,
+            min_per_region=int(opts.get("light_min_per_region", 1)),
+        )
+    indices = _cap_selection_indices(
+        selection.indices, opts.get("light_s1_max_candidates")
+    )
+    policy = selection.policy
+    if len(indices) < len(selection.indices):
+        policy += "::hard_budget"
+    return LightTTIRS1Selection(
+        indices=indices,
+        universal=universal,
+        universal_details=universal_details,
+        target_fraction=float(s1_fraction),
+        policy=policy,
+    )
+
+
+def evaluate_light_ttir_s2(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    s1: LightTTIRS1Selection,
+    options: Mapping[str, Any] | None = None,
+) -> LightTTIRPreselection:
+    """Evaluate only the incremental residual for S1 survivors.
+
+    ``s1`` must have been produced for the same ordered ``configs`` pool.  The
+    Universal arrays and numeric details are sliced and reused; no Universal
+    term is recomputed in S2.
+    """
+    import numpy as np
+    from . import light_ttir_ranking as ranking
+
+    opts = resolved_hardware_options(options or {})
+    if len(s1.universal.score) != len(configs):
+        raise ValueError("S1 result and config pool must have identical length")
+    if not configs or not s1.indices:
+        hybrid_full = np.full(len(configs), np.inf, dtype=np.float64)
+        return LightTTIRPreselection(
+            s1_indices=tuple(s1.indices), selected_indices=(),
+            universal=s1.universal, hybrid_scores=hybrid_full,
+            s1_target_fraction=float(s1.target_fraction), s2_target_fraction=0.0,
+            hybrid_evaluated=0, policy=f"s1_universal_then_s2_residual::{s1.policy}::empty",
+        )
+
+    family = _canonical_family(str(opts.get("operator_family", "flash_attention")).lower())
+    s1_indices = list(map(int, s1.indices))
+    universal_details = s1.universal_details
+    if not universal_details:
+        raise ValueError("S1 result does not contain reusable Universal numeric details")
+    u_scores = np.asarray(s1.universal.score, dtype=np.float64)
+    confidences = np.asarray(s1.universal.confidence, dtype=np.float64)
+    regions = [tuple(map(int, row)) for row in np.asarray(s1.universal.level1_region)]
+    axes = [_primary_axis_value(cfg, family) for cfg in configs]
+
+    hybrid_local = np.empty(len(s1_indices), dtype=np.float64)
+    selected_groups: Dict[tuple, List[Tuple[int, int, Any]]] = {}
+    for local_index, global_index in enumerate(s1_indices):
+        cfg = configs[global_index]
+        selected_groups.setdefault(_structural_group_key(cfg, opts), []).append(
+            (local_index, global_index, cfg)
+        )
+    for members in selected_groups.values():
+        local_positions = [x[0] for x in members]
+        global_indices = [x[1] for x in members]
+        subconfigs = [x[2] for x in members]
+        template = _resolve_template(subconfigs[0], all_args, opts)
+        local_opts = dict(opts)
+        local_opts["light_template_confidence_hint"] = float(template.confidence)
+        specialized = _vector_specialized_batch(family, subconfigs, all_args, local_opts, template)
+        base_local = _slice_numeric_details(universal_details, global_indices)
+        fused = base_local if specialized is None else _vector_fuse_batch(
+            family, base_local, specialized, local_opts, template
+        )
+        hybrid_local[np.asarray(local_positions, dtype=np.int64)] = np.asarray(
+            fused["score"], dtype=np.float64
+        )
+
+    selected_array = np.asarray(s1_indices, dtype=np.int64)
+    local_u = u_scores[selected_array]
+    local_conf = confidences[selected_array]
+    local_regions = [regions[i] for i in s1_indices]
+    local_axes = [axes[i] for i in s1_indices]
+    s2_min = float(opts.get("light_s2_min_fraction", 0.10))
+    s2_max = float(opts.get("light_s2_max_fraction", 0.30))
+    if family == "flash_attention":
+        final_local = ranking.select_fa_adaptive_candidates(
+            local_u, hybrid_local, local_regions, local_conf,
+            min_fraction=s2_min, max_fraction=s2_max,
+            min_per_region=int(opts.get("light_min_per_region", 1)),
+            axis_keys=local_axes,
+            low_confidence_threshold=float(opts.get("light_low_confidence_threshold", 0.30)),
+            disagreement_threshold=float(opts.get("light_disagreement_threshold", 0.20)),
+        )
+    else:
+        disagreement = ranking._ranking_disagreement(local_u, hybrid_local)
+        s2_fraction = ranking.adaptive_retention_fraction(
+            local_conf, disagreement=disagreement,
+            min_fraction=s2_min, max_fraction=s2_max,
+        )
+        final_local = ranking.select_homogeneous_candidates(
+            hybrid_local, local_regions, s2_fraction,
+            min_per_region=int(opts.get("light_min_per_region", 1)),
+        )
+
+    final_local_indices = _cap_selection_indices(
+        final_local.indices, opts.get("light_s2_max_candidates")
+    )
+    selected_indices = tuple(s1_indices[i] for i in final_local_indices)
+    hybrid_full = np.full(len(configs), np.inf, dtype=np.float64)
+    hybrid_full[selected_array] = hybrid_local
+    policy = f"s1_universal_then_s2_residual::{s1.policy}::{final_local.policy}"
+    if len(final_local_indices) < len(final_local.indices):
+        policy += "::hard_budget"
+    return LightTTIRPreselection(
+        s1_indices=tuple(s1_indices),
+        selected_indices=selected_indices,
+        universal=s1.universal,
+        hybrid_scores=hybrid_full,
+        s1_target_fraction=float(s1.target_fraction),
+        s2_target_fraction=float(final_local.target_fraction),
+        hybrid_evaluated=len(s1_indices),
+        policy=policy,
+    )
+
+
+def evaluate_light_ttir_s1_s2(
+    configs: Sequence[Any],
+    all_args: Mapping[str, Any],
+    options: Mapping[str, Any] | None = None,
+) -> LightTTIRPreselection:
+    """Convenience wrapper around the explicit S1 and S2 stage APIs."""
+    s1 = evaluate_light_ttir_s1(configs, all_args, options)
+    return evaluate_light_ttir_s2(configs, all_args, s1, options)
