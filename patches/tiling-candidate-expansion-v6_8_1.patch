+from pathlib import Path
+import sys
+ROOT=Path(__file__).resolve().parents[3]
+RUNTIME=ROOT/'third_party/ascend/backend/runtime'
+import types
+if 'backend' not in sys.modules:
+    b=types.ModuleType('backend'); b.__path__=[str(RUNTIME.parent)]; sys.modules['backend']=b
+if 'backend.runtime' not in sys.modules:
+    r=types.ModuleType('backend.runtime'); r.__path__=[str(RUNTIME)]; sys.modules['backend.runtime']=r
+from backend.runtime.safety_registry import SafetyRegistry, certificate_identity, certificate_payload
+
+
+def test_worker_change_invalidates_old_safe_certificate(tmp_path):
+    repo=tmp_path/'repo'; repo.mkdir()
+    src=tmp_path/'op.py'; src.write_text('x=1')
+    w1=tmp_path/'worker1.py'; w1.write_text('replays=1')
+    w2=tmp_path/'worker2.py'; w2.write_text('replays=3')
+    reg=SafetyRegistry(tmp_path/'registry.json')
+    ident1=certificate_identity(repo=repo,operator='op',source_path=src,safety_worker_path=w1)
+    p1=certificate_payload(repo=repo,operator='op',case={'M':1},cfg={'BLOCK':16},identity=ident1)
+    reg.record(p1,status='SAFE',evidence={'campaign_id':'c'})
+    ident2=certificate_identity(repo=repo,operator='op',source_path=src,safety_worker_path=w2)
+    p2=certificate_payload(repo=repo,operator='op',case={'M':1},cfg={'BLOCK':16},identity=ident2)
+    found,_=reg.lookup_compatible(p2)
+    assert found is None
