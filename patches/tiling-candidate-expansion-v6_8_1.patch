+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Stable, correctness-first cache keys for analytical model artifacts.
+
+The autotune process can reuse one ``Config`` across shapes, dtypes, kernels and
+hardware profiles.  Config-only keys are therefore unsafe for compiled IR,
+KernelTemplate and formal-model reports.  This module builds compact context
+signatures while intentionally representing tensor *metadata* rather than data
+or device addresses.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Mapping
+
+
+_INTERNAL_OPTION_PREFIXES = ("_candidate_", "_runtime_", "_light_prepared_")
+_INTERNAL_OPTION_KEYS = {
+    "_candidate_light_score_cache",
+    "_candidate_model_report_cache",
+    "_runtime_model_stats",
+}
+
+
+def _callable_signature(value: Any) -> tuple[str, str]:
+    return (
+        str(getattr(value, "__module__", type(value).__module__)),
+        str(getattr(value, "__qualname__", getattr(value, "__name__", type(value).__qualname__))),
+    )
+
+
+def _tensor_metadata(value: Any) -> Any | None:
+    shape = getattr(value, "shape", None)
+    dtype = getattr(value, "dtype", None)
+    if shape is None or dtype is None:
+        return None
+    try:
+        dims = tuple(int(v) for v in shape)
+    except Exception:
+        dims = repr(shape)
+    stride = None
+    stride_fn = getattr(value, "stride", None)
+    if callable(stride_fn):
+        try:
+            stride = tuple(int(v) for v in stride_fn())
+        except Exception:
+            stride = None
+    return {
+        "kind": "tensor_metadata",
+        "type": f"{type(value).__module__}.{type(value).__qualname__}",
+        "shape": dims,
+        "dtype": str(dtype),
+        "device": str(getattr(value, "device", "")),
+        "layout": str(getattr(value, "layout", "")),
+        "stride": stride,
+        "requires_grad": bool(getattr(value, "requires_grad", False)),
+    }
+
+
+def normalize_for_cache(value: Any) -> Any:
+    """Return a deterministic JSON-compatible representation.
+
+    Large tensors are represented by shape/dtype/layout metadata.  Callables
+    are represented by module and qualified name.  Unknown objects use a typed
+    repr as a conservative fallback.
+    """
+    if value is None or isinstance(value, (bool, int, float, str)):
+        return value
+    if isinstance(value, bytes):
+        return {"kind": "bytes", "sha256": hashlib.sha256(value).hexdigest(), "size": len(value)}
+    if isinstance(value, Path):
+        return str(value.resolve())
+    tensor = _tensor_metadata(value)
+    if tensor is not None:
+        return tensor
+    if isinstance(value, Mapping):
+        return {
+            str(k): normalize_for_cache(v)
+            for k, v in sorted(value.items(), key=lambda item: str(item[0]))
+        }
+    if isinstance(value, (tuple, list)):
+        return [normalize_for_cache(v) for v in value]
+    if isinstance(value, (set, frozenset)):
+        normalized = [normalize_for_cache(v) for v in value]
+        return sorted(normalized, key=repr)
+    if callable(value):
+        return {"kind": "callable", "identity": _callable_signature(value)}
+    if hasattr(value, "to_dict") and callable(value.to_dict):
+        try:
+            return {
+                "kind": f"{type(value).__module__}.{type(value).__qualname__}",
+                "value": normalize_for_cache(value.to_dict()),
+            }
+        except Exception:
+            pass
+    return {
+        "kind": f"{type(value).__module__}.{type(value).__qualname__}",
+        "repr": repr(value),
+    }
+
+
+def stable_digest(value: Any, *, length: int = 24) -> str:
+    payload = json.dumps(
+        normalize_for_cache(value), sort_keys=True, separators=(",", ":"), ensure_ascii=True
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()[: max(8, int(length))]
+
+
+def config_signature(cfg: Any) -> tuple:
+    return (
+        tuple(sorted(getattr(cfg, "kwargs", {}).items())),
+        getattr(cfg, "num_warps", None),
+        getattr(cfg, "num_stages", None),
+        getattr(cfg, "num_ctas", None),
+        getattr(cfg, "maxnreg", None),
+    )
+
+
+def _public_options(options: Mapping[str, Any] | None) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in (options or {}).items():
+        name = str(key)
+        if name in _INTERNAL_OPTION_KEYS or any(name.startswith(prefix) for prefix in _INTERNAL_OPTION_PREFIXES):
+            continue
+        result[name] = value
+    return result
+
+
+def model_context_signature(
+    all_args: Mapping[str, Any] | None,
+    options: Mapping[str, Any] | None,
+    *,
+    namespace: str = "model",
+) -> str:
+    explicit = (options or {}).get("model_cache_context_id")
+    payload = {
+        "namespace": str(namespace),
+        "explicit_context_id": explicit,
+        "all_args": dict(all_args or {}),
+        "options": _public_options(options),
+    }
+    return stable_digest(payload, length=32)
+
+
+def model_cache_key(
+    cfg: Any,
+    all_args: Mapping[str, Any] | None,
+    options: Mapping[str, Any] | None,
+    *,
+    namespace: str,
+) -> tuple:
+    return (
+        str(namespace),
+        config_signature(cfg),
+        model_context_signature(all_args, options, namespace=namespace),
+    )
