+#!/usr/bin/env python3
+"""Offline V6.8 ranker A/B against real hardware on the release-SAFE frontier.
+
+Ranking is frozen before the hardware oracle.  Three orders are compared:
+  A) V6.7 Source/Motif baseline;
+  B) V6.8 Source++ with compile-free per-program workload;
+  C) V6.8 Source++ plus TTIR anchors captured from already-paid production B0/bootstrap.
+
+The oracle benchmark is diagnostic/offline and is never counted as production
+Autotune overhead or fed back into the ranking model.
+"""
+from __future__ import annotations
+import argparse, json, math, os, shutil, statistics, sys, time
+from pathlib import Path
+from types import SimpleNamespace
+
+HERE=Path(__file__).resolve().parent
+EXP=HERE.parent
+CAL=EXP/'vtriton_new_ops_calibration'
+for p in (HERE,CAL):
+    if str(p) not in sys.path: sys.path.insert(0,str(p))
+
+from native_autotune_v53 import _cfg_sig, _prepare_once, write_json
+from native_autotune_v63 import _rank_rows_generic, _release_safe_rows
+from native_autotune_v68 import _rank_rows_source_pp, _native_tune_stable
+
+
+def _strip(rows):
+    keep=('config','origin_stage','is_source_official')
+    return [{k:r[k] for k in keep if k in r} for r in rows]
+
+
+def _defaults():
+    return dict(
+        expansion_seed_limit=64,s1_generation_per_seed=32,s1_anchor_budget=12,s1_max_new=48,
+        s2_max_domain_product=512,s2_candidates_per_region=4,s2_sparse_region_threshold=1,s2_max_new=64,
+        s3_max_new=96,s3_factorial_reserve=24,s3_generations=2,s3_parent_k=12,s3_population=32,
+        s3_mutation_per_parent=8,seed=17,source_program_workload_weight=1.10,
+        ttir_anchor_weight=0.60,ttir_anchor_max_neighbors=3,ttir_anchor_distance_scale=0.35,
+    )
+
+
+def _metrics(order, latency, b0_best, oracle):
+    ordered=[_cfg_sig(dict(r['config'])) for r in order if _cfg_sig(dict(r['config'])) in latency]
+    best=float(b0_best)
+    regrets={}
+    for i,sig in enumerate(ordered,1):
+        best=min(best,float(latency[sig]))
