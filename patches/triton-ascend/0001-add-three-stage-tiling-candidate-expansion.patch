@@ -0,0 +1,142 @@
+from triton.runtime.autotuner import Config
+from triton.backends.ascend.runtime.candidate_expansion import expand_official_configs
+
+
+def sigs(configs):
+    return {tuple(sorted(c.kwargs.items())) for c in configs}
+
+
+def test_three_stage_is_cumulative_and_preserves_official():
+    official = [Config({"BLOCK_M": 32, "BLOCK_N": 64}), Config({"BLOCK_M": 64, "BLOCK_N": 128})]
+    stages, stats = expand_official_configs(official, {"N_CTX": 128, "HEAD_DIM": 128},
+                                            {"s1_max_new": 8, "s2_max_new": 8, "s3_max_new": 8})
+    b0, b1, b2, b3 = (stages[k] for k in ("B0_official", "B1_plus_s1", "B2_plus_s2", "B3_plus_s3"))
+    assert sigs(b0) <= sigs(b1) <= sigs(b2) <= sigs(b3)
+    assert sigs(official) == sigs(b0)
+    assert stats["official"] == 2
+
+
+def test_expansion_is_seed_dependent_not_global_cartesian_product():
+    a, _ = expand_official_configs([Config({"BLOCK_M": 16, "BLOCK_N": 16})], {"N_CTX": 128},
+                                    {"s1_max_new": 4, "s2_max_new": 4, "s3_max_new": 0})
+    b, _ = expand_official_configs([Config({"BLOCK_M": 128, "BLOCK_N": 128})], {"N_CTX": 128},
+                                    {"s1_max_new": 4, "s2_max_new": 4, "s3_max_new": 0})
+    assert sigs(a["B2_plus_s2"]) != sigs(b["B2_plus_s2"])
+
+
+def test_s3_is_multi_generation_cost_model_guided():
+    official = [Config({"BLOCK_M": 32, "BLOCK_N": 16}), Config({"BLOCK_M": 64, "BLOCK_N": 32})]
+    stages, stats = expand_official_configs(
+        official, {"N_CTX": 128, "HEAD_DIM": 64, "Z": 1, "H": 1},
+        {"s1_max_new": 8, "s2_max_new": 8, "s3_max_new": 12,
+         "evolution_generations": 3, "evolution_parent_k": 4, "evolution_population": 8,
+         "evolution_patience": 0})
+    assert len(stats["evolution"]["generation_stats"]) == 3
+    assert stats["evolution"]["cost_model"] == "analytic_white_box"
+    assert sigs(stages["B2_plus_s2"]) <= sigs(stages["B3_plus_s3"])
+
+def test_explicit_tail_domain_contains_non_divisor():
+    cfg = Config({'BLOCK_M': 32, 'BLOCK_N': 64}, num_warps=4, num_stages=2)
+    stages, stats = expand_official_configs([cfg], {'N_CTX': 128, 'HEAD_DIM': 64}, {
+        'tunable_parameter': ['BLOCK_M', 'BLOCK_N'],
+        'default_tile_values': [24, 32, 48, 64, 80, 128],
+        'allow_tail_tiles': True,
+        's1_max_new': 64, 's2_max_new': 64, 's3_max_new': 0,
+    })
+    assert 48 in stats['parameter_domains']['BLOCK_M']
+
+
+def test_pareto_selection_metadata():
+    cfg = Config({'BLOCK_M': 32, 'BLOCK_N': 64}, num_warps=4, num_stages=2)
+    _, stats = expand_official_configs([cfg], {'N_CTX': 128, 'HEAD_DIM': 64}, {
+        'tunable_parameter': ['BLOCK_M', 'BLOCK_N'], 'selection_mode': 'pareto',
+        's1_max_new': 8, 's2_max_new': 8, 's3_max_new': 8,
+    })
+    assert stats['selection_mode'] == 'pareto'
+
+
+def test_s1_unifies_multi_radius_local_expansion():
+    official = [Config({"BLOCK_M": 32, "BLOCK_N": 32})]
+    stages, stats = expand_official_configs(
+        official, {"N_CTX": 128, "HEAD_DIM": 64},
+        {"max_stage": "B1_plus_s1", "tunable_parameter": ["BLOCK_M", "BLOCK_N"],
+         "default_tile_values": [8, 16, 24, 32, 48, 64, 96, 128], "s1_max_new": 64})
+    assert stats["s1_strategy"]["type"] == "structured_multiscale_local"
+    assert stats["s1_strategy"]["domain_index_offsets"] == [-1, 1]
+    assert stats["s1_strategy"]["scale_factors"] == [0.5, 0.75, 1.25, 1.5, 2.0]
+    assert len(stages["B1_plus_s1"]) > len(stages["B0_official"])
+
+
+def test_s2_is_resource_coverage_not_numeric_radius():
+    official = [Config({"BLOCK_M": 64, "BLOCK_N": 64})]
+    stages, stats = expand_official_configs(
+        official, {"N_CTX": 128, "HEAD_DIM": 64, "H": 1, "Z": 1},
+        {"max_stage": "B2_plus_s2", "tunable_parameter": ["BLOCK_M", "BLOCK_N"],
+         "default_tile_values": [8, 16, 24, 32, 48, 64, 96, 128],
+         "s1_max_new": 8, "s2_max_new": 24, "s2_candidates_per_region": 2})
+    assert stats["s2_strategy"] == "resource_coverage"
+    coverage = stats["s2_resource_coverage"]
+    assert coverage["reservoir"] >= coverage["emitted"]
+    assert coverage["covered_after_generation"] >= coverage["covered_before"]
+    assert sigs(stages["B1_plus_s1"]) <= sigs(stages["B2_plus_s2"])
+
+
+def test_s3_uses_cost_guided_global_domain_mutation():
+    official = [Config({"BLOCK_M": 32, "BLOCK_N": 64})]
+    _, stats = expand_official_configs(
+        official, {"N_CTX": 128, "HEAD_DIM": 64},
+        {"max_stage": "B3_plus_s3", "tunable_parameter": ["BLOCK_M", "BLOCK_N"],
