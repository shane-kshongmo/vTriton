index 0000000000000000000000000000000000000000..8bcf5837b9b10a9c8f69d84e6dd4c53c8eba00df
--- /dev/null
+++ b/third_party/ascend/experiments/operator_explanations.py
@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Operator-aware analytical explanations for autotuning winners.
+
+These features are *proxies*, not hardware-counter measurements.  They are
+intended to explain how a tiling change alters scheduling, loop counts, tail
+waste and approximate on-chip footprint.  Hardware profiler evidence should
+be used to validate the resulting hypotheses.
+"""
+from __future__ import annotations
+
+from math import ceil
+from typing import Any, Mapping
+
+
+def _kwargs(config: Mapping[str, Any] | None) -> dict[str, Any]:
+    if not config:
+        return {}
+    raw = config.get("kwargs", config)
+    return dict(raw) if isinstance(raw, Mapping) else {}
+
+
+def _get(kw: Mapping[str, Any], *names: str, default: int = 1) -> int:
+    for name in names:
+        if name in kw and kw[name] is not None:
+            return int(kw[name])
+    return int(default)
+
+
+def _waves(programs: int, cores: int) -> dict[str, Any]:
+    cores = max(int(cores), 1)
+    programs = max(int(programs), 0)
+    waves = ceil(programs / cores) if programs else 0
+    last = programs - (waves - 1) * cores if waves else 0
+    return {
+        "program_count_proxy": programs,
+        "wave_count_proxy": waves,
+        "last_wave_programs_proxy": last,
+        "last_wave_core_utilization_proxy": (last / cores) if waves else 0.0,
+    }
+
+
+def _tail(total: int, block: int) -> dict[str, Any]:
+    block = max(int(block), 1)
+    padded = ceil(int(total) / block) * block
+    waste = padded - int(total)
+    return {
+        "padded_elements_proxy": padded,
+        "tail_waste_elements_proxy": waste,
+        "tail_waste_ratio_proxy": waste / max(padded, 1),
+    }
+
+
+def flash_attention_features(config, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    kw = _kwargs(config)
+    bm = _get(kw, "BLOCK_M", "BM")
+    bn = _get(kw, "BLOCK_N", "BN")
+    z, h = int(shape["Z"]), int(shape["H"])
+    n_ctx, d = int(shape["N_CTX"]), int(shape["HEAD_DIM"])
+    dtype_bytes = 2
+    acc_bytes = 4
+    programs = z * h * ceil(n_ctx / bm)
+    result = {"operator_family": "cube_vector_mix", "BLOCK_M": bm, "BLOCK_N": bn}
+    result.update(_waves(programs, num_cores))
+    result.update({f"query_{k}": v for k, v in _tail(n_ctx, bm).items()})
+    result.update({f"kv_{k}": v for k, v in _tail(n_ctx, bn).items()})
+    result.update({
+        "kv_iterations_proxy": ceil(n_ctx / bn),
+        "q_tile_bytes_proxy": bm * d * dtype_bytes,
+        "k_tile_bytes_proxy": bn * d * dtype_bytes,
+        "v_tile_bytes_proxy": bn * d * dtype_bytes,
+        "qk_tile_bytes_proxy": bm * bn * acc_bytes,
+        "acc_tile_bytes_proxy": bm * d * acc_bytes,
+        "total_live_footprint_proxy_bytes": (
+            bm * d * dtype_bytes + 2 * bn * d * dtype_bytes
+            + bm * bn * acc_bytes + bm * d * acc_bytes
+        ),
+        "tile_aspect_ratio_proxy": bn / max(bm, 1),
+    })
+    return result
+
+
+def vector_add_features(config, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    kw = _kwargs(config)
+    block = _get(kw, "BLOCK_SIZE", "XBLOCK", "XBLOCK_SIZE")
+    n = int(shape.get("N", shape.get("numel", 1)))
+    result = {"operator_family": "vector", "BLOCK_SIZE": block}
+    result.update(_waves(ceil(n / block), num_cores))
+    result.update(_tail(n, block))
+    result["bytes_per_program_proxy"] = block * 2 * 3  # two loads + one store, fp16/bf16
+    return result
+
+
+def softmax_features(config, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    kw = _kwargs(config)
+    block = _get(kw, "BLOCK_SIZE", "RBLOCK_SIZE")
+    xblock = _get(kw, "XBLOCK", "XBLOCK_SIZE", default=1)
+    rows = int(shape.get("M", shape.get("n_rows", 1)))
+    cols = int(shape.get("N", shape.get("n_cols", 1)))
+    programs = ceil(rows / xblock)
+    result = {"operator_family": "vector_reduction", "BLOCK_SIZE": block, "XBLOCK": xblock}
+    result.update(_waves(programs, num_cores))
+    result.update({f"reduction_{k}": v for k, v in _tail(cols, block).items()})
+    result.update({
+        "reduction_iterations_proxy": ceil(cols / block),
+        "rows_per_program_proxy": xblock,
+        "live_vector_bytes_proxy": xblock * block * 4,
+    })
+    return result
+
+
+def layer_norm_features(config, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    result = softmax_features(config, shape, num_cores)
+    result["operator_family"] = "vector_multi_reduction"
+    result["full_row_passes_proxy"] = 3
+    result["total_reduction_chunks_proxy"] = 3 * result["reduction_iterations_proxy"]
+    return result
+
+
+def matmul_features(config, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    kw = _kwargs(config)
+    bm = _get(kw, "BLOCK_M", "BLOCK_SIZE_M")
+    bn = _get(kw, "BLOCK_N", "BLOCK_SIZE_N")
+    bk = _get(kw, "BLOCK_K", "BLOCK_SIZE_K")
+    m, n, k = int(shape["M"]), int(shape["N"]), int(shape["K"])
+    programs = ceil(m / bm) * ceil(n / bn)
+    result = {"operator_family": "cube_dominant_mix", "BLOCK_M": bm, "BLOCK_N": bn, "BLOCK_K": bk}
+    result.update(_waves(programs, num_cores))
+    result.update({f"m_{key}": value for key, value in _tail(m, bm).items()})
+    result.update({f"n_{key}": value for key, value in _tail(n, bn).items()})
+    result.update({f"k_{key}": value for key, value in _tail(k, bk).items()})
+    result.update({
+        "k_iterations_proxy": ceil(k / bk),
+        "l0a_tile_bytes_proxy": bm * bk * 2,
+        "l0b_tile_bytes_proxy": bk * bn * 2,
+        "l0c_tile_bytes_proxy": bm * bn * 4,
+        "cube_tile_ops_proxy": 2 * bm * bn * bk,
+    })
+    return result
+
+
+FEATURE_BUILDERS = {
+    "flash_attention": flash_attention_features,
+    "vector_add": vector_add_features,
+    "softmax": softmax_features,
+    "layer_norm": layer_norm_features,
+    "matmul_bias": matmul_features,
+}
+
+
+def explain_config(operator: str, config, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    try:
+        builder = FEATURE_BUILDERS[operator]
+    except KeyError as exc:
+        raise ValueError(f"Unsupported operator {operator!r}; choose from {sorted(FEATURE_BUILDERS)}") from exc
+    return builder(config, shape, num_cores)
+
+
+def compare_configs(operator: str, baseline, winner, shape: Mapping[str, Any], num_cores: int = 20) -> dict[str, Any]:
+    base = explain_config(operator, baseline, shape, num_cores)
+    new = explain_config(operator, winner, shape, num_cores)
+    delta = {}
+    for key in sorted(set(base) | set(new)):
+        a, b = base.get(key), new.get(key)
+        if isinstance(a, (int, float)) and isinstance(b, (int, float)):
+            delta[key] = b - a
+    hypotheses = []
+    if delta.get("wave_count_proxy", 0) < 0:
+        hypotheses.append("fewer scheduling waves")
+    if delta.get("last_wave_core_utilization_proxy", 0) > 0:
+        hypotheses.append("better last-wave core utilization")
+    for key in ("kv_iterations_proxy", "reduction_iterations_proxy", "total_reduction_chunks_proxy", "k_iterations_proxy"):
+        if delta.get(key, 0) < 0:
+            hypotheses.append(f"fewer {key.replace('_proxy', '').replace('_', ' ')}")
+    tail_keys = [k for k in delta if k.endswith("tail_waste_ratio_proxy")]
+    if any(delta[k] < 0 for k in tail_keys):
+        hypotheses.append("less masked/padded tail work")
+    if delta.get("total_live_footprint_proxy_bytes", 0) > 0:
+        hypotheses.append("larger tiles trade higher on-chip footprint for less loop/scheduling overhead")
+    return {
+        "operator": operator,
+        "baseline_features": base,
+        "winner_features": new,
+        "winner_minus_baseline": delta,
+        "analytical_hypotheses": hypotheses,
+        "evidence_warning": "Analytical proxies only; validate with stable retest and Ascend profiler counters.",
+    }
