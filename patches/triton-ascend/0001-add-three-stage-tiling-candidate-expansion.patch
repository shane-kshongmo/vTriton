+         "s1_max_new": 8, "s2_max_new": 8, "s3_max_new": 8,
+         "evolution_generations": 2, "evolution_parent_k": 4, "evolution_population": 8})
+    assert stats["s3_strategy"] == "pareto_analytic_objective_evolution_with_cost_ranked_mutation"
+
+
+def test_s2_region_tracks_ratio_and_program_density():
