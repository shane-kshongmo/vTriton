index 0000000000000000000000000000000000000000..fdac2890a0d5d2bb2aea259fb3bb99b1317290ba
--- /dev/null
+++ b/third_party/ascend/backend/runtime/candidate_expansion.py
@@ -0,0 +1,775 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026.
+"""Cumulative candidate expansion for Ascend autotuning.
+
+B0 is the untouched output of the official TileGenerator/CVTileGenerator.
+S1 is a bounded multi-radius local expansion. S2 is a hardware-resource-aware
+coverage expansion driven by UB/core/wave/tail regions. S3 is a multi-generation,
+cost-model-guided evolutionary expansion. Hard pruning is conservative and is
+kept separate from cost-model ranking.
+"""
+from __future__ import annotations
+
+import copy
+import itertools
+import math
+import random
+import time
+from dataclasses import dataclass
+from typing import Any, Dict, Iterable, List, Mapping, Sequence, Tuple
+
+from triton.runtime.autotuner import Config
+
+
+def _sig(cfg: Config) -> Tuple:
+    return (tuple(sorted(cfg.kwargs.items())), cfg.num_warps, cfg.num_stages, cfg.num_ctas, cfg.maxnreg)
+
+
+def _clone(cfg: Config, kwargs: Dict[str, Any]) -> Config:
+    return Config(kwargs=kwargs, num_warps=cfg.num_warps, num_stages=cfg.num_stages,
+                  num_ctas=cfg.num_ctas, maxnreg=cfg.maxnreg, pre_hook=cfg.pre_hook,
+                  ir_override=cfg.ir_override)
+
+
+def _dedupe(configs: Iterable[Config]) -> List[Config]:
+    out, seen = [], set()
+    for cfg in configs:
+        key = _sig(cfg)
+        if key not in seen:
+            seen.add(key)
+            out.append(cfg)
+    return out
+
+
+def _divisors(n: int) -> List[int]:
+    if not isinstance(n, int) or n <= 0:
+        return []
+    vals = set()
+    for i in range(1, math.isqrt(n) + 1):
+        if n % i == 0:
+            vals.update((i, n // i))
+    return sorted(vals)
+
+
+def _runtime_bound(name: str, all_args: Mapping[str, Any], observed: Sequence[int]) -> int:
+    upper = name.upper()
+    preferred = []
+    if upper.endswith("_M") or upper in {"BM", "BLOCK_M"}:
+        preferred = ["N_CTX", "MAX_Q_LEN", "M", "SEQ_LEN", "N"]
+    elif upper.endswith("_N") or upper in {"BN", "BLOCK_N"}:
+        preferred = ["N_CTX", "MAX_K_LEN", "MAX_Q_LEN", "N", "SEQ_LEN", "M"]
+    elif upper.endswith("_K") or upper in {"BK", "BLOCK_K"}:
+        preferred = ["HEAD_DIM", "QK_DIM", "V_DIM", "K"]
+    for key in preferred:
+        value = all_args.get(key)
+        if isinstance(value, int) and value > 0:
+            return value
+    return max(observed) if observed else 1
+
+
+def _legal_values(name: str, configs: Sequence[Config], all_args: Mapping[str, Any],
+                  options: Mapping[str, Any]) -> List[int]:
+    """Build an explicit, auditable domain rather than a divisor-only space."""
+    observed = sorted({cfg.kwargs.get(name) for cfg in configs if isinstance(cfg.kwargs.get(name), int)})
+    bound = _runtime_bound(name, all_args, observed)
+    custom_domains = options.get("parameter_domains", {})
+    custom = custom_domains.get(name) or custom_domains.get(name.upper())
+    default_tiles = options.get("default_tile_values", (1, 2, 4, 8, 16, 24, 32, 48, 64, 80,
+                                                         96, 128, 160, 192, 224, 256, 384,
+                                                         512, 768, 1024))
+    vals = set(observed) | set(_divisors(bound)) | {int(v) for v in (custom or default_tiles)}
+    allow_tail = bool(all_args.get("__allow_tail_tiles__", options.get("allow_tail_tiles", True)))
+    alignment = max(1, int(options.get("parameter_alignment", {}).get(name, 1)))
+    return sorted(v for v in vals if isinstance(v, int) and 0 < v <= bound
+                  and v % alignment == 0 and (allow_tail or bound % v == 0))
+
+
+def _basic_legal(cfg: Config, all_args: Mapping[str, Any]) -> bool:
+    for name, value in cfg.kwargs.items():
+        if not isinstance(value, int) or value <= 0:
+            continue
+        upper = name.upper()
+        if upper in {"BM", "BN", "BLOCK_M", "BLOCK_N"}:
+            n_ctx = all_args.get("N_CTX", all_args.get("MAX_Q_LEN"))
+            if (not bool(all_args.get("__allow_tail_tiles__", True))
+                    and isinstance(n_ctx, int) and n_ctx > 0 and n_ctx % value != 0):
+                return False
+        if upper in {"BK", "BLOCK_K"}:
+            head_dim = all_args.get("HEAD_DIM", all_args.get("QK_DIM"))
+            if (bool(all_args.get("__require_head_dim_divisible__", True))
+                    and isinstance(head_dim, int) and head_dim > 0 and head_dim % value != 0):
+                return False
+    return True
+
+
+def _neighbor(values: Sequence[int], value: int, offsets: Sequence[int]) -> List[int]:
+    if value not in values:
+        return []
+    idx = values.index(value)
+    return [values[idx + off] for off in offsets if 0 <= idx + off < len(values)]
+
+
+def _nearest_legal(values: Sequence[int], target: float) -> int | None:
+    if not values:
+        return None
+    return min(values, key=lambda v: (abs(v - target), v))
+
+
+def _mutate_one(cfg: Config, spaces: Mapping[str, Sequence[int]], offsets: Sequence[int],
+                scale_factors: Sequence[float] = (), numeric_steps: Sequence[int] = ()) -> List[Config]:
+    """Generate explicit single-axis mutation families.
+
+    ``offsets`` are indices in the ordered legal domain, while scale factors and
+    numeric steps act on the value itself and are projected back to that domain.
+    Keeping the families separate makes the search semantics auditable.
+    """
+    children = []
+    for name, values in spaces.items():
+        current = cfg.kwargs.get(name)
+        if not isinstance(current, int):
+            continue
+        targets = set(_neighbor(values, current, offsets))
+        for factor in scale_factors:
+            nearest = _nearest_legal(values, current * float(factor))
+            if nearest is not None:
+                targets.add(nearest)
+        for step in numeric_steps:
+            for target in (current - int(step), current + int(step)):
+                nearest = _nearest_legal(values, target)
+                if nearest is not None:
+                    targets.add(nearest)
+        targets.discard(current)
+        for new_value in sorted(targets):
+            kwargs = dict(cfg.kwargs)
+            kwargs[name] = new_value
+            children.append(_clone(cfg, kwargs))
+    return children
+
+
+def _small_block_anchors(base: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                         budget: int) -> List[Config]:
+    """Inject a bounded set of small-BM anchors once, not once per official seed."""
+    if budget <= 0 or not base:
+        return []
+    bm_name = next((n for n in spaces if n.upper() in {"BM", "BLOCK_M"}), None)
+    bn_name = next((n for n in spaces if n.upper() in {"BN", "BLOCK_N"}), None)
+    if bm_name is None:
+        return []
+    small = [v for v in (1, 2, 4, 8) if v in spaces[bm_name]]
+    if not small:
+        return []
+    bn_anchors = [None]
+    if bn_name is not None:
+        bn_anchors = []
+        for target in (32, 64, 128):
+            value = _nearest_legal(spaces[bn_name], target)
+            if value is not None and value not in bn_anchors:
+                bn_anchors.append(value)
+    out: List[Config] = []
+    template = base[0]
+    for bm, bn in itertools.product(small, bn_anchors):
+        kwargs = dict(template.kwargs)
+        kwargs[bm_name] = bm
+        if bn_name is not None and bn is not None:
+            kwargs[bn_name] = bn
+        out.append(_clone(template, kwargs))
+    return out[:budget]
+
+
+def _cross(parents: Sequence[Config], tunable: Sequence[str], max_pairs: int, rng: random.Random,
+           min_distance: float = 0.0) -> List[Config]:
+    pairs = [(a, b) for a, b in itertools.combinations(parents, 2)
+             if _distance(a, b, tunable) >= min_distance]
+    rng.shuffle(pairs)
+    children = []
+    for left, right in pairs[:max_pairs]:
+        if not tunable:
+            continue
+        if len(tunable) == 2:
+            # The only novel two-dimensional recombinations are the two mixed
+            # children. Random masks also produce unchanged parent duplicates.
+            a, b = tunable
+            for source, donor in ((left, right), (right, left)):
+                kwargs = dict(source.kwargs)
+                if b in donor.kwargs:
+                    kwargs[b] = donor.kwargs[b]
+                children.append(_clone(source, kwargs))
+            continue
+        mask = rng.randrange(1, 1 << len(tunable))
+        kwargs = dict(left.kwargs)
+        for idx, name in enumerate(tunable):
+            if mask & (1 << idx) and name in right.kwargs:
+                kwargs[name] = right.kwargs[name]
+        children.append(_clone(left, kwargs))
+    return children
+
+
+def _novel(base: Sequence[Config], candidates: Iterable[Config], all_args: Mapping[str, Any]) -> List[Config]:
+    seen = {_sig(cfg) for cfg in base}
+    out = []
+    for cfg in _dedupe(candidates):
+        if not _basic_legal(cfg, all_args) or _sig(cfg) in seen:
+            continue
+        seen.add(_sig(cfg))
+        out.append(cfg)
+    return out
+
+
+
+def _pairwise_local(cfg: Config, spaces: Mapping[str, Sequence[int]], offsets: Sequence[int]) -> List[Config]:
+    """Jointly perturb two tunable parameters inside a bounded local neighbourhood."""
+    children: List[Config] = []
+    names = [name for name in spaces if isinstance(cfg.kwargs.get(name), int)]
+    for left, right in itertools.combinations(names, 2):
+        left_values = _neighbor(spaces[left], cfg.kwargs[left], offsets)
+        right_values = _neighbor(spaces[right], cfg.kwargs[right], offsets)
+        for lv, rv in itertools.product(left_values, right_values):
+            kwargs = dict(cfg.kwargs)
+            kwargs[left], kwargs[right] = lv, rv
+            children.append(_clone(cfg, kwargs))
+    return children
+
+
+def _resource_metrics(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> Dict[str, float]:
+    """Operator-family-aware analytical proxies used by S2 selection.
+
+    These are ranking/coverage proxies, not profiler counters.  The caller must
+    pass ``operator_family`` in candidate_expansion_options.  Legacy callers
+    default to the original Flash-Attention model.
+    """
+    family = str(options.get("operator_family", "flash_attention")).lower()
+    cores = max(1, int(options.get("num_cores", 20)))
+    kw = cfg.kwargs
+
+    def block(*names, default=1):
+        for name in names:
+            value = kw.get(name)
+            if isinstance(value, int) and value > 0:
+                return value
+        return default
+
+    def finish(programs, padded, useful, ub_bytes, memory, compute, tile_ratio=1.0, divisible_axes=0):
+        waves = max(1, math.ceil(programs / cores))
+        wave_eff = programs / (waves * cores)
+        tail = max(0.0, (padded - useful) / max(1, padded))
+        return {
+            "ub_utilization": float(ub_bytes) / max(1.0, float(options.get("ub_capacity_bytes", 192 * 1024))),
+            "programs": float(programs), "waves": float(waves), "wave_efficiency": float(wave_eff),
+            "tail_waste": float(tail), "divisible_axes": float(divisible_axes),
+            "memory_proxy": float(memory), "compute_proxy": float(compute),
+            "core_imbalance": float(1.0 - wave_eff), "programs_per_core": float(programs / cores),
+            "tile_ratio": float(tile_ratio),
+        }
+
+    if family in {"vector", "vector_add"}:
+        n = max(1, int(all_args.get("N", all_args.get("n_elements", all_args.get("numel", 1)))))
+        b = block("BLOCK_SIZE", "XBLOCK", "XBLOCK_SIZE")
+        programs = math.ceil(n / b)
+        return finish(programs, programs * b, n, 3 * b * 2, 3 * b * 2, b, divisible_axes=int(n % b == 0))
+
+    if family in {"softmax", "vector_reduction", "layer_norm", "vector_multi_reduction"}:
+        rows = max(1, int(all_args.get("M", all_args.get("n_rows", 1))))
+        cols = max(1, int(all_args.get("N", all_args.get("n_cols", 1))))
+        b = block("BLOCK_SIZE", "RBLOCK_SIZE")
+        xblock = block("XBLOCK", "XBLOCK_SIZE", default=1)
+        programs = math.ceil(rows / xblock)
+        padded_cols = math.ceil(cols / b) * b
+        passes = 3 if family in {"layer_norm", "vector_multi_reduction"} else 2
+        ub = xblock * b * 4 * (3 if passes == 3 else 2)
+        memory = rows * cols * (4 if passes == 3 else 2)
+        compute = rows * padded_cols * passes
+        return finish(programs, rows * padded_cols, rows * cols, ub, memory, compute,
+                      tile_ratio=b / max(1, xblock), divisible_axes=int(cols % b == 0))
+
+    if family in {"matmul", "matmul_bias", "cube", "cube_dominant_mix"}:
+        m = max(1, int(all_args.get("M", 1))); n = max(1, int(all_args.get("N", 1))); k = max(1, int(all_args.get("K", 1)))
+        bm = block("BLOCK_M", "BLOCK_SIZE_M"); bn = block("BLOCK_N", "BLOCK_SIZE_N"); bk = block("BLOCK_K", "BLOCK_SIZE_K")
+        mt, nt, kt = math.ceil(m / bm), math.ceil(n / bn), math.ceil(k / bk)
+        programs = mt * nt
+        padded = mt * bm * nt * bn * kt * bk
+        useful = m * n * k
+        ub = (bm * bk + bk * bn) * 2 + bm * bn * 4
+        memory = mt * nt * kt * (bm * bk + bk * bn) * 2 + m * n * 2
+        compute = 2 * padded
+        return finish(programs, padded, useful, ub, memory, compute,
+                      tile_ratio=bn / max(1, bm), divisible_axes=int(m % bm == 0)+int(n % bn == 0)+int(k % bk == 0))
+
+    # Flash Attention / backward-compatible default.
+    bm = block("BLOCK_M", "BM"); bn = block("BLOCK_N", "BN")
+    n = max(1, int(all_args.get("N_CTX", all_args.get("MAX_Q_LEN", all_args.get("N", 1)))))
+    h = max(1, int(all_args.get("H", 1))); z = max(1, int(all_args.get("Z", 1)))
+    programs = math.ceil(n / bm) * math.ceil(n / bn) * h * z
+    padded = math.ceil(n / bm) * bm * math.ceil(n / bn) * bn
+    breakdown = analytic_cost_model(cfg, all_args, options)
+    result = finish(programs, padded, n * n, breakdown.ub_pressure * float(options.get("ub_capacity_bytes", 192 * 1024)),
+                    breakdown.memory, breakdown.compute, bn / max(1, bm), int(n % bm == 0)+int(n % bn == 0))
+    result["core_imbalance"] = breakdown.core_imbalance
+    return result
+
+
+def _bucket(value: float, cuts: Sequence[float]) -> int:
+    for idx, cut in enumerate(cuts):
+        if value < cut:
+            return idx
+    return len(cuts)
+
+
+def _resource_region(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> Tuple[int, ...]:
+    """Map a candidate to a stable resource-coverage region."""
+    m = _resource_metrics(cfg, all_args, options)
+    return (
+        _bucket(m["ub_utilization"], options.get("s2_ub_bucket_cuts", (0.35, 0.65, 0.85))),
+        _bucket(m["wave_efficiency"], options.get("s2_wave_efficiency_cuts", (0.50, 0.80, 0.95))),
+        _bucket(m["tail_waste"], options.get("s2_tail_bucket_cuts", (0.001, 0.05, 0.15, 0.30))),
+        int(m["divisible_axes"]),
+        _bucket(m["waves"], options.get("s2_wave_count_cuts", (1.5, 2.5, 4.5, 8.5))),
+        _bucket(m["programs_per_core"], options.get("s2_programs_per_core_cuts", (0.5, 1.0, 2.0, 4.0, 8.0))),
+        _bucket(math.log2(max(1e-12, m["tile_ratio"])),
+                options.get("s2_ratio_log2_cuts", (-0.5, 0.5, 1.5, 2.5))),
+    )
+
+
+def _resource_aware_candidates(base: Sequence[Config], spaces: Mapping[str, Sequence[int]],
+                               all_args: Mapping[str, Any], options: Mapping[str, Any]) -> Tuple[List[Config], Dict[str, Any]]:
+    """Construct candidates that fill missing or sparse hardware-resource regions.
+
+    The reservoir is bounded and deterministic. For the common BM/BN case it
+    evaluates the explicit legal BM x BN domain, classifies every point by
+    UB/core/wave/tail/divisibility proxies, and emits representatives only from
+    regions absent or under-represented in the incoming pool. No benchmark or
+    measured latency is used.
+    """
+    names = [name for name in spaces if any(isinstance(c.kwargs.get(name), int) for c in base)]
+    if not names:
+        return [], {"covered_before": 0, "reservoir": 0, "target_regions": 0, "emitted": 0}
+
+    region_counts: Dict[Tuple[int, ...], int] = {}
+    for cfg in base:
+        region = _resource_region(cfg, all_args, options)
+        region_counts[region] = region_counts.get(region, 0) + 1
+
+    max_domain_product = max(1, int(options.get("s2_max_domain_product", 4096)))
+    per_region = max(1, int(options.get("s2_candidates_per_region", 2)))
+    sparse_threshold = max(0, int(options.get("s2_sparse_region_threshold", 1)))
+    template_limit = max(1, int(options.get("s2_template_count", 1)))
+    # Preserve distinct compiler/kernel templates, but avoid repeating the full
+    # BM x BN reservoir for identical non-tunable metadata.
+    seed_templates = []
+    seen_templates = set()
+    for cfg in base:
+        signature = (cfg.num_warps, cfg.num_stages, cfg.num_ctas, cfg.maxnreg,
+                     tuple(sorted((k, v) for k, v in cfg.kwargs.items() if k not in names)))
+        if signature in seen_templates:
+            continue
+        seen_templates.add(signature)
+        seed_templates.append(cfg)
+        if len(seed_templates) >= template_limit:
+            break
+    reservoir: List[Config] = []
+
+    # BM/BN are the principal FA tiling variables. Use the complete explicit
+    # legal pair domain when bounded; otherwise use a deterministic subsample.
+    pair_names = [n for n in names if n.upper() in {"BM", "BN", "BLOCK_M", "BLOCK_N"}]
+    if len(pair_names) >= 2:
+        left, right = pair_names[:2]
+        pairs = list(itertools.product(spaces[left], spaces[right]))
+        if len(pairs) > max_domain_product:
+            step = max(1, math.ceil(len(pairs) / max_domain_product))
+            pairs = pairs[::step][:max_domain_product]
+        for template in seed_templates:
+            for lv, rv in pairs:
+                kwargs = dict(template.kwargs)
+                kwargs[left], kwargs[right] = lv, rv
+                reservoir.append(_clone(template, kwargs))
+    else:
+        # Generic fallback: sweep each parameter across its explicit legal
+        # domain and add bounded pairwise combinations.
+        for template in seed_templates:
+            for name in names:
+                for value in spaces[name]:
+                    kwargs = dict(template.kwargs); kwargs[name] = value
+                    reservoir.append(_clone(template, kwargs))
+            reservoir.extend(_pairwise_local(template, spaces, (-3, -2, -1, 1, 2, 3)))
+
+    reservoir = _novel(base, reservoir, all_args)
+    by_region: Dict[Tuple[int, ...], List[Config]] = {}
+    for cfg in reservoir:
+        by_region.setdefault(_resource_region(cfg, all_args, options), []).append(cfg)
+
+    target_regions = [r for r in by_region if region_counts.get(r, 0) <= sparse_threshold]
+    emitted: List[Config] = []
+    region_summary: Dict[str, int] = {}
+    for region in sorted(target_regions):
+        candidates = by_region[region]
+        scores = {c: _score(c, all_args, options) for c in candidates}
+        chosen = _diverse_top_k(candidates, scores, names, min(per_region, len(candidates)),
+                                float(options.get("diversity_weight", 0.08)))
+        emitted.extend(chosen)
+        region_summary[str(region)] = len(chosen)
+
+    return _dedupe(emitted), {
+        "covered_before": len(region_counts),
+        "reservoir": len(reservoir),
+        "target_regions": len(target_regions),
+        "covered_after_generation": len(set(region_counts) | set(by_region)),
+        "emitted": len(emitted),
+        "region_representatives": region_summary,
+    }
+
+
+def _cost_guided_mutations(parent: Config, spaces: Mapping[str, Sequence[int]], all_args: Mapping[str, Any],
+                           options: Mapping[str, Any], limit: int) -> List[Config]:
+    """Rank global single-axis mutations while guaranteeing coverage of every axis."""
+    if limit <= 0:
+        return []
+    by_axis: Dict[str, List[Config]] = {}
+    for name, values in spaces.items():
+        current = parent.kwargs.get(name)
+        if not isinstance(current, int):
+            continue
+        axis_children: List[Config] = []
+        for value in values:
+            if value == current:
+                continue
+            kwargs = dict(parent.kwargs)
+            kwargs[name] = value
+            axis_children.append(_clone(parent, kwargs))
+        axis_children = _dedupe(axis_children)
+        axis_children.sort(key=lambda c: _score(c, all_args, options))
+        if axis_children:
+            by_axis[name] = axis_children
+    if not by_axis:
+        return []
+
+    per_axis = max(1, limit // len(by_axis))
+    selected: List[Config] = []
+    residual: List[Config] = []
+    for name in sorted(by_axis):
+        children = by_axis[name]
+        selected.extend(children[:per_axis])
+        residual.extend(children[per_axis:])
+    residual.sort(key=lambda c: _score(c, all_args, options))
+    selected.extend(residual[:max(0, limit - len(selected))])
+    return _dedupe(selected)[:limit]
+
+
+@dataclass(frozen=True)
+class CostBreakdown:
+    score: float
+    compute: float
+    memory: float
+    ub_pressure: float
+    core_imbalance: float
+
+
+def analytic_cost_model(cfg: Config, all_args: Mapping[str, Any], options: Mapping[str, Any]) -> CostBreakdown:
+    """Lightweight white-box proxy. Lower is better.
+
+    An external callable can replace this through options['cost_model']. The
+    proxy deliberately ranks rather than hard-prunes candidates.
+    """
+    bm = int(cfg.kwargs.get("BLOCK_M", cfg.kwargs.get("BM", 1)))
+    bn = int(cfg.kwargs.get("BLOCK_N", cfg.kwargs.get("BN", 1)))
+    bk = int(cfg.kwargs.get("BLOCK_K", cfg.kwargs.get("BK", all_args.get("HEAD_DIM", all_args.get("QK_DIM", 1)))))
+    n = max(1, int(all_args.get("N_CTX", all_args.get("MAX_Q_LEN", all_args.get("N", 1)))))
+    h = max(1, int(all_args.get("H", 1)))
+    z = max(1, int(all_args.get("Z", 1)))
+    cores = max(1, int(options.get("num_cores", 20)))
+    dtype_bytes = max(1, int(options.get("dtype_bytes", 2)))
+
+    tiles = math.ceil(n / max(1, bm)) * math.ceil(n / max(1, bn)) * h * z
+    waves = math.ceil(tiles / cores)
+    core_imbalance = (waves * cores - tiles) / max(1, waves * cores)
+    compute = (bm * bn * max(1, bk)) / max(1.0, float(options.get("compute_scale", 65536.0)))
+    memory = dtype_bytes * (bm * bk + bn * bk + bm * bn) / max(1.0, float(options.get("memory_scale", 65536.0)))
+    ub_est = dtype_bytes * (bm * bk + 2 * bn * bk + 2 * bm * bn) + 8 * bm
+    ub_size = max(1, int(options.get("ub_size", 192 * 1024)))
+    ub_pressure = ub_est / ub_size
+    tiny_penalty = float(options.get("tiny_block_penalty", 0.0)) * (1.0 / max(1, bm) + 1.0 / max(1, bn))
+    score = (waves * max(compute, memory)
+             + float(options.get("ub_weight", 3.0)) * max(0.0, ub_pressure - 0.65) ** 2
+             + float(options.get("imbalance_weight", 1.0)) * core_imbalance
+             + tiny_penalty)
+    return CostBreakdown(score, compute, memory, ub_pressure, core_imbalance)
+
+
+def _score(cfg: Config, all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> float:
+    external = opts.get("cost_model")
+    if callable(external):
+        value = external(cfg=cfg, all_args=all_args, options=opts)
+        if isinstance(value, Mapping):
+            value = value.get("score")
+        return float(value)
+    return analytic_cost_model(cfg, all_args, opts).score
+
+
+def _distance(a: Config, b: Config, names: Sequence[str]) -> float:
+    d = 0.0
+    for name in names:
+        x, y = a.kwargs.get(name), b.kwargs.get(name)
+        if isinstance(x, int) and isinstance(y, int) and x > 0 and y > 0:
+            d += abs(math.log2(x / y))
+    return d
+
+
+def _diverse_top_k(configs: Sequence[Config], scores: Mapping[Config, float], names: Sequence[str], k: int,
+                   diversity_weight: float) -> List[Config]:
+    if k <= 0 or len(configs) <= k:
+        return sorted(configs, key=lambda c: scores[c])
+    ranked = sorted(configs, key=lambda c: scores[c])
+    selected = [ranked.pop(0)]
+    score_span = max(scores.values()) - min(scores.values()) or 1.0
+    while ranked and len(selected) < k:
+        def key(c):
+            normalized_cost = (scores[c] - min(scores.values())) / score_span
+            diversity = min(_distance(c, s, names) for s in selected)
+            return normalized_cost - diversity_weight * diversity
+        chosen = min(ranked, key=key)
+        ranked.remove(chosen)
+        selected.append(chosen)
+    return selected
+
+
+def _objectives(cfg: Config, all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> Tuple[float, ...]:
+    """Pareto objectives aligned with whole-kernel execution, not one-tile size.
+
+    Raw per-tile compute/memory values systematically favour tiny tiles and omit
+    the number of waves needed to execute the full workload. The primary
+    objective is therefore the complete predicted cost (external or analytic),
+    complemented by independent resource/tail objectives for diversity.
+    """
+    breakdown = analytic_cost_model(cfg, all_args, opts)
+    metrics = _resource_metrics(cfg, all_args, opts)
+    return (_score(cfg, all_args, opts), breakdown.ub_pressure,
+            breakdown.core_imbalance, metrics["tail_waste"])
+
+
+def _pareto_top_k(configs: Sequence[Config], all_args: Mapping[str, Any], opts: Mapping[str, Any],
+                  names: Sequence[str], k: int) -> List[Config]:
+    """NSGA-II-style non-dominated fronts with diversity tie breaking."""
+    if k <= 0 or len(configs) <= k:
+        return sorted(configs, key=lambda c: _score(c, all_args, opts))
+    objs = {c: _objectives(c, all_args, opts) for c in configs}
+    remaining = list(configs)
+    selected: List[Config] = []
+    while remaining and len(selected) < k:
+        front = []
+        for c in remaining:
+            dominated = any(all(a <= b for a, b in zip(objs[d], objs[c])) and
+                            any(a < b for a, b in zip(objs[d], objs[c]))
+                            for d in remaining if d is not c)
+            if not dominated:
+                front.append(c)
+        if len(selected) + len(front) <= k:
+            selected.extend(sorted(front, key=lambda c: objs[c][0]))
+        else:
+            scores = {c: objs[c][0] for c in front}
+            selected.extend(_diverse_top_k(front, scores, names, k - len(selected),
+                                           float(opts.get("diversity_weight", 0.08))))
+        fset = set(front)
+        remaining = [c for c in remaining if c not in fset]
+    return selected
+
+
+def _select(configs: Sequence[Config], scores: Mapping[Config, float], names: Sequence[str], k: int,
+            all_args: Mapping[str, Any], opts: Mapping[str, Any]) -> List[Config]:
+    mode = str(opts.get("selection_mode", "pareto")).lower()
+    if mode == "pareto":
+        return _pareto_top_k(configs, all_args, opts, names, k)
+    if mode == "random":
+        # Advance the deterministic random stream across repeated selection calls
+        # instead of restarting from the same seed every generation.
+        counter = int(opts.get("_random_select_counter", 0))
+        if isinstance(opts, dict):
+            opts["_random_select_counter"] = counter + 1
+        rng = random.Random(int(opts.get("random_seed", 20260710)) + counter)
+        items = list(configs); rng.shuffle(items)
+        return items[:k]
+    return _diverse_top_k(configs, scores, names, k, float(opts.get("diversity_weight", 0.08)))
+
+def expand_official_configs(official: Sequence[Config], all_args: Mapping[str, Any],
+                            options: Mapping[str, Any] | None = None):
+    """Build cumulative candidate pools only up to ``max_stage``.
+
+    This stage gate is intentionally inside candidate generation.  A B0/B1/B2
+    experiment therefore cannot accidentally pay for later-stage generation,
+    which is essential for valid end-to-end autotune and break-even metrics.
+    """
+    opts = dict(options or {})
+    stage_order = ("B0_official", "B1_plus_s1", "B2_plus_s2", "B3_plus_s3")
+    max_stage = str(opts.get("max_stage", "B3_plus_s3"))
+    if max_stage not in stage_order:
+        raise ValueError(f"Unknown max_stage={max_stage!r}; expected one of {stage_order}")
+    target_idx = stage_order.index(max_stage)
+
+    s1_limit = int(opts.get("s1_max_new", 48))
+    s2_limit = int(opts.get("s2_max_new", 64))
+    s3_limit = int(opts.get("s3_max_new", 64))
+    retain_all_generated = bool(opts.get("retain_all_generated", False))
+    parent_k = int(opts.get("evolution_parent_k", 8))
+    population_k = int(opts.get("evolution_population", max(32, parent_k * 2)))
+    generations = int(opts.get("evolution_generations", 2))
+    mutation_per_parent = int(opts.get("mutation_per_parent", 8))
+    seed = int(opts.get("random_seed", 20260710))
+    rng = random.Random(seed)
+    opts["_random_select_counter"] = 0
+    timings: Dict[str, float] = {}
+
+    t0 = time.perf_counter()
+    b0 = _dedupe(copy.deepcopy(list(official)))
+    requested_tunable = opts.get("tunable_parameter") or opts.get("tunable_parameters")
+    requested = {str(x) for x in requested_tunable} if requested_tunable else None
+    tunable = sorted({k for cfg in b0 for k, v in cfg.kwargs.items()
+                      if isinstance(v, int) and (requested is None or k in requested)})
+    spaces = {name: _legal_values(name, b0, all_args, opts) for name in tunable}
+    spaces = {name: vals for name, vals in spaces.items() if len(vals) > 1}
+    timings["official_capture_s"] = time.perf_counter() - t0
+
+    stages: Dict[str, List[Config]] = {"B0_official": b0}
+    stats: Dict[str, Any] = {
+        "requested_max_stage": max_stage,
+        "generated_through_stage": "B0_official",
+        "official": len(b0), "s1_generated": 0, "s1_new": 0,
+        "s2_generated": 0, "s2_new": 0, "s3_generated": 0, "s3_new": 0,
+        "b1": None, "b2": None, "b3": None,
+        "s3_no_op": None, "tunable_parameters": list(spaces),
+        "selection_mode": str(opts.get("selection_mode", "pareto")),
+        "retain_all_generated": retain_all_generated,
+        "parameter_domains": spaces,
+        "evolution": {"generations": generations, "parent_k": parent_k,
+                      "population": population_k, "generation_stats": [],
+                      "patience": int(opts.get("evolution_patience", 1)),
+                      "min_generations": int(opts.get("evolution_min_generations", 2)),
+                      "min_new_children": int(opts.get("evolution_min_new_children", 4)),
+                      "min_relative_improvement": float(opts.get("evolution_min_relative_improvement", 0.005)),
+                      "cost_model": "external" if callable(opts.get("cost_model")) else "analytic_white_box"},
+        "predicted_costs": {"s1": {}, "s2": {}, "s3": {}, "all": {}},
+        "timings_s": timings,
+    }
+
+    def finalize(final_pool: Sequence[Config]) -> Tuple[Dict[str, List[Config]], Dict[str, Any]]:
+        stats["covered_values"] = {
+            name: sorted({c.kwargs.get(name) for c in final_pool if isinstance(c.kwargs.get(name), int)})
+            for name in spaces
+        }
+        if target_idx > 0:
+            stats["predicted_costs"]["all"] = {
+                str(_sig(c)): float(_score(c, all_args, opts)) for c in final_pool
+            }
+        stats["executed_stage_names"] = list(stages)
+        return stages, stats
+
+    if target_idx == 0:
+        return finalize(b0)
+
+    t0 = time.perf_counter()
+    # S1: auditable local/multiscale families. Index offsets are local in the
+    # ordered legal domain; multiplicative and numeric steps are separate.
+    local_offsets = tuple(int(v) for v in opts.get("s1_local_offsets", (-1, 1)))
+    pair_offsets = tuple(int(v) for v in opts.get("s1_pair_offsets", (-1, 1)))
+    scale_factors = tuple(float(v) for v in opts.get("s1_scale_factors", (0.5, 0.75, 1.25, 1.5, 2.0)))
+    numeric_steps = tuple(int(v) for v in opts.get("s1_numeric_steps", (8, 16, 32)))
+    small_bm_budget = max(0, int(opts.get("s1_small_bm_budget", 8)))
+    s1_candidates: List[Config] = []
+    for cfg in b0:
+        s1_candidates.extend(_mutate_one(cfg, spaces, local_offsets, scale_factors, numeric_steps))
+        s1_candidates.extend(_pairwise_local(cfg, spaces, pair_offsets))
+    s1_candidates.extend(_small_block_anchors(b0, spaces, small_bm_budget))
+    s1_all = _novel(b0, s1_candidates, all_args)
+    s1_scores = {c: _score(c, all_args, opts) for c in s1_all}
+    s1_new = list(s1_all) if retain_all_generated else _select(
+        s1_all, s1_scores, list(spaces), s1_limit, all_args, opts
+    )
+    b1 = b0 + s1_new
+    stages["B1_plus_s1"] = b1
+    timings["s1_generation_s"] = time.perf_counter() - t0
+    stats.update({"s1_generated": len(s1_all), "s1_new": len(s1_new), "b1": len(b1),
+                  "generated_through_stage": "B1_plus_s1",
+                  "s1_strategy": {"type": "structured_multiscale_local",
+                                  "domain_index_offsets": list(local_offsets),
+                                  "scale_factors": list(scale_factors),
+                                  "numeric_steps": list(numeric_steps),
+                                  "pairwise_offsets": list(pair_offsets),
+                                  "small_block_m_anchors": [1, 2, 4, 8],
+                                  "small_block_m_budget": small_bm_budget}})
+    stats["predicted_costs"]["s1"] = {str(_sig(c)): float(s1_scores[c]) for c in s1_new}
+    if target_idx == 1:
+        return finalize(b1)
+
+    t0 = time.perf_counter()
+    # S2: resource-aware coverage expansion. Candidate construction is driven
+    # by missing/sparse UB/core/wave/tail/divisibility regions, not by a wider
+    # numeric offset from the seed.
+    s2_candidates, resource_stats = _resource_aware_candidates(b1, spaces, all_args, opts)
+    s2_all = _novel(b1, s2_candidates, all_args)
+    s2_scores = {c: _score(c, all_args, opts) for c in s2_all}
+    s2_new = list(s2_all) if retain_all_generated else _select(
+        s2_all, s2_scores, list(spaces), s2_limit, all_args, opts
+    )
+    b2 = b1 + s2_new
+    stages["B2_plus_s2"] = b2
+    timings["s2_generation_s"] = time.perf_counter() - t0
+    stats.update({"s2_generated": len(s2_all), "s2_new": len(s2_new), "b2": len(b2),
+                  "generated_through_stage": "B2_plus_s2", "s2_strategy": "resource_coverage",
+                  "s2_resource_coverage": resource_stats})
+    stats["predicted_costs"]["s2"] = {str(_sig(c)): float(s2_scores[c]) for c in s2_new}
+    if target_idx == 2:
+        return finalize(b2)
+
+    t0 = time.perf_counter()
+    population_scores = {c: _score(c, all_args, opts) for c in b2}
+    population = _select(b2, population_scores, list(spaces), population_k, all_args, opts)
+    generated_s3: List[Config] = []
+    generation_stats = []
+    patience = max(0, int(opts.get("evolution_patience", 1)))
+    min_generations = max(0, int(opts.get("evolution_min_generations", 2)))
+    min_new_children = max(0, int(opts.get("evolution_min_new_children", 4)))
+    min_relative_improvement = max(0.0, float(opts.get("evolution_min_relative_improvement", 0.005)))
+    stale_generations = 0
+    previous_best = min(population_scores.values()) if population_scores else math.inf
+    for generation in range(max(0, generations)):
+        scores = {c: _score(c, all_args, opts) for c in population}
+        parents = _select(population, scores, list(spaces), max(1, parent_k), all_args, opts)
+        children: List[Config] = []
+        for parent in parents:
+            # S3 no longer owns a fixed 卤1/卤2/卤3 radius. It explores the full
+            # explicit legal domain for one parameter at a time and retains the
+            # model-ranked mutations for each selected parent.
+            children.extend(_cost_guided_mutations(parent, spaces, all_args, opts, mutation_per_parent))
+        children.extend(_cross(parents, list(spaces), max_pairs=max(1, parent_k * 2), rng=rng,
+                               min_distance=float(opts.get("min_crossover_distance", 1.0))))
+        children = _novel(b2 + generated_s3, children, all_args)
+        generated_s3.extend(children)
+        union = _dedupe(population + children)
+        union_scores = {c: _score(c, all_args, opts) for c in union}
+        population = _select(union, union_scores, list(spaces), population_k, all_args, opts)
+        best_cost = min(union_scores.values()) if union_scores else math.inf
+        relative_improvement = ((previous_best - best_cost) / max(abs(previous_best), 1e-12)
+                                if math.isfinite(previous_best) else math.inf)
+        converged = len(children) < min_new_children or relative_improvement < min_relative_improvement
+        stale_generations = stale_generations + 1 if converged else 0
+        generation_stats.append({
+            "generation": generation + 1, "parents": len(parents),
+            "children": len(children), "survivors": len(population),
+            "best_predicted_cost": best_cost if math.isfinite(best_cost) else None,
+            "relative_improvement": relative_improvement if math.isfinite(relative_improvement) else None,
+            "stale_generations": stale_generations,
+        })
+        previous_best = min(previous_best, best_cost)
+        if patience > 0 and generation + 1 >= min_generations and stale_generations >= patience:
+            generation_stats[-1]["early_stop"] = True
+            break
+    s3_all = _novel(b2, generated_s3, all_args)
+    s3_scores = {c: _score(c, all_args, opts) for c in s3_all}
+    s3_new = list(s3_all) if retain_all_generated else _select(
+        s3_all, s3_scores, list(spaces), s3_limit, all_args, opts
+    )
+    b3 = b2 + s3_new
+    stages["B3_plus_s3"] = b3
+    timings["s3_evolution_s"] = time.perf_counter() - t0
+    stats.update({"s3_generated": len(s3_all), "s3_new": len(s3_new), "b3": len(b3),
+                  "s3_no_op": len(s3_new) == 0, "generated_through_stage": "B3_plus_s3",
+                  "s3_strategy": "pareto_analytic_objective_evolution_with_cost_ranked_mutation"})
+    stats["evolution"]["generation_stats"] = generation_stats
+    stats["predicted_costs"]["s3"] = {str(_sig(c)): float(s3_scores[c]) for c in s3_new}
+    return finalize(b3)
+
