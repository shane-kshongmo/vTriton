+    _, limited = expand_official_configs(
+        official, {"N_CTX": 128, "HEAD_DIM": 64, "H": 1, "Z": 1},
+        {"max_stage": "B2_plus_s2", "tunable_parameter": ["BLOCK_M", "BLOCK_N"],
+         "default_tile_values": [8, 16, 24, 32, 48, 64, 96, 128],
+         "s1_max_new": 1, "s2_max_new": 1})
+    stages_all, all_stats = expand_official_configs(
+        official, {"N_CTX": 128, "HEAD_DIM": 64, "H": 1, "Z": 1},
+        {"max_stage": "B2_plus_s2", "tunable_parameter": ["BLOCK_M", "BLOCK_N"],
+         "default_tile_values": [8, 16, 24, 32, 48, 64, 96, 128],
+         "s1_max_new": 1, "s2_max_new": 1, "retain_all_generated": True})
+    assert all_stats["retain_all_generated"] is True
+    assert all_stats["s1_new"] == all_stats["s1_generated"]
+    assert all_stats["s2_new"] == all_stats["s2_generated"]
+    assert len(stages_all["B2_plus_s2"]) > limited["b2"]
