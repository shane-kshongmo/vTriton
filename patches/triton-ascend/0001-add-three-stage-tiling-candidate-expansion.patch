+from triton.runtime.autotuner import Config
+from triton.backends.ascend.runtime.hardware_pruning import check_hardware_constraints, hard_prune_configs
+
+
+def test_small_block_m_values_are_preserved():
+    configs = [Config({"BLOCK_M": v, "BLOCK_N": 2}) for v in (1, 2, 4, 8)]
+    kept, _ = hard_prune_configs(configs, {"N_CTX": 128, "HEAD_DIM": 64}, 2,
+                                 {"allowed_small_block_m": [1, 2, 4, 8], "large_block_m_multiple_of": 4})
+    assert kept == configs
+
+
+def test_causal_order_constraint_is_explicit_not_global():
+    cfg = Config({"BLOCK_M": 32, "BLOCK_N": 64})
+    assert check_hardware_constraints(cfg, {"N_CTX": 128}, 2, {"block_m_ge_block_n": False})[0]
+    valid, reason, _ = check_hardware_constraints(cfg, {"N_CTX": 128}, 2, {"block_m_ge_block_n": True})
+    assert not valid and "BLOCK_M_lt_BLOCK_N" in reason
+
+
+def test_tail_tiles_are_safe_by_default():
+    cfg = Config({"BLOCK_M": 48, "BLOCK_N": 80})
+    assert check_hardware_constraints(cfg, {"N_CTX": 130, "HEAD_DIM": 64}, 2)[0]
+    assert not check_hardware_constraints(cfg, {"N_CTX": 130, "HEAD_DIM": 64}, 2,
+                                          {"require_n_ctx_divisible": True})[0]
+
+
+def test_capacity_estimate_is_only_aggressive_prune():
+    cfg = Config({"BLOCK_M": 4096, "BLOCK_N": 4096, "BLOCK_K": 4096})
+    assert check_hardware_constraints(cfg, {"N_CTX": 4096, "HEAD_DIM": 4096}, 2)[0]
+    valid, reason, usage = check_hardware_constraints(cfg, {"N_CTX": 4096, "HEAD_DIM": 4096}, 2,
+                                                      {"aggressive_capacity": True})
+    assert not valid and reason.startswith("analytical_") and usage
