                                                                                                "fp16":  14,
                                                                                                "fp32":  15
                                                                                            },
                                                                                 "_source":  "45-run isolated FP16 and FP32 910B3 CCE microbenchmarks, 2026-09-01"
                                                                             },
                        "scalar_overhead":  {
                                                "aiv_scalar_alu_width":  1,
                                                "aic_scalar_alu_width":  1,
                                                "max_scalar_ops_per_cycle_per_core":  1,
                                                "verified_by":  "remote scalar_peak.cce 2026-07-02: 45 runs, steady 30, mean aiv_scalar_time=3334.401us, 0.599807886 GFLOPS, 3.0843 cycles/scalar op."
                                            },
                        "parallelism":  {
                                            "num_aic_cores":  20,
