                                                                                              "fp16":  21,
                                                                                              "fp32":  21
                                                                                          },
                                                                                 "log":  {
                                                                                              "fp16":  22,
                                                                                              "fp32":  22
                                                                                          },
                                                                                 "sqrt":  {
                                                                                               "fp16":  21,
