                                                                                           "vsqrt":  21.295371437715057,
                                                                                           "vrsqrt":  14.110641718111357,
                                                                                           "copy":  3.0
                                                                     }
                                                                 },
                        "vector_op_cycles_per_vec_instruction_by_dtype":  {
